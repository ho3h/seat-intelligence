// Scan four elements per block. Accumulate the number passed once per block.
@prog = ((xs t) out)
  & @lb0 ~ (xs (t (0 out)))

@lb0 = ((?((@lb0_nil @lb0_cons) (pl (t (acc out)))) pl) (t (acc out)))

@lb0_nil = (* (t (acc acc)))
  & t ~ *

@lb0_cons = (* ((h tail) (t (acc out))))
  & t ~ {tc tr}
  & h ~ $([<] $(tc z))
  & z ~ ?((@lb0_done @lb0_more) (tail (tr (acc out))))

@lb0_done = (tail (t (acc acc)))
  & tail ~ *
  & t ~ *

@lb0_more = (* (tail (t (acc out))))
  & @lb1 ~ (tail (t (acc out)))

@lb1 = ((?((@lb1_nil @lb1_cons) (pl (t (acc out)))) pl) (t (acc out)))

@lb1_nil = (* (t (acc out)))
  & t ~ *
  & acc ~ $([+1] out)

@lb1_cons = (* ((h tail) (t (acc out))))
  & t ~ {tc tr}
  & h ~ $([<] $(tc z))
  & z ~ ?((@lb1_done @lb1_more) (tail (tr (acc out))))

@lb1_done = (tail (t (acc out)))
  & tail ~ *
  & t ~ *
  & acc ~ $([+1] out)

@lb1_more = (* (tail (t (acc out))))
  & @lb2 ~ (tail (t (acc out)))

@lb2 = ((?((@lb2_nil @lb2_cons) (pl (t (acc out)))) pl) (t (acc out)))

@lb2_nil = (* (t (acc out)))
  & t ~ *
  & acc ~ $([+2] out)

@lb2_cons = (* ((h tail) (t (acc out))))
  & t ~ {tc tr}
  & h ~ $([<] $(tc z))
  & z ~ ?((@lb2_done @lb2_more) (tail (tr (acc out))))

@lb2_done = (tail (t (acc out)))
  & tail ~ *
  & t ~ *
  & acc ~ $([+2] out)

@lb2_more = (* (tail (t (acc out))))
  & @lb3 ~ (tail (t (acc out)))

@lb3 = ((?((@lb3_nil @lb3_cons) (pl (t (acc out)))) pl) (t (acc out)))

@lb3_nil = (* (t (acc out)))
  & t ~ *
  & acc ~ $([+3] out)

@lb3_cons = (* ((h tail) (t (acc out))))
  & t ~ {tc tr}
  & h ~ $([<] $(tc z))
  & z ~ ?((@lb3_done @lb3_more) (tail (tr (acc out))))

@lb3_done = (tail (t (acc out)))
  & tail ~ *
  & t ~ *
  & acc ~ $([+3] out)

@lb3_more = (* (tail (t (acc out))))
  & acc ~ $([+4] acc2)
  & @lb0 ~ (tail (t (acc2 out)))
