// Emit the first item, then process the tail. The loop starts its recursive
// call before resolving whether the current item should be emitted.
@prog = ((?((@di_nil @di_cons) (pl out)) pl) out)

@di_nil = (* (pl out))
  & pl ~ *
  & out ~ (0 *)

@di_cons = (* ((h t) out))
  & h ~ {ph oh}
  & @dd_loop ~ (t (ph tailout))
  & out ~ (1 (oh tailout))

@dd_loop = ((?((@dl_nil @dl_cons) (pl (prev out))) pl) (prev out))

@dl_nil = (* (pl (prev out)))
  & pl ~ *
  & prev ~ *
  & out ~ (0 *)

@dl_cons = (* ((h t) (prev out)))
  & h ~ {hc hx}
  & hx ~ {ph oh}
  & hc ~ $([=] $(prev eq))
  & @dd_loop ~ (t (ph tailout))
  & eq ~ ?((@dl_keep @dl_drop) (oh (tailout out)))

@dl_keep = (* (oh (tailout out)))
  & out ~ (1 (oh tailout))

@dl_drop = (* (oh (tailout out)))
  & oh ~ *
  & out ~ tailout
