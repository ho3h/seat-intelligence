// Sorted-list deduplication. @dd carries (list, has_previous, previous, output).
@prog = (input out)
  & @dd ~ (input (0 (0 out)))

@dd = ((?((@dd_nil @dd_cons) (pl (has (prev out)))) pl) (has (prev out)))

@dd_nil = (* (* (* out)))
  & out ~ (0 *)

@dd_cons = (* ((h t) (has (prev out))))
  & h ~ {hc hx}
  & hx ~ {hp ho}
  & hc ~ $([=] $(prev eq))
  & eq ~ $([*] $(has skip))
  & skip ~ ?((@dd_keep @dd_drop) (t (hp (ho out))))

@dd_keep = (t (hp (ho out)))
  & @dd ~ (t (1 (hp tailout)))
  & out ~ (1 (ho tailout))

@dd_drop = (* (t (hp (ho out))))
  & ho ~ *
  & @dd ~ (t (1 (hp out)))
