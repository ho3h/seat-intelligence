// Build both output lists through open tail wires, preserving input order.
@prog = ((p xs) out)
  & out ~ (lo hi)
  & @part ~ (xs (p (lo hi)))

@part = ((?((@part_nil @part_cons) (pl (p (lo hi)))) pl) (p (lo hi)))

@part_nil = (* (p (lo hi)))
  & p ~ *
  & lo ~ (0 *)
  & hi ~ (0 *)

@part_cons = (* ((h t) (p (lo hi))))
  & p ~ {pc pr}
  & h ~ {hc hs}
  & hc ~ $([<] $(pc b))
  & b ~ ?((@part_ge @part_lt) (hs (t (pr (lo hi)))))

@part_ge = (* (h (t (p (lo hi)))))
  & hi ~ (1 (h hn))
  & @part ~ (t (p (lo hn)))

@part_lt = (* (h (t (p (lo hi)))))
  & lo ~ (1 (h ln))
  & @part ~ (t (p (ln hi)))
