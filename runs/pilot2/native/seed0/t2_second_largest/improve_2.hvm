// Initialize from the first two elements, then scan with the two largest values.
@prog = (l out)
  & @start ~ (l out)

@start = ((?((@empty @first) (pl out)) pl) out)

@empty = (* 0)

@first = (* ((h t) out))
  & @second ~ (t (h out))

@second = ((?((@one @two) (pl (h out))) pl) (h out))

@one = (* (* 0))

@two = (* ((y rest) (h out)))
  & h ~ {h_keep h_test}
  & y ~ {y_keep y_test}
  & h_test ~ $([>] $(y_test z))
  & z ~ ?((@first_less @first_greater) (h_keep (y_keep (rest out))))

@first_less = (* (h (y (rest out))))
  & @scan ~ (rest (y (h out)))

@first_greater = (* (h (y (rest out))))
  & @scan ~ (rest (h (y out)))

@scan = ((?((@nil @cons) (pl (a (b out)))) pl) (a (b out)))

@nil = (* (* (b b)))

@cons = (* ((h t) (a (b out))))
  & h ~ {x x_test}
  & b ~ {b_keep b_test}
  & x_test ~ $([>] $(b_test z))
  & z ~ ?((@keep @above) (x (a (b_keep (t out)))))

@keep = (x (a (b (t out))))
  & x ~ *
  & @scan ~ (t (a (b out)))

@above = (* (x (a (b (t out)))))
  & x ~ {x_keep x_test}
  & a ~ {a_keep a_test}
  & x_test ~ $([>] $(a_test z))
  & z ~ ?((@mid @big) (x_keep (a_keep (b (t out)))))

@big = (* (x (a (b (t out)))))
  & b ~ *
  & @scan ~ (t (x (a out)))

@mid = (* (x (a (b (t out)))))
  & b ~ *
  & @scan ~ (t (a (x out)))
