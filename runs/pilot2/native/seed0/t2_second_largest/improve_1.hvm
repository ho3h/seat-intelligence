// Keep the two largest values seen so far. Test against the second-largest
// first, so most values need only one comparison.
@prog = (l out)
  & @scan ~ (l (0 (0 out)))

@scan = ((?((@nil @cons) (pl (a (b out)))) pl) (a (b out)))

@nil = (* (* (b b)))

@cons = (* ((h t) (a (b out))))
  & h ~ {x h_test}
  & b ~ {b_keep b_test}
  & h_test ~ $([>] $(b_test z))
  & z ~ ?((@keep @above) (x (a (b_keep (t out)))))

@keep = (* (x (a (b (t out)))))
  & x ~ *
  & @scan ~ (t (a (b out)))

@above = (* (x (a (b (t out)))))
  & x ~ {x_keep x_test}
  & a ~ {a_keep a_test}
  & x_test ~ $([>] $(a_test z))
  & z ~ ?((@mid @big) (x_keep (a_keep (b (t out)))))

@big = (* (x (a (b (t out)))))
  & b ~ *
  & @scan ~ (t (x (a out)))

@mid = (* (x (a (b (t out)))))
  & b ~ *
  & @scan ~ (t (a (x out)))
