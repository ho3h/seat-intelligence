// Multiply little-endian base-4096 naturals recursively.
@prog = (input output)
  & input ~ (a b)
  & @mul ~ (a (b raw))
  & @trim ~ (raw output)

@mul = ((?((@mul_nil @mul_cons) (p (b out))) p) (b out))

@mul_nil = (p (b out))
  & p ~ *
  & b ~ *
  & out ~ (0 *)

@mul_cons = (* ((h t) (b out)))
  & b ~ {b1 b2}
  & @mul ~ (t (b1 mid))
  & @mdigit ~ (b2 (h (0 row)))
  & @add ~ (row ((1 (0 mid)) (0 out)))

// Multiply each digit of b by d, carrying in base 4096.
@mdigit = ((?((@md_nil @md_cons) (p (d (c out)))) p) (d (c out)))

@md_nil = (p (d (c out)))
  & p ~ *
  & d ~ *
  & out ~ (1 (c (0 *)))

@md_cons = (* ((x xs) (d (c out))))
  & d ~ {d1 d2}
  & x ~ $([*] $(d1 $([+] $(c v))))
  & v ~ {v1 v2}
  & v1 ~ $([%] $(4096 digit))
  & v2 ~ $([/] $(4096 c2))
  & @mdigit ~ (xs (d2 (c2 tail)))
  & out ~ (1 (digit tail))

// Add x and y with carry c.
@add = ((?((@add_xnil @add_xcons) (p (y (c out)))) p) (y (c out)))

@add_xnil = (p (y (c out)))
  & p ~ *
  & @add0 ~ (y (c out))

@add_xcons = (* ((xh xt) (y (c out))))
  & @add_y ~ (y (xh (xt (c out))))

@add_y = ((?((@add_y_nil @add_y_cons) (p (xh (xt (c out))))) p) (xh (xt (c out))))

@add_y_nil = (p (xh (xt (c out))))
  & p ~ *
  & @addstep ~ (xh (0 (c (digit c2))))
  & @add ~ (xt ((0 *) (c2 tail)))
  & out ~ (1 (digit tail))

@add_y_cons = (* ((yh yt) (xh (xt (c out)))))
  & @addstep ~ (xh (yh (c (digit c2))))
  & @add ~ (xt (yt (c2 tail)))
  & out ~ (1 (digit tail))

// Add y and carry c to a zero-padded list.
@add0 = ((?((@add0_nil @add0_cons) (p (c out))) p) (c out))

@add0_nil = (p (c out))
  & p ~ *
  & out ~ (1 (c (0 *)))

@add0_cons = (* ((yh yt) (c out)))
  & @addstep ~ (0 (yh (c (digit c2))))
  & @add0 ~ (yt (c2 tail))
  & out ~ (1 (digit tail))

// Produce digit and carry for x + y + c.
@addstep = (x (y (c (digit carry))))
  & x ~ $([+] $(y $([+] $(c v))))
  & v ~ {v1 v2}
  & v1 ~ $([%] $(4096 digit))
  & v2 ~ $([/] $(4096 carry))

// Trim high zero limbs from the result.
@trim = ((?((@trim_nil @trim_cons) (p out)) p) out)

@trim_nil = (p out)
  & p ~ *
  & out ~ (0 *)

@trim_cons = (* ((h t) out))
  & @trim ~ (t q)
  & @trim_join ~ (q (h out))

@trim_join = ((?((@tj_nil @tj_cons) (p (h out))) p) (h out))

@tj_nil = (p (h out))
  & p ~ *
  & h ~ {h1 h2}
  & h1 ~ $([=] $(0 z))
  & z ~ ?((@trim_keep @trim_drop) (h2 out))

@tj_cons = (* ((qh qt) (h out)))
  & out ~ (1 (h (1 (qh qt))))

@trim_keep = (h out)
  & out ~ (1 (h (0 *)))

@trim_drop = (* (h out))
  & h ~ *
  & out ~ (0 *)
