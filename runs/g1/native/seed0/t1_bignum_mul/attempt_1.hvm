// Multiply two little-endian base-4096 naturals.
@prog = (input output)
  & input ~ (a b)
  & @mul_a ~ (a (b (0 ((0 *) output))))

@mul_a = ((?((@ma_nil @ma_cons) (p (b (sh (acc out))))) p) (b (sh (acc out))))

@ma_nil = (p (b (sh (acc out))))
  & p ~ *
  & b ~ *
  & sh ~ *
  & @trim ~ (acc out)

@ma_cons = (* ((h t) (b (sh (acc out)))))
  & b ~ {b1 b2}
  & sh ~ {s1 s2}
  & @mdigit ~ (b1 (h (0 part)))
  & @asn ~ (s1 (part (acc acc2)))
  & s2 ~ $([+1] sh2)
  & @mul_a ~ (t (b2 (sh2 (acc2 out))))

// Multiply each digit of b by d, carrying in base 4096.
@mdigit = ((?((@md_nil @md_cons) (p (d (c out)))) p) (d (c out)))

@md_nil = (p (d (c out)))
  & p ~ *
  & d ~ *
  & out ~ (1 (c (0 *)))

@md_cons = (* ((x xs) (d (c out))))
  & d ~ {d1 d2}
  & x ~ $([*] $(d1 $([+] $(c v))))
  & v ~ {v1 v2}
  & v1 ~ $([%] $(4096 digit))
  & v2 ~ $([/] $(4096 c2))
  & @mdigit ~ (xs (d2 (c2 tail)))
  & out ~ (1 (digit tail))

// Add p to accumulator a, shifted left by sh limbs.
@asn = ((?((@asn_zero @asn_succ) (p (a out))) p) (a out))

@asn_zero = (p (a out))
  & @add ~ (p (a out))

@asn_succ = (sh (p ((?((@asn_acc_nil @asn_acc_cons) (q (sh (p out)))) q) out)))

@asn_acc_nil = (q (sh (p out)))
  & q ~ *
  & @asn ~ (sh (p ((0 *) tail)))
  & out ~ (1 (0 tail))

@asn_acc_cons = (* ((h t) (sh (p out))))
  & @asn ~ (sh (p (t tail)))
  & out ~ (1 (h tail))

// Add two limb lists with carry c.
@add = ((?((@add_xnil @add_xcons) (p (y (c out)))) p) (y (c out)))

@add_xnil = (p (y (c out)))
  & p ~ *
  & @add0 ~ (y (c out))

@add_xcons = (* ((xh xt) ((?((@add_y_nil @add_y_cons) (py (xh (xt (c out))))) py) (c out))))

@add_y_nil = (py (xh (xt (c out))))
  & py ~ *
  & @addstep ~ (xh (0 (c (digit c2))))
  & @add ~ (xt ((0 *) (c2 tail)))
  & out ~ (1 (digit tail))

@add_y_cons = (* ((yh yt) (xh (xt (c out)))))
  & @addstep ~ (xh (yh (c (digit c2))))
  & @add ~ (xt (yt (c2 tail)))
  & out ~ (1 (digit tail))

// Add y and carry c to a zero-padded list.
@add0 = ((?((@add0_nil @add0_cons) (p (c out))) p) (c out))

@add0_nil = (p (c out))
  & p ~ *
  & out ~ (1 (c (0 *)))

@add0_cons = (* ((yh yt) (c out)))
  & @addstep ~ (0 (yh (c (digit c2))))
  & @add0 ~ (yt (c2 tail))
  & out ~ (1 (digit tail))

// Return digit and carry for x + y + c.
@addstep = (x (y (c (digit carry))))
  & x ~ $([+] $(y $([+] $(c v))))
  & v ~ {v1 v2}
  & v1 ~ $([%] $(4096 digit))
  & v2 ~ $([/] $(4096 carry))

// Remove high zero limbs.
@trim = ((?((@trim_nil @trim_cons) (p out)) p) out)

@trim_nil = (p out)
  & p ~ *
  & out ~ (0 *)

@trim_cons = (* ((h t) out))
  & @trim ~ (t q)
  & q ~ (?( (@trim_tail_nil @trim_tail_cons) (r (h out))) r)

@trim_tail_nil = (r (h out))
  & r ~ *
  & h ~ {he ho}
  & he ~ $([=] $(0 z))
  & z ~ ?((@trim_end_nonzero @trim_end_zero) (ho out))

@trim_tail_cons = (* ((qh qt) (h out)))
  & out ~ (1 (h (1 (qh qt))))

@trim_end_nonzero = (ho out)
  & out ~ (1 (ho (0 *)))

@trim_end_zero = (ho out)
  & ho ~ *
  & out ~ (0 *)
