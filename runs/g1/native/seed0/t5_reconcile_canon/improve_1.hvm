// Build parent pointers, union each accepted edge, then emit each node's root.
@prog = ((n (tau cands)) out)
  & n ~ {n_init n_emit}
  & @init ~ (n_init (0 parents))
  & @scan ~ (cands (tau (parents parents2)))
  & @emit ~ (n_emit (0 (parents2 out)))

@init = (n (i out))
  & n ~ ?((@init_nil @init_cons) (i out))

@init_nil = (i out)
  & i ~ *
  & out ~ (0 *)

@init_cons = (k (i out))
  & i ~ {iout irec}
  & irec ~ $([+1] inext)
  & @init ~ (k (inext tail))
  & out ~ (1 (iout tail))

@scan = ((?((@scan_nil @scan_cons) (pl (tau (parents out)))) pl) (tau (parents out)))

@scan_nil = (pl (tau (parents out)))
  & pl ~ *
  & tau ~ *
  & out ~ parents

@scan_cons = (* ((edge tail) (tau (parents out))))
  & tau ~ {te tr}
  & @edge ~ (edge (te (parents parents2)))
  & @scan ~ (tail (tr (parents2 out)))

@edge = ((u (v score)) (tau (parents out)))
  & score ~ $([<] $(tau lt))
  & lt ~ ?((@edge_accept @edge_reject) (u (v (parents out))))

@edge_reject = (* (u (v (parents out))))
  & u ~ *
  & v ~ *
  & out ~ parents

@edge_accept = (u (v (parents out)))
  & parents ~ {pfind pset}
  & pfind ~ {pu pv}
  & @find ~ (pu (u ru))
  & @find ~ (pv (v rv))
  & ru ~ {ru_cmp ru_keep}
  & rv ~ {rv_cmp rv_keep}
  & ru_cmp ~ $([<] $(rv_cmp lt))
  & lt ~ ?((@edge_ge @edge_lt) (pset (ru_keep (rv_keep out))))

@edge_lt = (pset (ru (rv out)))
  & @set ~ (pset (ru (rv out)))

@edge_ge = (pset (ru (rv out)))
  & ru ~ {ru_cmp ru_keep}
  & rv ~ {rv_cmp rv_keep}
  & rv_cmp ~ $([<] $(ru_cmp lt2))
  & lt2 ~ ?((@edge_equal @edge_reverse) (pset (ru_keep (rv_keep out))))

@edge_equal = (pset (ru (rv out)))
  & ru ~ *
  & rv ~ *
  & out ~ pset

@edge_reverse = (* (pset (ru (rv out))))
  & @set ~ (pset (rv (ru out)))

@find = (parents (idx out))
  & parents ~ {plook prec}
  & idx ~ {ilook icmp}
  & @lookup ~ (plook (ilook value))
  & value ~ {vcmp vnext}
  & icmp ~ $([=] $(vcmp eq))
  & eq ~ ?((@find_step @find_self) (prec (vnext out)))

@find_step = (parents (val out))
  & @find ~ (parents (val out))

@find_self = (* (parents (val out)))
  & parents ~ *
  & out ~ val

@lookup = ((?((@lookup_nil @lookup_cons) (pl (idx out))) pl) (idx out))

@lookup_nil = (pl (idx out))
  & pl ~ *
  & idx ~ *
  & out ~ 0

@lookup_cons = (* ((h t) (idx out)))
  & idx ~ ?((@lookup_here @lookup_next) (h (t out)))

@lookup_here = (h (t out))
  & t ~ *
  & out ~ h

@lookup_next = (k (h (t out)))
  & h ~ *
  & @lookup ~ (t (k out))

@set = ((?((@set_nil @set_cons) (pl (idx (val out)))) pl) (idx (val out)))

@set_nil = (pl (idx (val out)))
  & pl ~ *
  & idx ~ *
  & val ~ *
  & out ~ (0 *)

@set_cons = (* ((h t) (idx (val out))))
  & idx ~ ?((@set_here @set_next) (h (t (val out))))

@set_here = (h (t (val out)))
  & h ~ *
  & out ~ (1 (val t))

@set_next = (k (h (t (val out))))
  & @set ~ (t (k (val tailout)))
  & out ~ (1 (h tailout))

@emit = (n (i (parents out)))
  & n ~ ?((@emit_nil @emit_cons) (i (parents out)))

@emit_nil = (i (parents out))
  & i ~ *
  & parents ~ *
  & out ~ (0 *)

@emit_cons = (k (i (parents out)))
  & i ~ {ifind irec}
  & irec ~ $([+1] inext)
  & parents ~ {pfind prec}
  & @find ~ (pfind (ifind root))
  & @emit ~ (k (inext (prec tail)))
  & out ~ (1 (root tail))
