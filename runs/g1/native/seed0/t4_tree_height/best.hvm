// t4_tree_height
@prog = (input output)
  & @height ~ (input output)

@height = ((?((@h_leaf @h_node) (payload out)) payload) out)

@h_leaf = (* 0)

@h_node = (* ((left (value right)) out))
  & @height ~ (left hl)
  & @height ~ (right hr)
  & value ~ *
  & hl ~ {hl_cmp hl_keep}
  & hr ~ {hr_cmp hr_keep}
  & hl_cmp ~ $([>] $(hr_cmp gt))
  & gt ~ ?((@max_no @max_yes) (hl_keep (hr_keep out)))

@max_no = (* ($([+1] x) x))

@max_yes = (* ($([+1] x) (* x)))
