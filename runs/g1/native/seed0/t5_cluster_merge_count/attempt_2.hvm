@prog = ((n (tau cands)) out)
  & @filter ~ (tau (cands sorted))
  & @init ~ (n (0 labels))
  & @run ~ (sorted (labels (0 out)))

@filter = (tau ((?((@filter_nil @filter_cons) (tau (pl out))) pl) out))

@filter_nil = (tau (pl out))
  & tau ~ *
  & pl ~ *
  & out ~ (0 *)

@filter_cons = (z (tau (pl out)))
  & z ~ *
  & pl ~ (edge tail)
  & edge ~ (u (v score))
  & tau ~ {tau_rec tau_cmp}
  & score ~ {score_keep score_cmp}
  & score_cmp ~ $([<] $(tau_cmp lt))
  & lt ~ ?((@filter_keep @filter_drop) (tau_rec (u (v (score_keep (tail out))))))

@filter_keep = (z (tau (u (v (score (tail out))))))
  & z ~ *
  & @filter ~ (tau (tail sorted))
  & @ins ~ ((u (v score)) (sorted out))

@filter_drop = (z (tau (u (v (score (tail out))))))
  & z ~ *
  & u ~ *
  & v ~ *
  & score ~ *
  & @filter ~ (tau (tail out))

@before = ((ua (va sa)) ((ub (vb sb)) out))
  & sa ~ {sa_gt {sa_eq sa_drop}}
  & sb ~ {sb_gt {sb_eq sb_drop}}
  & sa_drop ~ *
  & sb_drop ~ *
  & ua ~ {ua_lt ua_eq}
  & ub ~ {ub_lt ub_eq}
  & va ~ {va_lt va_drop}
  & vb ~ {vb_lt vb_drop}
  & va_drop ~ *
  & vb_drop ~ *
  & sa_gt ~ $([>] $(sb_gt gt))
  & sa_eq ~ $([=] $(sb_eq se))
  & ua_lt ~ $([<] $(ub_lt ul))
  & ua_eq ~ $([=] $(ub_eq ue))
  & va_lt ~ $([<] $(vb_lt vl))
  & ue ~ $([&] $(vl v_tie))
  & ul ~ $([|] $(v_tie uv_rank))
  & se ~ $([&] $(uv_rank score_tie))
  & gt ~ $([|] $(score_tie result))
  & out ~ result

@ins = (edge ((?((@ins_nil @ins_cons) (edge (pl out))) pl) out))

@ins_nil = (edge (pl out))
  & pl ~ *
  & out ~ (1 (edge (0 *)))

@ins_cons = (z (edge (pl out)))
  & z ~ *
  & edge ~ (u (v score))
  & pl ~ (cur rest)
  & cur ~ (cu (cv cscore))
  & u ~ {u_cmp u_keep}
  & v ~ {v_cmp v_keep}
  & score ~ {score_cmp score_keep}
  & cu ~ {cu_cmp cu_keep}
  & cv ~ {cv_cmp cv_keep}
  & cscore ~ {cscore_cmp cscore_keep}
  & @before ~ ((u_cmp (v_cmp score_cmp)) ((cu_cmp (cv_cmp cscore_cmp)) before))
  & before ~ ?((@ins_after @ins_before) ((u_keep (v_keep score_keep)) ((cu_keep (cv_keep cscore_keep)) (rest out))))

@ins_after = (z (edge (cur (rest out))))
  & z ~ *
  & @ins ~ (edge (rest r))
  & out ~ (1 (cur r))

@ins_before = (z (edge (cur (rest out))))
  & z ~ *
  & out ~ (1 (edge (1 (cur rest))))

@init = (?((@init_nil @init_cons) (id out)) (id out))

@init_nil = (id out)
  & id ~ *
  & out ~ (0 *)

@init_cons = (rem (id out))
  & id ~ {head nextin}
  & nextin ~ $([+1] id2)
  & @init ~ (rem (id2 tail))
  & out ~ (1 (head tail))

@nk = (idx ((?((@nk_nil @nk_cons) (idx (pl out))) pl) out))

@nk_nil = (idx (pl out))
  & idx ~ *
  & pl ~ *
  & out ~ (0 (0 *))

@nk_cons = (z (idx (pl out)))
  & z ~ *
  & pl ~ (h t)
  & idx ~ ?((@nk_hit @nk_more) (h (t out)))

@nk_hit = (h (t out))
  & h ~ {value h_keep}
  & out ~ (value (1 (h_keep t)))

@nk_more = (idx (h (t out)))
  & @nk ~ (idx (t r))
  & r ~ (value tail_new)
  & out ~ (value (1 (h tail_new)))

@replace = (old (new ((?((@replace_nil @replace_cons) (old (new (pl out)))) pl) out))

@replace_nil = (old (new (pl out)))
  & old ~ *
  & new ~ *
  & pl ~ *
  & out ~ (0 *)

@replace_cons = (z (old (new (pl out))))
  & z ~ *
  & pl ~ (h tail)
  & old ~ {old_cmp old_rec}
  & new ~ {new_head new_rec}
  & h ~ {h_cmp h_keep}
  & h_cmp ~ $([=] $(old_cmp eq))
  & eq ~ ?((@replace_no @replace_yes) (old_rec (new_rec (h_keep (new_head (tail out))))))

@replace_no = (z (old (new (h_keep (new_head (tail out))))))
  & z ~ *
  & new_head ~ *
  & @replace ~ (old (new (tail r)))
  & out ~ (1 (h_keep r))

@replace_yes = (z (old (new (h_keep (new_head (tail out))))))
  & z ~ *
  & h_keep ~ *
  & @replace ~ (old (new (tail r)))
  & out ~ (1 (new_head r))

@run = ((?((@run_nil @run_cons) (pl (labels (count out)))) pl) (labels (count out)))

@run_nil = (pl (labels (count out)))
  & pl ~ *
  & labels ~ *
  & out ~ count

@run_cons = (z (pl (labels (count out))))
  & z ~ *
  & pl ~ (edge tail)
  & edge ~ (u (v score))
  & score ~ *
  & @nk ~ (u (labels r1))
  & r1 ~ (lu labels1)
  & @nk ~ (v (labels1 r2))
  & r2 ~ (lv labels2)
  & lu ~ {lu_cmp lu_old}
  & lv ~ {lv_cmp lv_new}
  & lu_cmp ~ $([!] $(lv_cmp neq))
  & neq ~ ?((@run_same @run_diff) (lu_old (lv_new (labels2 (tail (count out))))))

@run_same = (z (old (new (labels (tail (count out))))))
  & z ~ *
  & old ~ *
  & new ~ *
  & @run ~ (tail (labels (count out)))

@run_diff = (z (old (new (labels (tail (count out))))))
  & z ~ *
  & count ~ $([+1] count2)
  & @replace ~ (old (new (labels updated)))
  & @run ~ (tail (updated (count2 out)))
