@prog = (input output)
  & @loop ~ (input (((((0 *) 0) ((0 *) 0)) (((0 *) 0) ((0 *) 0))) output))

@loop = ((?((@loop_nil @loop_cons) (payload (state out))) payload) (state out))

@loop_nil = (* ((((s0 c0) (s1 c1)) ((s2 c2) (s3 c3))) out))
  & s0 ~ *
  & s1 ~ *
  & s2 ~ *
  & s3 ~ *
  & out ~ (1 (c0 (1 (c1 (1 (c2 (1 (c3 (0 *)))))))))

@loop_cons = (* (((node (key value)) tail) (state out)))
  & node ~ *
  & key ~ ?((@upd0 @dispatch1) (value (tail (state out))))

@dispatch1 = (k (v (t (state out))))
  & k ~ ?((@upd1 @dispatch2) (v (t (state out))))

@dispatch2 = (k (v (t (state out))))
  & k ~ ?((@upd2 @dispatch3) (v (t (state out))))

@dispatch3 = (k (v (t (state out))))
  & k ~ ?((@upd3 @invalid) (v (t (state out))))

@invalid = (* (* *))

@contains = ((?((@contains_nil @contains_cons) (payload (v out))) payload) (v out))

@contains_nil = (* (v out))
  & v ~ *
  & out ~ 0

@contains_cons = (* ((h tail) (v out)))
  & v ~ {v_eq v_keep}
  & h ~ $([=] $(v_eq z))
  & z ~ ?((@has_no @has_yes) (tail (v_keep out)))

@has_no = (tail (v out))
  & @contains ~ (tail (v out))

@has_yes = (* (tail (v out)))
  & tail ~ *
  & v ~ *
  & out ~ 1

@upd0 = (v (t ((((s0 c0) p1) p23) out)))
  & s0 ~ {s_test s_keep}
  & v ~ {v_test v_keep}
  & @contains ~ (s_test (v_test found))
  & found ~ ?((@upd0_add @upd0_skip) (s_keep (v_keep (t (c0 (p1 (p23 out)))))))

@upd0_add = (s (v (t (c0 (p1 (p23 out))))))
  & c0 ~ $([+1] c_new)
  & @loop ~ (t (((((1 (v s)) c_new) p1) p23) out))

@upd0_skip = (* (s (v (t (c0 (p1 (p23 out)))))))
  & v ~ *
  & @loop ~ (t ((((s c0) p1) p23) out))

@upd1 = (v (t (((p0 (s1 c1)) p23) out)))
  & s1 ~ {s_test s_keep}
  & v ~ {v_test v_keep}
  & @contains ~ (s_test (v_test found))
  & found ~ ?((@upd1_add @upd1_skip) (s_keep (v_keep (t (p0 (c1 (p23 out)))))))

@upd1_add = (s (v (t (p0 (c1 (p23 out))))))
  & c1 ~ $([+1] c_new)
  & @loop ~ (t (((p0 ((1 (v s)) c_new)) p23) out))

@upd1_skip = (* (s (v (t (p0 (c1 (p23 out)))))))
  & v ~ *
  & @loop ~ (t (((p0 (s c1)) p23) out))

@upd2 = (v (t ((p01 ((s2 c2) p3)) out)))
  & s2 ~ {s_test s_keep}
  & v ~ {v_test v_keep}
  & @contains ~ (s_test (v_test found))
  & found ~ ?((@upd2_add @upd2_skip) (s_keep (v_keep (t (p01 (c2 (p3 out)))))))

@upd2_add = (s (v (t (p01 (c2 (p3 out))))))
  & c2 ~ $([+1] c_new)
  & @loop ~ (t ((p01 (((1 (v s)) c_new) p3)) out))

@upd2_skip = (* (s (v (t (p01 (c2 (p3 out)))))))
  & v ~ *
  & @loop ~ (t ((p01 ((s c2) p3)) out))

@upd3 = (v (t ((p01 (p2 (s3 c3))) out)))
  & s3 ~ {s_test s_keep}
  & v ~ {v_test v_keep}
  & @contains ~ (s_test (v_test found))
  & found ~ ?((@upd3_add @upd3_skip) (s_keep (v_keep (t (p01 (p2 (c3 out)))))))

@upd3_add = (s (v (t (p01 (p2 (c3 out))))))
  & c3 ~ $([+1] c_new)
  & @loop ~ (t ((p01 (p2 ((1 (v s)) c_new))) out))

@upd3_skip = (* (s (v (t (p01 (p2 (c3 out)))))))
  & v ~ *
  & @loop ~ (t ((p01 (p2 (s c3))) out))
