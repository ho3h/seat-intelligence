// Generate vertex labels, propagate minima across edges, then find
// the largest frequency among the resulting component labels.
@prog = ((n edges) out)
  & n ~ {ng nr}
  & @gen ~ (ng (0 labels))
  & @rounds ~ (nr (edges (labels labels2)))
  & @best ~ (labels2 (0 out))

@gen = (n (i out))
  & n ~ ?((@gen_nil @gen_succ) (i out))

@gen_nil = (i out)
  & i ~ *
  & out ~ (0 *)

@gen_succ = (n (i out))
  & i ~ {ih it}
  & it ~ $([+1] inext)
  & @gen ~ (n (inext tail))
  & out ~ (1 (ih tail))

// Perform n sweeps over the edges.
@rounds = (n (edges (labels out)))
  & n ~ ?((@rounds_nil @rounds_succ) (edges (labels out)))

@rounds_nil = (edges (labels out))
  & edges ~ *
  & out ~ labels

@rounds_succ = (n (edges (labels out)))
  & @sweep ~ (edges (labels swept))
  & swept ~ (edges2 labels2)
  & @rounds ~ (n (edges2 (labels2 out)))

// Sweep the edges, updating labels and rebuilding the edge list.
@sweep = (edges (labels out))
  & edges ~ (?( (@sweep_nil @sweep_cons) (payload (labels out))) payload)

@sweep_nil = (payload (labels out))
  & payload ~ *
  & out ~ ((0 *) labels)

@sweep_cons = (* (((u v) tail) (labels out)))
  & u ~ {uu ukeep}
  & v ~ {vv vkeep}
  & @update ~ ((uu vv) (labels labels2))
  & @sweep ~ (tail (labels2 rest))
  & rest ~ (edges2 labels3)
  & out ~ ((1 ((ukeep vkeep) edges2)) labels3)

// Replace both endpoint labels by their minimum.
@update = ((u v) (labels out))
  & u ~ {ug ur}
  & v ~ {vg vr}
  & @get2 ~ (labels (ug (vg got)))
  & got ~ (lu (lv labels2))
  & lu ~ {la lb}
  & lv ~ {va vb}
  & la ~ $([<] $(va cond))
  & @choose ~ (cond (lb (vb m)))
  & @replace ~ (labels2 (ur (vr (m out))))

// Read the labels at u and v while rebuilding the label list.
@get2 = (list (u (v out)))
  & list ~ (?( (@get2_nil @get2_cons) (payload (u (v out))) ) payload)

@get2_nil = (payload (u (v out)))
  & payload ~ *
  & u ~ *
  & v ~ *
  & out ~ (0 (0 (0 *)))

@get2_cons = (* ((h t) (u (v out))))
  & u ~ {utest udec}
  & v ~ {vtest vdec}
  & utest ~ $([=] $(0 bu))
  & vtest ~ $([=] $(0 bv))
  & udec ~ $([-1] unext)
  & vdec ~ $([-1] vnext)
  & h ~ {hrest hkeep}
  & hrest ~ {hfirst hsecond}
  & @get2 ~ (t (unext (vnext rr)))
  & rr ~ (lur (lvr tail2))
  & @choose ~ (bu (hfirst (lur lu)))
  & @choose ~ (bv (hsecond (lvr lv)))
  & out ~ (lu (lv (1 (hkeep tail2))))

// Replace the entries at u and v with m.
@replace = (list (u (v (m out))))
  & list ~ (?( (@replace_nil @replace_cons) (payload (u (v (m out)))) ) payload)

@replace_nil = (payload (u (v (m out))))
  & payload ~ *
  & u ~ *
  & v ~ *
  & m ~ *
  & out ~ (0 *)

@replace_cons = (* ((h t) (u (v (m out)))))
  & u ~ {utest udec}
  & v ~ {vtest vdec}
  & utest ~ $([=] $(0 bu))
  & vtest ~ $([=] $(0 bv))
  & udec ~ $([-1] unext)
  & vdec ~ $([-1] vnext)
  & bu ~ $([|] $(bv both))
  & m ~ {mhere mtail}
  & @choose ~ (both (mhere (h hnew)))
  & @replace ~ (t (unext (vnext (mtail tailout))))
  & out ~ (1 (hnew tailout))

// Select yes for 1, no for 0.
@choose = (b (yes (no out)))
  & b ~ ?((@choose_no @choose_yes) (yes (no out)))

@choose_no = (yes (no out))
  & yes ~ *
  & out ~ no

@choose_yes = (* (yes (no out)))
  & no ~ *
  & out ~ yes

// Count target occurrences in a list tail, returning the rebuilt tail.
@freq = (list (target out))
  & list ~ (?( (@freq_nil @freq_cons) (payload (target out))) payload)

@freq_nil = (payload (target out))
  & payload ~ *
  & target ~ *
  & out ~ (0 (0 *))

@freq_cons = (* ((h t) (target out)))
  & h ~ {hcmp hkeep}
  & target ~ {tcmp trec}
  & hcmp ~ $([=] $(tcmp eq))
  & @freq ~ (t (trec rr))
  & rr ~ (ctail tail2)
  & ctail ~ $([+] $(eq count))
  & out ~ (count (1 (hkeep tail2)))

// The largest suffix frequency is the largest component size.
@best = (list (best out))
  & list ~ (?( (@best_nil @best_cons) (payload (best out))) payload)

@best_nil = (payload (best out))
  & payload ~ *
  & out ~ best

@best_cons = (* ((h t) (best out)))
  & h ~ {target hdrop}
  & hdrop ~ *
  & @freq ~ (t (target fr))
  & fr ~ (ctail tail2)
  & ctail ~ $([+1] count)
  & best ~ {bcmp bkeep}
  & count ~ {ccmp csel}
  & ccmp ~ $([>] $(bcmp gt))
  & @choose ~ (gt (csel (bkeep best2)))
  & @best ~ (tail2 (best2 out))
