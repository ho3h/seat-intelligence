// Generate labels, propagate the minimum label across every edge for n rounds,
// count the resulting labels, and return the largest count.
@prog = ((n edges) out)
  & n ~ {ng nr}
  & @gen ~ (ng (0 labels))
  & @rounds ~ (nr (edges (labels labels2)))
  & @counts ~ (labels2 ((0 *) counts))
  & @max ~ (counts (0 out))

// Generate the list [i, i+1, ..., i+n-1].
@gen = (n (i out))
  & n ~ ?((@gen_nil @gen_succ) (i out))

@gen_nil = (i out)
  & i ~ *
  & out ~ (0 *)

@gen_succ = (n (i out))
  & i ~ {ih it}
  & it ~ $([+1] inext)
  & @gen ~ (n (inext tail))
  & out ~ (1 (ih tail))

// Perform n complete edge sweeps.
@rounds = (n (edges (labels out)))
  & n ~ ?((@rounds_nil @rounds_succ) (edges (labels out)))

@rounds_nil = (* (a a))

@rounds_succ = (n (edges (labels out)))
  & @sweep ~ (edges (labels swept))
  & swept ~ (edges2 labels2)
  & @rounds ~ (n (edges2 (labels2 out)))

// Sweep the edges, returning the rebuilt edges and updated labels.
@sweep = ((?((@sweep_nil @sweep_cons) (payload (labels out))) payload) (labels out))

@sweep_nil = (* (labels out))
  & out ~ ((0 *) labels)

@sweep_cons = (* (((u v) tail) (labels out)))
  & u ~ {uu ukeep}
  & v ~ {vv vkeep}
  & @update ~ ((uu vv) (labels labels2))
  & @sweep ~ (tail (labels2 rest))
  & rest ~ (edges2 labels3)
  & out ~ ((1 ((ukeep vkeep) edges2)) labels3)

// Replace both endpoint labels by their minimum.
@update = ((u v) (labels out))
  & u ~ {ug ur}
  & v ~ {vg vr}
  & @get2 ~ (labels (ug (vg got)))
  & got ~ (lu (lv labels2))
  & lu ~ {la lb}
  & lv ~ {va vb}
  & la ~ $([<] $(va cond))
  & @choose ~ (cond (lb (vb m)))
  & @replace ~ (labels2 (ur (vr (m out))))

// Read the labels at indices u and v while rebuilding the list.
@get2 = ((?((@get2_nil @get2_cons) (payload (u (v out)))) payload) (u (v out)))

@get2_nil = (* (u (v out)))
  & u ~ *
  & v ~ *
  & out ~ (0 (0 (0 *)))

@get2_cons = (* ((h t) (u (v out))))
  & u ~ {utest udec}
  & v ~ {vtest vdec}
  & utest ~ $([=] $(0 bu))
  & vtest ~ $([=] $(0 bv))
  & udec ~ $([-1] unext)
  & vdec ~ $([-1] vnext)
  & h ~ {h1 hrest}
  & hrest ~ {h2 hkeep}
  & @get2 ~ (t (unext (vnext rr)))
  & rr ~ (lur (lvr tail2))
  & @choose ~ (bu (h1 (lur lu)))
  & @choose ~ (bv (h2 (lvr lv)))
  & out ~ (lu (lv (1 (hkeep tail2))))

// Replace the labels at indices u and v with m.
@replace = ((?((@replace_nil @replace_cons) (payload (u (v (m out))))) payload) (u (v (m out))))

@replace_nil = (* (u (v (m out))))
  & u ~ *
  & v ~ *
  & m ~ *
  & out ~ (0 *)

@replace_cons = (* ((h t) (u (v (m out)))))
  & u ~ {utest udec}
  & v ~ {vtest vdec}
  & utest ~ $([=] $(0 bu))
  & vtest ~ $([=] $(0 bv))
  & udec ~ $([-1] unext)
  & vdec ~ $([-1] vnext)
  & bu ~ $([|] $(bv both))
  & m ~ {mhere mtail}
  & @choose ~ (both (mhere (h hnew)))
  & @replace ~ (t (unext (vnext (mtail tailout))))
  & out ~ (1 (hnew tailout))

// Boolean choice: select no for 0, yes for 1.
@choose = (b (yes (no out)))
  & b ~ ?((@choose_no @choose_yes) (yes (no out)))

@choose_no = (yes (no out))
  & yes ~ *
  & out ~ no

@choose_yes = (* (yes (no out)))
  & no ~ *
  & out ~ yes

// Build a list of (label, count) entries from the vertex labels.
@counts = ((?((@counts_nil @counts_cons) (payload (map out))) payload) (map out))

@counts_nil = (* (a a))

@counts_cons = (* ((h t) (map out)))
  & @inc ~ (map (h map2))
  & @counts ~ (t (map2 out))

// Increment the count for target, adding a new entry if absent.
@inc = ((?((@inc_nil @inc_cons) (payload (target out))) payload) (target out))

@inc_nil = (* (target out))
  & out ~ (1 ((target 1) (0 *)))

@inc_cons = (* (((key count) tail) (target out)))
  & key ~ {ktest kkeep}
  & target ~ {ttest trec}
  & ktest ~ $([=] $(ttest eq))
  & eq ~ ?((@inc_miss @inc_match) (kkeep (count (tail (trec out))))

@inc_miss = (key (count (tail (target out))))
  & @inc ~ (tail (target (tail2)))
  & out ~ (1 ((key count) tail2))

@inc_match = (* (key (count (tail (target out)))))
  & count ~ $([+1] count2)
  & target ~ *
  & out ~ (1 ((key count2) tail))

// Return the greatest count in the map.
@max = ((?((@max_nil @max_cons) (payload (best out))) payload) (best out))

@max_nil = (* (a a))

@max_cons = (* (((key count) tail) (best out)))
  & key ~ *
  & count ~ {candidate ccmp}
  & best ~ {bcmp bkeep}
  & ccmp ~ $([>] $(bcmp gt))
  & @choose ~ (gt (candidate (bkeep best2)))
  & @max ~ (tail (best2 out))
