// Generate vertex labels, propagate minimum labels across edges, and
// return the largest number of vertices sharing a label.
@prog = ((n edges) out)
  & n ~ {ng nr}
  & @gen ~ (ng (0 labels))
  & @rounds ~ (nr (edges (labels labels2)))
  & @best ~ (labels2 (0 out))

@gen = (n (i out))
  & n ~ ?((@gen_nil @gen_succ) (i out))

@gen_nil = (i out)
  & i ~ *
  & out ~ (0 *)

@gen_succ = (n (i out))
  & i ~ {ih it}
  & it ~ $([+1] inext)
  & @gen ~ (n (inext tail))
  & out ~ (1 (ih tail))

@rounds = (n (edges (labels out)))
  & n ~ ?((@rounds_nil @rounds_succ) (edges (labels out)))

@rounds_nil = (edges (labels out))
  & edges ~ *
  & out ~ labels

@rounds_succ = (n (edges (labels out)))
  & @sweep ~ (edges (labels swept))
  & swept ~ (edges2 labels2)
  & @rounds ~ (n (edges2 (labels2 out)))

@sweep = (edges (labels out))
  & edges ~ (?( (@sweep_nil @sweep_cons) (payload (labels out))) payload)

@sweep_nil = (payload (labels out))
  & payload ~ *
  & out ~ ((0 *) labels)

@sweep_cons = (* (((u v) tail) (labels out)))
  & u ~ {uu ukeep}
  & v ~ {vv vkeep}
  & @update ~ ((uu vv) (labels labels2))
  & @sweep ~ (tail (labels2 rest))
  & rest ~ (edges2 labels3)
  & out ~ ((1 ((ukeep vkeep) edges2)) labels3)

// Read both endpoint labels and replace each endpoint label by their minimum.
@update = ((u v) (labels out))
  & u ~ {ug ur}
  & v ~ {vg vr}
  & @get2 ~ (labels (ug (vg got)))
  & got ~ (lu (lv labels2))
  & lu ~ {la lb}
  & lv ~ {va vb}
  & la ~ $([<] $(va cond))
  & @choose ~ (cond (lb (vb m)))
  & m ~ {m1 m2}
  & @set ~ (labels2 (ur (m1 first)))
  & first ~ {labels3 discard}
  & discard ~ *
  & @set ~ (labels3 (vr (m2 out)))

// Scan the labels list to fetch values at indices u and v.
@get2 = (list (u (v out)))
  & list ~ (?( (@get2_nil @get2_cons) (payload (u (v out))) ) payload)

@get2_nil = (payload (u (v out)))
  & payload ~ *
  & u ~ *
  & v ~ *
  & out ~ (0 (0 (0 *)))

@get2_cons = (* ((h t) (u (v out))))
  & u ~ {utest udec}
  & v ~ {vtest vdec}
  & utest ~ $([=] $(0 bu))
  & vtest ~ $([=] $(0 bv))
  & udec ~ $([-1] unext)
  & vdec ~ $([-1] vnext)
  & h ~ {hrest hkeep}
  & hrest ~ {hfirst hsecond}
  & @get2 ~ (t (unext (vnext rr)))
  & rr ~ (lur (lvr tail2))
  & @choose ~ (bu (hfirst (lur lu)))
  & @choose ~ (bv (hsecond (lvr lv)))
  & out ~ (lu (lv (1 (hkeep tail2))))

// Set the value at one list index, rebuilding the list.
@set = (list (index (value out)))
  & list ~ (?( (@set_nil @set_cons) (payload (index (value out))) ) payload)

@set_nil = (payload (index (value out)))
  & payload ~ *
  & index ~ *
  & value ~ *
  & out ~ (0 *)

@set_cons = (* ((h t) (index (value out))))
  & index ~ {itest idec}
  & itest ~ $([=] $(0 iszero))
  & idec ~ $([-1] inext)
  & value ~ {vhere vtail}
  & @choose ~ (iszero (vhere (h hnew)))
  & @set ~ (t (inext (vtail tailout)))
  & out ~ (1 (hnew tailout))

// Boolean choice: select yes for 1 and no for 0.
@choose = (b (yes (no out)))
  & b ~ ?((@choose_no @choose_yes) (yes (no out)))

@choose_no = (yes (no out))
  & yes ~ *
  & out ~ no

@choose_yes = (* (yes (no out)))
  & no ~ *
  & out ~ yes

// Count occurrences of target in a list.
@freq = (list (target out))
  & list ~ (?( (@freq_nil @freq_cons) (payload (target out))) payload)

@freq_nil = (payload (target out))
  & payload ~ *
  & target ~ *
  & out ~ (0 (0 *))

@freq_cons = (* ((h t) (target out)))
  & h ~ {hcmp hkeep}
  & target ~ {tcmp trec}
  & hcmp ~ $([=] $(tcmp eq))
  & @freq ~ (t (trec rr))
  & rr ~ (ctail tail2)
  & ctail ~ $([+] $(eq count))
  & out ~ (count (1 (hkeep tail2)))

// Find the most frequent label.
@best = (list (best out))
  & list ~ (?( (@best_nil @best_cons) (payload (best out))) payload)

@best_nil = (payload (best out))
  & payload ~ *
  & out ~ best

@best_cons = (* ((h t) (best out)))
  & h ~ {target hdrop}
  & hdrop ~ *
  & @freq ~ (t (target fr))
  & fr ~ (ctail tail2)
  & ctail ~ $([+1] count)
  & best ~ {bcmp bkeep}
  & count ~ {ccmp csel}
  & ccmp ~ $([>] $(bcmp gt))
  & @choose ~ (gt (csel (bkeep best2)))
  & @best ~ (tail2 (best2 out))
