@prog = (input out)
  & input ~ (cl attrs)
  & @augment ~ (attrs (cl augmented))
  & @process ~ (augmented ((0 *) (0 out)))

@augment = ((?((@aug_nil @aug_cons) (pay (cl out))) pay) (cl out))

@aug_nil = (* (cl out))
  & cl ~ *
  & out ~ (0 *)

@aug_cons = (* (((node (key val)) tail) (cl out)))
  & cl ~ {cl_lookup cl_rec}
  & @lookup ~ (cl_lookup (node cid))
  & @augment ~ (tail (cl_rec out_tail))
  & out ~ (1 ((cid (key val)) out_tail))

@lookup = ((?((@lookup_nil @lookup_cons) (pay (idx out))) pay) (idx out))

@lookup_nil = (* (idx out))
  & idx ~ *
  & out ~ 0

@lookup_cons = (* ((head tail) (idx out)))
  & idx ~ ?((@lookup_hit @lookup_next) (head (tail out)))

@lookup_hit = (head (tail out))
  & head ~ out
  & tail ~ *

@lookup_next = (idx (head (tail out)))
  & head ~ *
  & @lookup ~ (tail (idx out))

@process = ((?((@process_nil @process_cons) (pay (prefix (acc out)))) pay) (prefix (acc out)))

@process_nil = (* (prefix (acc out)))
  & prefix ~ *
  & acc ~ out

@process_cons = (* (((cid (key val)) tail) (prefix (acc out))))
  & cid ~ {cid_s cid_x}
  & cid_x ~ {cid_d cid_p}
  & key ~ {key_s key_x}
  & key_x ~ {key_d key_p}
  & val ~ {val_d val_p}
  & tail ~ {tail_d tail_r}
  & prefix ~ {prefix_s prefix_r}
  & @seen ~ (prefix_s (cid_s (key_s seen)))
  & @diff ~ (tail_d (cid_d (key_d (val_d diff))))
  & seen ~ $([=] $(0 first))
  & first ~ $([*] $(diff flag))
  & acc ~ $([+] $(flag acc2))
  & @process ~ (tail_r ((1 ((cid_p (key_p val_p)) prefix_r)) (acc2 out)))

@seen = ((?((@seen_nil @seen_cons) (pay (cid (key out)))) pay) (cid (key out)))

@seen_nil = (* (cid (key out)))
  & cid ~ *
  & key ~ *
  & out ~ 0

@seen_cons = (* (((cid2 (k v)) tail) (cid (key out))))
  & v ~ *
  & cid ~ {cid_cmp cid_rec}
  & key ~ {key_cmp key_rec}
  & cid2 ~ $([=] $(cid_cmp ceq))
  & k ~ $([=] $(key_cmp keq))
  & ceq ~ $([*] $(keq here))
  & @seen ~ (tail (cid_rec (key_rec rest)))
  & here ~ $([|] $(rest out))

@diff = ((?((@diff_nil @diff_cons) (pay (cid (key (val out))))) pay) (cid (key (val out))))

@diff_nil = (* (cid (key (val out))))
  & cid ~ *
  & key ~ *
  & val ~ *
  & out ~ 0

@diff_cons = (* (((cid2 (k v)) tail) (cid (key (val out)))))
  & cid ~ {cid_cmp cid_rec}
  & key ~ {key_cmp key_rec}
  & val ~ {val_cmp val_rec}
  & cid2 ~ $([=] $(cid_cmp ceq))
  & k ~ $([=] $(key_cmp keq))
  & v ~ $([!] $(val_cmp neq))
  & ceq ~ $([*] $(keq c1))
  & c1 ~ $([*] $(neq here))
  & @diff ~ (tail (cid_rec (key_rec (val_rec rest))))
  & here ~ $([|] $(rest out))
