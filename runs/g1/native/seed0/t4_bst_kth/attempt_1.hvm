// Compute the number of nodes in a tree.
@size = ((?((@size_leaf @size_node) (pl out)) pl) out)

@size_leaf = (* 0)

@size_node = ((l (* r)) out)
  & @size ~ (l ls)
  & @size ~ (r rs)
  & ls ~ $([+] $(rs $([+] $(1 out))))

// Return the k-th in-order value, or 16777215 if it is out of range.
@kth = ((?((@kth_leaf @kth_node) (pl (k out))) pl) (k out))

@kth_leaf = (* (* 16777215))

@kth_node = (* ((l (v r)) (k out)))
  & l ~ {ls_tree lk_tree}
  & @size ~ (ls_tree ls)
  & ls ~ {ls_lt ls_keep}
  & k ~ {k_cmp k_keep}
  & k_cmp ~ $([<] $(ls_lt less))
  & less ~ ?((@kth_ge @kth_lt) (k_keep (ls_keep (lk_tree (v (r out)))))

@kth_lt = (* (k (* (l (* (* out))))))
  & @kth ~ (l (k out))

@kth_ge = (k (ls (* (v (r out)))))
  & k ~ {k_eq k_gt}
  & ls ~ {ls_eq ls_gt}
  & k_eq ~ $([=] $(ls_eq eq))
  & eq ~ ?((@kth_gt @kth_eq) (k_gt (ls_gt (v (r out)))))

@kth_eq = (* (* (* (v (* out)))))
  & v ~ out

@kth_gt = (k (ls (* (r out))))
  & k ~ $([-] $(ls $([-] $(1 k2))))
  & @kth ~ (r (k2 out))

@prog = ((k t) out)
  & @kth ~ (t (k out))
