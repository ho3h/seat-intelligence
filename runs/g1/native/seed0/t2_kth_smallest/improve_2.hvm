@prog = (input out)
  & input ~ (k xs)
  & @ms ~ (xs sorted)
  & @nth ~ (k (sorted out))

@ms = ((?((@ms_nil @ms_cons) (pl out)) pl) out)

@ms_nil = (* out)
  & out ~ (0 *)

@ms_cons = (* ((h t) out))
  & t ~ (?((@ms_single @ms_many) (p (h out))) p)

@ms_single = (* (h out))
  & out ~ (1 (h (0 *)))

@ms_many = (* ((h2 rest) (h out)))
  & @split ~ ((1 (h2 rest)) (a b))
  & @ms ~ ((1 (h a)) sorted_a)
  & @ms ~ (b sorted_b)
  & @merge ~ (sorted_a (sorted_b out))

@split = ((?((@split_nil @split_cons) (pl out)) pl) out)

@split_nil = (* out)
  & out ~ ((0 *) (0 *))

@split_cons = (* ((h t) out))
  & @split ~ (t (a b))
  & out ~ (b (1 (h a)))

@merge = ((?((@merge_nil @merge_cons) (pl (ys out))) pl) (ys out))

@merge_nil = (* (ys ys))

@merge_cons = (* ((h t) (ys out)))
  & ys ~ (?((@merge_second_nil @merge_second_cons) (p (h (t out)))) p)

@merge_second_nil = (* (h (t out)))
  & out ~ (1 (h t))

@merge_second_cons = (* ((g u) (h (t out))))
  & h ~ {h_cmp h_keep}
  & g ~ {g_cmp g_keep}
  & h_cmp ~ $([<] $(g_cmp z))
  & z ~ ?((@merge_take_g @merge_take_h) (h_keep (t (g_keep (u out))))

@merge_take_g = (h (t (g (u out))))
  & @merge ~ ((1 (h t)) (u merged))
  & out ~ (1 (g merged))

@merge_take_h = (* (h (t (g (u out)))))
  & @merge ~ (t ((1 (g u)) merged))
  & out ~ (1 (h merged))

@nth = (k ((?((@nth_nil @nth_cons) (k (pl out))) pl) out))

@nth_nil = (* (* 0))

@nth_cons = (* (k ((h t) out)))
  & k ~ ?((@nth_head @nth_tail) (h (t out)))

@nth_head = (h (t out))
  & t ~ *
  & out ~ h

@nth_tail = (k (h (t out)))
  & h ~ *
  & @nth ~ (k (t out))
