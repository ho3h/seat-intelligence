@prog = (input output)
  & @sort ~ (input output)

@sort = ((?((@sort_nil @sort_cons) (pl out)) pl) out)

@sort_nil = (* (0 *))

@sort_cons = (* ((h t) out))
  & @sort ~ (t s)
  & @insert ~ (h (s out))

@insert = (x ((?((@ins_nil @ins_cons) (pl (x out))) pl) out))

@ins_nil = (* (x (1 (x (0 *)))))

@ins_cons = (* ((h t) (x out)))
  & {xc xd} ~ x
  & {hc hd} ~ h
  & xc ~ $([<] $(hc z))
  & z ~ ?((@ins_ge @ins_lt) (xd (hd (t out))))

@ins_ge = (x (y (t out)))
  & {xa xb} ~ x
  & {ya yb} ~ y
  & xa ~ $([=] $(ya z))
  & z ~ ?((@ins_gt @ins_eq) (xb (yb (t out))))

@ins_lt = (* (x (y (t (1 (x (1 (y t))))))))

@ins_eq = (* (x (y (t (1 (y t))))))
  & x ~ *

@ins_gt = (x (y (t (1 (y r))))
  & @insert ~ (x (t r))
