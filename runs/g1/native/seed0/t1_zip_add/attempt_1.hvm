@prog = (input out)
  & input ~ (xs ys)
  & @zip ~ (xs (ys out))

@zip = ((?((@zip_xnil @zip_xcons) (px (ys out))) px) (ys out))

@zip_xnil = (* (* out))
  & out ~ (0 *)

@zip_xcons = (* ((xh xt) ((?((@zip_ynil @zip_ycons) (py (xh (xt out)))) py) out)))

@zip_ynil = (* (* (* out)))
  & out ~ (0 *)

@zip_ycons = (* ((yh yt) (xh (xt out))))
  & xh ~ $([+] $(yh sum))
  & @zip ~ (xt (yt rest))
  & out ~ (1 (sum rest))
