// Sort the input in descending order, then take at most k elements.

@prog = ((k xs) out)
  & @sort ~ (xs sorted)
  & @take ~ (k (sorted out))

@sort = ((?((@sort_nil @sort_cons) (pl out)) pl) out)

@sort_nil = (pl out)
  & pl ~ *
  & out ~ (0 *)

@sort_cons = (* ((h t) out))
  & @sort ~ (t sorted)
  & @insert ~ (h (sorted out))

@insert = (x ((?((@ins_nil @ins_cons) (x (pl out))) pl) out))

@ins_nil = (x (pl out))
  & pl ~ *
  & out ~ (1 (x (0 *)))

@ins_cons = (* (x ((h t) out)))
  & x ~ {xc xk}
  & h ~ {hc hk}
  & xc ~ $([>] $(hc z))
  & z ~ ?((@ins_no @ins_yes) (xk (hk (t out))))

@ins_no = (* (x (h (t out))))
  & @insert ~ (x (t rest))
  & out ~ (1 (h rest))

@ins_yes = (* (x (h (t out))))
  & out ~ (1 (x (1 (h t))))

// A zero count returns Nil. A positive count consumes one list cell
// and recurses with the decremented count.

@take = (?((@take_zero @take_pos) (xs out)) (xs out))

@take_zero = (xs out)
  & xs ~ *
  & out ~ (0 *)

@take_pos = (km ((?((@take_nil @take_cons) (km (pl out))) pl) out))

@take_nil = (km (pl out))
  & km ~ *
  & pl ~ *
  & out ~ (0 *)

@take_cons = (* (km ((h t) out)))
  & @take ~ (km (t rest))
  & out ~ (1 (h rest))
