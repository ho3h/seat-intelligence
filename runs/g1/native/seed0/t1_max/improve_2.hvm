// Use the first element as the initial maximum, avoiding a comparison with 0.
@prog = ((?((@first_nil @first_cons) (pl out)) pl) out)

@first_nil = (* 0)

@first_cons = (* ((h t) out))
  & @max ~ (t (h out))

@max = ((?((@max_nil @max_cons) (pl (acc out))) pl) (acc out))

@max_nil = (* (a a))

@max_cons = (* ((h t) (acc out)))
  & h ~ {h_cmp h_ctx}
  & acc ~ {acc_cmp acc_ctx}
  & h_cmp ~ $([>] $(acc_cmp z))
  & z ~ ?((@max_keep @max_take) (h_ctx (t (acc_ctx out))))

@max_keep = (h (t (acc out)))
  & h ~ *
  & @max ~ (t (acc out))

@max_take = (* (h (t (acc out))))
  & acc ~ *
  & @max ~ (t (h out))
