@prog = (input output)
  & input ~ (tau (cap cands))
  & @build ~ (cands (tau filtered))
  & @sort ~ (filtered sorted)
  & @stage ~ (sorted (cap output))

@build = ((?((@build_nil @build_cons) (pl (tau out))) pl) (tau out))

@build_nil = (* (tau out))
  & tau ~ *
  & out ~ (0 *)

@build_cons = (* (((u (v score)) tail) (tau out)))
  & tau ~ {tau_rec tau_cmp}
  & score ~ {score_cmp score_keep}
  & @build ~ (tail (tau_rec rest))
  & score_cmp ~ $([<] $(tau_cmp lt))
  & lt ~ ?((@build_accept @build_reject) ((u (v score_keep)) (rest out)))

@build_accept = ((u (v score)) (rest out))
  & out ~ (1 ((u (v score)) rest))

@build_reject = ((u (v score)) (rest out))
  & u ~ *
  & v ~ *
  & score ~ *
  & out ~ rest

@sort = ((?((@sort_nil @sort_cons) (pl out)) pl) out)

@sort_nil = (* out)
  & out ~ (0 *)

@sort_cons = (* ((head tail) out))
  & @sort_tail ~ (tail (head out))

@sort_tail = ((?((@sort_tail_nil @sort_tail_cons) (pl (head out))) pl) (head out))

@sort_tail_nil = (* (head out))
  & out ~ (1 (head (0 *)))

@sort_tail_cons = (* ((next rest) (head out)))
  & @split ~ ((1 (head (1 (next rest)))) (0 parts))
  & parts ~ (left right)
  & @sort ~ (left sorted_left)
  & @sort ~ (right sorted_right)
  & @merge ~ (sorted_left (sorted_right out))

@split = ((?((@split_nil @split_cons) (pl (flag out))) pl) (flag out))

@split_nil = (* (flag out))
  & flag ~ *
  & out ~ ((0 *) (0 *))

@split_cons = (* ((head tail) (flag out)))
  & flag ~ ?((@split_left @split_right) ((head tail) out))

@split_left = ((head tail) out)
  & @split ~ (tail (1 parts))
  & parts ~ (left right)
  & out ~ ((1 (head left)) right)

@split_right = (* ((head tail) out))
  & @split ~ (tail (0 parts))
  & parts ~ (left right)
  & out ~ (left (1 (head right)))

@merge = (a (b out))
  & @merge_left ~ (a (b out))

@merge_left = ((?((@merge_left_nil @merge_left_cons) (pl (b out))) pl) (b out))

@merge_left_nil = (* (b out))
  & out ~ b

@merge_left_cons = (* ((x xs) (b out)))
  & @merge_right ~ (b (x (xs out)))

@merge_right = ((?((@merge_right_nil @merge_right_cons) (pl (x (xs out)))) pl) (x (xs out)))

@merge_right_nil = (* (x (xs out)))
  & out ~ (1 (x xs))

@merge_right_cons = (* ((y ys) (x (xs out))))
  & x ~ {x_cmp x_keep}
  & y ~ {y_cmp y_keep}
  & @before ~ (x_cmp (y_cmp pred))
  & pred ~ ?((@merge_choose_y @merge_choose_x) (x_keep (xs (y_keep (ys out))))

@merge_choose_y = (x (xs (y (ys out))))
  & @merge ~ ((1 (x xs)) (ys rest))
  & out ~ (1 (y rest))

@merge_choose_x = (* (x (xs (y (ys out)))))
  & @merge ~ (xs ((1 (y ys)) rest))
  & out ~ (1 (x rest))

@before = ((u (v s)) ((eu (ev es)) out))
  & s ~ {s_eq s_gt}
  & es ~ {es_eq es_gt}
  & s_eq ~ $([=] $(es_eq eq))
  & s_gt ~ $([>] $(es_gt gt))
  & eq ~ ?((@before_score_gt @before_score_tie) ((u (v gt)) ((eu ev) out))

@before_score_gt = ((u (v gt)) ((eu ev) out))
  & gt ~ ?((@before_score_false @before_score_true) ((u (v (eu ev))) out))

@before_score_false = ((u (v (eu ev))) out)
  & u ~ *
  & v ~ *
  & eu ~ *
  & ev ~ *
  & out ~ 0

@before_score_true = ((u (v (eu ev))) out)
  & u ~ *
  & v ~ *
  & eu ~ *
  & ev ~ *
  & out ~ 1

@before_score_tie = (* ((u (v gt)) ((eu ev) out)))
  & gt ~ *
  & u ~ {u_lt u_eq}
  & eu ~ {eu_lt eu_eq}
  & u_lt ~ $([<] $(eu_lt lt))
  & u_eq ~ $([=] $(eu_eq eq))
  & lt ~ ?((@before_u_not_lt @before_u_true) ((u_eq (v ev)) out))

@before_u_true = ((u_eq (v ev)) out)
  & u_eq ~ *
  & v ~ *
  & ev ~ *
  & out ~ 1

@before_u_not_lt = ((u_eq (v ev)) out)
  & u_eq ~ ?((@before_u_false @before_v_check) ((v ev) out))

@before_u_false = ((v ev) out)
  & v ~ *
  & ev ~ *
  & out ~ 0

@before_v_check = (* ((v ev) out))
  & v ~ $([<] $(ev lt))
  & lt ~ ?((@before_v_false @before_v_true) out)

@before_v_false = out
  & out ~ 0

@before_v_true = (* out)
  & out ~ 1

@stage = ((?((@stage_nil @stage_cons) (pl (cap out))) pl) (cap out))

@stage_nil = (* (cap out))
  & cap ~ *
  & out ~ ((0 *) 0)

@stage_cons = (* (((u (v score)) tail) (cap out)))
  & cap ~ ?((@stage_exhausted @stage_room) (((u (v score)) tail) out))

@stage_exhausted = (((u (v score)) tail) out)
  & @length ~ ((1 ((u (v score)) tail)) n)
  & out ~ ((0 *) n)

@stage_room = (remaining (((u (v score)) tail) out))
  & @stage ~ (tail (remaining res))
  & res ~ (staged deferred)
  & score ~ *
  & out ~ ((1 ((u v) staged)) deferred)

@length = ((?((@length_nil @length_cons) (pl out)) pl) out)

@length_nil = (* out)
  & out ~ 0

@length_cons = (* ((head tail) out))
  & head ~ *
  & @length ~ (tail n)
  & n ~ $([+1] out)
