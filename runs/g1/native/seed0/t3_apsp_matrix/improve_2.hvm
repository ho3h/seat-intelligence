@prog = ((n edges) out)
  & n ~ {ni nt}
  & nt ~ {nl nf}
  & @initmat ~ (ni mat0)
  & @load ~ (edges (nl (mat0 mat1)))
  & @floyd ~ (nf (mat1 out))

@initmat = (n out)
  & n ~ {nr nt}
  & @im ~ (nr (0 (nt out)))

@im = (?( (@im_nil @im_more) (i (n out)) ) (i (n out)))

@im_nil = (i (n out))
  & i ~ *
  & n ~ *
  & out ~ (0 *)

@im_more = (rem (i (n out)))
  & i ~ {ir ii}
  & n ~ {nr nn}
  & ii ~ $([+1] inext)
  & @initrow ~ (nr (ir row))
  & @im ~ (rem (inext (nn tail)))
  & out ~ (1 (row tail))

@initrow = (?( (@ir_nil @ir_more) (j (i out)) ) (j (i out)))

@ir_nil = (j (i out))
  & j ~ *
  & i ~ *
  & out ~ (0 *)

@ir_more = (rem (j (i out)))
  & j ~ {jc ji}
  & i ~ {ic ir}
  & jc ~ $([=] $(ic z))
  & z ~ ?((@ir_inf @ir_zero) cell)
  & ji ~ $([+1] jnext)
  & @initrow ~ (rem (jnext (ir tail)))
  & out ~ (1 (cell tail))

@ir_inf = 16777215

@ir_zero = (* cell)
  & cell ~ 0

@get = ((?((@get_nil @get_cons) (pl (idx out))) pl) (idx out))

@get_nil = (pl (idx out))
  & pl ~ *
  & idx ~ *
  & out ~ 0

@get_cons = (* ((h t) (idx out)))
  & idx ~ ?((@get_here @get_next) (h (t out)))

@get_here = (h (t out))
  & t ~ *
  & out ~ h

@get_next = (idx (h (t out)))
  & h ~ *
  & @get ~ (t (idx out))

@set = ((?((@set_nil @set_cons) (pl (idx (val out)))) pl) (idx (val out)))

@set_nil = (pl (idx (val out)))
  & pl ~ *
  & idx ~ *
  & val ~ *
  & out ~ (0 *)

@set_cons = (* ((h t) (idx (val out))))
  & idx ~ ?((@set_here @set_next) (h (t (val out))))

@set_here = (h (t (val out)))
  & h ~ *
  & out ~ (1 (val t))

@set_next = (idx (h (t (val out))))
  & @set ~ (t (idx (val tail)))
  & out ~ (1 (h tail))

@load = ((?((@load_nil @load_cons) (pl (n (matrix out)))) pl) (n (matrix out)))

@load_nil = (pl (n (matrix out)))
  & pl ~ *
  & n ~ *
  & out ~ matrix

@load_cons = (* (((u (v w)) tail) (n (matrix out))))
  & matrix ~ {mr mw}
  & u ~ {ug us}
  & v ~ {vg vs}
  & @get ~ (mr (ug row))
  & row ~ {rr rw}
  & @get ~ (rr (vg old))
  & @min ~ (old (w val))
  & @set ~ (rw (vs (val row2)))
  & @set ~ (mw (us (row2 matrix2)))
  & @load ~ (tail (n (matrix2 out)))

@floyd = (n (matrix out))
  & @fw_outer ~ (n (0 (matrix out)))

@fw_outer = (?( (@fwo_nil @fwo_more) (k (matrix out)) ) (k (matrix out)))

@fwo_nil = (k (matrix out))
  & k ~ *
  & out ~ matrix

@fwo_more = (rem (k (matrix out)))
  & k ~ {kg kt}
  & kt ~ {kr kn}
  & matrix ~ {mr mw}
  & @get ~ (mr (kg rowK))
  & @fw_matrix ~ (mw (kr (rowK matrix2)))
  & kn ~ $([+1] knew)
  & @fw_outer ~ (rem (knew (matrix2 out)))

@fw_matrix = ((?((@fwm_nil @fwm_cons) (pl (k (rowK out)))) pl) (k (rowK out)))

@fwm_nil = (pl (k (rowK out)))
  & pl ~ *
  & k ~ *
  & rowK ~ *
  & out ~ (0 *)

@fwm_cons = (* ((row tail) (k (rowK out))))
  & row ~ {rread rorig}
  & k ~ {kg kr}
  & rowK ~ {rkzip rkrec}
  & @get ~ (rread (kg dik))
  & dik ~ {dtest dkeep}
  & dtest ~ $([=] $(16777215 z))
  & z ~ ?((@fwm_update @fwm_skip) (rkzip (kr (rorig (tail (rkrec (dkeep out)))))))

@fwm_update = (rkzip (kr (rorig (tail (rkrec (dkeep out))))))
  & @fw_zip ~ (rkzip (dkeep (rorig rownew)))
  & @fw_matrix ~ (tail (kr (rkrec tailout)))
  & out ~ (1 (rownew tailout))

@fwm_skip = (rkzip (kr (rorig (tail (rkrec (dkeep out))))))
  & rkzip ~ *
  & dkeep ~ *
  & @fw_matrix ~ (tail (kr (rkrec tailout)))
  & out ~ (1 (rorig tailout))

@fw_zip = ((?((@zip_nil @zip_cons) (pl (dik (row out)))) pl) (dik (row out)))

@zip_nil = (pl (dik (row out)))
  & pl ~ *
  & dik ~ *
  & row ~ *
  & out ~ (0 *)

@zip_cons = (* ((dkj tailK) (dik ((tag (old tail)) out))))
  & tag ~ *
  & dik ~ {da dr}
  & dkj ~ {dtest dk}
  & dtest ~ $([=] $(16777215 z))
  & z ~ ?((@zip_calc @zip_skip) (tailK (da (dr (dk (old (tail out)))))))

@zip_calc = (tailK (da (dr (dk (old (tail out))))))
  & @satadd ~ (da (dk cand))
  & @min ~ (old (cand val))
  & @fw_zip ~ (tailK (dr (tail tailout)))
  & out ~ (1 (val tailout))

@zip_skip = (tailK (da (dr (dk (old (tail out))))))
  & da ~ *
  & dk ~ *
  & @fw_zip ~ (tailK (dr (tail tailout)))
  & out ~ (1 (old tailout))

@satadd = (a (b out))
  & a ~ {ac ar}
  & ac ~ $([+] $(b sum))
  & sum ~ {sc sr}
  & sc ~ $([<] $(ar z))
  & z ~ ?((@sat_ok @sat_over) (sr out))

@sat_ok = (sum out)
  & out ~ sum

@sat_over = (* (sum out))
  & sum ~ *
  & out ~ 16777215

@min = (a (b out))
  & a ~ {ac ar}
  & b ~ {bc br}
  & ac ~ $([<] $(bc z))
  & z ~ ?((@min_no @min_yes) (ar (br out)))

@min_no = (a (b out))
  & a ~ *
  & out ~ b

@min_yes = (* (a (b out)))
  & b ~ *
  & out ~ a
