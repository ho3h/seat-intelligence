// Internal register state: (r0 (r1 (r2 (r3 sentinel))))

@prog = (input out)
  & @run ~ (input ((0 (0 (0 (0 0)))) out))

@run = (l c)
  & l ~ (tag payload)
  & tag ~ ?((@run_nil @run_cons) (payload c))

@run_nil = (payload (regs out))
  & payload ~ *
  & @emit ~ (regs out)

@run_cons = (z (payload (regs out)))
  & z ~ *
  & payload ~ (instr tail)
  & @step ~ (instr (regs next))
  & @run ~ (tail (next out))

@step = (instr (regs out))
  & instr ~ (op (a b))
  & @dispatch ~ (op (a (b (regs out))))

@dispatch = (op c)
  & op ~ ?((@step0 @stepS) c)

@step0 = (a (b (regs out)))
  & @set ~ (a (b (regs out)))

@stepS = (n c)
  & n ~ ?((@step1 @stepS2) c)

@stepS2 = (n c)
  & n ~ ?((@step2 @stepS3) c)

@stepS3 = (n c)
  & n ~ ?((@step3 @step4) c)

@step1 = (a (b (regs out)))
  & @add ~ (a (b (regs out)))

@step2 = (a (b (regs out)))
  & @sub ~ (a (b (regs out)))

@step3 = (a (b (regs out)))
  & @mul ~ (a (b (regs out)))

@step4 = (z (a (b (regs out))))
  & z ~ *
  & @mov ~ (a (b (regs out)))

@get = (idx c)
  & idx ~ ?((@get0 @getS) c)

@get0 = (regs out)
  & regs ~ (r0 rest)
  & r0 ~ out
  & rest ~ *

@getS = (n (regs out))
  & regs ~ (r0 rest)
  & r0 ~ *
  & @get ~ (n (rest out))

@set = (idx c)
  & idx ~ ?((@set0 @setS) c)

@set0 = (val (regs out))
  & regs ~ (r0 rest)
  & r0 ~ *
  & out ~ (val rest)

@setS = (n (val (regs out)))
  & regs ~ (r0 rest)
  & r0 ~ *
  & @set ~ (n (val (rest tail)))
  & out ~ (r0 tail)

@add = (a (b (regs out)))
  & a ~ {ag as}
  & regs ~ {pair keep}
  & pair ~ {left right}
  & @get ~ (ag (left av))
  & @get ~ (b (right bv))
  & av ~ $([+] $(bv val))
  & @set ~ (as (val (keep out)))

@sub = (a (b (regs out)))
  & a ~ {ag as}
  & regs ~ {pair keep}
  & pair ~ {left right}
  & @get ~ (ag (left av))
  & @get ~ (b (right bv))
  & av ~ $([-] $(bv val))
  & @set ~ (as (val (keep out)))

@mul = (a (b (regs out)))
  & a ~ {ag as}
  & regs ~ {pair keep}
  & pair ~ {left right}
  & @get ~ (ag (left av))
  & @get ~ (b (right bv))
  & av ~ $([*] $(bv val))
  & @set ~ (as (val (keep out)))

@mov = (a (b (regs out)))
  & regs ~ {source keep}
  & @get ~ (b (source val))
  & @set ~ (a (val (keep out)))

@emit = (regs out)
  & regs ~ (r0 rest1)
  & rest1 ~ (r1 rest2)
  & rest2 ~ (r2 rest3)
  & rest3 ~ (r3 sentinel)
  & sentinel ~ *
  & out ~ (1 (r0 (1 (r1 (1 (r2 (1 (r3 (0 *)))))))))
