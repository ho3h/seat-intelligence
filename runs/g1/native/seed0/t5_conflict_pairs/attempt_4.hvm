@prog = (input out)
  & input ~ (c mnl)
  & @pairs ~ (mnl (c ((0 *) out)))

@pairs = ((?((@pairs_nil @pairs_cons) (pl (c (acc out)))) pl) (c (acc out)))

@pairs_nil = (* (c (acc out)))
  & c ~ *
  & acc ~ out

@pairs_cons = (d (((a b) tail) (c (acc out))))
  & d ~ *
  & c ~ {cnext {ca cb}}
  & a ~ {a_idx a_keep}
  & b ~ {b_idx b_keep}
  & @get ~ (ca (a_idx va))
  & @get ~ (cb (b_idx vb))
  & va ~ $([=] $(vb eq))
  & eq ~ ?((@pairs_no @pairs_yes) (tail (cnext (acc (a_keep (b_keep out))))))

@pairs_no = (tail (c (acc (a (b out)))))
  & a ~ *
  & b ~ *
  & @pairs ~ (tail (c (acc out)))

@pairs_yes = (tail (c (acc (a (b out)))))
  & @ins ~ (acc ((a b) sorted))
  & @pairs ~ (tail (c (sorted out)))

@get = ((?((@get_nil @get_cons) (pl (idx out))) pl) (idx out))

@get_nil = (* (idx out))
  & idx ~ *
  & out ~ 0

@get_cons = (* ((h t) (idx out)))
  & idx ~ ?((@get_zero @get_succ) (h (t out)))

@get_zero = (h (t out))
  & t ~ *
  & out ~ h

@get_succ = (dec (h (t out)))
  & h ~ *
  & @get ~ (t (dec out))

@ins = ((?((@ins_nil @ins_cons) (pl (new out))) pl) (new out))

@ins_nil = (* (new out))
  & out ~ (1 (new (0 *)))

@ins_cons = (* (((x y) tail) (new out)))
  & new ~ (a b)
  & a ~ {a_lt {a_eq a_keep}}
  & x ~ {x_lt {x_eq x_keep}}
  & b ~ {b_lt b_keep}
  & y ~ {y_lt y_keep}
  & a_lt ~ $([<] $(x_lt less))
  & less ~ ?((@ins_not_less @ins_before)
      (a_eq (x_eq (b_lt (y_lt (a_keep (b_keep (x_keep (y_keep (tail out)))))))))
    )

@ins_before = ctx
  & ctx ~ (ae (xe (bl (yl (ak (bk (xk (yk (tail out)))))))))
  & ae ~ *
  & xe ~ *
  & bl ~ *
  & yl ~ *
  & out ~ (1 ((ak bk) (1 ((xk yk) tail))))

@ins_not_less = ctx
  & ctx ~ (ae (xe (bl (yl (ak (bk (xk (yk (tail out)))))))))
  & ae ~ $([=] $(xe equal))
  & equal ~ ?((@ins_greater @ins_equal)
      (bl (yl (ak (bk (xk (yk (tail out)))))))
    )

@ins_greater = ctx
  & ctx ~ (bl (yl (ak (bk (xk (yk (tail out)))))))
  & bl ~ *
  & yl ~ *
  & @ins ~ (tail ((ak bk) mid))
  & mid ~ (1 ((xk yk) out))

@ins_equal = ctx
  & ctx ~ (bl (yl (ak (bk (xk (yk (tail out)))))))
  & bl ~ $([<] $(yl less2))
  & less2 ~ ?((@ins_after_second @ins_before_second)
      (ak (bk (xk (yk (tail out)))))
    )

@ins_before_second = ctx
  & ctx ~ (ak (bk (xk (yk (tail out)))))
  & out ~ (1 ((ak bk) (1 ((xk yk) tail))))

@ins_after_second = ctx
  & ctx ~ (ak (bk (xk (yk (tail out)))))
  & @ins ~ (tail ((ak bk) mid))
  & mid ~ (1 ((xk yk) out))
