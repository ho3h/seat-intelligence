@prog = (input out)
  & input ~ (n edges)
  & @solve ~ (0 (n ((0 *) (0 (edges out))))

@solve = (v (n (chosen (count (edges out)))))
  & v ~ $([<] $(n test))
  & test ~ ?((@solve_done @solve_step) (v (n (chosen (count (edges out)))))

@solve_done = (v (n (chosen (count (edges out)))))
  & v ~ *
  & n ~ *
  & chosen ~ *
  & edges ~ *
  & count ~ out

@solve_step = (* (v (n (chosen (count (edges out))))))
  & v ~ {v_valid v_rest}
  & v_rest ~ {v_append v_plus}
  & v_plus ~ $([+1] next)
  & next ~ {next_ex next_inc}
  & n ~ {n_ex n_inc}
  & chosen ~ {chosen_left chosen_right}
  & chosen_left ~ {chosen_valid chosen_ex}
  & chosen_right ~ chosen_inc
  & count ~ {count_ex count_plus}
  & count_plus ~ $([+1] count_inc)
  & edges ~ {edges_left edges_right}
  & edges_left ~ {edges_valid edges_ex}
  & edges_right ~ {edges_exc edges_inc}
  & @solve ~ (next_ex (n_ex (chosen_ex (count_ex (edges_exc ex)))))
  & @valid ~ (chosen_valid (v_valid (edges_valid ok)))
  & ok ~ ?((@solve_bad @solve_good) (next_inc (n_inc (chosen_inc (count_inc (edges_inc inc)))))
  & @max ~ (ex (inc out))

@solve_bad = (next (n (chosen (count (edges inc)))))
  & next ~ *
  & n ~ *
  & chosen ~ *
  & count ~ *
  & edges ~ *
  & inc ~ 0

@solve_good = (* (next (n (chosen (count (edges inc))))))
  & @solve ~ (next (n (chosen (count (edges inc)))))

@valid = (l (v (edges out)))
  & l ~ (?((@valid_nil @valid_cons) (payload (v (edges out)))) payload)

@valid_nil = (payload (v (edges out)))
  & payload ~ *
  & v ~ *
  & edges ~ *
  & out ~ 1

@valid_cons = (* (payload (v (edges out))))
  & payload ~ (h t)
  & v ~ {v_hit v_rec}
  & edges ~ {edges_hit edges_rec}
  & @has ~ (edges_hit (h (v_hit hit)))
  & hit ~ ?((@valid_no @valid_yes) (t (v_rec (edges_rec out))))

@valid_no = (t (v (edges out)))
  & t ~ *
  & v ~ *
  & edges ~ *
  & out ~ 0

@valid_yes = (* (t (v (edges out))))
  & @valid ~ (t (v (edges out)))

@has = (l (a (b out)))
  & l ~ (?((@has_nil @has_cons) (payload (a (b out)))) payload)

@has_nil = (payload (a (b out)))
  & payload ~ *
  & a ~ *
  & b ~ *
  & out ~ 0

@has_cons = (* (payload (a (b out))))
  & payload ~ (edge tail)
  & edge ~ (u v)
  & a ~ {a_hit a_rec}
  & b ~ {b_hit b_rec}
  & @edgehit ~ (u (v (a_hit (b_hit hit))))
  & hit ~ ?((@has_more @has_yes) (tail (a_rec (b_rec out))))

@has_more = (tail (a (b out)))
  & @has ~ (tail (a (b out)))

@has_yes = (* (tail (a (b out))))
  & tail ~ *
  & a ~ *
  & b ~ *
  & out ~ 1

@edgehit = (u (v (a (b out))))
  & u ~ {u1 u2}
  & v ~ {v1 v2}
  & a ~ {a1 a2}
  & b ~ {b1 b2}
  & @eq ~ (u1 (a1 e1))
  & @eq ~ (v1 (b1 e2))
  & @eq ~ (u2 (b2 e3))
  & @eq ~ (v2 (a2 e4))
  & e1 ~ $([&] $(e2 p))
  & e3 ~ $([&] $(e4 q))
  & p ~ $([|] $(q out))

@eq = (a (b out))
  & a ~ $([=] $(b out))

@max = (a (b out))
  & a ~ {a_test a_out}
  & b ~ {b_test b_out}
  & a_test ~ $([>] $(b_test test))
  & test ~ ?((@max_b @max_a) (a_out (b_out out)))

@max_a = (* (a (b out)))
  & a ~ out
  & b ~ *

@max_b = (a (b out))
  & a ~ *
  & b ~ out
