// Check that both endpoints are in range.
@prog = (input out)
  & @check ~ (input out)

@check = ((n (s (t (k edges)))) out)
  & n ~ {n_s n_rest}
  & n_rest ~ {n_t n_keep}
  & s ~ {s_cmp s_keep}
  & t ~ {t_cmp t_keep}
  & s_cmp ~ $([<] $(n_s b1))
  & t_cmp ~ $([<] $(n_t b2))
  & b1 ~ $([&] $(b2 good))
  & good ~ ?((@bad @good) ((n_keep (s_keep (t_keep (k edges)))) out))

@bad = ((n (s (t (k edges)))) out)
  & n ~ *
  & s ~ *
  & t ~ *
  & k ~ *
  & edges ~ *
  & out ~ 0

@good = (* ((n (s (t (k edges)))) out))
  & n ~ {n_vec n_steps}
  & @zeros ~ (n_vec vec)
  & @set ~ (vec (s (1 curr)))
  & @steps ~ (k (n_steps (t (edges (curr out)))))

// Make a list of n zeroes.
@zeros = (n out)
  & n ~ ?((@zeros_zero @zeros_succ) (out *))

@zeros_zero = (out *)
  & out ~ (0 *)

@zeros_succ = (prev (out *))
  & @zeros ~ (prev tail)
  & out ~ (1 (0 tail))

// Set vec[idx] to val.
@set = (vec (idx (val out)))
  & vec ~ (tag payload)
  & tag ~ ?((@set_nil @set_cons) (payload (idx (val out))))

@set_nil = (* (idx (val out)))
  & idx ~ *
  & val ~ *
  & out ~ (0 *)

@set_cons = (* ((head tail) (idx (val out))))
  & idx ~ ?((@set_zero @set_succ) (head (tail (val out))))

@set_zero = (head (tail (val out)))
  & head ~ $([+] $(val sum))
  & out ~ (1 (sum tail))

@set_succ = (idx (head (tail (val out))))
  & head ~ *
  & @set ~ (tail (idx (val newtail)))
  & out ~ (1 (head newtail))

// Read vec[idx], returning zero if idx is out of range.
@lookup = (vec (idx out))
  & vec ~ (tag payload)
  & tag ~ ?((@lookup_nil @lookup_cons) (payload (idx out)))

@lookup_nil = (* (idx out))
  & idx ~ *
  & out ~ 0

@lookup_cons = (* ((head tail) (idx out)))
  & idx ~ ?((@lookup_zero @lookup_succ) (head (tail out)))

@lookup_zero = (head (tail out))
  & tail ~ *
  & out ~ head

@lookup_succ = (idx (head (tail out)))
  & head ~ *
  & @lookup ~ (tail (idx out))

// For each edge u -> v, add old[u] to acc[v].
@scan = (edges (old (acc out)))
  & edges ~ (tag payload)
  & tag ~ ?((@scan_nil @scan_cons) (payload (old (acc out))))

@scan_nil = (* (old (acc out)))
  & old ~ *
  & out ~ acc

@scan_cons = (* ((edge tail) (old (acc out))))
  & edge ~ (u v)
  & v ~ {v_lookup v_set}
  & old ~ {old_lookup old_next}
  & acc ~ {acc_lookup acc_set}
  & @lookup ~ (old_lookup (u oldval))
  & @lookup ~ (acc_lookup (v_lookup accval))
  & accval ~ $([+] $(oldval sum))
  & @set ~ (acc_set (v_set (sum next)))
  & @scan ~ (tail (old_next (next out)))

// Repeat propagation k times, then read the target count.
@steps = (rem (n (t (edges (curr out)))))
  & rem ~ ?((@steps_zero @steps_succ) (n (t (edges (curr out)))))

@steps_zero = (n (t (edges (curr out))))
  & n ~ *
  & edges ~ *
  & @lookup ~ (curr (t out))

@steps_succ = (* (n (t (edges (curr out)))))
  & n ~ {n_zero n_next}
  & edges ~ {edges_scan edges_next}
  & @zeros ~ (n_zero zeroes)
  & @scan ~ (edges_scan (curr (zeroes next)))
  & @steps ~ (rem (n_next (t (edges_next (next out)))))
