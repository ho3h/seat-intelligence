// Count even elements two at a time. Pair increments are combined independently
// of the recursive tail count, reducing the dependent addition chain.
@prog = (l out)
  & @ce ~ (l out)

@ce = ((?((@ce_nil @ce_cons) (pl out)) pl) out)

@ce_nil = (* out)
  & out ~ 0

@ce_cons = (* ((h1 t1) out))
  & t1 ~ (?((@ce_last @ce_more) (pl (h1 out))) pl)

@ce_last = (* (h1 out))
  & h1 ~ $([&] $(1 p))
  & p ~ $([^] $(1 out))

@ce_more = (* ((h2 t2) (h1 out)))
  & @ce ~ (t2 tail)
  & h1 ~ $([&] $(1 p1))
  & p1 ~ $([^] $(1 i1))
  & h2 ~ $([&] $(1 p2))
  & p2 ~ $([^] $(1 i2))
  & i1 ~ $([+] $(i2 pairinc))
  & tail ~ $([+] $(pairinc out))
