// Filter the list, preserving elements strictly greater than the key.
@prog = ((k xs) out)
  & @filter_gt ~ (k (xs out))

@filter_gt = (k ((?((@filter_nil @filter_cons) (pl (ka (kr o)))) pl) o))
  & k ~ {ka kr}

@filter_nil = (pl (ka (kr out)))
  & pl ~ *
  & ka ~ *
  & kr ~ *
  & out ~ (0 *)

@filter_cons = (* ((h t) (ka (kr out))))
  & h ~ {ht hk}
  & ht ~ $([>] $(ka z))
  & z ~ ?((@filter_drop @filter_keep) (hk (t (kr out))))

@filter_drop = (hk (t (kr out)))
  & hk ~ *
  & @filter_gt ~ (kr (t out))

@filter_keep = (* (hk (t (kr out))))
  & @filter_gt ~ (kr (t rest))
  & out ~ (1 (hk rest))
