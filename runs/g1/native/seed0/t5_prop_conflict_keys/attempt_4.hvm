@prog = (c (attrs out))
  & c ~ {cur full}
  & @clust ~ (cur (0 (full (attrs out))))

@clust = ((?((@clnil @clcons) (pl (idx (full (attrs out))))) pl) (idx (full (attrs out))))

@clnil = (* (idx (full (attrs out))))
  & idx ~ *
  & full ~ *
  & attrs ~ *
  & out ~ (0 *)

@clcons = (* ((cval tail) (idx (full (attrs out)))))
  & idx ~ {icheck ikeep}
  & cval ~ $([=] $(icheck eq))
  & eq ~ ?((@cl_no @cl_yes) (ikeep (full (attrs (tail out))))

@cl_no = (idx (full (attrs (tail out))))
  & idx ~ $([+1] nextidx)
  & @clust ~ (tail (nextidx (full (attrs out))))

@cl_yes = (idx (full (attrs (tail out))))
  & @keys ~ (full (idx (0 (tail (attrs out)))))

@keys = (full (idx (key (tail (attrs out)))))
  & key ~ {kcheck kkeep}
  & kcheck ~ $([=] $(4 eq))
  & eq ~ ?((@key_more @key_end) (full (idx (kkeep (tail (attrs out)))))

@key_more = (full (idx (key (tail (attrs out)))))
  & full ~ {fscan frest}
  & idx ~ {itmp irec}
  & itmp ~ {iscan iemit}
  & key ~ {ktmp kinc}
  & ktmp ~ {kscan kemit}
  & kinc ~ $([+1] nextkey)
  & attrs ~ {ascan arest}
  & @keys ~ (frest (irec (nextkey (tail (arest rest)))))
  & @scan ~ (ascan (fscan (iscan (kscan (0 (0 (0 scanstate))))))
  & @emit ~ (iemit (kemit (scanstate (rest out))))

@key_end = (* (full (idx (key (tail (attrs out))))))
  & key ~ *
  & idx ~ $([+1] nextidx)
  & @clust ~ (tail (nextidx (full (attrs out))))

@emit = (idx (key (((?((@emit_no @emit_yes) (idx (key (rest out)))) *) (rest out))))

@emit_no = (idx (key (rest out)))
  & idx ~ *
  & key ~ *
  & out ~ rest

@emit_yes = (* (idx (key (rest out))))
  & out ~ (1 ((idx key) rest))

@scan = ((?((@scan_nil @scan_cons) (pl (full (target (key (state out)))))) pl) (full (target (key (state out))))

@scan_nil = (* (full (target (key (state out)))))
  & full ~ *
  & target ~ *
  & key ~ *
  & out ~ state

@scan_cons = (* (((node (akey value)) tail) (full (target (key (state out))))))
  & key ~ {kcheck kkeep}
  & akey ~ $([=] $(kcheck eq))
  & eq ~ ?((@scan_skip @scan_match) (full (target (kkeep (node (akey (value (tail (state out))))))))

@scan_skip = (full (target (key (node (akey (value (tail (state out))))))))
  & node ~ *
  & akey ~ *
  & value ~ *
  & @scan ~ (tail (full (target (key (state out))))

@scan_match = (full (target (key (node (akey (value (tail (state out))))))))
  & full ~ {nthfull scanfull}
  & akey ~ *
  & @nth ~ (nthfull (node got))
  & @after_nth ~ (got (scanfull (target (key (value (tail (state out))))))

@after_nth = (got (full (target (key (value (tail (state out)))))))
  & target ~ {tcheck tkeep}
  & got ~ $([=] $(tcheck eq2))
  & eq2 ~ ?((@scan_wrong @scan_right) (full (tkeep (key (value (tail (state out))))))

@scan_wrong = (full (target (key (value (tail (state out))))))
  & value ~ *
  & @scan ~ (tail (full (target (key (state out))))

@scan_right = (full (target (key (value (tail (state out))))))
  & @update ~ (value (state newstate))
  & @scan ~ (tail (full (target (key (newstate out))))

@update = (val ((?((@upd_none @upd_some) (val (first conflict))) (first conflict)) out))

@upd_none = (val (first (conflict out)))
  & first ~ *
  & conflict ~ *
  & out ~ (1 (val 0))

@upd_some = (* (val (first (conflict out))))
  & val ~ $([=] $(first eq))
  & eq ~ ?((@upd_diff @upd_same) (first (conflict out)))

@upd_diff = (first (conflict out))
  & conflict ~ *
  & out ~ (1 (first 1))

@upd_same = (* (first (conflict out)))
  & out ~ (1 (first conflict))

@nth = ((?((@nth_nil @nth_cons) (pl (idx out))) pl) (idx out))

@nth_nil = (* (idx out))
  & idx ~ *
  & out ~ 0

@nth_cons = (* ((head tail) (idx out)))
  & idx ~ ?((@nth_zero @nth_more) (head (tail out)))

@nth_zero = (head (tail out))
  & tail ~ *
  & out ~ head

@nth_more = (idx (head (tail out)))
  & head ~ *
  & @nth ~ (tail (idx out))
