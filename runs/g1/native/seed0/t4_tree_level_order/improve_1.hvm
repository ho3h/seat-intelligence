// Breadth-first traversal with a front queue and reversed rear queue.
// Emit each value directly into the output list as it is visited.

@prog = (input out)
  & @bfs ~ ((1 (input (0 *))) ((0 *) out))

@bfs = ((?((@bfs_empty @bfs_cons) (payload (rear out))) payload) (rear out))

@bfs_empty = (* (rear out))
  & @normalize ~ (rear out)

@bfs_cons = (* ((tree tail) (rear out)))
  & @visit ~ (tree (tail (rear out)))

@visit = ((?((@visit_leaf @visit_node) (payload (tail (rear out)))) payload) (tail (rear out)))

@visit_leaf = (* (tail (rear out)))
  & @bfs ~ (tail (rear out))

@visit_node = (* ((left (value right)) (tail (rear out))))
  & out ~ (1 (value out2))
  & @bfs ~ (tail ((1 (right (1 (left rear)))) out2))

@normalize = ((?((@normal_nil @normal_cons) (payload out)) payload) out)

@normal_nil = (* out)
  & out ~ (0 *)

@normal_cons = (* ((head tail) out))
  & @rev ~ ((1 (head tail)) ((0 *) front))
  & @bfs ~ (front ((0 *) out))

@rev = ((?((@rev_nil @rev_cons) (payload (acc out))) payload) (acc out))

@rev_nil = (* (x x))

@rev_cons = (* ((head tail) (acc out)))
  & @rev ~ (tail ((1 (head acc)) out))
