// @prog takes a list and returns the list of its even elements.
@prog = (l out)
  & @filter ~ (l out)

@filter = ((?((@filter_nil @filter_cons) (pl out)) pl) out)

@filter_nil = (* (0 *))

@filter_cons = (* ((h t) result))
  & h ~ {h_test h_keep}
  & h_test ~ $([%] $(2 rem))
  & rem ~ ?((@filter_even @filter_odd) (h_keep (t result)))

@filter_even = (h (t out))
  & @filter ~ (t rest)
  & out ~ (1 (h rest))

@filter_odd = (* (h (t out)))
  & h ~ *
  & @filter ~ (t out)
