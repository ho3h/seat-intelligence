// Build reachability sets for every vertex, then select the least mutually
// reachable vertex for each output entry.
@prog = ((n edges) out)
  & {ncount ntotal} ~ n
  & @build ~ (ncount (ntotal (edges (0 records))))
  & {r1 r2} ~ records
  & @labels ~ (r1 (r2 out))

// Build the map (vertex, reachable-set) in ascending vertex order.
@build = (?( (@build_nil @build_step) (total (edges (id out)))) (total (edges (id out))))

@build_nil = (* (* (* (0 *))))

@build_step = (remaining (total (edges (id out))))
  & {t1 t2} ~ total
  & {e1 e2} ~ edges
  & {i1 i2} ~ id
  & {isource ioutput} ~ i1
  & i2 ~ $([+1] next)
  & @reach ~ (t1 (e1 (isource reachset)))
  & @build ~ (remaining (t2 (e2 (next rest))))
  & out ~ (1 ((ioutput reachset) rest))

// Reachability: n full sweeps suffice for a graph with n vertices.
@reach = (count (edges (source out)))
  & @iterate ~ (count (edges ((1 (source (0 *))) out)))

@iterate = (?( (@iterate_zero @iterate_step) (edges (set out))) (edges (set out)))

@iterate_zero = (* (s s))

@iterate_step = (remaining (edges (set out)))
  & {escan eagain} ~ edges
  & @sweep ~ (escan (set updated))
  & @iterate ~ (remaining (eagain (updated out)))

// Sweep the directed edge list, adding v whenever u is reachable.
@sweep = ((?((@sweep_nil @sweep_cons) (p (set out))) p) (set out))

@sweep_nil = (* (s s))

@sweep_cons = (* (((u v) tail) (set out)))
  & {sm sr} ~ set
  & @mem ~ (sm (u z))
  & z ~ ?((@sweep_skip @sweep_if) (v (tail (sr out))))

@sweep_skip = (* (tail (set out)))
  & @sweep ~ (tail (set out))

@sweep_if = (* (v (tail (set out))))
  & @add ~ (v (set newset))
  & @sweep ~ (tail (newset out))

// Add v to set if it is not already present.
@add = (v (set out))
  & {v1 v2} ~ v
  & {s1 s2} ~ set
  & @mem ~ (s1 (v1 z))
  & z ~ ?((@add_no @add_yes) (v2 (s2 out)))

@add_no = (* (s s))

@add_yes = (* (v (set out)))
  & out ~ (1 (v set))

// Membership test for a number in a list.
@mem = ((?((@mem_nil @mem_cons) (p (x out))) p) (x out))

@mem_nil = (* (* 0))

@mem_cons = (* ((h t) (x out)))
  & {xcmp xrec} ~ x
  & h ~ $([=] $(xcmp z))
  & z ~ ?((@mem_more @mem_yes) (t (xrec out)))

@mem_more = (t (x out))
  & @mem ~ (t (x out))

@mem_yes = (* (* (* 1)))

// Scan the complete reachability map to label each vertex.
@labels = ((?((@labels_nil @labels_cons) (p (full out))) p) (full out))

@labels_nil = (* (* (0 *)))

@labels_cons = (* (((id reach) tail) (full out)))
  & {ffind fagain} ~ full
  & @find ~ (ffind (id (reach label)))
  & @labels ~ (tail (fagain rest))
  & out ~ (1 (label rest))

// Return the first (hence smallest) mutually reachable candidate.
@find = ((?((@find_nil @find_cons) (p (source (reach out)))) p) (source (reach out)))

@find_nil = (* (source (* source)))

@find_cons = (* (((u ru) tail) (source (reach out))))
  & {r1 r2} ~ reach
  & {u1 u2} ~ u
  & @mem ~ (r1 (u1 z))
  & z ~ ?((@find_advance @find_check2) (u2 (ru (tail (source (r2 out))))))

@find_advance = (* (* (tail (source (reach out)))))
  & @find ~ (tail (source (reach out)))

@find_check2 = (* (u (ru (tail (source (reach out))))))
  & {scheck skeep} ~ source
  & @mem ~ (ru (scheck z2))
  & z2 ~ ?((@find_skip2 @find_found) (u (tail (skeep (reach out)))))

@find_skip2 = (* (tail (source (reach out))))
  & @find ~ (tail (source (reach out)))

@find_found = (* (u (* (* (* u)))))
