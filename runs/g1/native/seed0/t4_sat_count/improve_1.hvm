// Build an 8-bit truth table, then count its set bits.
@prog = (input out)
  & @mask ~ (input mask)
  & @pop ~ (mask out)

@mask = ((?((@m_false @m_ge1) (payload out)) payload) out)

@m_false = (payload out)
  & payload ~ *
  & out ~ 0

@m_ge1 = (n ctx)
  & n ~ ?((@m_true @m_ge2) ctx)

@m_true = (payload out)
  & payload ~ *
  & out ~ 255

@m_ge2 = (n ctx)
  & n ~ ?((@m_var @m_ge3) ctx)

@m_var = (i out)
  & i ~ ?((@m_v0 @m_vpos) out)

@m_v0 = out
  & out ~ 170

@m_vpos = (n out)
  & n ~ ?((@m_v1 @m_v2) out)

@m_v1 = out
  & out ~ 204

@m_v2 = (n out)
  & n ~ *
  & out ~ 240

@m_ge3 = (n ctx)
  & n ~ ?((@m_not @m_ge4) ctx)

@m_not = (child out)
  & @mask ~ (child value)
  & value ~ $([^] $(255 out))

@m_ge4 = (n ctx)
  & n ~ ?((@m_and @m_ge5) ctx)

@m_and = ((a b) out)
  & @mask ~ (a x)
  & @mask ~ (b y)
  & x ~ $([&] $(y out))

@m_ge5 = (n ctx)
  & n ~ ?((@m_or @m_bad) ctx)

@m_or = ((a b) out)
  & @mask ~ (a x)
  & @mask ~ (b y)
  & x ~ $([|] $(y out))

@m_bad = (n ctx)
  & n ~ *
  & ctx ~ *

@pop = (mask out)
  & @bits0 ~ (mask (0 out))

@bits0 = (q (acc out))
  & q ~ {qb qs}
  & qb ~ $([&] $(1 bit))
  & bit ~ $([+] $(acc acc1))
  & qs ~ $([>>] $(1 q1))
  & @bits1 ~ (q1 (acc1 out))

@bits1 = (q (acc out))
  & q ~ {qb qs}
  & qb ~ $([&] $(1 bit))
  & bit ~ $([+] $(acc acc1))
  & qs ~ $([>>] $(1 q1))
  & @bits2 ~ (q1 (acc1 out))

@bits2 = (q (acc out))
  & q ~ {qb qs}
  & qb ~ $([&] $(1 bit))
  & bit ~ $([+] $(acc acc1))
  & qs ~ $([>>] $(1 q1))
  & @bits3 ~ (q1 (acc1 out))

@bits3 = (q (acc out))
  & q ~ {qb qs}
  & qb ~ $([&] $(1 bit))
  & bit ~ $([+] $(acc acc1))
  & qs ~ $([>>] $(1 q1))
  & @bits4 ~ (q1 (acc1 out))

@bits4 = (q (acc out))
  & q ~ {qb qs}
  & qb ~ $([&] $(1 bit))
  & bit ~ $([+] $(acc acc1))
  & qs ~ $([>>] $(1 q1))
  & @bits5 ~ (q1 (acc1 out))

@bits5 = (q (acc out))
  & q ~ {qb qs}
  & qb ~ $([&] $(1 bit))
  & bit ~ $([+] $(acc acc1))
  & qs ~ $([>>] $(1 q1))
  & @bits6 ~ (q1 (acc1 out))

@bits6 = (q (acc out))
  & q ~ {qb qs}
  & qb ~ $([&] $(1 bit))
  & bit ~ $([+] $(acc acc1))
  & qs ~ $([>>] $(1 q1))
  & @bits7 ~ (q1 (acc1 out))

@bits7 = (q (acc out))
  & q ~ $([&] $(1 bit))
  & bit ~ $([+] $(acc out))
