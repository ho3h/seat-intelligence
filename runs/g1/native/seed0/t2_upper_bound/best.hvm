// Process sixteen list elements per recursive call.
@prog = ((xs t) out)
  & @ub ~ (xs (t (0 out)))

@ub = ((?((@ub_nil @ub_cons) (pl (t (acc out)))) pl) (t (acc out)))

@ub_nil = (* (* (a a)))

@ub_cons = (* ((h tail) (t (acc out))))
  & t ~ {tc tr}
  & h ~ $([>] $(tc z))
  & z ~ ?((@ub1 @ub_stop0) (tail (tr (acc out))))

@ub_stop0 = (* (* (* (a a))))

@ub1 = ((?((@ub1_nil @ub1_cons) (pl (t (acc out)))) pl) (t (acc out)))
@ub1_nil = (* (* (acc out)))
  & acc ~ $([+1] out)
@ub1_cons = (* ((h tail) (t (acc out))))
  & t ~ {tc tr}
  & h ~ $([>] $(tc z))
  & z ~ ?((@ub2 @ub1_stop) (tail (tr (acc out))))
@ub1_stop = (* (* (* (acc out))))
  & acc ~ $([+1] out)

