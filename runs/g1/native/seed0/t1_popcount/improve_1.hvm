// Parallel 24-bit SWAR popcount.
@prog = (n out)
  & @pc ~ (n out)

@pc = (n out)
  & n ~ {x1 x2}
  & x2 ~ $([>>] $(1 r1))
  & r1 ~ $([&] $(5592405 r2))
  & x1 ~ $([-] $(r2 s1))
  & s1 ~ {y1 y2}
  & y1 ~ $([&] $(3355443 r3))
  & y2 ~ $([>>] $(2 r4))
  & r4 ~ $([&] $(3355443 r5))
  & r3 ~ $([+] $(r5 s2))
  & s2 ~ {z1 z2}
  & z1 ~ $([+] $(r6 r7))
  & z2 ~ $([>>] $(4 r6))
  & r7 ~ $([&] $(986895 s3))
  & s3 ~ {w1 w2}
  & w1 ~ $([+] $(r8 r9))
  & w2 ~ $([>>] $(8 r8))
  & r9 ~ {v1 v2}
  & v1 ~ $([+] $(r10 r11))
  & v2 ~ $([>>] $(16 r10))
  & r11 ~ $([&] $(63 out))
