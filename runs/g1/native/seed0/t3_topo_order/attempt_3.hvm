// Construct a list of n zeros.
@zeros = (n out)
  & n ~ ?((@zeros_nil @zeros_more) out)

@zeros_nil = out
  & out ~ (0 *)

@zeros_more = (m out)
  & @zeros ~ (m tail)
  & out ~ (1 (0 tail))


// Increment the element at index idx in a list.
@incAt = ((?((@inc_nil @inc_cons) (idx out)) pl) (idx out))

@inc_nil = (* (idx out))
  & idx ~ *
  & out ~ (0 *)

@inc_cons = (* ((h t) (idx out)))
  & idx ~ ?((@inc_here @inc_later) (h (t out)))

@inc_here = (h (t out))
  & h ~ $([+1] h2)
  & out ~ (1 (h2 t))

@inc_later = (idx (h (t out)))
  & @incAt ~ (t (idx tail))
  & out ~ (1 (h tail))


// Decrement the element at index idx in a list.
@decAt = ((?((@dec_nil @dec_cons) (idx out)) pl) (idx out))

@dec_nil = (* (idx out))
  & idx ~ *
  & out ~ (0 *)

@dec_cons = (* ((h t) (idx out)))
  & idx ~ ?((@dec_here @dec_later) (h (t out)))

@dec_here = (h (t out))
  & h ~ $([-1] h2)
  & out ~ (1 (h2 t))

@dec_later = (idx (h (t out)))
  & @decAt ~ (t (idx tail))
  & out ~ (1 (h tail))


// Build indegrees while preserving a copy of the edge list.
@builddeg = ((?((@bd_nil @bd_cons) (deg out)) pl) (deg out))

@bd_nil = (* (deg out))
  & out ~ (deg (0 *))

@bd_cons = (* (((u v) tail) (deg out)))
  & v ~ {v_inc v_keep}
  & @incAt ~ (deg (v_inc mid))
  & @builddeg ~ (tail (mid (deg2 tail2)))
  & out ~ (deg2 (1 ((u v_keep) tail2)))


// For every edge whose source is v, decrement its target's indegree
// and replace its source with the sentinel.
@remove = ((?((@remove_nil @remove_cons) (v (deg out))) pl) (v (deg out)))

@remove_nil = (* (v (deg out)))
  & v ~ *
  & out ~ ((0 *) deg)

@remove_cons = (* (((u w) tail) (v (deg out))))
  & v ~ {v_cmp v_next}
  & u ~ {u_cmp u_keep}
  & u_cmp ~ $([=] $(v_cmp z))
  & z ~ ?((@remove_no @remove_yes) (u_keep (w (tail (v_next (deg out)))))

@remove_no = (u (w (tail (v (deg out)))))
  & @remove ~ (tail (v (deg (rest deg2))))
  & out ~ ((1 ((u w) rest)) deg2)

@remove_yes = (u_keep (w (tail (v (deg out)))))
  & u_keep ~ *
  & w ~ {w_dec w_keep}
  & @decAt ~ (deg (w_dec mid))
  & @remove ~ (tail (v (mid (rest deg2))))
  & out ~ ((1 ((16777215 w_keep) rest)) deg2)


// Find and mark the first zero in the indegree list.
@pick = ((?((@pick_nil @pick_cons) (idx out)) pl) (idx out))

@pick_nil = (* (idx out))
  & idx ~ *
  & out ~ (16777215 (0 *))

@pick_cons = (* ((h t) (idx out)))
  & h ~ {h_cmp h_keep}
  & h_cmp ~ $([=] $(0 z))
  & z ~ ?((@pick_zero @pick_nonzero) (h_keep (t (idx out)))

@pick_zero = (h_keep (t (idx out)))
  & h_keep ~ *
  & out ~ (idx (1 (16777215 t)))

@pick_nonzero = (h_keep (t (idx out)))
  & idx ~ $([+1] idx2)
  & @pick ~ (t (idx2 (found tail2)))
  & out ~ (found (1 (h_keep tail2))))


// Repeatedly pick the smallest available vertex.
@topo = (n (deg (edges out)))
  & n ~ ?((@topo_nil @topo_more) (deg (edges out)))

@topo_nil = (deg (edges out))
  & deg ~ *
  & edges ~ *
  & out ~ (0 *)

@topo_more = (m (deg (edges out)))
  & @pick ~ (deg (0 (found marked)))
  & found ~ {v_remove v_out}
  & @remove ~ (edges (v_remove (marked (newedges newdeg))))
  & @topo ~ (m (newdeg (newedges tail)))
  & out ~ (1 (v_out tail))


@prog = ((n edges) out)
  & n ~ {n_zero n_topo}
  & @zeros ~ (n_zero zeroes)
  & @builddeg ~ (edges (zeroes (deg edges_copy)))
  & @topo ~ (n_topo (deg (edges_copy out)))
