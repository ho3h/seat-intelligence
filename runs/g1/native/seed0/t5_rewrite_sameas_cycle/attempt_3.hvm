// Count the list while rebuilding it, producing its length and a copy.
@prog = (input out)
  & @len ~ (input (n full))
  & @scan ~ (full (0 (n out)))

@len = ((?((@len_nil @len_cons) (pl (out listout))) pl) (out listout))

@len_nil = (pl (out listout))
  & pl ~ *
  & out ~ 0
  & listout ~ (0 *)

@len_cons = (* ((h t) (out listout)))
  & @len ~ (t (k tailout))
  & k ~ $([+1] out)
  & listout ~ (1 (h tailout))

// Test indices from zero up to the list length.
@scan = (full (i (n out)))
  & i ~ {i_test i_ctx}
  & n ~ {n_test n_ctx}
  & i_test ~ $([<] $(n_test z))
  & z ~ ?((@scan_end @scan_step) (full (i_ctx (n_ctx out))))

@scan_end = (full (i (n out)))
  & full ~ *
  & i ~ *
  & n ~ *
  & out ~ 0

@scan_step = (* (full (i (n out))))
  & full ~ {f_walk f_recur}
  & i ~ {i_walk i_recur}
  & n ~ {n_walk n_recur}
  & i_recur ~ $([+1] inext)
  & @walk ~ (f_walk (i_walk (n_walk cyc)))
  & cyc ~ ?((@scan_no @scan_yes) (f_recur (inext (n_recur out))))

@scan_no = (full (i (n out)))
  & @scan ~ (full (i (n out)))

@scan_yes = (* (full (i (n out))))
  & full ~ *
  & i ~ *
  & n ~ *
  & out ~ 1

// Follow pointers for at most n steps. Exhausting the steps means a cycle.
@walk = (pl (x (?( (@walk_zero @walk_succ) (pl (x out)) ) out)))

@walk_zero = (pl (x out))
  & pl ~ *
  & x ~ *
  & out ~ 1

@walk_succ = (rem (pl (x out)))
  & pl ~ {pl_at pl_rec}
  & x ~ {x_at x_cmp}
  & @at ~ (pl_at (x_at p))
  & p ~ {p_test p_next}
  & x_cmp ~ $([=] $(p_test z))
  & z ~ ?((@walk_more @walk_root) (pl_rec (p_next (rem out))))

@walk_more = (pl (x (rem out)))
  & @walk ~ (pl (x (rem out)))

@walk_root = (* (pl (x (rem out))))
  & pl ~ *
  & x ~ *
  & rem ~ *
  & out ~ 0

// Look up an index in a list.
@at = ((?((@at_nil @at_cons) (pl (idx val))) pl) (idx val))

@at_nil = (pl (idx val))
  & pl ~ *
  & idx ~ *
  & val ~ 0

@at_cons = (* ((h t) (idx val)))
  & idx ~ ?((@at_zero @at_more) (h (t val)))

@at_zero = (h (t val))
  & h ~ val
  & t ~ *

@at_more = (idx (h (t val)))
  & h ~ *
  & @at ~ (t (idx val))
