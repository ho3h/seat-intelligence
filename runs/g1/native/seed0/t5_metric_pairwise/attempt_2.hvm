// Accumulators are carried as (tp (fp (fn out))).
@prog = ((p t) out)
  & @outer ~ (p (t (0 (0 (0 out)))))

@outer = ((?((@outer_nil @outer_cons) (pl (t (tp (fp (fn out)))))) pl) (t (tp (fp (fn out)))))

@outer_nil = (* (* (tp (fp (fn out)))))
  & out ~ (tp (fp fn))

@outer_cons = (* ((h pt) (t (tp (fp (fn out))))))
  & @truth ~ (t (h (pt (tp (fp (fn out))))))

@truth = ((?((@truth_nil @truth_cons) (pl (h (pt (tp (fp (fn out))))))) pl) (h (pt (tp (fp (fn out)))))

@truth_nil = (* (* (* (tp (fp (fn out))))))
  & out ~ (tp (fp fn))

@truth_cons = (* ((k qt) (h (pt (tp (fp (fn out)))))))
  & @inner ~ (pt (qt (h (k (tp (fp (fn out)))))))

@inner = ((?((@inner_nil @inner_cons) (pl (qt (h (k (tp (fp (fn out))))))) pl) (qt (h (k (tp (fp (fn out)))))))

@inner_nil = (* (qt (* (* (tp (fp (fn out)))))))
  & @outer ~ ((0 *) (qt (tp (fp (fn out)))))

@inner_cons = (* ((u pt) (qt (h (k (tp (fp (fn out))))))))
  & @inner_truth ~ (qt (u (pt (h (k (tp (fp (fn out))))))))

@inner_truth = ((?((@it_nil @it_cons) (pl (u (pt (h (k (tp (fp (fn out))))))))) pl) (u (pt (h (k (tp (fp (fn out)))))))

@it_nil = (* (* (* (* (* (tp (fp (fn out))))))))
  & out ~ (tp (fp fn))

@it_cons = (* ((v qt) (u (pt (h (k (tp (fp (fn out)))))))))
  & h ~ {hc hn}
  & k ~ {kc kn}
  & u ~ $([=] $(hc ep))
  & v ~ $([=] $(kc et))
  & ep ~ {ep_tp ep_rest}
  & ep_rest ~ {ep_fp ep_zero}
  & ep_zero ~ $([=] $(0 ep_fn))
  & et ~ {et_tp et_rest}
  & et_rest ~ {et_fn et_zero}
  & et_zero ~ $([=] $(0 et_fp))
  & ep_tp ~ $([&] $(et_tp btp))
  & ep_fp ~ $([&] $(et_fp bfp))
  & ep_fn ~ $([&] $(et_fn bfn))
  & tp ~ $([+] $(btp tp2))
  & fp ~ $([+] $(bfp fp2))
  & fn ~ $([+] $(bfn fn2))
  & @inner ~ (pt (qt (hn (kn (tp2 (fp2 (fn2 out))))))
