@prog = (input out)
  & input ~ (n edges)
  & n ~ {ni ne}
  & @init ~ (ni labels)
  & @edges ~ (edges (ne (labels out)))

@init = (n out)
  & n ~ ?((@init_zero @init_succ) out)

@init_zero = out
  & out ~ (0 *)

@init_succ = (k out)
  & k ~ {head krec}
  & @init ~ (krec tail)
  & out ~ (1 (head tail))

@edges = ((?((@edges_nil @edges_cons) (pl (n (labels out)))) pl) (n (labels out)))

@edges_nil = (pl (n (labels out)))
  & pl ~ *
  & n ~ *
  & @largest ~ (labels out)

@edges_cons = (* (pl (n (labels out))))
  & pl ~ (edge tail)
  & edge ~ (u v)
  & n ~ {nidx nrec}
  & nidx ~ $([-1] nm)
  & nm ~ {mu mv}
  & mu ~ $([-] $(u iu))
  & mv ~ $([-] $(v iv))
  & labels ~ {la tmp}
  & tmp ~ {lb lc}
  & @get ~ (iu (la lu))
  & @get ~ (iv (lb lv))
  & @replace ~ (lc (lu (lv updated)))
  & @edges ~ (tail (nrec (updated out)))

@get = (?((@get_zero @get_succ) (list out)) (list out))

@get_zero = (list out)
  & list ~ (tag payload)
  & tag ~ *
  & payload ~ (head tail)
  & tail ~ *
  & out ~ head

@get_succ = (idx (list out))
  & list ~ (tag payload)
  & tag ~ *
  & payload ~ (head tail)
  & head ~ *
  & @get ~ (idx (tail out))

@replace = ((?((@replace_nil @replace_cons) (pl (old (new out)))) pl) (old (new out)))

@replace_nil = (pl (old (new out)))
  & pl ~ *
  & old ~ *
  & new ~ *
  & out ~ (0 *)

@replace_cons = (* (pl (old (new out))))
  & pl ~ (head tail)
  & old ~ {oc or}
  & new ~ {nh nr}
  & head ~ {hc hk}
  & hc ~ $([=] $(oc bit))
  & bit ~ ?((@replace_no @replace_yes) (hk (nh (or (nr (tail out))))))

@replace_no = (hk (nh (or (nr (tail out)))))
  & nh ~ *
  & @replace ~ (tail (or (nr rest)))
  & out ~ (1 (hk rest))

@replace_yes = (* (hk (nh (or (nr (tail out))))))
  & hk ~ *
  & @replace ~ (tail (or (nr rest)))
  & out ~ (1 (nh rest))

@largest = ((?((@largest_nil @largest_cons) (pl out)) pl) out)

@largest_nil = (pl out)
  & pl ~ *
  & out ~ 0

@largest_cons = (* (pl out))
  & pl ~ (head tail)
  & tail ~ {tf tr}
  & @freq ~ (head (tf (1 freq)))
  & @largest ~ (tr rest)
  & freq ~ {fc fp}
  & rest ~ {rc rp}
  & fc ~ $([>] $(rc bit))
  & bit ~ ?((@max_no @max_yes) (fp (rp out)))

@max_no = (fp (rp out))
  & fp ~ *
  & out ~ rp

@max_yes = (* (fp (rp out)))
  & rp ~ *
  & out ~ fp

@freq = ((?((@freq_nil @freq_cons) (pl (target (acc out)))) pl) (target (acc out)))

@freq_nil = (pl (target (acc out)))
  & pl ~ *
  & target ~ *
  & out ~ acc

@freq_cons = (* (pl (target (acc out))))
  & pl ~ (head tail)
  & target ~ {tc tr}
  & head ~ $([=] $(tc bit))
  & bit ~ ?((@freq_no @freq_yes) (tr (tail (acc out))))

@freq_no = (tr (tail (acc out)))
  & @freq ~ (tail (tr (acc out)))

@freq_yes = (* (tr (tail (acc out))))
  & acc ~ $([+1] acc2)
  & @freq ~ (tail (tr (acc2 out)))
