@prog = (input out)
  & input ~ (n edges)
  & @init ~ (n ((0 *) labels))
  & @edges ~ (edges (labels out))

@init = (n (acc out))
  & n ~ ?((@init_zero @init_succ) (acc out))

@init_zero = (acc out)
  & acc ~ out

@init_succ = (n (acc out))
  & n ~ {nr nh}
  & @init ~ (nr ((1 (nh acc)) out))

@edges = ((?((@edges_nil @edges_cons) (pl (labels out))) pl) (labels out))

@edges_nil = (* (labels out))
  & @largest ~ (labels out)

@edges_cons = (* (pl (labels out)))
  & pl ~ (edge tail)
  & edge ~ (u v)
  & labels ~ {l1 tmp}
  & tmp ~ {l2 keep}
  & @getpack ~ (u (l1 (cin1 res1)))
  & cin1 ~ (v (tail (l2 (keep out))))
  & res1 ~ (lu cout1)
  & cout1 ~ (v1 (tail1 (l2b (keep1 out1))))
  & @getpack ~ (v1 (l2b (cin2 res2)))
  & cin2 ~ (lu (tail1 (keep1 out1)))
  & res2 ~ (lv cout2)
  & cout2 ~ (lu2 (tail2 (keep2 out2)))
  & @replace ~ (keep2 (lv (lu2 updated)))
  & @edges ~ (tail2 (updated out2))

@getpack = (idx (list (ctx out)))
  & idx ~ ?((@getpack_zero @getpack_more) (list (ctx out)))

@getpack_zero = (list (ctx out))
  & list ~ (tag payload)
  & tag ~ *
  & payload ~ (head tail)
  & tail ~ *
  & out ~ (head ctx)

@getpack_more = (idx (list (ctx out)))
  & list ~ (tag payload)
  & tag ~ *
  & payload ~ (head tail)
  & head ~ *
  & @getpack ~ (idx (tail (ctx out)))

@replace = ((?((@replace_nil @replace_cons) (pl (old (new out)))) pl) (old (new out)))

@replace_nil = (* (old (new out)))
  & old ~ *
  & new ~ *
  & out ~ (0 *)

@replace_cons = (* (pl (old (new out))))
  & pl ~ (head tail)
  & head ~ {hc ho}
  & old ~ {oc or}
  & new ~ {nc nr}
  & hc ~ $([=] $(oc bit))
  & bit ~ ?((@replace_no @replace_yes) (ho (or (nc (nr (tail out)))))

@replace_no = (* (ho (or (nc (nr (tail out))))))
  & nc ~ *
  & @replace ~ (tail (or (nr rt)))
  & out ~ (1 (ho rt))

@replace_yes = (* (ho (or (nc (nr (tail out))))))
  & ho ~ *
  & @replace ~ (tail (or (nr rt)))
  & out ~ (1 (nc rt))

@largest = ((?((@largest_nil @largest_cons) (pl out)) pl) out)

@largest_nil = (pl out)
  & pl ~ *
  & out ~ 0

@largest_cons = (* (pl out))
  & pl ~ (head tail)
  & tail ~ {tf tr}
  & @freq ~ (head (tf (1 freq)))
  & @largest ~ (tr rest)
  & freq ~ {fc fp}
  & rest ~ {rc rp}
  & fc ~ $([>] $(rc bit))
  & bit ~ ?((@max_no @max_yes) (fp (rp out)))

@max_no = (* (fp (rp out)))
  & fp ~ *
  & out ~ rp

@max_yes = (* (fp (rp out)))
  & rp ~ *
  & out ~ fp

@freq = ((?((@freq_nil @freq_cons) (pl (target (acc out)))) pl) (target (acc out)))

@freq_nil = (* (target (acc out)))
  & target ~ *
  & out ~ acc

@freq_cons = (* (pl (target (acc out))))
  & pl ~ (head tail)
  & target ~ {tc tr}
  & head ~ $([=] $(tc bit))
  & bit ~ ?((@freq_no @freq_yes) (tr (tail (acc out))))

@freq_no = (* (target (tail (acc out))))
  & @freq ~ (target (tail (acc out)))

@freq_yes = (* (target (tail (acc out))))
  & acc ~ $([+1] acc2)
  & @freq ~ (target (tail (acc2 out)))
