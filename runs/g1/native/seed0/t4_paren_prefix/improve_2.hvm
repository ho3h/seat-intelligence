// Track nesting depth, consumed position, and the last balanced position.
// Advance the position in parallel with classifying each character.
@prog = (l out)
  & @scan ~ (l (0 (0 (0 out))))

@scan = ((?((@scan_nil @scan_cons) (pl (dep (pos (best out))))) pl) (dep (pos (best out))))

@scan_nil = (* (* (* (a a))))

@scan_cons = (* ((h t) (dep (pos (best out)))))
  & h ~ $([-40] z)
  & pos ~ $([+1] pos2)
  & z ~ ?((@scan_open @scan_close) (t (dep (pos2 (best out)))))

@scan_open = (t (dep (pos (best out))))
  & dep ~ $([+1] dep2)
  & @scan ~ (t (dep2 (pos (best out))))

@scan_close = (* (t (dep (pos (best out)))))
  & dep ~ ?((@scan_stop @scan_down) (t (pos (best out))))

@scan_stop = (* (* (a a)))

@scan_down = (dep2 (t (pos (best out))))
  & dep2 ~ ?((@scan_zero @scan_more) (t (pos (best out))))

@scan_zero = (t (pos (best out)))
  & pos ~ {p1 p2}
  & best ~ *
  & @scan ~ (t (0 (p1 (p2 out))))

@scan_more = (dep3 (t (pos (best out))))
  & @scan ~ (t (dep3 (pos (best out))))
