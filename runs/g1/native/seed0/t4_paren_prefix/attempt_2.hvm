// Longest balanced prefix: track current depth, position, and last position
// at which the depth returned to zero.
@prog = (l out)
  & @scan ~ (l (0 (0 (0 out))))

@scan = ((?((@scan_nil @scan_cons) (pl (dep (pos (best out))))) pl) (dep (pos (best out))))

@scan_nil = (* (* (* (a a))))

@scan_cons = (* ((h t) (dep (pos (best out)))))
  & h ~ $([=] $(40 z))
  & z ~ ?((@scan_close @scan_open) (t (dep (pos (best out)))))

@scan_open = (* (t (dep (pos (best out)))))
  & dep ~ $([+1] dep2)
  & pos ~ $([+1] pos2)
  & @scan ~ (t (dep2 (pos2 (best out))))

@scan_close = (t (dep (pos (best out))))
  & dep ~ ?((@scan_stop @scan_down) (t (pos (best out))))

@scan_stop = (* (* (a a)))

@scan_down = (dep (t (pos (best out))))
  & pos ~ $([+1] pos2)
  & dep ~ ?((@scan_zero @scan_more) (t (pos2 (best out))))

@scan_zero = (t (pos (best out)))
  & pos ~ {p1 p2}
  & best ~ *
  & @scan ~ (t (0 (p1 (p2 out))))

@scan_more = (dep2 (t (pos (best out))))
  & dep2 ~ $([+1] dep3)
  & @scan ~ (t (dep3 (pos (best out))))
