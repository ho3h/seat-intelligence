// Initialize colors to zero, then examine every vertex.
@prog = ((n edges) out)
  & n ~ {n_fill n_roots}
  & @fill ~ (n_fill colors)
  & @roots ~ (0 (n_roots (edges (colors (0 out))))

@fill = (n out)
  & n ~ ?((@fill_zero @fill_succ) out)

@fill_zero = (z out)
  & z ~ *
  & out ~ (0 *)

@fill_succ = (k out)
  & @fill ~ (k tail)
  & out ~ (1 (0 tail))

// Get an element from a list by index.
@get = (idx (lst out))
  & lst ~ (
      ?((@get_nil @get_cons) (payload (idx out)))
      payload
    )

@get_nil = (z (payload (idx out)))
  & z ~ *
  & payload ~ *
  & idx ~ *
  & out ~ 0

@get_cons = (z ((head tail) (idx out)))
  & z ~ *
  & idx ~ ?((@get_here @get_more) ((head tail) out))

@get_here = ((head tail) out)
  & tail ~ *
  & out ~ head

@get_more = (k ((head tail) out))
  & head ~ *
  & @get ~ (k (tail out))

// Replace an element in a list by index.
@put = (idx (val (lst out)))
  & lst ~ (
      ?((@put_nil @put_cons) (payload (idx (val out))))
      payload
    )

@put_nil = (z (payload (idx (val out))))
  & z ~ *
  & payload ~ *
  & idx ~ *
  & val ~ *
  & out ~ (0 *)

@put_cons = (z ((head tail) (idx (val out))))
  & z ~ *
  & idx ~ ?((@put_here @put_more) ((head tail) (val out)))

@put_here = ((head tail) (val out))
  & head ~ *
  & out ~ (1 (val tail))

@put_more = (k ((head tail) (val out)))
  & @put ~ (k (val (tail tailout)))
  & out ~ (1 (head tailout))

// Traverse the pending vertex stack.
@walk = (queue (edges (colors (good out))))
  & queue ~ (
      ?((@walk_nil @walk_cons) (payload (edges (colors (good out)))))
      payload
    )

@walk_nil = (z (payload (edges (colors (good out))))
  & z ~ *
  & payload ~ *
  & edges ~ *
  & out ~ (colors good)

@walk_cons = (z (((v c) tail) (edges (colors (good out)))))
  & z ~ *
  & edges ~ {edges_scan edges_next}
  & @scan ~ (edges_scan (v (c (tail (colors (good scanout)))))
  & scanout ~ (stack2 (colors2 good2))
  & @walk ~ (stack2 (edges_next (colors2 (good2 out))))

// Scan all edges for neighbors of the current vertex.
@scan = (edges (v (c (stack (colors (good out)))))
  & edges ~ (
      ?((@scan_nil @scan_cons) (payload (v (c (stack (colors (good out))))))
      payload
    )

@scan_nil = (z (payload (v (c (stack (colors (good out))))))
  & z ~ *
  & payload ~ *
  & v ~ *
  & c ~ *
  & out ~ (stack (colors good))

@scan_cons = (z (((u w) tail) (v (c (stack (colors (good out)))))))
  & z ~ *
  & u ~ {u_cmp u_keep}
  & v ~ {v_cmp v_keep}
  & u_cmp ~ $([=] $(v_cmp eq))
  & eq ~ ?(
      (@scan_u_no @scan_u_yes)
      (w (u_keep (v_keep (c (tail (stack (colors (good out))))))))
    )

@scan_u_yes = (z (w (u (v (c (tail (stack (colors (good out)))))))))
  & z ~ *
  & u ~ *
  & @neighbor ~ (w (v (c (tail (stack (colors (good out)))))))

@scan_u_no = (z (w (u (v (c (tail (stack (colors (good out)))))))))
  & z ~ *
  & u ~ *
  & w ~ {w_cmp w_keep}
  & v ~ {v_cmp v_keep}
  & w_cmp ~ $([=] $(v_cmp eq2))
  & eq2 ~ ?(
      (@scan_w_no @scan_w_yes)
      (w_keep (v_keep (c (tail (stack (colors (good out))))))
    )

@scan_w_no = (z (w (v (c (tail (stack (colors (good out))))))))
  & z ~ *
  & w ~ *
  & @scan ~ (tail (v (c (stack (colors (good out))))))

@scan_w_yes = (z (w (v (c (tail (stack (colors (good out))))))))
  & z ~ *
  & @neighbor ~ (w (v (c (tail (stack (colors (good out)))))))

// Color an unvisited neighbor, or detect a conflicting color.
@neighbor = (nb (v (c (tail (stack (colors (good out))))))
  & nb ~ {nb_get nb_keep}
  & colors ~ {colors_get colors_keep}
  & @get ~ (nb_get (colors_get old))
  & old ~ ?(
      (@neighbor_new @neighbor_seen)
      (nb_keep (v (c (tail (stack (colors_keep (good out)))))))
    )

@neighbor_new = (z (nb (v (c (tail (stack (colors (good out))))))))
  & z ~ *
  & nb ~ {nb_put nb_push}
  & c ~ {c_calc c_keep}
  & 3 ~ $([-] $(c_calc opposite))
  & @put ~ (nb_put (opposite (colors colors2)))
  & @scan ~ (tail (v (c_keep ((1 ((nb_push opposite) stack)) (colors2 (good out))))))

@neighbor_seen = (z (nb (v (c (tail (stack (colors (good out))))))))
  & nb ~ *
  & c ~ {c_calc c_keep}
  & 2 ~ $([-] $(c_calc expected_minus_one))
  & expected_minus_one ~ $([=] $(z eq))
  & eq ~ ?(
      (@neighbor_conflict @neighbor_match)
      (v (c_keep (tail (stack (colors (good out))))))
    )

@neighbor_conflict = (z (v (c (tail (stack (colors (good out)))))))
  & z ~ *
  & good ~ *
  & @scan ~ (tail (v (c (stack (colors (0 out))))))

@neighbor_match = (z (v (c (tail (stack (colors (good out)))))))
  & z ~ *
  & @scan ~ (tail (v (c (stack (colors (good out))))))

// Examine vertices in order; start a traversal at each uncolored vertex.
@roots = (i (rem (edges (colors (count out))))
  & rem ~ ?(
      (@roots_done @roots_step)
      (i (edges (colors (count out))))
    )

@roots_done = (z (i (edges (colors (count out)))))
  & z ~ *
  & i ~ *
  & edges ~ *
  & colors ~ *
  & out ~ count

@roots_step = (z (i (edges (colors (count out)))))
  & i ~ {iget ikeep}
  & colors ~ {colors_get colors_keep}
  & @get ~ (iget (colors_get state))
  & state ~ ?(
      (@roots_new @roots_seen)
      (ikeep (z (edges (colors_keep (count out)))))
    )

@roots_seen = (color_minus_one (i (z (edges (colors (count out))))))
  & color_minus_one ~ *
  & i ~ $([+1] inext)
  & @roots ~ (inext (z (edges (colors (count out)))))

@roots_new = (zero (i (z (edges (colors (count out))))))
  & zero ~ *
  & i ~ {i_put {i_start i_inc}}
  & @put ~ (i_put (1 (colors colors2)))
  & edges ~ {edges_walk edges_next}
  & @walk ~ ((1 ((i_start 1) (0 *))) (edges_walk (colors2 (1 walkout))))
  & walkout ~ (colors_final good_result)
  & count ~ $([+] $(good_result count2))
  & @roots ~ (i_inc (z (edges_next (colors_final (count2 out)))))
