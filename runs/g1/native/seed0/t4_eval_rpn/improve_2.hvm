// Evaluate the list with an empty stack.
@prog = (input out)
  & @eval ~ (input (* out))

// Dispatch on the list tag.
@eval = ((?((@eval_nil @eval_cons) (pl (stk out))) pl) (stk out))

// The valid final stack contains one value followed by the empty sentinel.
@eval_nil = (* ((value *) value))

// Dispatch on the token kind.
@eval_cons = (* (((?((@push @operator) (val (tail (stk out)))) val) tail) (stk out))

// Push a number and continue.
@push = (val (tail (stk out)))
  & @eval ~ (tail ((val stk) out))

// Opcode minus 42 is 0 for '*', 1 for '+', and 3 for '-'.
@operator = (* (op (tail ((b (a rest)) out))))
  & op ~ $([-42] code)
  & code ~ ?((@do_mul @decode_pos) (a (b (rest (tail out)))))

// For positive codes, subtract one in the switch: 0 selects '+',
// while a positive value selects '-'.
@decode_pos = (code ctx)
  & code ~ ?((@do_add @do_sub) ctx)

@do_add = (a (b (rest (tail out))))
  & a ~ $([+] $(b result))
  & @eval ~ (tail ((result rest) out))

// The subtraction branch also receives an unused successor value.
@do_sub = (* (a (b (rest (tail out)))))
  & a ~ $([-] $(b result))
  & @eval ~ (tail ((result rest) out))

@do_mul = (a (b (rest (tail out))))
  & a ~ $([*] $(b result))
  & @eval ~ (tail ((result rest) out))
