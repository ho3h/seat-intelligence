// Input: (cluster_id, property_key, clustering, attributes)
// Output: majority value, or 16777215 when there are no matching attributes.
@prog = ((k (key (cl attrs))) out)
  & @scan ~ (attrs (key (k (cl ((0 *) out)))))

@scan = ((?((@a_nil @a_cons) (pl (key (k (cl (hist out)))))) pl) (key (k (cl (hist out)))))

@a_nil = (* (key (k (cl (hist out)))))
  & key ~ *
  & k ~ *
  & cl ~ *
  & @best ~ (hist out)

@a_cons = (* (((node (ak val)) tail) (key (k (cl (hist out))))))
  & key ~ {key_f key_r}
  & k ~ {k_f k_r}
  & cl ~ {cl_f cl_r}
  & @filter ~ ((node (ak val)) (key_f (k_f (cl_f (hist hist2)))))
  & @scan ~ (tail (key_r (k_r (cl_r (hist2 out))))

// Filter an attribute by key and cluster membership.
@filter = ((node (ak val)) (key (k (cl (hist out)))))
  & key ~ $([=] $(ak eq))
  & eq ~ ?((@f_no @f_yes) (node (val (k (cl (hist out))))))

@f_no = (node (val (k (cl (hist out)))))
  & node ~ *
  & val ~ *
  & k ~ *
  & cl ~ *
  & out ~ hist

@f_yes = (* (node (val (k (cl (hist out))))))
  & @get ~ (cl (node got))
  & k ~ $([=] $(got member))
  & member ~ ?((@m_no @m_yes) (val (hist out)))

@m_no = (val (hist out))
  & val ~ *
  & out ~ hist

@m_yes = (* (val (hist out)))
  & @update ~ (hist (val out))

// Return the clustering ID at the given node index.
@get = ((?((@get_nil @get_cons) (pl (idx out))) pl) (idx out))

@get_nil = (* (idx out))
  & idx ~ *
  & out ~ 0

@get_cons = (* ((head tail) (idx out)))
  & idx ~ ?((@get_zero @get_succ) (head (tail out)))

@get_zero = (head (tail out))
  & tail ~ *
  & out ~ head

@get_succ = (idx2 (head (tail out)))
  & head ~ *
  & @get ~ (tail (idx2 out))

// Histogram update. Entries are (value, count).
@update = ((?((@u_nil @u_cons) (pl (v out))) pl) (v out))

@u_nil = (* (v out))
  & out ~ (1 ((v 1) (0 *)))

@u_cons = (* ((x cnt) (tail (v out))))
  & x ~ {x_cmp x_keep}
  & v ~ {v_cmp v_keep}
  & x_cmp ~ $([=] $(v_cmp eq))
  & eq ~ ?((@u_diff @u_same) (x_keep (cnt (tail (v_keep out)))))

@u_diff = (x (cnt (tail (v out))))
  & @update ~ (tail (v tail2))
  & out ~ (1 ((x cnt) tail2))

@u_same = (* (x (cnt (tail (v out)))))
  & cnt ~ $([+1] cnt2)
  & v ~ *
  & out ~ (1 ((x cnt2) tail))

// Find the best histogram entry, starting with the empty-result sentinel.
@best = (hist out)
  & @choose ~ (hist (16777215 (0 out)))

@choose = ((?((@ch_nil @ch_cons) (pl (best (bc out)))) pl) (best (bc out)))

@ch_nil = (* (best (bc out)))
  & bc ~ *
  & out ~ best

@ch_cons = (* ((val cnt) (tail (best (bc out)))))
  & @consider ~ ((val cnt) (best (bc (tail out))))

// Prefer greater counts, then smaller values.
@consider = ((val cnt) (best (bc (tail out))))
  & val ~ {val_lt val_keep}
  & cnt ~ {cnt_gt cnt_rest}
  & cnt_rest ~ {cnt_eq cnt_keep}
  & bc ~ {bc_gt bc_rest}
  & bc_rest ~ {bc_eq bc_keep}
  & best ~ {best_lt best_keep}
  & cnt_gt ~ $([>] $(bc_gt gt))
  & cnt_eq ~ $([=] $(bc_eq eq))
  & val_lt ~ $([<] $(best_lt lt))
  & eq ~ $([&] $(lt eqlt))
  & gt ~ $([|] $(eqlt better))
  & better ~ ?((@keep_old @take_new) (val_keep (cnt_keep (best_keep (bc_keep (tail out)))))

@keep_old = (val (cnt (best (bc (tail out)))))
  & val ~ *
  & cnt ~ *
  & @choose ~ (tail (best (bc out)))

@take_new = (* (val (cnt (best (bc (tail out))))))
  & best ~ *
  & bc ~ *
  & @choose ~ (tail (val (cnt out)))
