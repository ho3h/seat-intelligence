// Entry point: parse into reverse RPN, then reverse once.
@prog = (input output)
  & @expr ~ (input ((0 *) er))
  & er ~ (rest rev)
  & @skip ~ (rest end)
  & end ~ *
  & @reverse ~ (rev ((0 *) reversed))
  & output ~ reversed

// Remove leading spaces.
@skip = ((?((@skip_nil @skip_cons) (pl out)) pl) out)

@skip_nil = (* (0 *))

@skip_cons = (* ((h t) out))
  & h ~ {hc hk}
  & hc ~ $([=] $(32 z))
  & z ~ ?((@skip_keep @skip_space) (hk (t out)))

@skip_keep = (hk (t out))
  & out ~ (1 (hk t))

@skip_space = (* (hk (t out)))
  & hk ~ *
  & @skip ~ (t out)

// Expression parser. The accumulator stores reverse RPN.
@expr = (l (acc out))
  & @term ~ (l (acc tr))
  & tr ~ (rest acc1)
  & @expr_loop ~ ((rest acc1) out)

@expr_loop = ((l acc) out)
  & @skip ~ (l s)
  & @expr_step ~ ((s acc) out)

@expr_step = (((?((@el_nil @el_cons) (pl (acc out))) pl) acc) out)

@el_nil = (* (acc ((0 *) acc)))

@el_cons = (* ((h t) (acc out)))
  & h ~ {hc hk}
  & hc ~ $([=] $(43 z))
  & z ~ ?((@el_done @el_plus) (hk (t (acc out))))

@el_done = (hk (t (acc ((1 (hk t)) acc))))

@el_plus = (* (hk (t (acc out))))
  & hk ~ *
  & @term ~ (t (acc tr))
  & tr ~ (rest acc1)
  & @expr_loop ~ ((rest (1 ((1 43) acc1))) out)

// Term parser.
@term = (l (acc out))
  & @factor ~ (l (acc fr))
  & fr ~ (rest acc1)
  & @term_loop ~ ((rest acc1) out)

@term_loop = ((l acc) out)
  & @skip ~ (l s)
  & @term_step ~ ((s acc) out)

@term_step = (((?((@tl_nil @tl_cons) (pl (acc out))) pl) acc) out)

@tl_nil = (* (acc ((0 *) acc)))

@tl_cons = (* ((h t) (acc out)))
  & h ~ {hc hk}
  & hc ~ $([=] $(42 z))
  & z ~ ?((@tl_done @tl_star) (hk (t (acc out))))

@tl_done = (hk (t (acc ((1 (hk t)) acc))))

@tl_star = (* (hk (t (acc out))))
  & hk ~ *
  & @factor ~ (t (acc fr))
  & fr ~ (rest acc1)
  & @term_loop ~ ((rest (1 ((1 42) acc1))) out)

// Factor parser.
@factor = (l (acc out))
  & @skip ~ (l s)
  & @factor_dispatch ~ (s (acc out))

@factor_dispatch = ((?((@fd_nil @fd_cons) (pl (acc out))) pl) (acc out))

@fd_nil = (* (acc ((0 *) acc)))

@fd_cons = (* ((h t) (acc out)))
  & h ~ {hc hk}
  & hc ~ $([=] $(40 z))
  & z ~ ?((@fd_number @fd_group) (hk (t (acc out))))

@fd_number = (hk (t (acc out)))
  & @digits ~ ((1 (hk t)) (0 dr))
  & dr ~ (rest val)
  & out ~ (rest (1 ((0 val) acc)))

@fd_group = (* (hk (t (acc out))))
  & hk ~ *
  & @expr ~ (t (acc er))
  & er ~ (mid acc1)
  & @drop1 ~ (mid rest)
  & out ~ (rest acc1)

// Consume the closing parenthesis.
@drop1 = ((?((@drop_nil @drop_cons) (pl out)) pl) out)

@drop_nil = (* (0 *))

@drop_cons = (* ((h t) out))
  & h ~ *
  & out ~ t

// Read decimal digits using a running numeric accumulator.
@digits = ((?((@dig_nil @dig_cons) (pl (acc out))) pl) (acc out))

@dig_nil = (* (acc ((0 *) acc)))

@dig_cons = (* ((h t) (acc out)))
  & h ~ {hc hk}
  & hc ~ $([<] $(48 z))
  & z ~ ?((@dig_more @dig_stop) (hk (t (acc out))))

@dig_stop = (* (hk (t (acc ((1 (hk t)) acc)))))

@dig_more = (hk (t (acc out)))
  & hk ~ $([-] $(48 digit))
  & acc ~ $([*10] prod)
  & prod ~ $([+] $(digit next))
  & @digits ~ (t (next out))

// Reverse a list.
@reverse = ((?((@rv_nil @rv_cons) (pl (acc out))) pl) (acc out))

@rv_nil = (* (acc acc))

@rv_cons = (* ((h t) (acc out)))
  & @reverse ~ (t ((1 (h acc)) out))
