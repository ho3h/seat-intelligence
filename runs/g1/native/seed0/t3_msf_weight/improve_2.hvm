// Initialize one distinct component label per vertex, sort the edges, then run Kruskal.
@prog = ((n edges) out)
  & @init ~ (n labels)
  & @sort ~ (edges sorted)
  & @go ~ (sorted (labels (0 out)))

@init = (n out)
  & n ~ ?((@init_zero @init_succ) out)

@init_zero = (* out)

@init_succ = (nm out)
  & nm ~ {n1 n2}
  & @init ~ (n1 rest)
  & out ~ (1 (n2 rest))

// Merge-sort a list of edges.
@sort = ((tag payload) out)
  & tag ~ ?((@sort_nil @sort_cons) (payload out))

@sort_nil = (* (payload out))
  & payload ~ *
  & out ~ (0 *)

@sort_cons = (* ((h (tt tp)) out))
  & tt ~ ?((@sort_last @sort_many) (tp (h out)))

@sort_last = (tp (h out))
  & tp ~ *
  & out ~ (1 (h (0 *)))

@sort_many = (* ((x xs) (h out)))
  & @split ~ ((1 (h (1 (x xs)))) ((0 *) ((0 *) (0 (left right)))))
  & @sort ~ (left sl)
  & @sort ~ (right sr)
  & @merge ~ (sl (sr out))

// Split a list alternately into two reversed lists.
@split = ((?((@split_nil @split_cons) (payload (accL (accR (flag out))))) payload)
          (accL (accR (flag out))))

@split_nil = (* (payload (accL (accR (flag out)))))
  & payload ~ *
  & flag ~ *
  & out ~ (accL accR)

@split_cons = (* ((h t) (accL (accR (flag out)))))
  & flag ~ ?((@split_putleft @split_putright) (h (t (accL (accR out))))

@split_putleft = (h (t (accL (accR out))))
  & @split ~ (t ((1 (h accL)) (accR (1 out)))

@split_putright = (* (h (t (accL (accR out)))))
  & @split ~ (t (accL ((1 (h accR)) (0 out))))

// Merge two edge lists already sorted by weight.
@merge = ((tagA payA) ((tagB payB) out))
  & tagA ~ ?((@merge_a_nil @merge_a_cons) (payA ((tagB payB) out)))

@merge_a_nil = (* (payA ((tagB payB) out)))
  & payA ~ *
  & out ~ (tagB payB)

@merge_a_cons = (* ((ea ta) ((tagB pb) out)))
  & tagB ~ ?((@merge_b_nil @merge_b_cons) (pb ((ea ta) out)))

@merge_b_nil = (* (pb ((ea ta) out)))
  & pb ~ *
  & out ~ (1 (ea ta))

@merge_b_cons = (* ((eb tb) ((ea ta) out)))
  & ea ~ (u (v wa))
  & eb ~ (x (y wb))
  & wa ~ {wa1 wa2}
  & wb ~ {wb1 wb2}
  & wa1 ~ $([<] $(wb1 flag))
  & flag ~ ?((@merge_take_b @merge_take_a)
              (u (v (wa2 (x (y (wb2 (ta (tb out))))))))

@merge_take_b = (u (v (wa (x (y (wb (ta (tb out))))))))
  & @merge ~ ((1 ((u (v wa)) ta)) (tb rest))
  & out ~ (1 ((x (y wb)) rest))

@merge_take_a = (* (u (v (wa (x (y (wb (ta (tb out)))))))))
  & @merge ~ (ta ((1 ((x (y wb)) tb)) rest))
  & out ~ (1 ((u (v wa)) rest))

// Look up the label at index idx in a list.
@at = (idx ((tag payload) out))
  & tag ~ ?((@at_nil @at_list_cons) (payload (idx out)))

@at_nil = (* (idx out))
  & idx ~ *
  & out ~ 0

@at_list_cons = (* ((h t) (idx out)))
  & idx ~ ?((@at_here @at_more) (h (t out)))

@at_here = (h (t out))
  & t ~ *
  & out ~ h

@at_more = (idxm (h (t out)))
  & h ~ *
  & @at ~ (idxm (t out))

// Replace every occurrence of old with new in a label list.
@replace = ((tag payload) (old (new out)))
  & tag ~ ?((@rp_nil @rp_cons) (payload (old (new out))))

@rp_nil = (* (old (new out)))
  & old ~ *
  & new ~ *
  & out ~ (0 *)

@rp_cons = (* ((h t) (old (new out))))
  & h ~ {hc hh}
  & old ~ {oc oldkeep}
  & hc ~ $([=] $(oc eq))
  & eq ~ ?((@rp_no @rp_yes) (hh (t (oldkeep (new out)))))

@rp_no = (h (t (old (new out))))
  & @replace ~ (t (old (new rest)))
  & out ~ (1 (h rest))

@rp_yes = (* (h (t (old (new out)))))
  & h ~ *
  & new ~ {nrec nhead}
  & @replace ~ (t (old (nrec rest)))
  & out ~ (1 (nhead rest))

// Process the sorted edges.
@go = ((tag payload) (labels (acc out)))
  & tag ~ ?((@go_nil @go_cons) (payload (labels (acc out))))

@go_nil = (* (labels (acc out)))
  & labels ~ *
  & out ~ acc

@go_cons = (* ((h t) (labels (acc out))))
  & @process ~ (h (labels (acc (t out))))

// Join the endpoint components when they differ.
@process = ((u (v w)) (labels (acc (rest out))))
  & labels ~ {la more}
  & more ~ {lb lc}
  & @at ~ (u (la lu))
  & @at ~ (v (lb lv))
  & @decision ~ (w (lu (lv (lc (acc (rest out))))))

@decision = (w (lu (lv (labels (acc (rest out))))))
  & lu ~ {lu_cmp lu_keep}
  & lv ~ {lv_cmp lv_keep}
  & lu_cmp ~ $([=] $(lv_cmp eq))
  & eq ~ ?((@different @samecomp) (w (lu_keep (lv_keep (labels (acc (rest out)))))))

@different = (w (lu (lv (labels (acc (rest out))))))
  & @replace ~ (labels (lv (lu newlabels)))
  & acc ~ $([+] $(w acc2))
  & @go ~ (rest (newlabels (acc2 out)))

@samecomp = (* (w (lu (lv (labels (acc (rest out)))))))
  & w ~ *
  & lu ~ *
  & lv ~ *
  & @go ~ (rest (labels (acc out)))
