@prog = (input output)
  & input ~ (tau cands)
  & @filter ~ (cands (tau output))

@filter = ((?((@filter_nil @filter_cons) (pl (tau out))) pl) (tau out))

@filter_nil = (* (tau out))
  & tau ~ *
  & out ~ (0 *)

@filter_cons = (* (((u (v score)) tail) (tau out)))
  & tau ~ $([>] $(score gt))
  & gt ~ ?((@filter_keep @filter_drop) ((u (v score)) (tail (tau out))))

@filter_keep = ((u (v score)) (tail (tau out)))
  & @filter ~ (tail (tau rest))
  & out ~ (1 ((u (v score)) rest))

@filter_drop = (* (* (tail (tau out))))
  & @filter ~ (tail (tau out))
