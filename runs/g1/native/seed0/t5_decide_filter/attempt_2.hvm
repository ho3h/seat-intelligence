@prog = (input output)
  & input ~ (tau cands)
  & @filter ~ (cands (tau output))

@filter = ((?((@filter_nil @filter_cons) (pl (tau out))) pl) (tau out))

@filter_nil = (* (tau out))
  & tau ~ *
  & out ~ (0 *)

@filter_cons = (* (((u (v {score_cmp score_keep})) tail) ({tau_cmp tau_rec} out)))
  & tau_cmp ~ $([>] $(score_cmp gt))
  & gt ~ ?((@filter_keep @filter_drop) ((u (v score_keep)) (tail (tau_rec out))))

@filter_keep = ((u (v score)) (tail (tau out)))
  & @filter ~ (tail (tau rest))
  & out ~ (1 ((u (v score)) rest))

@filter_drop = (* (* (tail (tau out))))
  & @filter ~ (tail (tau out))
