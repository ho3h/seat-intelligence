// t3_dag_longest (GRAPH-SWING, runs/exp5): the DAG recursion  len(u) = max(0, max over u->v of len(v)+1)  is built
// directly as a dataflow net. Each vertex value is a wire; its consumers are reached by a DUP multicast chain
// (request trie Q, one reply wire per edge), each vertex's max-accumulator is a leaf of trie A. Streaming the edge
// list builds both by pre-expanded keyed updates; fin wires A's leaf u into Q's chain u (value -> its consumers) and
// the end of every chain into a max-reduction. No rounds and no global synchronisation: values ripple along the DAG.
@prog = ((n es) out)
  & n ~ ?((@dl_zero @dl_pos) (es out))
@dl_zero = (* 0)
@dl_pos = (nm1 (es out))
  & @lg ~ (nm1 L)
  & L ~ {L1 {L2 L3}}
  & @zt ~ (L1 A0)
  & @zq ~ (L2 Q0)
  & @w_blk ~ (es ((L3 (A0 Q0)) out))
@dl_step = ((L (A Q)) ((u v) (L3 (A2 Q2))))
  & L ~ {L1 {L2 L3}}
  & @pu ~ (Q (v (L1 (x Q2))))
  & x ~ $([+1] x1)
  & @mx ~ (A (u (L2 (x1 A2))))
@dl_fin = ((L (A Q)) o)
  & @zx ~ (A (Q (L o)))
// max-update act
@mx_act = (old (c o))
  & old ~ {o1 o2}
  & c ~ {k1 k2}
  & k1 ~ $([<] $(o1 lt))
  & lt ~ ?((@sel2 @sel1s) (o2 (k2 o)))
// selectors on a switch context (a (b o)): Z-branch forms and S-branch forms
@sel1 = (x (* x))
@sel2 = (* (y y))
@sel1s = (* (x (* x)))
@sel2s = (* (* (y y)))
@pu_act = ((i o) (x (i o2)))
  & o ~ {x o2}
// zx(A, Q, L): wire each accumulator into its multicast chain; max-reduce the chain ends
@zx = (a (q (L o)))
  & L ~ ?((@zx_leaf @zx_node) (a (q o)))
@zx_leaf = (a ((a o) o))
@zx_node = (lm ((a1 a2) ((q1 q2) o)))
  & lm ~ {l1 l2}
  & @zx ~ (a1 (q1 (l1 x)))
  & @zx ~ (a2 (q2 (l2 y)))
  & x ~ {x1 x2}
  & y ~ {y1 y2}
  & x1 ~ $([<] $(y1 lt))
  & lt ~ ?((@sel1 @sel2s) (x2 (y2 o)))
@zq = (?(((y y) @zq_node) o) o)
@zq_node = (lm (a b))
  & lm ~ {l1 l2}
  & @zq ~ (l1 a)
  & @zq ~ (l2 b)
@w_blk = (t (S0 o0))
  & t ~ (T1 (E1 (T2 (E2 (T3 (E3 (T4 (E4 (T5 (E5 (T6 (E6 (T7 (E7 (T8 (E8 (T9 (E9 (T10 (E10 (T11 (E11 (T12 (E12 (T13 (E13 (T14 (E14 (T15 (E15 (T16 (E16 t16))))))))))))))))))))))))))))))))
  & T1 ~ ?((@w_nil @w_cons) (S0 (o0 (E1 (S1 o1)))))
  & T2 ~ ?((@w_nil @w_cons) (S1 (o1 (E2 (S2 o2)))))
  & T3 ~ ?((@w_nil @w_cons) (S2 (o2 (E3 (S3 o3)))))
  & T4 ~ ?((@w_nil @w_cons) (S3 (o3 (E4 (S4 o4)))))
  & T5 ~ ?((@w_nil @w_cons) (S4 (o4 (E5 (S5 o5)))))
  & T6 ~ ?((@w_nil @w_cons) (S5 (o5 (E6 (S6 o6)))))
  & T7 ~ ?((@w_nil @w_cons) (S6 (o6 (E7 (S7 o7)))))
  & T8 ~ ?((@w_nil @w_cons) (S7 (o7 (E8 (S8 o8)))))
  & T9 ~ ?((@w_nil @w_cons) (S8 (o8 (E9 (S9 o9)))))
  & T10 ~ ?((@w_nil @w_cons) (S9 (o9 (E10 (S10 o10)))))
  & T11 ~ ?((@w_nil @w_cons) (S10 (o10 (E11 (S11 o11)))))
  & T12 ~ ?((@w_nil @w_cons) (S11 (o11 (E12 (S12 o12)))))
  & T13 ~ ?((@w_nil @w_cons) (S12 (o12 (E13 (S13 o13)))))
  & T14 ~ ?((@w_nil @w_cons) (S13 (o13 (E14 (S14 o14)))))
  & T15 ~ ?((@w_nil @w_cons) (S14 (o14 (E15 (S15 o15)))))
  & T16 ~ ?((@w_nil @w_last) (S15 (o15 (E16 t16))))
@w_nil = (S (o *))
  & @dl_fin ~ (S o)
@w_cons = (* (S (o (E (S2 o)))))
  & @dl_step ~ (S (E S2))
@w_last = (* (S (o (E t))))
  & @dl_step ~ (S (E S2))
  & @w_blk ~ (t (S2 o))
@pu = (t (k (L (P o))))
  & L ~ ?((@pu_leaf @pu_node) (t (k (P o))))
@pu_leaf = (t (* (P o)))
  & @pu_act ~ (t (P o))
@pu_node = (lm (t (k (P o))))
  & k ~ {k1 k2}
  & lm ~ {l1 l2}
  & k1 ~ $([>>] $(l1 sh))
  & sh ~ $([&] $(1 b))
  & b ~ ?((@pu_L @pu_R) (t (k2 (l2 (P o)))))
@pu_L = ((l r) (k (L (P (l2 r)))))
  & @pu ~ (l (k (L (P l2))))
@pu_R = (* ((l r) (k (L (P (l r2))))))
  & @pu ~ (r (k (L (P r2))))
@mx = (t (k (L (P o))))
  & L ~ ?((@mx_leaf @mx_node) (t (k (P o))))
@mx_leaf = (t (* (P o)))
  & @mx_act ~ (t (P o))
@mx_node = (lm (t (k (P o))))
  & k ~ {k1 k2}
  & lm ~ {l1 l2}
  & k1 ~ $([>>] $(l1 sh))
  & sh ~ $([&] $(1 b))
  & b ~ ?((@mx_L @mx_R) (t (k2 (l2 (P o)))))
@mx_L = ((l r) (k (L (P (l2 r)))))
  & @mx ~ (l (k (L (P l2))))
@mx_R = (* ((l r) (k (L (P (l r2))))))
  & @mx ~ (r (k (L (P r2))))
// ---- shared trie primitives (depth-L complete binary trie, leaves are numbers, keyed by bits of the key, high bit first)
// lg(x) = number of bits of x (0 for 0): trie depth for keys 0..x
@lg = (?((0 @lg_s) o) o)
@lg_s = (xm o)
  & xm ~ $([+1] x)
  & x ~ $([>>] $(1 y))
  & @lg ~ (y z)
  & z ~ $([+1] o)

// zt(L): trie of depth L with all leaves 0
@zt = (?((0 @zt_node) o) o)
@zt_node = (lm (a b))
  & lm ~ {l1 l2}
  & @zt ~ (l1 a)
  & @zt ~ (l2 b)

// cnt(t, L): sum of the leaves
@cnt = (t (L o))
  & L ~ ?((@cnt_leaf @cnt_node) (t o))
@cnt_leaf = (x x)
@cnt_node = (lm ((a b) o))
  & lm ~ {l1 l2}
  & @cnt ~ (a (l1 x))
  & @cnt ~ (b (l2 y))
  & x ~ $([+] $(y o))

// ins(t, k, L): set leaf k to 1. Control flow depends on k and L only, so it expands before t exists.
@ins = (t (k (L o)))
  & L ~ ?((@ins_leaf @ins_node) (t (k o)))
@ins_leaf = (* (* 1))
@ins_node = (lm (t (k o)))
  & k ~ {k1 k2}
  & lm ~ {l1 l2}
  & k1 ~ $([>>] $(l1 sh))
  & sh ~ $([&] $(1 b))
  & b ~ ?((@ins_L @ins_R) (t (k2 (l2 o))))
@ins_L = ((l r) (k (L (l2 r))))
  & @ins ~ (l (k (L l2)))
@ins_R = (* ((l r) (k (L (l r2)))))
  & @ins ~ (r (k (L r2)))
