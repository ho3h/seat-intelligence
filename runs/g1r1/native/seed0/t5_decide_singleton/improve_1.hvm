// Task: t5_decide_singleton

@prog = (input output)
  & input ~ (tau probs)
  & @s0 ~ (probs (tau output))

@s0 = ((?((@s0_nil @s0_cons) (pl (tau out))) pl) (tau out))

@s0_nil = (* (* 6))

@s0_cons = (* ((h t) (tau out)))
  & @s1 ~ (t (h (0 (tau out))))

@s1 = ((?((@s1_nil @s1_cons) (pl (best (idx (tau out))))) pl) (best (idx (tau out))))

@s1_nil = (* (best (idx (tau out))))
  & @final ~ (best (idx (tau out)))

@s1_cons = (* ((h t) (best (idx (tau out)))))
  & h ~ {h_cmp h_save}
  & best ~ {b_cmp b_save}
  & h_cmp ~ $([>] $(b_cmp gt))
  & gt ~ ?((@s1_keep @s1_update) (h_save (b_save (t (idx (tau out))))))

@s1_keep = (h (b (t (idx (tau out)))))
  & h ~ *
  & @s2 ~ (t (b (idx (tau out))))

@s1_update = (* (h (b (t (idx (tau out))))))
  & b ~ *
  & idx ~ *
  & @s2 ~ (t (h (1 (tau out))))

