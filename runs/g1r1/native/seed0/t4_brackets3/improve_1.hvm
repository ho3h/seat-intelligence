@prog = (input out)
  & @scan ~ (input ((0 *) (0 out)))

@scan = ((?((@scan_nil @scan_cons) (payload (stack (i out)))) payload) (stack (i out)))

@scan_nil = (payload (stack (i out)))
  & payload ~ *
  & @end ~ (stack (i out))

@scan_cons = (* ((h t) (stack (i out))))
  & @dispatch ~ (h (t (stack (i out))))

@end = ((?((@end_empty @end_nonempty) (payload (i out))) payload) (i out))

@end_empty = (payload (i out))
  & payload ~ *
  & i ~ *
  & out ~ 0

@end_nonempty = (* (payload (i out)))
  & payload ~ *
  & i ~ $([+1] out)

@dispatch = (h (t (stack (i out))))
  & h ~ {h1 h2}
  & h1 ~ $([<] $(60 z))
  & z ~ ?((@dispatch_ge60 @paren) (h2 (t (stack (i out)))))

@dispatch_ge60 = (h (t (stack (i out))))
  & h ~ {h1 h2}
  & h1 ~ $([<] $(110 z))
  & z ~ ?((@curly @square) (h2 (t (stack (i out)))))

@paren = (h (t (stack (i out))))
  & h ~ {h1 h2}
  & h1 ~ $([=] $(40 z))
  & z ~ ?((@paren_close @paren_open) (h2 (t (stack (i out)))))

@paren_open = (* (h (t (stack (i out)))))
  & h ~ *
  & @scan ~ (t ((1 (41 stack)) (i1 out)))
  & i ~ $([+1] i1)

@paren_close = (h (t (stack (i out))))
  & @close ~ (stack (h (t (i out))))

@square = (h (t (stack (i out))))
  & h ~ {h1 h2}
  & h1 ~ $([=] $(91 z))
  & z ~ ?((@square_close @square_open) (h2 (t (stack (i out)))))

@square_open = (* (h (t (stack (i out)))))
  & h ~ *
  & @scan ~ (t ((1 (93 stack)) (i1 out)))
  & i ~ $([+1] i1)

@square_close = (h (t (stack (i out))))
  & @close ~ (stack (h (t (i out))))

@curly = (h (t (stack (i out))))
  & h ~ {h1 h2}
  & h1 ~ $([=] $(123 z))
  & z ~ ?((@curly_close @curly_open) (h2 (t (stack (i out)))))

@curly_open = (* (h (t (stack (i out)))))
  & h ~ *
  & @scan ~ (t ((1 (125 stack)) (i1 out)))
  & i ~ $([+1] i1)

@curly_close = (h (t (stack (i out))))
  & @close ~ (stack (h (t (i out))))

@close = ((?((@close_empty @close_nonempty) (payload (h (t (i out))))) payload) (h (t (i out))))

@close_empty = (payload (h (t (i out))))
  & payload ~ *
  & h ~ *
  & t ~ *
  & i ~ $([+1] out)

@close_nonempty = (* ((expected rest) (h (t (i out)))))
  & h ~ $([=] $(expected z))
  & z ~ ?((@mismatch @matched) (rest (t (i out))))

@mismatch = (rest (t (i out)))
  & rest ~ *
  & t ~ *
  & i ~ $([+1] out)

@matched = (* (rest (t (i out))))
  & @scan ~ (t (rest (i1 out)))
  & i ~ $([+1] i1)
