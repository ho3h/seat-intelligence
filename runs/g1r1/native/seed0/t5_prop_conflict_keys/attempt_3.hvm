@prog = ((c attrs) out)
  & c ~ {c_full c_iter}
  & @nodes ~ (c_iter (c_full (attrs (0 out))))

@nodes = ((?((@nodes_nil @nodes_cons) (pl (c_full (attrs (idx out))))) pl) (c_full (attrs (idx out))))

@nodes_nil = (* (c_full (attrs (idx out))))
  & c_full ~ *
  & attrs ~ *
  & idx ~ *
  & out ~ (0 *)

@nodes_cons = (* ((cid tail) (c_full (attrs (idx out)))))
  & cid ~ {cid_cmp cid_keep}
  & idx ~ {idx_cmp idx_keep}
  & cid_cmp ~ $([=] $(idx_cmp eq))
  & eq ~ ?((@nodes_notroot @nodes_root) (tail (cid_keep (c_full (attrs (idx_keep out))))))

@nodes_notroot = (tail (cid (c_full (attrs (idx out)))))
  & cid ~ *
  & idx ~ $([+1] ni)
  & @nodes ~ (tail (c_full (attrs (ni out))))

@nodes_root = (* (tail (cid (c_full (attrs (idx out))))))
  & idx ~ $([+1] ni)
  & @keys ~ (cid (0 (c_full (attrs (tail (ni out))))))

@keys = (cid (key (c_full (attrs (tail (idx out))))))
  & key ~ {key_cmp key_keep}
  & key_cmp ~ $([<] $(4 valid))
  & valid ~ ?((@keys_done @keys_test) (cid (key_keep (c_full (attrs (tail (idx out)))))))

@keys_done = (cid (key (c_full (attrs (tail (idx out))))))
  & cid ~ *
  & key ~ *
  & @nodes ~ (tail (c_full (attrs (idx out))))

@keys_test = (* (cid (key (c_full (attrs (tail (idx out)))))))
  & cid ~ {cid_s cid_k}
  & key ~ {key_s key_k}
  & c_full ~ {c_s c_k}
  & attrs ~ {attrs_s attrs_k}
  & @conflict ~ (attrs_s (c_s (cid_s (key_s conf))))
  & conf ~ ?((@keys_no @keys_yes) (cid_k (key_k (c_k (attrs_k (tail (idx out)))))))

@keys_no = (cid (key (c_full (attrs (tail (idx out))))))
  & key ~ $([+1] nk)
  & @keys ~ (cid (nk (c_full (attrs (tail (idx out))))))

@keys_yes = (* (cid (key (c_full (attrs (tail (idx out)))))))
  & cid ~ {cid_out cid_next}
  & key ~ {key_next key_out}
  & key_next ~ $([+1] nk)
  & @keys ~ (cid_next (nk (c_full (attrs (tail (idx rest))))))
  & out ~ (1 ((cid_out key_out) rest))

@conflict = (attrs (c_full (cid (key out))))
  & @scan ~ (attrs (c_full (cid (key (0 (0 (0 out)))))))

@scan = ((?((@scan_nil @scan_cons) (pl (c_full (cid (key (seen (base (found out))))))) pl) (c_full (cid (key (seen (base (found out)))))))

@scan_nil = (* (c_full (cid (key (seen (base (found out)))))))
  & c_full ~ *
  & cid ~ *
  & key ~ *
  & seen ~ *
  & base ~ *
  & out ~ found

@scan_cons = (* (((node (akey val)) tail) (c_full (cid (key (seen (base (found out))))))))
  & c_full ~ {c_nth c_rec}
  & @nth ~ (c_nth (node cval))
  & cid ~ {cid_cmp cid_keep}
  & key ~ {key_cmp key_keep}
  & akey ~ $([=] $(key_cmp eqkey))
  & cval ~ $([=] $(cid_cmp eqcluster))
  & eqkey ~ $([&] $(eqcluster relevant))
  & relevant ~ ?((@scan_irrel @scan_rel) (tail (c_rec (cid_keep (key_keep (seen (base (found (val out))))))))

@scan_irrel = (tail (c_rec (cid (key (seen (base (found (val out))))))))
  & val ~ *
  & @scan ~ (tail (c_rec (cid (key (seen (base (found out)))))))

@scan_rel = (* (tail (c_rec (cid (key (seen (base (found (val out)))))))))
  & seen ~ ?((@scan_first @scan_more) (tail (c_rec (cid (key (base (found (val out))))))))

@scan_first = (tail (c_rec (cid (key (base (found (val out)))))))
  & base ~ *
  & @scan ~ (tail (c_rec (cid (key (1 (val (found out)))))))

@scan_more = (tail (c_rec (cid (key (base (found (val out)))))))
  & base ~ {base_cmp base_keep}
  & val ~ $([!] $(base_cmp diff))
  & found ~ $([|] $(diff nf))
  & @scan ~ (tail (c_rec (cid (key (1 (base_keep (nf out)))))))

@nth = ((?((@nth_nil @nth_cons) (pl (idx out))) pl) (idx out))

@nth_nil = (* (idx out))
  & idx ~ *
  & out ~ 0

@nth_cons = (* ((head tail) (idx out)))
  & idx ~ ?((@nth_here @nth_later) (head (tail out)))

@nth_here = (head (tail out))
  & tail ~ *
  & out ~ head

@nth_later = (idxm (head (tail out)))
  & head ~ *
  & @nth ~ (tail (idxm out))
