@prog = ((n (s edges)) out)
  & n ~ {n_init n_round}
  & @init ~ (n_init (s (0 dist0)))
  & @round ~ (n_round (edges (dist0 out)))

@init = (?((@init_zero @init_succ) ctx) ctx)

@init_zero = (s (i out))
  & s ~ *
  & i ~ *
  & out ~ (0 *)

@init_succ = (k (s (i out)))
  & s ~ {s_eq s_rec}
  & i ~ {i_eq i_rec}
  & s_eq ~ $([=] $(i_eq eq))
  & i_rec ~ $([+1] i_next)
  & @init ~ (k (s_rec (i_next tail)))
  & eq ~ ?((@init_other @init_same) (tail out))

@init_other = (tail out)
  & out ~ (1 (16777215 tail))

@init_same = (* (tail out))
  & out ~ (1 (0 tail))

@round = (?((@round_zero @round_succ) ctx) ctx)

@round_zero = (edges (dist out))
  & edges ~ *
  & out ~ dist

@round_succ = (k (edges (dist out)))
  & edges ~ {edges_now edges_next}
  & @scan ~ (edges_now (dist (0 scanres)))
  & scanres ~ (dist2 changed)
  & changed ~ ?((@round_stop @round_continue) (k (edges_next (dist2 out))))

@round_stop = (k (edges (dist out)))
  & k ~ *
  & edges ~ *
  & out ~ dist

@round_continue = (* (k (edges (dist out))))
  & @round ~ (k (edges (dist out)))

@scan = ((?((@scan_nil @scan_cons) (pl (dist (changed out)))) pl) (dist (changed out)))

@scan_nil = (* (dist (changed out)))
  & out ~ (dist changed)

@scan_cons = (* (((u v) tail) (dist (changed out))))
  & @relax ~ (u (v (dist (changed scanres))))
  & scanres ~ (dist2 changed2)
  & @scan ~ (tail (dist2 (changed2 out)))

@relax = (u (v (dist (changed out))))
  & v ~ {v_get v_set}
  & dist ~ {d1 {d2 d3}}
  & @get ~ (d1 (u du))
  & @get ~ (d2 (v_get dv))
  & du ~ {du_finite du_inc}
  & du_finite ~ $([<] $(16777215 finite))
  & du_inc ~ $([+1] cand)
  & cand ~ {cand_cmp cand_set}
  & cand_cmp ~ $([<] $(dv less))
  & less ~ $([&] $(finite change))
  & change ~ ?((@relax_no @relax_yes) (d3 (v_set (cand_set (changed out))))

@relax_no = (dist (v (cand (changed out))))
  & v ~ *
  & cand ~ *
  & out ~ (dist changed)

@relax_yes = (dist (v (cand (changed out))))
  & changed ~ *
  & @set ~ (dist (v (cand dist2)))
  & out ~ (dist2 1)

@get = ((?((@get_nil @get_cons) (pl (idx out))) pl) (idx out))

@get_nil = (* (* out))
  & out ~ 16777215

@get_cons = (* ((head tail) (idx out)))
  & idx ~ ?((@get_here @get_later) (head (tail out)))

@get_here = (head (tail out))
  & tail ~ *
  & out ~ head

@get_later = (k (head (tail out)))
  & head ~ *
  & @get ~ (tail (k out))

@set = ((?((@set_nil @set_cons) (pl (idx (val out)))) pl) (idx (val out)))

@set_nil = (* (idx (val out)))
  & idx ~ *
  & val ~ *
  & out ~ (0 *)

@set_cons = (* ((head tail) (idx (val out))))
  & idx ~ ?((@set_here @set_later) (head (tail (val out))))

@set_here = (head (tail (val out)))
  & head ~ *
  & out ~ (1 (val tail))

@set_later = (k (head (tail (val out))))
  & @set ~ (tail (k (val tail2)))
  & out ~ (1 (head tail2))
