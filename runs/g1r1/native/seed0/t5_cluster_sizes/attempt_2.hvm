// Construct the label list [0, 1, ..., n-1].
@init = (n (id out))
  & n ~ ?((@init_nil @init_cons) (id out))

@init_nil = (id out)
  & id ~ *
  & out ~ (0 *)

@init_cons = (* (remaining (id out)))
  & id ~ {id_head id_inc}
  & id_inc ~ $([+1] nextid)
  & @init ~ (remaining (nextid tail))
  & out ~ (1 (id_head tail))

// Scan each edge once, merging the two components by keeping the larger label.
@scan = ((?((@scan_nil @scan_cons) (pl (labels out))) pl) (labels out))

@scan_nil = (pl (labels out))
  & pl ~ *
  & labels ~ out

@scan_cons = (* (pl (labels out)))
  & pl ~ (edge tail)
  & edge ~ (u v)
  & labels ~ {labels_u labels_rest}
  & labels_rest ~ {labels_v labels_work}
  & @get ~ (u (labels_u a))
  & @get ~ (v (labels_v b))
  & a ~ {a_eq a_keep}
  & b ~ {b_eq b_keep}
  & a_eq ~ $([=] $(b_eq same))
  & same ~ ?((@scan_diff @scan_same) (a_keep (b_keep (labels_work (tail out))))

@scan_same = (a (b (labels (tail out))))
  & a ~ *
  & b ~ *
  & @scan ~ (tail (labels out))

@scan_diff = (a (b (labels (tail out))))
  & a ~ {a_test a_saved}
  & b ~ {b_test b_saved}
  & a_test ~ $([>] $(b_test gt))
  & gt ~ ?((@scan_low @scan_high) (a_saved (b_saved (labels (tail out))))

// If a <= b, replace a with b; otherwise replace b with a.
@scan_low = (a (b (labels (tail out))))
  & @replace ~ (a (b (labels updated)))
  & @scan ~ (tail (updated out))

@scan_high = (a (b (labels (tail out))))
  & @replace ~ (b (a (labels updated)))
  & @scan ~ (tail (updated out))

// Replace every occurrence of old with new in a list.
@replace = (old (new ((?((@replace_nil @replace_cons) (old (new (pl out)))) pl) out)))

@replace_nil = (old (new (pl out)))
  & old ~ *
  & new ~ *
  & pl ~ *
  & out ~ (0 *)

@replace_cons = (* (old (new (pl out))))
  & pl ~ (h tail)
  & old ~ {old_test old_rec}
  & new ~ {new_pick new_rec}
  & h ~ {h_test h_keep}
  & h_test ~ $([=] $(old_test eq))
  & eq ~ ?((@rep_not @rep_yes) (h_keep (new_pick (old_rec (new_rec (tail out))))))

@rep_not = (h (new (old (oldrec (newrec (tail out))))))
  & new ~ *
  & @replace ~ (old (new (tail tailout)))
  & out ~ (1 (h tailout))

@rep_yes = (h (new (old (oldrec (newrec (tail out))))))
  & h ~ *
  & @replace ~ (old (new (tail tailout)))
  & out ~ (1 (new tailout))

// Look up the list element at a valid index.
@get = (idx (list out))
  & idx ~ ?((@get_zero @get_succ) (list out))

@get_zero = (list out)
  & list ~ (tag payload)
  & tag ~ *
  & payload ~ (head tail)
  & tail ~ *
  & head ~ out

@get_succ = (* (idx (list out)))
  & list ~ (tag payload)
  & tag ~ *
  & payload ~ (head tail)
  & head ~ *
  & @get ~ (idx (tail out))

// Count occurrences of target in a list.
@freq = (target ((?((@freq_nil @freq_cons) (target (pl (acc out)))) pl) (acc out)))

@freq_nil = (target (pl (acc out)))
  & target ~ *
  & pl ~ *
  & acc ~ out

@freq_cons = (* (target (pl (acc out))))
  & pl ~ (h tail)
  & target ~ {target_test target_rec}
  & h ~ $([=] $(target_test eq))
  & eq ~ ?((@freq_no @freq_yes) (target_rec (tail (acc out))))

@freq_no = (target (tail (acc out)))
  & @freq ~ (target (tail (acc out)))

@freq_yes = (* (target (tail (acc out))))
  & acc ~ $([+1] acc_next)
  & @freq ~ (target (tail (acc_next out)))

// Visit candidate labels from largest to smallest; prepending on unwind
// yields output ordered by ascending canonical cluster id.
@emit = (remaining (labels out))
  & remaining ~ ?((@emit_nil @emit_cons) (labels out))

@emit_nil = (labels out)
  & labels ~ *
  & out ~ (0 *)

@emit_cons = (* (id (labels out)))
  & id ~ {id_freq id_rec}
  & labels ~ {labels_freq labels_rec}
  & @freq ~ (id_freq (labels_freq (0 count)))
  & @emit ~ (id_rec (labels_rec rest))
  & count ~ {count_test count_value}
  & count_test ~ ?((@emit_skip @emit_add) (count_value (rest out)))

@emit_skip = (count (rest out))
  & count ~ *
  & rest ~ out

@emit_add = (* (count (rest out)))
  & out ~ (1 (count rest))

@prog = (n (edges out))
  & n ~ {n_init n_emit}
  & @init ~ (n_init (0 labels))
  & @scan ~ (edges (labels scanned))
  & @emit ~ (n_emit (scanned out))
