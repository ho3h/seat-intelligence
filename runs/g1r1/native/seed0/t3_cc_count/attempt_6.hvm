// Build labels [0, 1, ..., n-1], then relax each edge for n rounds.
@prog = ((n edges) out)
  & n ~ {n_init n_round}
  & @init ~ (n_init labs)
  & @round ~ (n_round (edges (labs out)))

@init = (n out)
  & n ~ ?((@init_zero @init_succ) out)

@init_zero = out
  & out ~ (0 *)

@init_succ = (k out)
  & k ~ {kr kv}
  & @init ~ (kr mid)
  & @append ~ (mid (kv out))

// Append a number to the end of a list.
@append = ((?((@append_nil @append_cons) (pl (v out))) pl) (v out))

@append_nil = (* (v out))
  & out ~ (1 (v (0 *)))

@append_cons = (* ((h t) (v out)))
  & @append ~ (t (v tail))
  & out ~ (1 (h tail))

// Read the value at index i, returning (rebuilt_list, value).
@get = ((?((@get_nil @get_cons) (pl (i out))) pl) (i out))

@get_nil = (* (i out))
  & i ~ *
  & out ~ ((0 *) 0)

@get_cons = (* ((h t) (i out)))
  & i ~ ?((@get_here @get_next) (h (t out)))

@get_here = (h (t out))
  & h ~ {h1 h2}
  & out ~ ((1 (h1 t)) h2)

@get_next = (k (h (t out)))
  & @get ~ (t (k mid))
  & mid ~ (tail val)
  & out ~ ((1 (h tail)) val)

// Replace the value at index i with v.
@set = ((?((@set_nil @set_cons) (pl (i (v out)))) pl) (i (v out)))

@set_nil = (* (i (v out)))
  & i ~ *
  & v ~ *
  & out ~ (0 *)

@set_cons = (* ((h t) (i (v out))))
  & i ~ ?((@set_here @set_next) (h (t (v out))))

@set_here = (h (t (v out)))
  & h ~ *
  & out ~ (1 (v t))

@set_next = (k (h (t (v out))))
  & @set ~ (t (k (v mid)))
  & out ~ (1 (h mid))

// Set two indices to the same value.
@set_both = (labs (u (v (val out))))
  & val ~ {val1 val2}
  & @set ~ (labs (u (val1 mid))
  & @set ~ (mid (v (val2 out)))

// Lower both endpoint labels to their minimum.
@relax = (u (v (labs out)))
  & u ~ {uget uset}
  & v ~ {vget vset}
  & @get ~ (labs (uget m1))
  & m1 ~ (labs1 lu)
  & @get ~ (labs1 (vget m2))
  & m2 ~ (labs2 lv)
  & lu ~ {lu_cmp lu_keep}
  & lv ~ {lv_cmp lv_keep}
  & lu_cmp ~ $([<] $(lv_cmp z))
  & z ~ ?((@relax_ge @relax_lt) (lu_keep (lv_keep (uset (vset (labs2 out))))))

@relax_ge = (lu (lv (u (v (ls out)))))
  & lu ~ *
  & @set_both ~ (ls (u (v (lv out))))

@relax_lt = (* (lu (lv (u (v (ls out))))))
  & lv ~ *
  & @set_both ~ (ls (u (v (lu out))))

// Sweep the edge list, returning the rebuilt list and updated labels.
@sweep = ((?((@sweep_nil @sweep_cons) (pl (labs out))) pl) (labs out))

@sweep_nil = (* (labs out))
  & out ~ ((0 *) labs)

@sweep_cons = (* (((u v) tail) (labs out)))
  & u ~ {ur uk}
  & v ~ {vr vk}
  & @relax ~ (ur (vr (labs mid)))
  & @sweep ~ (tail (mid mid2))
  & mid2 ~ (tail2 labs2)
  & out ~ ((1 ((uk vk) tail2)) labs2)

// Run n sweeps, then count labels equal to their indices.
@round = (n (edges (labs out)))
  & n ~ ?((@round_zero @round_succ) (edges (labs out)))

@round_zero = (edges (labs out))
  & edges ~ *
  & @count ~ (labs (0 out))

@round_succ = (k (edges (labs out)))
  & @sweep ~ (edges (labs mid))
  & mid ~ (edges2 labs2)
  & @round ~ (k (edges2 (labs2 out)))

@count = ((?((@count_nil @count_cons) (pl (i (acc out)))) pl) (i (acc out)))

@count_nil = (* (i (acc out)))
  & i ~ *
  & out ~ acc

@count_cons = (* ((h t) (i (acc out))))
  & i ~ {it ir}
  & h ~ $([=] $(it z))
  & z ~ ?((@count_no @count_yes) (ir (acc (t out))))

@count_no = (i (acc (t out)))
  & i ~ $([+1] i2)
  & @count ~ (t (i2 (acc out)))

@count_yes = (* (i (acc (t out))))
  & i ~ $([+1] i2)
  & acc ~ $([+1] acc2)
  & @count ~ (t (i2 (acc2 out)))
