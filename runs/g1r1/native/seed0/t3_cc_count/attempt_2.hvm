// Build the initial labels 0..n-1, then relax every edge for n rounds.
@prog = ((n edges) out)
  & n ~ {n1 n2}
  & @init ~ (n1 ((0 *) labs))
  & @round ~ (n2 (edges (labs out)))

@init = (n (acc out))
  & n ~ ?((@init_zero @init_succ) (acc out))

@init_zero = (a a)

@init_succ = (k (acc out))
  & k ~ {k1 k2}
  & @init ~ (k1 ((1 (k2 acc)) out))

// Scan a list, rebuilding it and returning the value at target.
// The output is (rebuilt_list, found_value).
@seek = ((?((@seek_nil @seek_cons) (pl (i (target (found out))))) pl) (i (target (found out))))

@seek_nil = (* (i (target (found out))))
  & i ~ *
  & target ~ *
  & out ~ ((0 *) found)

@seek_cons = (* ((h t) (i (target (found out)))))
  & i ~ {ic ir}
  & target ~ {tc tr}
  & h ~ {hv head}
  & ic ~ $([=] $(tc z))
  & z ~ ?((@seek_no @seek_yes) (hv (t (ir (tr (found (head out)))))))

@seek_no = (* (t (i (target (found (head out))))))
  & @seek ~ (t (i (target (found mid))))
  & mid ~ (tail found2)
  & out ~ ((1 (head tail)) found2)

@seek_yes = (* (h (t (i (target (found (head out)))))))
  & found ~ *
  & @seek ~ (t (i (target (h mid))))
  & mid ~ (tail found2)
  & out ~ ((1 (head tail)) found2)

// Set one list element, returning the rebuilt list.
@set = ((?((@set_nil @set_cons) (pl (i (v out)))) pl) (i (v out)))

@set_nil = (* (i (v out)))
  & i ~ *
  & v ~ *
  & out ~ (0 *)

@set_cons = (* ((h t) (i (v out))))
  & i ~ ?((@set_here @set_next) (h (t (v out))))

@set_here = (h (t (v out)))
  & h ~ *
  & out ~ (1 (v t))

@set_next = (i (h (t (v out))))
  & @set ~ (t (i (v mid)))
  & out ~ (1 (h mid))

// Find both endpoint labels, then lower the larger one.
@relax = (u (v (labs out)))
  & u ~ {us0 us}
  & v ~ {vs0 vs}
  & @seek ~ (labs (0 (us0 0 m1)))
  & m1 ~ (labs1 lu)
  & @seek ~ (labs1 (0 (vs0 0 m2)))
  & m2 ~ (labs2 lv)
  & lu ~ {luc luk}
  & lv ~ {lvc lvk}
  & luc ~ $([<] $(lvc z))
  & z ~ ?((@relax_ge @relax_lt) (luk (lvk (us (vs (labs2 out))))))

@relax_ge = (* (lv (u (v (ls out)))))
  & v ~ *
  & @set ~ (ls (u (lv out)))

@relax_lt = (lu (* (u (v (ls out)))))
  & u ~ *
  & @set ~ (ls (v (lu out)))

// Sweep the edge list, rebuilding it for the next round.
@sweep = ((?((@sweep_nil @sweep_cons) (pl (labs out))) pl) (labs out))

@sweep_nil = (* (labs out))
  & out ~ ((0 *) labs)

@sweep_cons = (* (((u v) tail) (labs out)))
  & u ~ {ur uh}
  & v ~ {vr vh}
  & @relax ~ (ur (vr (labs mid)))
  & @sweep ~ (tail (mid mid2))
  & mid2 ~ (tail2 labs2)
  & out ~ ((1 ((uh vh) tail2)) labs2)

// Run n sweeps, then count labels equal to their vertex indices.
@round = (n (edges (labs out)))
  & n ~ ?((@round_zero @round_succ) (edges (labs out)))

@round_zero = (* (labs out))
  & @count ~ (labs (0 out))

@round_succ = (k (edges (labs out)))
  & @sweep ~ (edges (labs mid))
  & mid ~ (edges2 labs2)
  & @round ~ (k (edges2 (labs2 out)))

@count = ((?((@count_nil @count_cons) (pl (i (acc out)))) pl) (i (acc out)))

@count_nil = (* (* (a a)))

@count_cons = (* ((h t) (i (acc out))))
  & i ~ {it ir}
  & h ~ $([=] $(it z))
  & z ~ ?((@count_no @count_yes) (ir (acc (t out))))

@count_no = (i (acc (t out)))
  & i ~ $([+1] i2)
  & @count ~ (t (i2 (acc out)))

@count_yes = (* (i (acc (t out))))
  & i ~ $([+1] i2)
  & acc ~ $([+1] acc2)
  & @count ~ (t (i2 (acc2 out)))
