// Initialize labels to 0..n-1, then relax every edge for n rounds.
@prog = ((n edges) out)
  & n ~ {n1 n2}
  & @init ~ (n1 (0 labs))
  & @round ~ (n2 (edges (labs out)))

// Build an ascending list of labels, using i as the next label.
@init = (?((@init_zero @init_succ) (i out)) (i out))

@init_zero = (i out)
  & i ~ *
  & out ~ (0 *)

@init_succ = (k (i out))
  & i ~ {ih in}
  & in ~ $([+1] in2)
  & @init ~ (k (in2 tail))
  & out ~ (1 (ih tail))

// Get index i while rebuilding the list.
// Result: (rebuilt_list, value).
@get = ((?((@get_nil @get_cons) (pl (i out))) pl) (i out))

@get_nil = (* (i out))
  & i ~ *
  & out ~ ((0 *) 0)

@get_cons = (* ((h t) (i out)))
  & i ~ ?((@get_here @get_next) (h (t out)))

@get_here = (h (t out))
  & h ~ {h1 h2}
  & out ~ ((1 (h1 t)) h2)

@get_next = (k (h (t out)))
  & @get ~ (t (k mid))
  & mid ~ (tail val)
  & out ~ ((1 (h tail)) val)

// Set index i to v.
@set = ((?((@set_nil @set_cons) (pl (i (v out)))) pl) (i (v out)))

@set_nil = (* (i (v out)))
  & i ~ *
  & v ~ *
  & out ~ (0 *)

@set_cons = (* ((h t) (i (v out))))
  & i ~ ?((@set_here @set_next) (h (t (v out))))

@set_here = (h (t (v out)))
  & h ~ *
  & out ~ (1 (v t))

@set_next = (k (h (t (v out))))
  & @set ~ (t (k (v mid)))
  & out ~ (1 (h mid))

// Lower the larger endpoint label to the smaller endpoint label.
@relax = (u (v (labs out)))
  & u ~ {uget uset}
  & v ~ {vget vset}
  & @get ~ (labs (uget m1))
  & m1 ~ (labs1 lu)
  & @get ~ (labs1 (vget m2))
  & m2 ~ (labs2 lv)
  & lu ~ {lu1 lu2}
  & lv ~ {lv1 lv2}
  & lu1 ~ $([<] $(lv1 z))
  & z ~ ?((@relax_ge @relax_lt) (lu2 (lv2 (uset (vset (labs2 out))))))

@relax_ge = (lu (lv (u (v (ls out)))))
  & lu ~ *
  & v ~ *
  & @set ~ (ls (u (lv out)))

@relax_lt = (* (lu (lv (u (v (ls out))))))
  & lv ~ *
  & u ~ *
  & @set ~ (ls (v (lu out)))

// Sweep the edges, returning the rebuilt edge list and updated labels.
@sweep = ((?((@sweep_nil @sweep_cons) (pl (labs out))) pl) (labs out))

@sweep_nil = (* (labs out))
  & out ~ ((0 *) labs)

@sweep_cons = (* (((u v) tail) (labs out)))
  & u ~ {ur uh}
  & v ~ {vr vh}
  & @relax ~ (ur (vr (labs mid)))
  & @sweep ~ (tail (mid mid2))
  & mid2 ~ (tail2 labs2)
  & out ~ ((1 ((uh vh) tail2)) labs2)

// Run n sweeps, then count labels equal to their vertex indices.
@round = (?((@round_zero @round_succ) (edges (labs out))) (edges (labs out)))

@round_zero = (edges (labs out))
  & edges ~ *
  & @count ~ (labs (0 out))

@round_succ = (k (edges (labs out)))
  & @sweep ~ (edges (labs mid))
  & mid ~ (edges2 labs2)
  & @round ~ (k (edges2 (labs2 out)))

@count = ((?((@count_nil @count_cons) (pl (i (acc out)))) pl) (i (acc out)))

@count_nil = (* (i (acc out)))
  & i ~ *
  & out ~ acc

@count_cons = (* ((h t) (i (acc out))))
  & i ~ {it ir}
  & h ~ $([=] $(it z))
  & z ~ ?((@count_no @count_yes) (ir (acc (t out))))

@count_no = (i (acc (t out)))
  & i ~ $([+1] i2)
  & @count ~ (t (i2 (acc out)))

@count_yes = (* (i (acc (t out))))
  & i ~ $([+1] i2)
  & acc ~ $([+1] acc2)
  & @count ~ (t (i2 (acc2 out)))
