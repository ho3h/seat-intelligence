// Build labels [0, 1, ..., n-1].
@prog = ((n edges) out)
  & n ~ {n1 n2}
  & @mklabels ~ (n1 (0 labs))
  & @run ~ (n2 (labs (edges out)))

@mklabels = (?((@mk_nil @mk_succ) c) c)

@mk_nil = (* (0 *))

@mk_succ = (pred (i out))
  & i ~ {ix iy}
  & iy ~ $([+1] ni)
  & @mklabels ~ (pred (ni tl))
  & out ~ (1 (ix tl))

// Run n passes over the edges.
@run = (?((@run_done @run_more) c) c)

@run_done = (labs (* out))
  & @count ~ (labs out)

@run_more = (pred (labs (edges out)))
  & edges ~ {e1 e2}
  & @ep ~ (e1 (labs nextlabs))
  & @run ~ (pred (nextlabs (e2 out)))

// Apply every edge once.
@ep = ((?((@ep_nil @ep_cons) (pl (labs out))) pl) (labs out))

@ep_nil = (* (a a))

@ep_cons = (* (((u v) t) (labs out)))
  & @merge ~ (labs (u (v merged)))
  & @ep ~ (t (merged out))

// Set both endpoint labels to the smaller of their current labels.
@merge = (labs (u (v out)))
  & labs ~ {lwork llook}
  & u ~ {u_lookup u_set}
  & v ~ {v_lookup v_set}
  & llook ~ {ll1 ll2}
  & @lookup ~ (ll1 (u_lookup lu))
  & @lookup ~ (ll2 (v_lookup lv))
  & @min ~ (lu (lv m))
  & m ~ {m1 m2}
  & @set ~ (lwork (u_set (m1 first)))
  & @set ~ (first (v_set (m2 out)))

// Look up the label at an index.
@lookup = ((?((@lookup_nil @lookup_cons) (pl (idx out))) pl) (idx out))

@lookup_nil = (* (idx out))
  & idx ~ *
  & out ~ 0

@lookup_cons = (* ((head tail) (idx out)))
  & idx ~ ?((@lookup_here @lookup_next) (head (tail out)))

@lookup_here = (head (tail out))
  & head ~ out
  & tail ~ *

@lookup_next = (idx (head (tail out)))
  & head ~ *
  & @lookup ~ (tail (idx out))

// Replace the label at an index.
@set = ((?((@set_nil @set_cons) (pl (idx (value out)))) pl) (idx (value out)))

@set_nil = (* (idx (value out)))
  & idx ~ *
  & value ~ *
  & out ~ (0 *)

@set_cons = (* ((head tail) (idx (value out))))
  & idx ~ ?((@set_here @set_next) (head (tail (value out))))

@set_here = (head (tail (value out)))
  & head ~ *
  & out ~ (1 (value tail))

@set_next = (idx (head (tail (value out))))
  & @set ~ (tail (idx (value tailout)))
  & out ~ (1 (head tailout))

// Return the smaller number.
@min = (a (b out))
  & a ~ {aa ac}
  & b ~ {bb bc}
  & aa ~ $([<] $(bb z))
  & z ~ ?((@min_ge @min_lt) (ac (bc out)))

@min_ge = (* (b b))

@min_lt = (a (* a))

// Count unordered pairs of equal labels.
@count = ((?((@count_nil @count_cons) (pl out)) pl) out)

@count_nil = (* out)
  & out ~ 0

@count_cons = (* ((h t) out))
  & t ~ {t1 t2}
  & @eqtail ~ (t1 (h eqn))
  & @count ~ (t2 rest)
  & eqn ~ $([+] $(rest out))

// Count occurrences of x in a list.
@eqtail = ((?((@eq_nil @eq_cons) (pl (x out))) pl) (x out))

@eq_nil = (* (x out))
  & x ~ *
  & out ~ 0

@eq_cons = (* ((h t) (x out)))
  & x ~ {x1 x2}
  & @eqtail ~ (t (x1 tailcount))
  & h ~ $([=] $(x2 z))
  & z ~ ?((@eq_no @eq_yes) (tailcount out))

@eq_no = (a a)

@eq_yes = (* (c out))
  & c ~ $([+1] out)
