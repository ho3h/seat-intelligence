@prog = ((pred truth) out)
  & @zip ~ (pred (truth rows))
  & rows ~ {todo full}
  & @outer ~ (todo (full ((0 *) (0 out))))

@zip = ((?((@zip_nil @zip_cons) (pl (truth out))) pl) (truth out))

@zip_nil = (* (truth out))
  & truth ~ *
  & out ~ (0 *)

@zip_cons = (* ((ph pt) (truth out)))
  & @zipT ~ (truth (ph (pt out)))

@zipT = ((?((@zipT_nil @zipT_cons) (pl (ph (pt out)))) pl) (ph (pt out)))

@zipT_nil = (* (ph (pt out)))
  & ph ~ *
  & pt ~ *
  & out ~ (0 *)

@zipT_cons = (* ((th tt) (ph (pt out))))
  & @zip ~ (pt (tt rest))
  & out ~ (1 ((ph th) rest))

@mem = ((?((@mem_nil @mem_cons) (pl (q out))) pl) (q out))

@mem_nil = (* (q out))
  & q ~ *
  & out ~ 0

@mem_cons = (* ((h t) (q out)))
  & q ~ {q_cmp q_rec}
  & h ~ $([=] $(q_cmp eq))
  & eq ~ ?((@mem_no @mem_yes) (t (q_rec out)))

@mem_no = (* (t (q out)))
  & @mem ~ (t (q out))

@mem_yes = (* (t (q out)))
  & t ~ *
  & q ~ *
  & out ~ 1

@outer = ((?((@outer_nil @outer_cons) (pl (full (seen (acc out))))) pl) (full (seen (acc out))))

@outer_nil = (* (full (seen (acc out))))
  & full ~ *
  & seen ~ *
  & acc ~ out

@outer_cons = (* (((p t) tail) (full (seen (acc out)))))
  & full ~ {full_metric full_recur}
  & seen ~ {seen_query seen_recur}
  & p ~ {p_query p_rest}
  & p_rest ~ {p_metric p_seen}
  & @mem ~ (seen_query (p_query has))
  & has ~ ?((@outer_new @outer_old) (tail (full_metric (full_recur (seen_recur (p_metric (p_seen (t (acc out)))))))))

@outer_old = (* (tail (full_metric (full_recur (seen_recur (p_metric (p_seen (t (acc out)))))))))
  & full_metric ~ *
  & p_metric ~ *
  & p_seen ~ *
  & t ~ *
  & @outer ~ (tail (full_recur (seen_recur (acc out))))

@outer_new = (* (tail (full_metric (full_recur (seen_recur (p_metric (p_seen (t (acc out)))))))))
  & full_metric ~ {candidate_rows count_rows}
  & @metric ~ (candidate_rows (count_rows (p_metric (0 m))))
  & acc ~ $([+] $(m acc2))
  & t ~ *
  & new_seen ~ (1 (p_seen seen_recur))
  & @outer ~ (tail (full_recur (new_seen (acc2 out))))

@metric = ((?((@metric_nil @metric_cons) (pl (all (target (mx out))))) pl) (all (target (mx out))))

@metric_nil = (* (all (target (mx out))))
  & all ~ *
  & target ~ *
  & mx ~ out

@metric_cons = (* (((cp ct) tail) (all (target (mx out)))))
  & all ~ {all_count all_next}
  & target ~ {p_cmp p_rest}
  & p_rest ~ {p_count p_next}
  & cp ~ $([=] $(p_cmp eq))
  & eq ~ ?((@metric_no @metric_yes) (tail (all_count (all_next (p_count (p_next (ct (mx out))))))))

@metric_no = (* (tail (all_count (all_next (p_count (p_next (ct (mx out))))))))
  & all_count ~ *
  & p_count ~ *
  & ct ~ *
  & @metric ~ (tail (all_next (p_next (mx out))))

@metric_yes = (* (tail (all_count (all_next (p_count (p_next (ct (mx out))))))))
  & @count ~ (all_count (p_count (ct cnt))
  & cnt ~ {cnt_cmp cnt_candidate}
  & mx ~ {mx_cmp mx_recur}
  & cnt_cmp ~ $([>] $(mx_cmp gt))
  & gt ~ ?((@metric_keep @metric_update) (tail (all_next (p_next (mx_recur (cnt_candidate out))))))

@metric_keep = (* (tail (all_next (p_next (mx_recur (cnt_candidate out))))))
  & cnt_candidate ~ *
  & @metric ~ (tail (all_next (p_next (mx_recur out))))

@metric_update = (* (tail (all_next (p_next (mx_recur (cnt_candidate out))))))
  & mx_recur ~ *
  & @metric ~ (tail (all_next (p_next (cnt_candidate out))))

@count = ((?((@count_nil @count_cons) (pl (targetp (targett (acc out))))) pl) (targetp (targett (acc out))))

@count_nil = (* (targetp (targett (acc out))))
  & targetp ~ *
  & targett ~ *
  & acc ~ out

@count_cons = (* (((rp rt) tail) (targetp (targett (acc out)))))
  & targetp ~ {pc pr}
  & targett ~ {tc tr}
  & rp ~ $([=] $(pc ep))
  & ep ~ ?((@count_pno @count_pyes) (tail (pr (tr (rt (acc out))))))

@count_pno = (* (tail (pr (tr (rt (acc out))))))
  & rt ~ *
  & @count ~ (tail (pr (tr (acc out))))

@count_pyes = (* (tail (pr (tr (rt (acc out))))))
  & rt ~ $([=] $(tc et))
  & et ~ ?((@count_tno @count_tyes) (tail (pr (tr (acc out)))))

@count_tno = (* (tail (pr (tr (acc out)))))
  & @count ~ (tail (pr (tr (acc out))))

@count_tyes = (* (tail (pr (tr (acc out)))))
  & acc ~ $([+1] acc2)
  & @count ~ (tail (pr (tr (acc2 out))))
