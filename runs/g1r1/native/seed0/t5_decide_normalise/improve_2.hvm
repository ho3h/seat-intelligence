@prog = (inp out)
  & @sort ~ (inp out)

@sort = ((?((@sort_nil @sort_cons) (pl out)) pl) out)

@sort_nil = (* out)
  & out ~ (0 *)

@sort_cons = (* ((h t) out))
  & t ~ (?( (@sort_one @sort_many) (h (pl out))) pl)

@sort_one = (h (pl out))
  & pl ~ *
  & @canon ~ (h c)
  & out ~ (1 (c (0 *)))

@sort_many = (* (h (pl out)))
  & @split ~ ((1 (h (1 pl))) halves)
  & @sort_halves ~ (halves out)

@sort_halves = ((l r) out)
  & @sort ~ (l sl)
  & @sort ~ (r sr)
  & @merge ~ (sl (sr out))

@split = ((?((@split_nil @split_cons) (pl out)) pl) out)

@split_nil = (* out)
  & out ~ ((0 *) (0 *))

@split_cons = (* ((h t) out))
  & @split ~ (t r)
  & r ~ (a b)
  & out ~ ((1 (h b)) a)

@canon = ((u (v s)) out)
  & u ~ {u1 u2}
  & v ~ {v1 v2}
  & u1 ~ $([<] $(v1 z))
  & z ~ ?((@canon_swap @canon_keep) (u2 (v2 (s out))))

@canon_keep = (* (u (v (s out))))
  & out ~ (1 (u (v s)))

@canon_swap = (* (u (v (s out))))
  & out ~ (1 (v (u s)))

@merge = ((?((@merge_nil @merge_cons) (pl (r out))) pl) (r out))

@merge_nil = (* (r out))
  & out ~ r

@merge_cons = (* ((h t) (r out)))
  & r ~ (?( (@merge_rnil @merge_rcons) (h (t (pl out)))) pl)

@merge_rnil = (h (t (pl out)))
  & pl ~ *
  & out ~ (1 (h t))

@merge_rcons = (* (h (t (pl out))))
  & pl ~ (p t2)
  & h ~ {hc hk}
  & p ~ {pc pk}
  & @keycmp ~ (hc (pc cmp))
  & cmp ~ (le eq)
  & le ~ ?((@merge_gt @merge_le) (eq (hk (pk (t (t2 out))))))

@merge_gt = (eq (h (p (t (t2 out)))))
  & eq ~ *
  & @merge ~ ((1 (h t)) (t2 r))
  & out ~ (1 (p r))

@merge_le = (* (eq (h (p (t (t2 out))))))
  & eq ~ ?((@merge_lt @merge_equal) (h (p (t (t2 out)))))

@merge_lt = (h (p (t (t2 out))))
  & @merge ~ (t ((1 (p t2)) r))
  & out ~ (1 (h r))

@merge_equal = (* (h (p (t (t2 out)))))
  & h ~ (u (v s))
  & p ~ (a (b q))
  & a ~ *
  & b ~ *
  & s ~ {sc sk}
  & q ~ {qc qk}
  & sc ~ $([>] $(qc z))
  & z ~ ?((@merge_score_no @merge_score_yes) (u (v (sk (qk (t (t2 out)))))))

@merge_score_no = (u (v (s (q (t (t2 out))))))
  & s ~ *
  & @merge ~ (t (t2 r))
  & out ~ (1 ((u (v q)) r))

@merge_score_yes = (* (u (v (s (q (t (t2 out)))))))
  & q ~ *
  & @merge ~ (t (t2 r))
  & out ~ (1 ((u (v s)) r))

@keycmp = ((u (v s)) ((a (b q)) out))
  & s ~ *
  & q ~ *
  & u ~ {ul ue}
  & a ~ {al ae}
  & ul ~ $([<] $(al z))
  & z ~ ?((@kc_u_ge @kc_u_lt) (ue (ae (v (b out)))))

@kc_u_lt = (* (ue (ae (v (b out)))))
  & ue ~ *
  & ae ~ *
  & v ~ *
  & b ~ *
  & out ~ (1 0)

@kc_u_ge = (ue (ae (v (b out))))
  & ue ~ $([=] $(ae z2))
  & z2 ~ ?((@kc_u_gt @kc_u_eq) (v (b out)))

@kc_u_gt = (v (b out))
  & v ~ *
  & b ~ *
  & out ~ (0 0)

@kc_u_eq = (* (v (b out)))
  & v ~ {vl ve}
  & b ~ {bl be}
  & vl ~ $([<] $(bl z3))
  & z3 ~ ?((@kc_v_ge @kc_v_lt) (ve (be out)))

@kc_v_lt = (* (ve (be out)))
  & ve ~ *
  & be ~ *
  & out ~ (1 0)

@kc_v_ge = (ve (be out))
  & ve ~ $([=] $(be z4))
  & z4 ~ ?((@kc_v_gt @kc_v_eq) out)

@kc_v_gt = out
  & out ~ (0 0)

@kc_v_eq = (* out)
  & out ~ (1 1)
