@prog = ((n (s (t edges))) out)
  & @valid_s ~ (n (s (t (edges out))))

@valid_s = (n (s (t (edges out))))
  & n ~ {n1 n2}
  & s ~ {s1 s2}
  & s1 ~ $([<] $(n1 b))
  & b ~ ?((@invalid @valid_s_yes) (n2 (s2 (t (edges out)))))

@valid_s_yes = (* (n (s (t (edges out)))))
  & @valid_t ~ (n (s (t (edges out))))

@valid_t = (n (s (t (edges out))))
  & n ~ {n1 n2}
  & t ~ {t1 t2}
  & t1 ~ $([<] $(n1 b))
  & b ~ ?((@invalid @valid_t_yes) (n2 (s (t2 (edges out)))))

@valid_t_yes = (* (n (s (t (edges out)))))
  & @solve ~ (n (s (t (edges out))))

@invalid = (n (s (t (edges out))))
  & n ~ *
  & s ~ *
  & t ~ *
  & edges ~ *
  & out ~ (0 *)

@solve = (n (s (t (edges out))))
  & n ~ {nm ni}
  & @mk ~ (0 (nm (s labels)))
  & @iter ~ (ni (edges (labels (t out))))

@mk = (i (n (s out)))
  & i ~ {ix ic}
  & n ~ {nx nc}
  & ix ~ $([<] $(nx b))
  & b ~ ?((@mk_stop @mk_more) (ic (nc (s out))))

@mk_stop = (i (n (s out)))
  & i ~ *
  & n ~ *
  & s ~ *
  & out ~ (0 *)

@mk_more = (* (i (n (s out))))
  & i ~ {il ir}
  & s ~ {sl sr}
  & @mk_label ~ (il (sl lab))
  & ir ~ $([+1] ix)
  & @mk ~ (ix (n (sr tail)))
  & out ~ (1 (lab tail))

@mk_label = (i (s out))
  & i ~ {ix ic}
  & s ~ {sx sc}
  & ix ~ $([=] $(sx b))
  & b ~ ?((@ml_no @ml_yes) (ic (sc out)))

@ml_no = (i (s out))
  & i ~ *
  & s ~ *
  & out ~ (0 (0 (0 (0 *))))

@ml_yes = (* (i (s out)))
  & i ~ *
  & out ~ (1 (0 (0 (1 (s (0 *)))))

@iter = (k (edges (labels (t out))))
  & k ~ ?((@iter_done @iter_more) (edges (labels (t out))))

@iter_done = (edges (labels (t out)))
  & edges ~ *
  & @finish ~ (labels (t out))

@iter_more = (* (edges (labels (t out))))
  & edges ~ {escan erec}
  & @scan ~ (escan (labels ls))
  & @iter ~ (k (erec (ls (t out))))

@scan = ((?((@scan_nil @scan_cons) (pl (labels out))) pl) (labels out))

@scan_nil = (pl (labels out))
  & pl ~ *
  & out ~ labels

@scan_cons = (* ((u (v w)) (tail (labels out))))
  & u ~ {u1 u2}
  & v ~ {v1 v2}
  & w ~ {w1 w2}
  & @relax ~ (u1 (v1 (w1 (labels l1))))
  & @relax ~ (v2 (u2 (w2 (l1 l2))))
  & @scan ~ (tail (l2 out))

@relax = (u (v (w (labels out))))
  & labels ~ {la {lb lc}}
  & v ~ {vg vr}
  & @get ~ (u (la src))
  & @get ~ (vg (lb dst))
  & @r_src ~ (src (dst (vr (w (lc out))))

@r_src = (src (dst (v (w (base out)))))
  & src ~ (sr (sd (sh sp)))
  & sr ~ ?((@rs_no @rs_yes) (sd (sh (sp (dst (v (w (base out)))))))

@rs_no = (sd (sh (sp (dst (v (w (base out))))))
  & sd ~ *
  & sh ~ *
  & sp ~ *
  & dst ~ *
  & v ~ *
  & w ~ *
  & out ~ base

@rs_yes = (* (sd (sh (sp (dst (v (w (base out)))))))
  & sd ~ $([+] $(w cd))
  & sh ~ $([+1] ch)
  & @append ~ (sp (v cp))
  & @cmp ~ ((1 (cd (ch cp))) (dst (v (base out))))

@get = (i ((?((@get_nil @get_cons) (pl (i out))) pl) out))

@get_nil = (pl (i out))
  & pl ~ *
  & i ~ *
  & out ~ (0 (0 (0 (0 *))))

@get_cons = (* ((h t) (i out)))
  & i ~ ?((@get_here @get_next) (h (t out)))

@get_here = (h (t out))
  & t ~ *
  & out ~ h

@get_next = (* (h (t out)))
  & h ~ *
  & @get ~ (i (t out))

@set = (i ((?((@set_nil @set_cons) (pl (i (val out)))) pl) (val out)))

@set_nil = (pl (i (val out)))
  & pl ~ *
  & i ~ *
  & val ~ *
  & out ~ (0 *)

@set_cons = (* ((h t) (i (val out))))
  & i ~ ?((@set_here @set_next) (h (t (val out))))

@set_here = (h (t (val out)))
  & h ~ *
  & out ~ (1 (val t))

@set_next = (* (h (t (val out))))
  & h ~ *
  & @set ~ (i (t (val out)))

@append = ((?((@app_nil @app_cons) (pl (x out))) pl) (x out))

@app_nil = (pl (x out))
  & pl ~ *
  & out ~ (1 (x (0 *)))

@app_cons = (* ((h t) (x out)))
  & @append ~ (t (x tail))
  & out ~ (1 (h tail))

@cmp = (cand (cur (v (base out))))
  & cur ~ (cr (dd (dh dp)))
  & cr ~ ?((@cmp_empty @cmp_present) (cand (dd (dh (dp (v (base out)))))))

@cmp_empty = (cand (dd (dh (dp (v (base out))))))
  & dd ~ *
  & dh ~ *
  & dp ~ *
  & @set ~ (v (base (cand out)))

@cmp_present = (* (cand (dd (dh (dp (v (base out))))))
  & @cmp_take ~ (cand ((1 (dd (dh dp))) (v (base out))))

@cmp_take = (cand (cur (v (base out))))
  & cand ~ {cb ck}
  & @better ~ (cb (cur b))
  & b ~ ?((@ct_no @ct_yes) (ck (v (base out))))

@ct_no = (ck (v (base out)))
  & ck ~ *
  & v ~ *
  & out ~ base

@ct_yes = (* (ck (v (base out))))
  & @set ~ (v (base (ck out)))

@r_src_unused = *

@better = (cand (cur out))
  & cand ~ (cd (ch cp))
  & cur ~ (cr (dd (dh dp)))
  & cr ~ ?((@better_empty @better_present) (cd (ch (cp (dd (dh (dp out)))))))

@better_empty = (cd (ch (cp (dd (dh (dp out))))))
  & cd ~ *
  & ch ~ *
  & cp ~ *
  & dd ~ *
  & dh ~ *
  & dp ~ *
  & out ~ 1

@better_present = (* (cd (ch (cp (dd (dh (dp out)))))))
  & @ord_d ~ (cd (dd (ch (dh (cp (dp out)))))

@ord_d = (cd (dd (ch (dh (cp (dp out))))))
  & cd ~ {cd1 cd2}
  & dd ~ {dd1 dd2}
  & cd1 ~ $([<] $(dd1 b))
  & b ~ ?((@od_notless @od_yes) (cd2 (dd2 (ch (dh (cp (dp out)))))))

@od_yes = (* (cd (dd (ch (dh (cp (dp out))))))
  & cd ~ *
  & dd ~ *
  & ch ~ *
  & dh ~ *
  & cp ~ *
  & dp ~ *
  & out ~ 1

@od_notless = (cd (dd (ch (dh (cp (dp out))))))
  & @ord_eqd ~ (cd (dd (ch (dh (cp (dp out)))))

@ord_eqd = (cd (dd (ch (dh (cp (dp out))))))
  & cd ~ $([=] $(dd b))
  & b ~ ?((@oed_no @oed_yes) (ch (dh (cp (dp out)))))

@oed_no = (ch (dh (cp (dp out))))
  & ch ~ *
  & dh ~ *
  & cp ~ *
  & dp ~ *
  & out ~ 0

@oed_yes = (* (ch (dh (cp (dp out)))))
  & @ord_h ~ (ch (dh (cp (dp out))))

@ord_h = (ch (dh (cp (dp out))))
  & ch ~ {ch1 ch2}
  & dh ~ {dh1 dh2}
  & ch1 ~ $([<] $(dh1 b))
  & b ~ ?((@oh_notless @oh_yes) (ch2 (dh2 (cp (dp out)))))

@oh_yes = (* (ch (dh (cp (dp out)))))
  & ch ~ *
  & dh ~ *
  & cp ~ *
  & dp ~ *
  & out ~ 1

@oh_notless = (ch (dh (cp (dp out))))
  & @ord_eqh ~ (ch (dh (cp (dp out))))

@ord_eqh = (ch (dh (cp (dp out))))
  & ch ~ $([=] $(dh b))
  & b ~ ?((@oeh_no @oeh_yes) (cp (dp out)))

@oeh_no = (cp (dp out))
  & cp ~ *
  & dp ~ *
  & out ~ 0

@oeh_yes = (* (cp (dp out)))
  & @lex ~ (cp (dp out))

@lex = (a (b out))
  & @lex_a ~ (a (b out))

@lex_a = ((?((@lex_nil @lex_cons) (pl (b out))) pl) (b out))

@lex_nil = (pl (b out))
  & pl ~ *
  & b ~ *
  & out ~ 0

@lex_cons = (* ((ah at) (b out)))
  & @lex_b ~ (ah (at (b out)))

@lex_b = (ah (at ((?((@lexb_nil @lexb_cons) (pl (ah (at out)))) pl) out))

@lexb_nil = (pl (ah (at out)))
  & pl ~ *
  & ah ~ *
  & at ~ *
  & out ~ 0

@lexb_cons = (* ((bh bt) (ah (at out))))
  & @lex_heads ~ (ah (at (bh (bt out))))

@lex_heads = (ah (at (bh (bt out))))
  & ah ~ {a1 a2}
  & bh ~ {b1 b2}
  & a1 ~ $([<] $(b1 less))
  & less ~ ?((@lh_notless @lh_yes) (a2 (b2 (at (bt out)))))

@lh_yes = (* (a (b (at (bt out)))))
  & a ~ *
  & b ~ *
  & at ~ *
  & bt ~ *
  & out ~ 1

@lh_notless = (a (b (at (bt out))))
  & a ~ $([=] $(b eq))
  & eq ~ ?((@lh_ne @lh_eq) (at (bt out)))

@lh_ne = (at (bt out))
  & at ~ *
  & bt ~ *
  & out ~ 0

@lh_eq = (* (at (bt out)))
  & @lex ~ (at (bt out))

@finish = (labels (t out))
  & @get ~ (t (labels lab))
  & lab ~ (r (d (h path)))
  & r ~ ?((@fin_no @fin_yes) (d (h (path out))))

@fin_no = (d (h (path out)))
  & d ~ *
  & h ~ *
  & path ~ *
  & out ~ (0 *)

@fin_yes = (* (d (h (path out))))
  & d ~ *
  & h ~ *
  & out ~ path
