// Top-level: duplicate n into the remaining-step count and the scan bound.
@prog = (({left total} edges) out)
  & @loop ~ (left (total (edges ((0 *) out))))

// Repeatedly find the smallest available vertex.
@loop = (?((@loop_zero @loop_succ) (total (edges (acc out)))) (total (edges (acc out))))

@loop_zero = (total (edges (acc out)))
  & total ~ *
  & edges ~ *
  & @rev ~ (acc ((0 *) out))

@loop_succ = (left ({t1 t2} ({e1 e2} ({a1 a2} out))))
  & @find ~ (t1 (0 (e1 (a1 vertex))))
  & @loop ~ (left (t2 (e2 ((1 (vertex a2)) out)))

// Find the first un-emitted vertex with no incoming edge from an un-emitted vertex.
@find = (?((@find_fail @find_succ) (i (edges (done result)))) (i (edges (done result))))

@find_fail = (i (edges (done result)))
  & i ~ *
  & edges ~ *
  & done ~ *
  & result ~ 0

@find_succ = (left ({i1 i2} (edges ({d1 d2} result))))
  & @member ~ (d1 (i1 m))
  & m ~ ?((@find_not_done @find_done) (left (i2 (edges (d2 result))))

@find_done = (* (left (i (edges (done result)))))
  & i ~ $([+1] next)
  & @find ~ (left (next (edges (done result))))

@find_not_done = (left ({i1 i2} ({e1 e2} ({d1 d2} result))))
  & @blocked ~ (e1 (i1 (d1 b)))
  & b ~ ?((@find_found @find_blocked) (left (i2 (e2 (d2 result))))

@find_found = (left (i (edges (done result))))
  & left ~ *
  & edges ~ *
  & done ~ *
  & result ~ i

@find_blocked = (* (left (i (edges (done result)))))
  & i ~ $([+1] next)
  & @find ~ (left (next (edges (done result))))

// Membership test: is target in list?
@member = ((?((@mem_nil @mem_cons) (payload (target result))) payload) (target result))

@mem_nil = (payload (target result))
  & payload ~ *
  & target ~ *
  & result ~ 0

@mem_cons = (* ((head tail) ({a b} result)))
  & head ~ $([=] $(a eq))
  & eq ~ ?((@mem_false @mem_true) (tail (b result)))

@mem_false = (tail (target result))
  & @member ~ (tail (target result))

@mem_true = (* (tail (target result)))
  & tail ~ *
  & target ~ *
  & result ~ 1

// Is there an edge into candidate whose source is not in done?
@blocked = ((?((@blocked_nil @blocked_cons) (payload (candidate (done result)))) payload) (candidate (done result)))

@blocked_nil = (payload (candidate (done result)))
  & payload ~ *
  & candidate ~ *
  & done ~ *
  & result ~ 0

@blocked_cons = (* ((edge tail) ({c1 c2} ({d1 d2} result))))
  & edge ~ (u v)
  & v ~ $([=] $(c1 eq))
  & eq ~ ?((@bc_vno @bc_vyes) (u (tail (c2 (d1 (d2 result))))))

@bc_vno = (u (tail (candidate (d1 (d2 result)))))
  & u ~ *
  & d1 ~ *
  & @blocked ~ (tail (candidate (d2 result)))

@bc_vyes = (* (u (tail (candidate (d1 (d2 result))))))
  & @member ~ (d1 (u m))
  & m ~ ?((@bc_unremoved @bc_removed) (tail (candidate (d2 result))))

@bc_unremoved = (tail (candidate (done result)))
  & tail ~ *
  & candidate ~ *
  & done ~ *
  & result ~ 1

@bc_removed = (* (tail (candidate (done result))))
  & @blocked ~ (tail (candidate (done result)))

// Reverse the accumulated list.
@rev = ((?((@rev_nil @rev_cons) (payload (acc out))) payload) (acc out))

@rev_nil = (payload (acc out))
  & payload ~ *
  & acc ~ out

@rev_cons = (* ((head tail) (acc out)))
  & @rev ~ (tail ((1 (head acc)) out))
