@prog = (inp out)
  & @init ~ (inp out)

@init = ((n (s (k edges))) out)
  & n ~ *
  & s ~ {s1 s2}
  & @loop ~ (k ((1 (s1 (0 *))) ((1 (s2 (0 *))) (1 (edges out)))))

@loop = (k (front (visited (count (edges out)))))
  & k ~ ?((@stop @more) (front (visited (count (edges out)))))

@stop = (front (visited (count (edges out))))
  & front ~ *
  & visited ~ *
  & edges ~ *
  & count ~ out

@more = (km (front (visited (count (edges out)))))
  & edges ~ {scan_edges keep_edges}
  & @scan ~ (scan_edges (front (visited ((0 *) (count scanout)))))
  & @advance ~ (km (scanout (keep_edges out)))

@advance = (km (state (edges out)))
  & state ~ (front (visited count))
  & front ~ (tag payload)
  & tag ~ ?((@advance_nil @advance_nonempty) (payload (km (visited (count (edges out))))))

@advance_nil = (payload (km (visited (count (edges out)))))
  & payload ~ *
  & km ~ *
  & visited ~ *
  & edges ~ *
  & count ~ out

@advance_nonempty = (* ((head tail) (km (visited (count (edges out))))))
  & @loop ~ (km ((1 (head tail)) (visited (count (edges out)))))

@scan = (edges (front (visited (next (count out)))))
  & edges ~ (tag payload)
  & tag ~ ?((@scan_nil @scan_cons) (payload (front (visited (next (count out))))))

@scan_nil = (payload (front (visited (next (count out)))))
  & payload ~ *
  & front ~ *
  & out ~ (next (visited count))

@scan_cons = (* (((u v) tail) (front (visited (next (count out))))))
  & front ~ {fedge frest}
  & @edge ~ (u (v (fedge (visited (next (count (tail (frest out))))))))

@edge = (u (v (front (visited (next (count (tail (frest out))))))))
  & front ~ {f1 f2}
  & u ~ {uq uk}
  & @has ~ (uq (f1 z))
  & z ~ ?((@edge_no @edge_yes) (uk (v (f2 (visited (next (count (tail (frest out))))))))

@edge_no = (uk (v (f2 (visited (next (count (tail (frest out))))))))
  & @has ~ (v (f2 z2))
  & z2 ~ ?((@edge_no2 @edge_yes2) (uk (visited (next (count (tail (frest out)))))))

@edge_yes = (* (uk (v (f2 (visited (next (count (tail (frest out)))))))))
  & uk ~ *
  & f2 ~ *
  & @candidate ~ (v (visited (next (count (tail (frest out))))))

@edge_no2 = (uk (visited (next (count (tail (frest out))))))
  & uk ~ *
  & @scan ~ (tail (frest (visited (next (count out)))))

@edge_yes2 = (* (uk (visited (next (count (tail (frest out)))))))
  & @candidate ~ (uk (visited (next (count (tail (frest out))))))

@candidate = (x (visited (next (count (tail (frest out))))))
  & x ~ {xq xkeep}
  & visited ~ {vquery vkeep}
  & @has ~ (xq (vquery z))
  & z ~ ?((@candidate_old @candidate_new) (xkeep (vkeep (next (count (tail (frest out)))))))

@candidate_old = (xkeep (vkeep (next (count (tail (frest out))))))
  & xkeep ~ *
  & @scan ~ (tail (frest (vkeep (next (count out)))))

@candidate_new = (* (xkeep (vkeep (next (count (tail (frest out)))))))
  & xkeep ~ {xv xn}
  & count ~ $([+1] cnew)
  & @scan ~ (tail (frest (vnew (nnew (cnew out)))))
  & vnew ~ (1 (xv vkeep))
  & nnew ~ (1 (xn next))

@has = (x (list out))
  & list ~ (tag payload)
  & tag ~ ?((@has_nil @has_cons) (payload (x out)))

@has_nil = (payload (x out))
  & payload ~ *
  & x ~ *
  & out ~ 0

@has_cons = (* ((head tail) (x out)))
  & x ~ {xcmp xrec}
  & xcmp ~ $([=] $(head z))
  & z ~ ?((@has_no @has_yes) (tail (xrec out)))

@has_no = (tail (x out))
  & @has ~ (x (tail out))

@has_yes = (* (tail (x out)))
  & tail ~ *
  & x ~ *
  & out ~ 1
