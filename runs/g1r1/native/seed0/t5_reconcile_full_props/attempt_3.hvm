// Build identity canonical ids; filter self-loops and normalize the remaining edges.
@prog = ((n (tau (mnl (cands (edges attrs))))) out)
  & tau ~ *
  & mnl ~ *
  & cands ~ *
  & @range ~ (n ((0 *) c))
  & @filter ~ (edges e)
  & out ~ (c (e attrs))

@range = ((?((@range_zero @range_succ) (pl (acc out))) pl) (acc out))

@range_zero = (* (acc out))
  & acc ~ out

@range_succ = (* (pl (acc out)))
  & pl ~ {a b}
  & @range ~ (a ((1 (b acc)) out))

@filter = ((?((@filter_nil @filter_cons) (pl out)) pl) out)

@filter_nil = (* out)
  & out ~ (0 *)

@filter_cons = (* ((u v) (tail out)))
  & u ~ {u1 u2}
  & v ~ {v1 v2}
  & u1 ~ $([=] $(v1 z))
  & z ~ ?((@filter_keep @filter_drop) (u2 (v2 (tail out))))

@filter_drop = (* (u (v (tail out))))
  & u ~ *
  & v ~ *
  & @filter ~ (tail out)

@filter_keep = (u (v (tail out)))
  & u ~ {u1 u2}
  & v ~ {v1 v2}
  & u1 ~ $([<] $(v1 z))
  & z ~ ?((@filter_swap @filter_ordered) (u2 (v2 (tail out))))

@filter_swap = (u (v (tail out)))
  & @filter ~ (tail rest)
  & out ~ (1 ((v u) rest))

@filter_ordered = (* (u (v (tail out))))
  & @filter ~ (tail rest)
  & out ~ (1 ((u v) rest))
