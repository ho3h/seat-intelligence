// Count edges; for forests, n minus the edge count is the component count.
@prog = ((n edges) out)
  & @len ~ (edges (0 m))
  & m ~ {mt mc}
  & n ~ {nt nc}
  & mt ~ $([>] $(nt bad))
  & bad ~ ?((@subtract @tooMany) (nc (mc out)))

@len = ((?((@lenNil @lenCons) (pl (acc out))) pl) (acc out))

@lenNil = (* (a a))

@lenCons = (* ((h t) (acc out)))
  & h ~ *
  & acc ~ $([+1] acc2)
  & @len ~ (t (acc2 out))

@subtract = (pred (n (m out)))
  & pred ~ *
  & n ~ $([-] $(m out))

@tooMany = (pred (n (m out)))
  & pred ~ *
  & n ~ *
  & m ~ *
  & out ~ 0
