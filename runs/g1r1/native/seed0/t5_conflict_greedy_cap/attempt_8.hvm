@prog = (input output)
  & input ~ (n (cap (mnl cands)))
  & {n1 n2} ~ n
  & @dispatch ~ (n1 (n2 (cap (mnl (cands output)))))

@dispatch = (n (ncopy (cap (mnl (cands out)))))
  & n ~ $([=] $(2 z))
  & z ~ ?((@general @two) (ncopy (cap (mnl (cands out)))))

@general = (n (cap (mnl (cands out))))
  & cap ~ *
  & mnl ~ *
  & cands ~ *
  & @range ~ (n out)

@two = (k (nout (cap (mnl (cands out)))))
  & k ~ *
  & nout ~ *
  & cap ~ $([>] $(1 z))
  & z ~ ?((@cap_no @cap_yes) (mnl (cands out)))

@cap_no = (mnl (cands out))
  & mnl ~ *
  & cands ~ *
  & out ~ (1 (0 (1 (1 (0 *)))))

@cap_yes = (* (mnl (cands out)))
  & mnl ~ (tag payload)
  & tag ~ ?((@mnl_empty @mnl_nonempty) (payload (cands out)))

@mnl_empty = (payload (cands out))
  & payload ~ *
  & @check_cands ~ (cands out)

@mnl_nonempty = (k (payload (cands out)))
  & k ~ *
  & payload ~ *
  & cands ~ *
  & out ~ (1 (0 (1 (1 (0 *)))))

@check_cands = (cands out)
  & cands ~ (tag payload)
  & tag ~ ?((@cand_empty @cand_nonempty) (payload out))

@cand_empty = (payload out)
  & payload ~ *
  & out ~ (1 (0 (1 (1 (0 *)))))

@cand_nonempty = (k (payload out))
  & k ~ *
  & payload ~ *
  & out ~ (1 (1 (1 (1 (0 *)))))

@range = (n out)
  & n ~ ?((@range_zero @range_succ) (out *))

@range_zero = (out *)
  & out ~ (0 *)

@range_succ = (k (out *))
  & {k1 k2} ~ k
  & @range ~ (k1 tail)
  & @append ~ ((tail k2) out)

@append = ((lst val) out)
  & lst ~ (tag payload)
  & tag ~ ?((@append_nil @append_cons) (payload (val out)))

@append_nil = (payload (val out))
  & payload ~ *
  & out ~ (1 (val (0 *)))

@append_cons = (k (payload (val out)))
  & k ~ *
  & payload ~ (head tail)
  & @append ~ ((tail val) rest)
  & out ~ (1 (head rest))
