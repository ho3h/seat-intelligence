@prog = (input output)
  & input ~ (n (cap (mnl cands)))
  & cap ~ *
  & mnl ~ *
  & cands ~ *
  & @range ~ (n output)

@range = (n out)
  & n ~ ?((@range_zero @range_succ) (out *))

@range_zero = (out *)
  & out ~ (0 *)

@range_succ = (k (out *))
  & {k1 k2} ~ k
  & @range ~ (k1 tail)
  & @append ~ ((tail k2) out)

@append = ((lst val) out)
  & lst ~ (?( (@append_nil @append_cons) (payload (val out))) payload)

@append_nil = (payload (val out))
  & payload ~ *
  & out ~ (1 (val (0 *)))

@append_cons = (* (payload (val out)))
  & payload ~ (head tail)
  & @append ~ ((tail val) rest)
  & out ~ (1 (head rest))
