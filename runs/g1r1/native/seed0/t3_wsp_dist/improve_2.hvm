@prog = ((n (s (t edges))) out)
  & @check ~ (n (s (t (edges out))))

@check = (n (s (t (edges out))))
  & {n_cmp n_keep} ~ n
  & {s_cmp s_keep} ~ s
  & s_cmp ~ $([<] $(n_cmp b))
  & b ~ ?((@invalid @check_t) (n_keep (s_keep (t (edges out)))))

@check_t = (* (n (s (t (edges out)))))
  & {n_cmp n_keep} ~ n
  & {t_cmp t_keep} ~ t
  & t_cmp ~ $([<] $(n_cmp b))
  & b ~ ?((@invalid @valid) (n_keep (s (t_keep (edges out)))))

@invalid = (n (s (t (edges out))))
  & n ~ *
  & s ~ *
  & t ~ *
  & edges ~ *
  & out ~ 16777215

@valid = (* (n (s (t (edges out)))))
  & {s_cmp s_keep} ~ s
  & {t_cmp t_keep} ~ t
  & s_cmp ~ $([=] $(t_cmp b))
  & b ~ ?((@different @same) (n (s_keep (t_keep (edges out)))))

@same = (* (n (s (t (edges out)))))
  & n ~ *
  & s ~ *
  & t ~ *
  & edges ~ *
  & out ~ 0

@different = (n (s (t (edges out))))
  & {n_fill n_round} ~ n
  & @fill ~ (n_fill arr)
  & @set ~ (arr (s (0 d)))
  & @round ~ (n_round (edges (d dist)))
  & @at ~ (dist (t out))

@fill = (?((@fill_done @fill_more) (arr *)) arr)

@fill_done = (arr *)
  & arr ~ (0 *)

@fill_more = (k (arr *))
  & @fill ~ (k tail)
  & arr ~ (1 (16777215 tail))

@round = ((?((@round_end @round_more) (edges (dist out))) *) (edges (dist out)))

@round_end = (* (dist out))
  & out ~ dist

@round_more = (k (edges (dist out)))
  & {e_scan e_next} ~ edges
  & @scan ~ (e_scan (dist (0 (dnew changed))))
  & changed ~ ?((@round_stable @round_changed) (k (e_next (dnew out))))

@round_stable = (k (edges (dist out)))
  & k ~ *
  & edges ~ *
  & out ~ dist

@round_changed = (* (k (edges (dist out))))
  & @round ~ (k (edges (dist out)))

@scan = ((?((@scan_nil @scan_cons) (payload (dist (chg out)))) payload) (dist (chg out)))

@scan_nil = (* (dist (chg out)))
  & out ~ (dist chg)

@scan_cons = (* ((edge tail) (dist (chg out))))
  & @relax ~ (edge (dist (chg (dnew cnew))))
  & @scan ~ (tail (dnew (cnew out)))

@relax = ((u (v w)) (dist (chg out)))
  & {u_a u_b} ~ u
  & {v_a v_b} ~ v
  & {w_a w_b} ~ w
  & {rd wr} ~ dist
  & @at ~ (rd (u_a du))
  & @safeadd ~ (du (w_a cand_v))
  & @try_update ~ (wr (v_a (cand_v (d1 f1))))
  & {rd2 wr2} ~ d1
  & @at ~ (rd2 (v_b dv))
  & @safeadd ~ (dv (w_b cand_u))
  & @try_update ~ (wr2 (u_b (cand_u (d2 f2))))
  & chg ~ $([|] $(f1 x))
  & x ~ $([|] $(f2 any))
  & out ~ (d2 any)

@try_update = (dist (idx (cand out)))
  & {rd wr} ~ dist
  & {ir iw} ~ idx
  & {cc cs} ~ cand
  & @at ~ (rd (ir old))
  & cc ~ $([<] $(old flag))
  & flag ~ ?((@tu_no @tu_yes) (wr (iw (cs out))))

@tu_no = (wr (iw (cs out)))
  & iw ~ *
  & cs ~ *
  & out ~ (wr 0)

@tu_yes = (* (wr (iw (cs out))))
  & @set ~ (wr (iw (cs newdist)))
  & out ~ (newdist 1)

@at = ((?((@at_nil @at_cons) (payload (idx out))) payload) (idx out))

@at_nil = (* (idx out))
  & idx ~ *
  & out ~ 16777215

@at_cons = (* ((head tail) (idx out)))
  & idx ~ ?((@at_here @at_later) (head (tail out)))

@at_here = (head (tail out))
  & out ~ head
  & tail ~ *

@at_later = (idx (head (tail out)))
  & head ~ *
  & @at ~ (tail (idx out))

@set = ((?((@set_nil @set_cons) (payload (idx (val out)))) payload) (idx (val out)))

@set_nil = (* (idx (val out)))
  & idx ~ *
  & val ~ *
  & out ~ (0 *)

@set_cons = (* ((head tail) (idx (val out))))
  & idx ~ ?((@set_here @set_later) (head (tail (val out))))

@set_here = (head (tail (val out)))
  & head ~ *
  & out ~ (1 (val tail))

@set_later = (idx (head (tail (val out))))
  & @set ~ (tail (idx (val newtail)))
  & out ~ (1 (head newtail))

@safeadd = (a (w out))
  & {a_cmp a_keep} ~ a
  & a_cmp ~ $([=] $(16777215 flag))
  & flag ~ ?((@safeadd_do @safeadd_inf) (a_keep (w out)))

@safeadd_do = (a (w out))
  & a ~ $([+] $(w out))

@safeadd_inf = (* (a (w out)))
  & a ~ *
  & w ~ *
  & out ~ 16777215
