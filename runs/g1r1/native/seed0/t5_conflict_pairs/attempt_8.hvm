@prog = ((c mnl) out)
  & @filter ~ (mnl (c (0 out)))

@filter = ((?((@filter_nil @filter_cons) (pl (c (acc out)))) pl) (c (acc out)))

@filter_nil = (* (* (a a)))

@filter_cons = (* ((pair tail) (c (acc out))))
  & pair ~ (a b)
  & c ~ {cnext cuse}
  & cuse ~ {ca cb}
  & a ~ {aidx akeep}
  & b ~ {bidx bkeep}
  & @get ~ (ca (aidx va))
  & @get ~ (cb (bidx vb))
  & va ~ $([=] $(vb eq))
  & eq ~ ?((@filter_no @filter_yes) (akeep (bkeep (tail (cnext (acc out))))))

@filter_no = (* (* (tail (c (acc out)))))
  & @filter ~ (tail (c (acc out)))

@filter_yes = (a (b (tail (c (acc out)))))
  & @ins ~ ((a b) (acc newacc))
  & @filter ~ (tail (c (newacc out)))

@get = ((?((@get_nil @get_cons) (pl (idx out))) pl) (idx out))

@get_nil = (* (idx out))
  & idx ~ *
  & out ~ 0

@get_cons = (* ((head tail) (idx out)))
  & idx ~ ?((@idx_zero @idx_succ) (head (tail out)))

@idx_zero = (head (tail out))
  & tail ~ *
  & out ~ head

@idx_succ = (n (head (tail out)))
  & head ~ *
  & @get ~ (tail (n out))

@ins = ((?((@ins_nil @ins_cons) (pl (item out))) pl) (item out))

@ins_nil = (* (item out))
  & out ~ (1 (item (0 *)))

@ins_cons = (* ((old rest) (item out)))
  & old ~ {old_cmp old_keep}
  & item ~ {item_cmp item_keep}
  & @ltpair ~ (item_cmp (old_cmp less))
  & less ~ ?((@ins_after @ins_before) (item_keep (old_keep (rest out))))

@ins_after = (item (old (rest out)))
  & @ins ~ (rest (item sub))
  & out ~ (1 (old sub))

@ins_before = (* (item (old (rest out))))
  & out ~ (1 (item (1 (old rest))))

@ltpair = ((a b) ((x y) out))
  & a ~ {alt aeq}
  & x ~ {xlt xeq}
  & alt ~ $([<] $(xlt less_first))
  & aeq ~ $([=] $(xeq equal_first))
  & b ~ $([<] $(y less_second))
  & equal_first ~ $([&] $(less_second tie))
  & less_first ~ $([|] $(tie out))
