@prog = (input output)
  & input ~ (n edges)
  & @mkverts ~ (n (0 verts))
  & @peel ~ (verts (edges (0 output)))

@mkverts = (n (i out))
  & n ~ ?((@mkv_nil @mkv_succ) (i out))

@mkv_nil = (i out)
  & i ~ *
  & out ~ (0 *)

@mkv_succ = (n (i out))
  & i ~ {i_out i_inc}
  & out ~ (1 (i_out tail))
  & i_inc ~ $([+1] i_next)
  & @mkverts ~ (n (i_next tail))

@peel = (verts (edges (acc out)))
  & verts ~ {v_scan v_rem}
  & edges ~ {e_scan e_rem}
  & @find ~ (v_scan (e_scan found))
  & @found_case ~ (found (v_rem (e_rem (acc out))))

@found_case = ((?((@peel_done @peel_found) (pl (verts (edges (acc out))))) pl) (verts (edges (acc out))))

@peel_done = (pl (verts (edges (acc out))))
  & pl ~ *
  & verts ~ *
  & edges ~ *
  & out ~ acc

@peel_found = (* ((v (d nb)) (verts (edges (acc out)))))
  & d ~ $([=] $(1 z))
  & z ~ ?((@peel_iso @peel_leaf) (v (nb (verts (edges (acc out))))))

@peel_iso = (v (nb (verts (edges (acc out)))))
  & nb ~ *
  & @fverts ~ (verts (v verts2))
  & acc ~ $([+1] acc2)
  & @peel ~ (verts2 (edges (acc2 out)))

@peel_leaf = (* (v (nb (verts (edges (acc out))))))
  & v ~ {v_vfilter v_rest}
  & v_rest ~ {v_efilter1 v_efilter2}
  & nb ~ {nb_vfilter nb_rest}
  & nb_rest ~ {nb_efilter1 nb_efilter2}
  & @fverts ~ (verts (v_vfilter verts1))
  & @fverts ~ (verts1 (nb_vfilter verts2))
  & @fedges ~ (edges (v_efilter1 edges1))
  & @fedges ~ (edges1 (nb_efilter1 edges2))
  & acc ~ $([+1] acc2)
  & @peel ~ (verts2 (edges2 (acc2 out)))

@find = ((?((@find_nil @find_cons) (pl (edges out))) pl) (edges out))

@find_nil = (pl (edges out))
  & pl ~ *
  & edges ~ *
  & out ~ (0 *)

@find_cons = (* ((v vs) (edges out)))
  & v ~ {v_deg v_keep}
  & edges ~ {e_deg e_rest}
  & @degree ~ (v_deg (e_deg degree))
  & degree ~ (d nb)
  & d ~ {d_cmp d_keep}
  & d_cmp ~ $([<] $(2 z))
  & z ~ ?((@find_next @find_yes) (v_keep (d_keep (nb (vs (e_rest out))))))

@find_next = (v (d (nb (vs (edges out)))))
  & v ~ *
  & d ~ *
  & nb ~ *
  & @find ~ (vs (edges out))

@find_yes = (* (v (d (nb (vs (edges out))))))
  & vs ~ *
  & edges ~ *
  & out ~ (1 (v (d nb)))

@degree = (target (edges out))
  & @degloop ~ (edges (target (0 (0 out))))

@degloop = ((?((@dl_nil @dl_cons) (pl (target (count (neighbor out))))) pl) (target (count (neighbor out))))

@dl_nil = (pl (target (count (neighbor out))))
  & pl ~ *
  & target ~ *
  & out ~ (count neighbor)

@dl_cons = (* (((u w) tail) (target (count (neighbor out)))))
  & target ~ {t_u t_rest}
  & t_rest ~ {t_w t_next}
  & u ~ {u_cmp u_keep}
  & w ~ {w_cmp w_keep}
  & u_cmp ~ $([=] $(t_u eq_u))
  & eq_u ~ ?((@dl_u_no @dl_u_yes) (tail (t_next (count (neighbor (u_keep (w_keep out))))))

@dl_u_no = (tail (target (count (neighbor (u (w out))))))
  & target ~ {t_cmp t_next}
  & w ~ {w_cmp w_keep}
  & w_cmp ~ $([=] $(t_cmp eq))
  & eq ~ ?((@dl_none @dl_hit_w) (tail (t_next (count (neighbor (u (w_keep out))))))

@dl_none = (tail (target (count (neighbor (u (w out))))))
  & u ~ *
  & w ~ *
  & @degloop ~ (tail (target (count (neighbor out))))

@dl_hit_w = (* (tail (target (count (neighbor (u (w out))))))
  & w ~ *
  & neighbor ~ *
  & count ~ $([+1] count2)
  & @degloop ~ (tail (target (count2 (u out))))

@dl_u_yes = (* (tail (target (count (neighbor (u (w out))))))
  & u ~ *
  & neighbor ~ *
  & count ~ $([+1] count2)
  & @degloop ~ (tail (target (count2 (w out))))

@fverts = ((?((@fv_nil @fv_cons) (pl (target out))) pl) (target out))

@fv_nil = (pl (target out))
  & pl ~ *
  & target ~ *
  & out ~ (0 *)

@fv_cons = (* ((x xs) (target out)))
  & x ~ {x_cmp x_keep}
  & target ~ {target_cmp target_rec}
  & x_cmp ~ $([=] $(target_cmp z))
  & z ~ ?((@fv_keep @fv_drop) (x_keep (xs (target_rec out))))

@fv_keep = (x (xs (target out)))
  & out ~ (1 (x tail))
  & @fverts ~ (xs (target tail))

@fv_drop = (* (x (xs (target out))))
  & x ~ *
  & @fverts ~ (xs (target out))

@fedges = ((?((@fe_nil @fe_cons) (pl (target out))) pl) (target out))

@fe_nil = (pl (target out))
  & pl ~ *
  & target ~ *
  & out ~ (0 *)

@fe_cons = (* (((u v) xs) (target out)))
  & target ~ {t_u t_rest}
  & t_rest ~ {t_v t_next}
  & u ~ {u_cmp u_keep}
  & v ~ {v_cmp v_keep}
  & u_cmp ~ $([=] $(t_u zu))
  & v_cmp ~ $([=] $(t_v zv))
  & zu ~ $([|] $(zv rm))
  & rm ~ ?((@fe_keep @fe_drop) (u_keep (v_keep (xs (t_next out))))

@fe_keep = (u (v (xs (target out))))
  & out ~ (1 ((u v) tail))
  & @fedges ~ (xs (target tail))

@fe_drop = (* (u (v (xs (target out)))))
  & u ~ *
  & v ~ *
  & @fedges ~ (xs (target out))
