@prog = (input output)
  & input ~ (n edges)
  & @mkverts ~ (n (0 verts))
  & @peel ~ (verts (edges (0 output)))

@mkverts = ( ?((@mkv_nil @mkv_succ) (i out)) (i out))

@mkv_nil = (i out)
  & i ~ *
  & out ~ (0 *)

@mkv_succ = (* (i out))
  & i ~ {i_out i_inc}
  & out ~ (1 (i_out tail))
  & i_inc ~ $([+1] i_next)
  & @mkverts ~ (n (i_next tail))

@peel = (verts (edges (acc out)))
  & @find ~ (verts (edges found))
  & @leafcase ~ (found (verts (edges (acc out))))

@leafcase = ((?((@peel_done @peel_found) (payload (verts (edges (acc out))))) payload) (verts (edges (acc out))))

@peel_done = (* (verts (edges (acc out))))
  & payload ~ *
  & verts ~ *
  & edges ~ *
  & out ~ acc

@peel_found = (* ((v d) (verts (edges (acc out)))))
  & d ~ ?((@peel_iso @peel_leaf) (v (verts (edges (acc out))))

@peel_iso = (v (verts (edges (acc out))))
  & @fverts ~ (verts (v verts2))
  & acc ~ $([+1] acc2)
  & @peel ~ (verts2 (edges (acc2 out)))

@peel_leaf = (* (v (verts (edges (acc out)))))
  & v ~ {v_nb v_rest}
  & v_rest ~ {v_vf v_ef}
  & edges ~ {edges_nb edges_filter}
  & @nb_loop ~ (edges_nb (v_nb nb))
  & nb ~ {nb_vf nb_ef}
  & @fverts ~ (verts (v_vf verts1))
  & @fverts ~ (verts1 (nb_vf verts2))
  & @fedges ~ (edges_filter (v_ef edges1))
  & @fedges ~ (edges1 (nb_ef edges2))
  & acc ~ $([+1] acc2)
  & @peel ~ (verts2 (edges2 (acc2 out)))

@find = ((?((@fl_nil @fl_cons) (pl (edges out))) pl) (edges out))

@fl_nil = (pl (edges out))
  & pl ~ *
  & edges ~ *
  & out ~ (0 *)

@fl_cons = (* ((v vs) (edges out)))
  & v ~ {v_deg v_hold}
  & edges ~ {e_deg e_rest}
  & @degree ~ (v_deg (e_deg degree))
  & degree ~ {d_cmp d_saved}
  & d_cmp ~ $([<] $(2 z))
  & z ~ ?((@fl_next @fl_yes) (v_hold (d_saved (vs (e_rest out))))

@fl_next = (v (d (vs (edges out))))
  & v ~ *
  & d ~ *
  & @find ~ (vs (edges out))

@fl_yes = (* (v (d (vs (edges out)))))
  & out ~ (1 (v d))
  & vs ~ *
  & edges ~ *

@degree = (v (edges out))
  & @deg_loop ~ (edges (v (0 out)))

@deg_loop = ((?((@dl_nil @dl_cons) (pl (v (count out)))) pl) (v (count out)))

@dl_nil = (pl (v (count out)))
  & pl ~ *
  & v ~ *
  & out ~ count

@dl_cons = (* ((u w) (tail (v (count out)))))
  & v ~ {v1 v_rest}
  & v_rest ~ {v2 v_rec}
  & u ~ $([=] $(v1 z1))
  & w ~ $([=] $(v2 z2))
  & z1 ~ $([+] $(z2 both))
  & count ~ $([+] $(both count2))
  & @deg_loop ~ (tail (v_rec (count2 out)))

@nb_loop = ((?((@nb_nil @nb_cons) (pl (target out))) pl) (target out))

@nb_nil = (pl (target out))
  & pl ~ *
  & target ~ *
  & out ~ (0 *)

@nb_cons = (* ((u w) (tail (target out))))
  & target ~ {t1 t_rest}
  & t_rest ~ {t2 t_rec}
  & u ~ {u_cmp u_keep}
  & w ~ {w_cmp w_keep}
  & u_cmp ~ $([=] $(t1 zu))
  & w_cmp ~ $([=] $(t2 zw))
  & zu ~ ?((@nb_test2 @nb_hit_u) (tail (t_rec (u_keep (w_keep (zw out)))))

@nb_test2 = (tail (target (u (w (z out)))))
  & z ~ ?((@nb_none @nb_hit_w) (tail (target (u (w out))))

@nb_none = (tail (target (u (w out))))
  & tail ~ *
  & target ~ *
  & u ~ *
  & w ~ *
  & out ~ (0 *)

@nb_hit_u = (* (tail (target (u (w z out)))))
  & tail ~ *
  & target ~ *
  & u ~ *
  & w ~ out
  & z ~ *

@nb_hit_w = (* (tail (target (u (w out)))))
  & tail ~ *
  & target ~ *
  & w ~ *
  & out ~ u

@fverts = ((?((@fv_nil @fv_cons) (pl (target out))) pl) (target out))

@fv_nil = (pl (target out))
  & pl ~ *
  & target ~ *
  & out ~ (0 *)

@fv_cons = (* ((x xs) (target out)))
  & x ~ {x_cmp x_keep}
  & target ~ {target_cmp target_rec}
  & x_cmp ~ $([=] $(target_cmp z))
  & z ~ ?((@fv_keep @fv_drop) (x_keep (xs (target_rec out))))

@fv_keep = (x (xs (target out)))
  & out ~ (1 (x tail))
  & @fverts ~ (xs (target tail))

@fv_drop = (* (x (xs (target out))))
  & x ~ *
  & @fverts ~ (xs (target out))

@fedges = ((?((@fe_nil @fe_cons) (pl (target out))) pl) (target out))

@fe_nil = (pl (target out))
  & pl ~ *
  & target ~ *
  & out ~ (0 *)

@fe_cons = (* (((u v) xs) (target out)))
  & target ~ {t1 t_rest}
  & t_rest ~ {t2 t_rec}
  & u ~ {u_cmp u_keep}
  & v ~ {v_cmp v_keep}
  & u_cmp ~ $([=] $(t1 zu))
  & v_cmp ~ $([=] $(t2 zv))
  & zu ~ $([|] $(zv rm))
  & rm ~ ?((@fe_keep @fe_drop) (u_keep (v_keep (xs (t_rec out))))

@fe_keep = (u (v (xs (target out))))
  & out ~ (1 ((u v) tail))
  & @fedges ~ (xs (target tail))

@fe_drop = (* (u (v (xs (target out)))))
  & u ~ *
  & v ~ *
  & @fedges ~ (xs (target out))
