// Deduplicate a sorted list recursively. Inspect the deduplicated tail
// directly, avoiding a second copy of the entire result list.
@prog = (input output)
  & @dd ~ (input output)

@dd = ((?((@dd_nil @dd_cons) (pl out)) pl) out)

@dd_nil = (pl out)
  & pl ~ *
  & out ~ (0 *)

@dd_cons = (* ((h t) out))
  & h ~ {hcmp hkeep}
  & @dd ~ (t res)
  & res ~ (?( (@res_nil @res_cons) (payload (hcmp (hkeep out))) ) payload)

@res_nil = (payload (hcmp (hkeep out)))
  & payload ~ *
  & hcmp ~ *
  & out ~ (1 (hkeep (0 *)))

@res_cons = (* ((rh rt) (hcmp (hkeep out))))
  & rh ~ {rcmp rkeep}
  & hcmp ~ $([=] $(rcmp eq))
  & eq ~ ?((@different @equal) (hkeep (rkeep (rt out))))

@different = (hkeep (rkeep (rt out)))
  & out ~ (1 (hkeep (1 (rkeep rt))))

@equal = (hkeep (rkeep (rt out)))
  & hkeep ~ *
  & out ~ (1 (rkeep rt))
