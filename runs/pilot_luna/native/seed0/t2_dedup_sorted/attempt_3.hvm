// Deduplicate a sorted list recursively, keeping a head only when it differs
// from the first element of the deduplicated tail.
@prog = (input output)
  & @dd ~ (input output)

@dd = ((?((@dd_nil @dd_cons) (pl out)) pl) out)

@dd_nil = (* out)
  & out ~ (0 *)

@dd_cons = (* ((h t) out))
  & @dd ~ (t res)
  & res ~ (?((@res_nil @res_cons) (h out)) payload)

@res_nil = (* (h out))
  & out ~ (1 (h (0 *)))

@res_cons = (* ((rh rt) (h out)))
  & rh ~ {rcmp rkeep}
  & h ~ {hcmp hkeep}
  & hcmp ~ $([=] $(rcmp eq))
  & eq ~ ?((@different @equal) (rkeep (rt (hkeep out))))

@different = (* (rkeep (rt (hkeep out))))
  & out ~ (1 (hkeep (1 (rkeep rt))))

@equal = (* (rkeep (rt (hkeep out))))
  & hkeep ~ *
  & out ~ (1 (rkeep rt))
