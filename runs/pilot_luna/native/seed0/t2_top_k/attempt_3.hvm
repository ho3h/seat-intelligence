@prog = ((k xs) out)
  & @sort ~ (xs sorted)
  & @take ~ (k (sorted out))

@sort = ((?((@sort_nil @sort_cons) (pl out)) pl) out)

@sort_nil = (* (0 *))

@sort_cons = (* ((h t) out))
  & @sort ~ (t sorted)
  & @ins ~ (h (sorted out))

@ins = (h ((?((@ins_nil @ins_cons) (pl (h out))) pl) out))

@ins_nil = (* (h (1 (h (0 *)))))

@ins_cons = (* ((x t) (h out)))
  & h ~ {hc hi}
  & x ~ {xc xi}
  & hc ~ $([>] $(xc z))
  & z ~ ?((@ins_after @ins_before) (hi (xi (t out))))

@ins_after = (hi (xi (t out)))
  & @ins ~ (hi (t r))
  & out ~ (1 (xi r))

@ins_before = (hi (xi (t (1 (hi (1 (xi t)))))))

@take = (?( (@take_zero @take_more) (xs out)) (xs out))

@take_zero = (* (0 *))

@take_more = (k ((?((@take_nil @take_cons) (pl (k out))) pl) out))

@take_nil = (* (* (0 *)))

@take_cons = (* ((h t) (k out)))
  & @take ~ (k (t r))
  & out ~ (1 (h r))
