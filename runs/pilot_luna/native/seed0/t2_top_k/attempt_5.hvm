@prog = ((k xs) out)
  & @sort ~ (xs sorted)
  & @take ~ (k (sorted out))

@sort = ((?((@sort_nil @sort_cons) (pl out)) pl) out)

@sort_nil = (* (pl out))
  & pl ~ *
  & out ~ (0 *)

@sort_cons = (* ((h t) out))
  & @sort ~ (t sorted)
  & @ins ~ (h (sorted out))

@ins = (x ((?((@ins_nil @ins_cons) (pl (x out))) pl) out))

@ins_nil = (* (pl (x out)))
  & pl ~ *
  & out ~ (1 (x (0 *)))

@ins_cons = (* ((h t) (x out)))
  & h ~ {hc hk}
  & x ~ {xc xk}
  & xc ~ $([>] $(hc z))
  & z ~ ?((@ins_recur @ins_before) (hk (xk (t out))))

@ins_recur = (* (hk (xk (t out))))
  & @ins ~ (xk (t r))
  & out ~ (1 (hk r))

@ins_before = (* (hk (xk (t out))))
  & out ~ (1 (xk (1 (hk t))))

@take = (?((@take_zero @take_more) (xs out)) (xs out))

@take_zero = (* (xs out))
  & xs ~ *
  & out ~ (0 *)

@take_more = (k ((?((@take_nil @take_cons) (pl (k out))) pl) out))

@take_nil = (* (pl (k out)))
  & pl ~ *
  & k ~ *
  & out ~ (0 *)

@take_cons = (* ((h t) (k out)))
  & @take ~ (k (t r))
  & out ~ (1 (h r))
