// Entry point
@prog = (input out)
  & input ~ (a b)
  & @outer ~ (a (b ((0 *) out)))

// Multiply each digit of a by b, shifting b by one digit each step.
@outer = ((?((@outer_nil @outer_cons) (pl (bs (acc out)))) pl) (bs (acc out)))

@outer_nil = (* (bs (acc out)))
  & @trim ~ (acc out)

@outer_cons = (* ((d t) (bs (acc out))))
  & bs ~ {bmul bnext}
  & @dmul ~ (bmul (d (0 part)))
  & @add ~ (acc (part sum))
  & @outer ~ (t ((1 (0 bnext)) (sum out)))

// Multiply a list by one digit, carrying in base 4096.
@dmul = ((?((@dmul_nil @dmul_cons) (pl (d (c out)))) pl) (d (c out)))

@dmul_nil = (* (d (c out)))
  & c ~ ?((@dmul_end0 @dmul_endp) out)

@dmul_cons = (* ((h t) (d (c out))))
  & h ~ $([*] $(d p))
  & @calc ~ (p (c (0 (r q))))
  & out ~ (1 (r rest))
  & @dmul ~ (t (d (q rest)))

@dmul_end0 = (0 *)

@dmul_endp = (cm out)
  & cm ~ $([+1] digit)
  & out ~ (1 (digit (0 *)))

// Calculate (x + y + c) as (remainder, carry) in base 4096.
@calc = (x (y (c (r q))))
  & x ~ $([+] $(y s))
  & s ~ $([+] $(c z))
  & z ~ {u v}
  & u ~ $([%] $(4096 r))
  & v ~ $([/] $(4096 q))

// Add two lists of base-4096 digits.
@add = (x (y out))
  & @addrec ~ (x (y (0 out)))

@addrec = ((?((@ax0 @ax1) (pl (y (c out)))) pl) (y (c out)))

@ax0 = (* (y (c out)))
  & @addy0 ~ (y (c out))

@ax1 = (* ((h t) (y (c out))))
  & @addy1 ~ (y (h (t (c out))))

@addy0 = ((?((@ay0 @ay1) (pl (c out))) pl) (c out))

@ay0 = (* (c out))
  & c ~ ?((@addend0 @addend1) out)

@ay1 = (* ((g u) (c out)))
  & @calc ~ (0 (g (c (r q))))
  & out ~ (1 (r rest))
  & @addy0 ~ (u (q rest))

@addy1 = ((?((@by0 @by1) (pl (h (t (c out))))) pl) (h (t (c out))))

@by0 = (* (h (t (c out))))
  & @calc ~ (h (0 (c (r q))))
  & out ~ (1 (r rest))
  & @addrec ~ (t ((0 *) (q rest)))

@by1 = (* ((g u) (h (t (c out)))))
  & @calc ~ (h (g (c (r q))))
  & out ~ (1 (r rest))
  & @addrec ~ (t (u (q rest)))

@addend0 = (0 *)

@addend1 = (* out)
  & out ~ (1 (1 (0 *)))

// Trim high zero digits. The helper returns (trimmed-list, nonzero-flag).
@trim = (l out)
  & @trimf ~ (l (out *))

@trimf = ((?((@trimf_nil @trimf_cons) (pl out)) pl) out)

@trimf_nil = (* ((0 *) 0))

@trimf_cons = (* ((h t) out))
  & @trimf ~ (t (rt flag))
  & h ~ {hc hk}
  & hc ~ $([!] $(0 b))
  & b ~ $([|] $(flag nz))
  & nz ~ ?((@trimf_drop @trimf_keep) (hk (rt out)))

@trimf_drop = (h (rt out))
  & h ~ *
  & out ~ (rt 0)

@trimf_keep = (* (h (rt out)))
  & out ~ ((1 (h rt)) 1)
