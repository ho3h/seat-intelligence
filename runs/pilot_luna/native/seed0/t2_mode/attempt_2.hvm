// Most frequent value; ties go to the smallest value.

@prog = (input out)
  & {remaining full} ~ input
  & @mode ~ (remaining (full (0 (0 out))))

// mode(remaining, full, best_value, best_count, out)
@mode = ((?((@mode_nil @mode_cons) (pl (full (best (bc out))))) pl) (full (best (bc out))))

@mode_nil = (pl (full (best (bc out))))
  & pl ~ *
  & full ~ *
  & bc ~ out
  & best ~ out

@mode_cons = (* ((h t) (full (best (bc out)))))
  & {scan full_keep} ~ full
  & {candidate count_candidate} ~ h
  & @cnt ~ (scan (count_candidate (0 count)))
  & @decide ~ (candidate (count (full_keep (best (bc (t out))))))

// cnt(list, candidate, accumulator, out)
@cnt = ((?((@cnt_nil @cnt_cons) (pl (candidate (acc out)))) pl) (candidate (acc out)))

@cnt_nil = (pl (candidate (acc out)))
  & pl ~ *
  & candidate ~ *
  & acc ~ out

@cnt_cons = (* ((h t) (candidate (acc out))))
  & {cmp next_candidate} ~ candidate
  & h ~ $([=] $(cmp eq))
  & eq ~ ?((@cnt_no @cnt_yes) (t (next_candidate (acc out))))

@cnt_no = (t (candidate (acc out)))
  & @cnt ~ (t (candidate (acc out)))

@cnt_yes = (t (candidate (acc out)))
  & acc ~ $([+] $(1 acc2))
  & @cnt ~ (t (candidate (acc2 out)))

// decide(candidate, count, full, best_value, best_count, tail, out)
@decide = (candidate (count (full (best (bc (t out))))))
  & {cg cr} ~ count
  & {bg br} ~ bc
  & cg ~ $([>] $(bg gt))
  & gt ~ ?((@dec_low @dec_high) (candidate (cr (full (best (br (t out))))))

@dec_high = (candidate (cr (full (best (br (t out))))))
  & best ~ *
  & br ~ *
  & @mode ~ (t (full (candidate (cr out))))

@dec_low = (candidate (cr (full (best (br (t out))))))
  & {cl ct} ~ cr
  & {bl bt} ~ br
  & cl ~ $([<] $(bl lt))
  & lt ~ ?((@dec_keep @dec_tie) (candidate (ct (full (best (bt (t out))))))

@dec_keep = (candidate (ct (full (best (bt (t out))))))
  & candidate ~ *
  & ct ~ *
  & @mode ~ (t (full (best (bt out))))

@dec_tie = (candidate (ct (full (best (bt (t out))))))
  & {cc ck} ~ candidate
  & {bc_cmp bk} ~ best
  & cc ~ $([<] $(bc_cmp smaller))
  & smaller ~ ?((@tie_keep @tie_update) (ck (ct (full (bk (bt (t out))))))

@tie_keep = (ck (ct (full (bk (bt (t out))))))
  & ck ~ *
  & ct ~ *
  & @mode ~ (t (full (bk (bt out))))

@tie_update = (ck (ct (full (bk (bt (t out))))))
  & bk ~ *
  & bt ~ *
  & @mode ~ (t (full (ck (ct out))))
