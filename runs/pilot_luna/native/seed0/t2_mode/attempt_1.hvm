// t2_mode: most frequent value; ties go to the smallest value.

@prog = (input out)
  & {remaining full} ~ input
  & @mode ~ (remaining (full (0 (0 out))))

// mode(remaining, full, best_value, best_count, out)
@mode = ((?((@mode_nil @mode_cons) (pl (full (best (bc out))))) pl) (full (best (bc out))))

@mode_nil = (* (full (best (bc (o o)))))
  & full ~ *
  & bc ~ *

@mode_cons = (* ((h t) (full (best (bc out)))))
  & {full_scan full_keep} ~ full
  & {h_count h_decide} ~ h
  & @cnt ~ (full_scan (h_count (0 count)))
  & @decide ~ (h_decide (count (full_keep (best (bc (t out))))))

// cnt(list, candidate, accumulator, out)
@cnt = ((?((@cnt_nil @cnt_cons) (pl (candidate (acc out)))) pl) (candidate (acc out)))

@cnt_nil = (* (candidate (acc (o o))))
  & candidate ~ *
  & acc ~ *

@cnt_cons = (* ((h t) (candidate (acc out))))
  & {candidate_cmp candidate_rec} ~ candidate
  & h ~ $([=] $(candidate_cmp eq))
  & eq ~ ?((@cnt_no @cnt_yes) (t (candidate_rec (acc out))))

@cnt_no = (* (t (candidate (acc out))))
  & @cnt ~ (t (candidate (acc out)))

@cnt_yes = (* (t (candidate (acc out))))
  & acc ~ $([+] $(1 acc2))
  & @cnt ~ (t (candidate (acc2 out)))

// decide(candidate, count, full, best_value, best_count, tail, out)
@decide = (candidate (count (full (best (bc (tail out))))))
  & {count_cmp count_ctx} ~ count
  & {bc_cmp bc_ctx} ~ bc
  & count_cmp ~ $([>] $(bc_cmp gt))
  & gt ~ ?((@dec_eq @dec_update) (candidate (count_ctx (full (best (bc_ctx (tail out))))))

@dec_eq = (candidate (count (full (best (bc (tail out))))))
  & {candidate_cmp candidate_ctx} ~ candidate
  & {best_cmp best_ctx} ~ best
  & candidate_cmp ~ $([<] $(best_cmp lt))
  & lt ~ ?((@dec_keep @dec_tie) (candidate_ctx (count (full (best_ctx (bc (tail out))))))

@dec_keep = (* (candidate (count (full (best (bc (tail out)))))))
  & candidate ~ *
  & count ~ *
  & @mode ~ (tail (full (best (bc out))))

@dec_tie = (* (candidate (count (full (best (bc (tail out)))))))
  & best ~ *
  & bc ~ *
  & @mode ~ (tail (full (candidate (count out))))

@dec_update = (* (candidate (count (full (best (bc (tail out)))))))
  & best ~ *
  & bc ~ *
  & @mode ~ (tail (full (candidate (count out))))
