// Merge two ascending lists.

@prog = ((xs ys) out)
  & @mg ~ (xs (ys out))

@mg = ((?((@mg_x_nil @mg_x_cons) (pl (ys out))) pl) (ys out))

@mg_x_nil = (pl (ys out))
  & pl ~ *
  & ys ~ out

@mg_x_cons = (* ((x xt) (ys out)))
  & ys ~ ((?((@mg_y_nil @mg_y_cons) (py (x (xt out)))) py)

@mg_y_nil = (py (x (xt out)))
  & py ~ *
  & out ~ (1 (x xt))

@mg_y_cons = (* (py (x (xt out))))
  & py ~ (y yt)
  & x ~ {xc xk}
  & y ~ {yc yk}
  & xc ~ $([>] $(yc gt))
  & gt ~ ?((@mg_take_x @mg_take_y) (xk (xt (yk (yt out))))

@mg_take_x = (x (xt (y (yt out))))
  & @mg ~ (xt ((1 (y yt)) tail))
  & out ~ (1 (x tail))

@mg_take_y = (* (x (xt (y (yt out)))))
  & @mg ~ ((1 (x xt)) (yt tail))
  & out ~ (1 (y tail))
