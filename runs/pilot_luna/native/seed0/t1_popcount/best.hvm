// Parallel 24-bit population count; multiply sums the three byte counts.
@prog = (n out)
  & n ~ {n0 n1}
  & n1 ~ $([>>] $(1 s1))
  & s1 ~ $([&] $(5592405 masked1))
  & n0 ~ $([-] $(masked1 x1))

  & x1 ~ {x1a x1b}
  & x1a ~ $([&] $(3355443 lo2))
  & x1b ~ $([>>] $(2 s2))
  & s2 ~ $([&] $(3355443 hi2))
  & lo2 ~ $([+] $(hi2 x2))

  & x2 ~ {x2a x2b}
  & x2b ~ $([>>] $(4 s3))
  & x2a ~ $([+] $(s3 sum3))
  & sum3 ~ $([&] $(986895 x3))

  & x3 ~ $([*] $(65793 mult))
  & mult ~ $([>>] $(16 out))
