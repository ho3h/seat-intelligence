
@prog = ((n (L (tau (E (HE (M HM)))))) (C (F K)))
  & L ~ {L1 {L2 {L3 {L4 {L5 {L6 {L7 {L8 {L9 {L10 L11}}}}}}}}}}
  & @ew ~ (HE ((L1 tau) (E (te t2e))))
  & @mw ~ (HM (L2 (M (tm (((0 *) F) t2m)))))
  & @mg ~ (L3 (te (tm T)))
  & @dz ~ (T (L4 (0 (S P))))
  & @A_loop ~ (L5 (S Sf))
  & @pzf ~ (Sf (P (L6 (L7 (0 (S3 t2v))))))
  & @mg2 ~ (L8 (t2e (t2m t2a)))
  & @mg2 ~ (L9 (t2a (t2v T2)))
  & @st ~ (T2 (L10 (0 ((0 *) K))))
  & @A_tl ~ (S3 (L11 (0 (n ((0 *) C)))))

// ---- mg2: merge of stage-2 sparse tries; leaf payload (V (E M)), three difference lists
@mg2 = (L (a (b o)))
  & a ~ (ta pa)
  & ta ~ ?((@mh_a0 @mh_a1) (pa (L (b o))))
@mh_a0 = (* (* (b b)))
@mh_a1 = (* (pa (L (b o))))
  & b ~ (tb pb)
  & tb ~ ?((@mh_b0 @mh_b1) (pa (pb (L o))))
@mh_b0 = (pa (* (* (1 pa))))
@mh_b1 = (* (pa (pb (L (1 po)))))
  & L ~ ?((@mh_lf @mh_nd) (pa (pb po)))
@mh_lf = (((x1 r1) ((x2 r2) (x3 r3))) (((h1 x1) ((h2 x2) (h3 x3))) ((h1 r1) ((h2 r2) (h3 r3)))))
@mh_nd = (lm ((al ar) ((bl br) (ol or))))
  & lm ~ {l1 l2}
  & @mg2 ~ (l1 (al (bl ol)))
  & @mg2 ~ (l2 (ar (br or)))

// ---- edge tree walk: stage-1 trie (channels, probe on u) and stage-2 trie (edge item keyed by label(u))
@ew = (h (K (e (t t2))))
  & h ~ ?((@ew_leaf @ew_node) (K (e (t t2))))
@ew_node = (hm ((L tau) ((el er) (t t2))))
  & hm ~ {h1 h2}
  & L ~ {L1 {L2 {L3 L4}}}
  & tau ~ {t1 tx}
  & @ew ~ (h1 ((L1 t1) (el (tl t2l))))
  & @ew ~ (h2 ((L2 tx) (er (tr t2r))))
  & @mg ~ (L3 (tl (tr t)))
  & @mg2 ~ (L4 (t2l (t2r t2)))
@ew_leaf = ((L tau) ((u (v s)) (t t2)))
  & s ~ $([<] $(tau rej))
  & rej ~ ?((@ew_acc @ew_rej) (L (u (v (t t2)))))
@ew_rej = (* (* (* (* ((0 *) (0 *))))))
@ew_acc = (L (u (v (t t2))))
  & L ~ {L1 {L2 {L3 L4}}}
  & u ~ {u1 u2}
  & v ~ {v1 v2}
  & @pa ~ (u1 (L1 (((c2 c1) (g1 (1 (wu g1)))) pu)))
  & @pa ~ (v1 (L2 (((c1 c2) (q2 q2)) pv)))
  & @mg ~ (L3 (pu (pv t)))
  & @pa ~ (wu (L4 (((e1 e1) ((h (1 ((u2 v2) h))) (q3 q3))) t2)))

// ---- must-not-link walk: probes, conflict list, stage-2 pair items keyed by the shared label
@mw = (h (L (m (t (r t2)))))
  & h ~ ?((@mw_leaf @mw_node) (L (m (t (r t2)))))
@mw_node = (hm (L ((ml mr) (t ((rh rr) t2)))))
  & hm ~ {h1 h2}
  & L ~ {L1 {L2 {L3 L4}}}
  & @mw ~ (h1 (L1 (ml (tl ((x rr) t2l)))))
  & @mw ~ (h2 (L2 (mr (tr ((rh x) t2r)))))
  & @mg ~ (L3 (tl (tr t)))
  & @mg2 ~ (L4 (t2l (t2r t2)))
@mw_leaf = (L ((a (b live)) (t (r t2))))
  & live ~ ?((@mw_dead @mw_live) (L (a (b (t (r t2))))))
@mw_dead = (* (* (* ((0 *) ((q q) (0 *))))))
@mw_live = (* (L (a (b (t ((rh rr) t2))))))
  & L ~ {L1 {L2 {L3 L4}}}
  & a ~ {a1 a2}
  & b ~ {b1 b2}
  & @pa ~ (a1 (L1 (((@A_zs *) (g1 (1 (wa g1)))) pu)))
  & @pa ~ (b1 (L2 (((@A_zs *) (g2 (1 (wb g2)))) pv)))
  & @mg ~ (L3 (pu (pv t)))
  & wa ~ {la1 la2}
  & la1 ~ $([=] $(wb eq))
  & eq ~ ?((@mw_ne @mw_eq) (L4 (a2 (b2 (la2 ((rh rr) t2))))))
@mw_ne = (* (* (* (* ((h h) (0 *))))))
@mw_eq = (* (L (a (b (l ((h (1 ((a1 (b1 l1)) h))) t2))))))
  & a ~ {a1 a2}
  & b ~ {b1 b2}
  & l ~ {l1 l2}
  & @pa ~ (l2 (L (((e e) ((f f) (g (1 ((a2 b2) g))))) t2)))

// ---- after LP: probes get labels; every vertex emits (i reply) keyed by its label; leaves become (reply 0)
@pzf = (s (p (L (LF (base (o t2))))))
  & L ~ ?((@pzf_leaf @pzf_node) (s (p (LF (base (o t2))))))
@pzf_leaf = ((x *) (pr (LF (b ((r 0) t2)))))
  & @sd ~ (pr (x y))
  & @pa ~ (y (LF (((h (1 ((b r) h))) ((e e) (q q))) t2)))
@pzf_node = (lm ((sa sc) ((qa qc) (LF (base ((oa oc) t2))))))
  & lm ~ {l1 {l2 l3}}
  & LF ~ {F1 {F2 F3}}
  & base ~ {b1 b2}
  & 1 ~ $([<<] $(l3 half))
  & b2 ~ $([+] $(half bR))
  & @pzf ~ (sa (qa (l1 (F1 (b1 (oa ta))))))
  & @pzf ~ (sc (qc (l2 (F2 (bR (oc tc))))))
  & @mg2 ~ (F3 (ta (tc t2)))

// ---- stage-2 walk: per label c, reply c (no pair) or run the greedy (pairs); k = difference list of skipped merges
@st = (t (L (base k)))
  & t ~ (tg pl)
  & tg ~ ?((@st_e @st_p) (pl (L (base k))))
@st_e = (* (* (* (h h))))
@st_p = (* (pl (L (base k))))
  & L ~ ?((@st_leaf @st_node) (pl (base k)))
@st_node = (lm ((a c) (base (h r))))
  & lm ~ {l1 {l2 l3}}
  & base ~ {b1 b2}
  & 1 ~ $([<<] $(l3 half))
  & b2 ~ $([+] $(half bR))
  & @st ~ (a (l1 (b1 (x r))))
  & @st ~ (c (l2 (bR (h x))))
@st_leaf = ((((0 *) vs) (((0 *) es) ((0 *) ms))) (c k))
  & ms ~ (mt mp)
  & mt ~ ?((@st_ok @st_bad) (mp (vs (es (c k)))))
@st_ok = (* (vs (es (c (h h)))))
  & @rep ~ (vs c)
  & es ~ *
@st_bad = (* (mp (vs (es (c k)))))
  & c ~ *
  & @cells ~ (vs (H T))
  & @fold ~ (es (H (T ((1 mp) (K1 (Tf Hf))))))
  & @rpl ~ (Tf Hf)
  & @cat ~ (K1 k)
@rep = ((?((@rp_nil @rp_cons) (pl c)) pl) c)
@rp_nil = (* *)
@rp_cons = (* (((b r) rest) c))
  & c ~ {r c2}
  & b ~ *
  & @rep ~ (rest c2)
// cells: member list [(i reply)] -> perfect tree (height lg(s-1)) of cells (x (c reply)), padding (16777215 (0 *))
@cells = (vs (H T))
  & @len ~ (vs (0 (s vs2)))
  & s ~ $([-] $(1 s1))
  & @lg ~ (s1 Hc)
  & Hc ~ {H1 H}
  & @bt ~ (H1 (vs2 (T rest)))
  & rest ~ *
@len = ((?((@ln_nil @ln_cons) (pl (n (o l2)))) pl) (n (o l2)))
@ln_nil = (* (n (n (0 *))))
@ln_cons = (* ((h t) (n (o (1 (h t2))))))
  & n ~ $([+1] n2)
  & @len ~ (t (n2 (o t2)))
@bt = (H (l (T rest)))
  & H ~ ?((@bt_leaf @bt_node) (l (T rest)))
@bt_node = (hm (l ((a b) rest)))
  & hm ~ {h1 h2}
  & @bt ~ (h1 (l (a mid)))
  & @bt ~ (h2 (mid (b rest)))
@bt_leaf = (l (T rest))
  & l ~ (tg pl)
  & tg ~ ?((@bt_pad @bt_take) (pl (T rest)))
@bt_pad = (* ((16777215 (0 *)) (0 *)))
@bt_take = (* (((x r) t) ((x1 (x2 r)) t)))
  & x ~ {x1 x2}
@rpl = (t H)
  & H ~ ?((@rpl_leaf @rpl_node) t)
@rpl_leaf = (* (c c))
@rpl_node = (hm (l r))
  & hm ~ {h1 h2}
  & @rpl ~ (l h1)
  & @rpl ~ (r h2)
@cat = ((?((@ct_nil @ct_cons) (pl (tail o))) pl) (tail o))
@ct_nil = (* (t t))
@ct_cons = (* ((h t) (tail (1 (h o)))))
  & @cat ~ (t (tail o))
@pa = (k (L (P o)))
  & L ~ ?((@pa_leaf @pa_node) (k (P o)))
@pa_leaf = (* (P (1 P)))
@pa_node = (lm (k (P (1 kids))))
  & k ~ {k1 k2}
  & lm ~ {l1 l2}
  & k1 ~ $([>>] $(l1 sh))
  & sh ~ $([&] $(1 b))
  & b ~ ?((@pa_L @pa_R) (k2 (l2 (P kids))))
@pa_L = (k (L (P (sub (0 *)))))
  & @pa ~ (k (L (P sub)))
@pa_R = (* (k (L (P ((0 *) sub)))))
  & @pa ~ (k (L (P sub)))

// ---- merge two sparse tries of remaining depth L; leaf payloads (C P) are pairs of difference lists (hole result)
@mg = (L (a (b o)))
  & a ~ (ta pa)
  & ta ~ ?((@mg_a0 @mg_a1) (pa (L (b o))))
@mg_a0 = (* (* (b b)))
@mg_a1 = (* (pa (L (b o))))
  & b ~ (tb pb)
  & tb ~ ?((@mg_b0 @mg_b1) (pa (pb (L o))))
@mg_b0 = (pa (* (* (1 pa))))
@mg_b1 = (* (pa (pb (L (1 po)))))
  & L ~ ?((@mg_lf @mg_nd) (pa (pb po)))
@mg_lf = ((ca (y qr)) ((cb (qh y)) (cc (qh qr))))
  & @fan ~ (ca (cb cc))
@mg_nd = (lm ((al ar) ((bl br) (ol or))))
  & lm ~ {l1 l2}
  & @mg ~ (l1 (al (bl ol)))
  & @mg ~ (l2 (ar (br or)))

// ---- edge tree walk: height h, K = (L tau) -> sparse trie of channel ends
@dz = (t (L (base (S P))))
  & t ~ (tg pl)
  & tg ~ ?((@dz_e @dz_p) (pl (L (base (S P)))))
@dz_e = (* (L (base (S P))))
  & L ~ {L1 L2}
  & @mk ~ (L1 (base (1 S)))
  & @zl ~ (L2 P)
@dz_p = (* (pl (L (base (S P)))))
  & L ~ ?((@dz_leaf @dz_node) (pl (base (S P))))
@dz_leaf = ((c ((0 *) pr)) (b ((b (1 (c (0 *)))) pr)))
@dz_node = (lm ((a c) (base ((Sa Sc) (Pa Pc)))))
  & lm ~ {l1 {l2 l3}}
  & base ~ {b1 b2}
  & 1 ~ $([<<] $(l3 half))
  & b2 ~ $([+] $(half bR))
  & @dz ~ (a (l1 (b1 (Sa Pa))))
  & @dz ~ (c (l2 (bR (Sc Pc))))

// ---- after LP: send every final label into the vertex's probe wires; leaves become (x 0)
@sd = ((?((@sd_nil @sd_cons) (pl (x y))) pl) (x y))
@sd_nil = (* (x x))
@sd_cons = (* ((p rest) (x y)))
  & x ~ {p x2}
  & @sd ~ (rest (x2 y))

// ---- fan: joins two channel-likes (i o) into one, as a persistent process. The value from above is copied into both
// children at once (DUP chain, ~1 rewrite per level); only the recursion waits on a switch (gate: one round per value)

// ---- fan: joins two channel-likes (i o) into one, as a persistent process. The value from above is copied into both
// children at once (DUP chain, ~1 rewrite per level); only the recursion waits on a switch (gate: one round per value)
@fan = (A (B (I O)))
  & @fl ~ (O (I (A B)))
@fl = ((x O2) (I ((ia oa) (ib ob))))
  & x ~ {x1 {x2 x3}}
  & oa ~ (x1 oa2)
  & ob ~ (x2 ob2)
  & x3 ~ ?((@fl_go (* @fl_go)) (O2 (I ((ia oa2) (ib ob2)))))
@fl_go = (O2 (I ((ia oa2) (ib ob2))))
  & ia ~ (ya ia2)
  & ib ~ (yb ib2)
  & ya ~ {a1 a2}
  & yb ~ {b1 b2}
  & a1 ~ $([<] $(b1 lt))
  & lt ~ ?(((a (* a)) (* (* (b b)))) (a2 (b2 y)))
  & I ~ (y I2)
  & @fl ~ (O2 (I2 ((ia2 oa2) (ib2 ob2))))
@fold = ((?((@f_nil @f_cons) (pl (H (T (M (os out)))))) pl) (H (T (M (os out)))))
@f_nil = (* (H (T (* ((0 *) (T H))))))
@f_cons = (* (((u v) rest) (H (T (M (os out))))))
  & H ~ {H1 {H2 H3}}
  & u ~ {u1 u2}
  & v ~ {v1 v2}
  & @fd ~ (T (H1 (u1 (v1 (T1 (cu cv))))))
  & cu ~ {cu1 {cu2 {cu3 {cu4 {cu5 cu6}}}}}
  & cv ~ {cv1 {cv2 {cv3 {cv4 cv5}}}}
  & @blk ~ (M (cu1 (cv1 (M1 bl))))
  & cu2 ~ $([!] $(cv2 ne))
  & bl ~ {bl1 bl2}
  & ne ~ {ne1 ne2}
  & bl1 ~ $([^] $(1 nb))
  & ne1 ~ $([&] $(nb g))
  & ne2 ~ $([&] $(bl2 sk))
  & cu3 ~ $([<] $(cv3 lt))
  & cv4 ~ $([-] $(cu4 dd))
  & lt ~ $([*] $(dd ad))
  & cu5 ~ $([+] $(ad nc))
  & {Pa Pb} ~ (cu6 (cv5 (nc g)))
  & @rl ~ (T1 (H2 (Pa T2)))
  & @rlm ~ (M1 (Pb M2))
  & sk ~ ?((@ns @ys) (u2 (v2 (os os2))))
  & @fold ~ (rest (H3 (T2 (M2 (os2 out)))))
@ns = (* (* (o o)))
@ys = (* (u (v ((1 ((u v) o)) o))))

// fd: (cu, cv) = labels of u and v; the tree is rebuilt unchanged
@fd = (t (H (u (v (t2 (cu cv))))))
  & H ~ ?((@fd_leaf @fd_node) (t (u (v (t2 (cu cv))))))
@fd_leaf = ((x (c r)) (u (v ((x3 (c3 r)) (cu cv)))))
  & x ~ {x1 {x2 x3}}
  & c ~ {c1 {c2 c3}}
  & x1 ~ $([=] $(u eu))
  & x2 ~ $([=] $(v ev))
  & eu ~ $([*] $(c1 cu))
  & ev ~ $([*] $(c2 cv))
@fd_node = (hm ((l r) (u (v ((l2 r2) (cu cv))))))
  & hm ~ {h1 h2}
  & u ~ {ua ub}
  & v ~ {va vb}
  & @fd ~ (l (h1 (ua (va (l2 (cul cvl))))))
  & @fd ~ (r (h2 (ub (vb (r2 (cur cvr))))))
  & cul ~ $([+] $(cur cu))
  & cvl ~ $([+] $(cvr cv))

// blk: 1 iff some pair (a b) of M has {a, b} == {cu, cv}; M rebuilt
@blk = ((?((@bk_nil @bk_cons) (pl (cu (cv (m1 bl))))) pl) (cu (cv (m1 bl))))
@bk_nil = (* (* (* ((0 *) 0))))
@bk_cons = (* (((a b) rest) (cu (cv ((1 ((a3 b3) rest2)) bl)))))
  & a ~ {a1 {a2 a3}}
  & b ~ {b1 {b2 b3}}
  & cu ~ {cu1 {cu2 cu3}}
  & cv ~ {cv1 {cv2 cv3}}
  & a1 ~ $([=] $(cu1 e1))
  & b1 ~ $([=] $(cv1 e2))
  & a2 ~ $([=] $(cv2 e3))
  & b2 ~ $([=] $(cu2 e4))
  & e1 ~ $([&] $(e2 h1))
  & e3 ~ $([&] $(e4 h2))
  & h1 ~ $([|] $(h2 h))
  & h ~ $([|] $(blr bl))
  & @blk ~ (rest (cu3 (cv3 (rest2 blr))))

// rlc: relabel one label c with the bundle (cu cv nc g)
@rlc = (c ((cu (cv (nc g))) c2))
  & c ~ {c1 {cx {c3 c4}}}
  & c1 ~ $([=] $(cu m1))
  & cx ~ $([=] $(cv m2))
  & m1 ~ $([|] $(m2 m))
  & m ~ $([&] $(g gm))
  & nc ~ $([-] $(c3 d))
  & gm ~ $([*] $(d e))
  & c4 ~ $([+] $(e c2))
@rl = (t (H (P t2)))
  & H ~ ?((@rl_leaf @rl_node) (t (P t2)))
@rl_node = (hm ((l r) (P (l2 r2))))
  & hm ~ {h1 h2}
  & P ~ {Pa Pb}
  & @rl ~ (l (h1 (Pa l2)))
  & @rl ~ (r (h2 (Pb r2)))
@rl_leaf = ((x (c r)) (P (x (c2 r))))
  & @rlc ~ (c (P c2))
@rlm = ((?((@rm_nil @rm_cons) (pl (P o))) pl) (P o))
@rm_nil = (* (* (0 *)))
@rm_cons = (* (((a b) rest) (P (1 ((a2 b2) rest2)))))
  & P ~ {Pa {Pb Pc}}
  & @rlc ~ (a (Pa a2))
  & @rlc ~ (b (Pb b2))
  & @rlm ~ (rest (Pc rest2))

// of: the real cells (x c) in tree order
// ---- cc core A (op mx)
@A_cc = (L (es Sf))
  & L ~ {L1 {L2 L3}}
  & @mk ~ (L1 (0 (1 S0)))
  & @A_ea_blk ~ (es ((L2 S0) S))
  & @A_loop ~ (L3 (S Sf))
@A_cct = (L (tau (es Sf)))
  & L ~ {L1 {L2 L3}}
  & @mk ~ (L1 (0 (1 S0)))
  & @A_et_blk ~ (es (((L2 tau) S0) S))
  & @A_loop ~ (L3 (S Sf))
@A_ea_step = ((L s) ((u v) (L3 s2)))
  & L ~ {L1 {L2 L3}}
  & @cp ~ (s (u (L1 ((c2 c1) s1))))
  & @cp ~ (s1 (v (L2 ((c1 c2) s2))))
@A_ea_fin = ((* s) s)
@A_et_step = (((L tau) s) ((u (v sc)) ((L3 tau3) s2)))
  & L ~ {L1 {L2 L3}}
  & tau ~ {t1 tau3}
  & sc ~ $([<] $(t1 rej))
  & rej ~ {r1 r2}
  & @cq ~ (s (u (L1 ((r1 (c2 c1)) s1))))
  & @cq ~ (s1 (v (L2 ((r2 (c1 c2)) s2))))
@A_et_fin = ((* s) s)
@A_ch_acc = ((c2 c1) (c1 c2))
@A_ch_rej = (* ((@A_zs *) (@A_zs *)))
@A_zs = (0 @A_zs)
@A_loop = (L (S O))
  & @A_spawn ~ (L (S (D (F O))))
  & D ~ (1 (1 D3))
  & @A_rt ~ (F D3)
@A_spawn = (L (S (D (F O))))
  & L ~ ?((@A_sp_leaf @A_sp_node) (S (D (F O))))
@A_sp_leaf = ((x ch) (D (F O)))
  & @A_lf ~ (x (ch (D (F O))))
@A_sp_node = (lm ((a b) (D (F (Oa Ob)))))
  & lm ~ {l1 l2}
  & @A_dn ~ (D (Da Db))
  & @A_up ~ (Fa (Fb F))
  & @A_spawn ~ (l1 (a (Da (Fa Oa))))
  & @A_spawn ~ (l2 (b (Db (Fb Ob))))
// vertex process: wait for the decision, then one round; emits its change flag
@A_lf = (x (ch (D (F out))))
  & D ~ (d D2)
  & d ~ ?((@A_lf_stop @A_lf_go) (x (ch (D2 (F out)))))
@A_lf_stop = (x (ch (* ((0 *) (x ch)))))
@A_lf_go = (* (x (ch (D2 (F out)))))
  & x ~ {xs {xa xc}}
  & @A_wk ~ (ch (xs (xa (ch2 m))))
  & m ~ {x2 m2}
  & m2 ~ $([!] $(xc f))
  & F ~ (1 (f F2))
  & @A_lf ~ (x2 (ch2 (D2 (F2 out))))
// up-loop: OR of two tagged flag streams (children stop together)
@A_up = ((?((@A_up_nil @A_up_cons) (pl (Fr Fo))) pl) (Fr Fo))
@A_up_nil = (* (* (0 *)))
@A_up_cons = (* ((f Fl) ((* (g Fr)) Fo)))
  & f ~ $([|] $(g h))
  & Fo ~ (1 (h Fo2))
  & @A_up ~ (Fl (Fr Fo2))
// down-loop: copy each decision to both children, stop after a 0
@A_dn = ((d D2) ((d1 Dl2) (d2 Dr2)))
  & d ~ {d1 {d2 d3}}
  & d3 ~ ?((@A_dn_stop @A_dn_go) (D2 (Dl2 Dr2)))
@A_dn_stop = (* (* *))
@A_dn_go = (* (D2 (Dl2 Dr2)))
  & @A_dn ~ (D2 (Dl2 Dr2))
// root: decision j+k = flag j; after the first 0, drop the remaining flags
@A_rt = ((?((@A_rt_nil @A_rt_cons) (pl D)) pl) D)
@A_rt_nil = (* *)
@A_rt_cons = (* ((f F2) D))
  & f ~ {f1 f2}
  & D ~ (f1 D2)
  & f2 ~ ?((@A_rt_stop @A_rt_go) (F2 D2))
@A_rt_stop = (* *)
@A_rt_go = (* (F2 D2))
  & @A_rt ~ (F2 D2)
@A_rnd = (L (S (S2 f)))
  & L ~ ?((@A_rnd_leaf @A_rnd_node) (S (S2 f)))
@A_rnd_node = (lm ((a b) ((a2 b2) f)))
  & lm ~ {l1 l2}
  & @A_rnd ~ (l1 (a (a2 f1)))
  & @A_rnd ~ (l2 (b (b2 f2)))
  & f1 ~ $([|] $(f2 f))
@A_rnd_leaf = ((x ch) ((x2 ch2) f))
  & x ~ {xs {xa xc}}
  & @A_wk ~ (ch (xs (xa (ch2 m))))
  & m ~ {x2 m2}
  & m2 ~ $([!] $(xc f))
@A_wk = ((?((@A_wk_nil @A_wk_cons) (pl (x (acc (ch2 m))))) pl) (x (acc (ch2 m))))
@A_wk_nil = (* (* (acc ((0 *) acc))))
@A_wk_cons = (* (((i o) rest) (x (acc ((1 ((i2 o2) rest2)) m)))))
  & x ~ {x1 x2}
  & o ~ (x1 o2)
  & i ~ (y i2)
  & acc ~ {a1 a2}
  & y ~ {b1 b2}
  & a1 ~ $([<] $(b1 lt))
  & lt ~ ?(((a (* a)) (* (* (b b)))) (a2 (b2 acc1)))
  & @A_wk ~ (rest (x2 (acc1 (rest2 m))))
@A_ea_blk = (t (S0 o0))
  & t ~ (T1 (E1 (T2 (E2 (T3 (E3 (T4 (E4 (T5 (E5 (T6 (E6 (T7 (E7 (T8 (E8 (T9 (E9 (T10 (E10 (T11 (E11 (T12 (E12 (T13 (E13 (T14 (E14 (T15 (E15 (T16 (E16 t16))))))))))))))))))))))))))))))))
  & T1 ~ ?((@A_ea_nil @A_ea_cons) (S0 (o0 (E1 (S1 o1)))))
  & T2 ~ ?((@A_ea_nil @A_ea_cons) (S1 (o1 (E2 (S2 o2)))))
  & T3 ~ ?((@A_ea_nil @A_ea_cons) (S2 (o2 (E3 (S3 o3)))))
  & T4 ~ ?((@A_ea_nil @A_ea_cons) (S3 (o3 (E4 (S4 o4)))))
  & T5 ~ ?((@A_ea_nil @A_ea_cons) (S4 (o4 (E5 (S5 o5)))))
  & T6 ~ ?((@A_ea_nil @A_ea_cons) (S5 (o5 (E6 (S6 o6)))))
  & T7 ~ ?((@A_ea_nil @A_ea_cons) (S6 (o6 (E7 (S7 o7)))))
  & T8 ~ ?((@A_ea_nil @A_ea_cons) (S7 (o7 (E8 (S8 o8)))))
  & T9 ~ ?((@A_ea_nil @A_ea_cons) (S8 (o8 (E9 (S9 o9)))))
  & T10 ~ ?((@A_ea_nil @A_ea_cons) (S9 (o9 (E10 (S10 o10)))))
  & T11 ~ ?((@A_ea_nil @A_ea_cons) (S10 (o10 (E11 (S11 o11)))))
  & T12 ~ ?((@A_ea_nil @A_ea_cons) (S11 (o11 (E12 (S12 o12)))))
  & T13 ~ ?((@A_ea_nil @A_ea_cons) (S12 (o12 (E13 (S13 o13)))))
  & T14 ~ ?((@A_ea_nil @A_ea_cons) (S13 (o13 (E14 (S14 o14)))))
  & T15 ~ ?((@A_ea_nil @A_ea_cons) (S14 (o14 (E15 (S15 o15)))))
  & T16 ~ ?((@A_ea_nil @A_ea_last) (S15 (o15 (E16 t16))))
@A_ea_nil = (S (o *))
  & @A_ea_fin ~ (S o)
@A_ea_cons = (* (S (o (E (S2 o)))))
  & @A_ea_step ~ (S (E S2))
@A_ea_last = (* (S (o (E t))))
  & @A_ea_step ~ (S (E S2))
  & @A_ea_blk ~ (t (S2 o))
@A_et_blk = (t (S0 o0))
  & t ~ (T1 (E1 (T2 (E2 (T3 (E3 (T4 (E4 (T5 (E5 (T6 (E6 (T7 (E7 (T8 (E8 (T9 (E9 (T10 (E10 (T11 (E11 (T12 (E12 (T13 (E13 (T14 (E14 (T15 (E15 (T16 (E16 t16))))))))))))))))))))))))))))))))
  & T1 ~ ?((@A_et_nil @A_et_cons) (S0 (o0 (E1 (S1 o1)))))
  & T2 ~ ?((@A_et_nil @A_et_cons) (S1 (o1 (E2 (S2 o2)))))
  & T3 ~ ?((@A_et_nil @A_et_cons) (S2 (o2 (E3 (S3 o3)))))
  & T4 ~ ?((@A_et_nil @A_et_cons) (S3 (o3 (E4 (S4 o4)))))
  & T5 ~ ?((@A_et_nil @A_et_cons) (S4 (o4 (E5 (S5 o5)))))
  & T6 ~ ?((@A_et_nil @A_et_cons) (S5 (o5 (E6 (S6 o6)))))
  & T7 ~ ?((@A_et_nil @A_et_cons) (S6 (o6 (E7 (S7 o7)))))
  & T8 ~ ?((@A_et_nil @A_et_cons) (S7 (o7 (E8 (S8 o8)))))
  & T9 ~ ?((@A_et_nil @A_et_cons) (S8 (o8 (E9 (S9 o9)))))
  & T10 ~ ?((@A_et_nil @A_et_cons) (S9 (o9 (E10 (S10 o10)))))
  & T11 ~ ?((@A_et_nil @A_et_cons) (S10 (o10 (E11 (S11 o11)))))
  & T12 ~ ?((@A_et_nil @A_et_cons) (S11 (o11 (E12 (S12 o12)))))
  & T13 ~ ?((@A_et_nil @A_et_cons) (S12 (o12 (E13 (S13 o13)))))
  & T14 ~ ?((@A_et_nil @A_et_cons) (S13 (o13 (E14 (S14 o14)))))
  & T15 ~ ?((@A_et_nil @A_et_cons) (S14 (o14 (E15 (S15 o15)))))
  & T16 ~ ?((@A_et_nil @A_et_last) (S15 (o15 (E16 t16))))
@A_et_nil = (S (o *))
  & @A_et_fin ~ (S o)
@A_et_cons = (* (S (o (E (S2 o)))))
  & @A_et_step ~ (S (E S2))
@A_et_last = (* (S (o (E t))))
  & @A_et_step ~ (S (E S2))
  & @A_et_blk ~ (t (S2 o))
@A_tl = (t (L (base (n (tail o)))))
  & L ~ ?((@A_tl_leaf @A_tl_node) (t (base (n (tail o)))))
@A_tl_leaf = ((x *) (base (n (tail o))))
  & base ~ {b0 i}
  & b0 ~ $([<] $(n keep))
  & keep ~ ?((@A_tl_drop @A_tl_keep) (y (tail o)))
  & y ~ x
  & i ~ *
@A_tl_drop = (* (t t))
@A_tl_keep = (* (x (t (1 (x t)))))
@A_tl_node = (lm ((a b) (base (n (tail o)))))
  & lm ~ {l1 {l2 l3}}
  & base ~ {b1 b2}
  & n ~ {n1 n2}
  & 1 ~ $([<<] $(l3 half))
  & b2 ~ $([+] $(half bR))
  & @A_tl ~ (a (l1 (b1 (n1 (mid o)))))
  & @A_tl ~ (b (l2 (bR (n2 (tail mid)))))
// mx(a, b) = max, mn(a, b) = min
@mx = (a (b o))
  & a ~ {a1 a2}
  & b ~ {b1 b2}
  & a1 ~ $([<] $(b1 lt))
  & lt ~ ?((@mx_a @mx_b) (a2 (b2 o)))
@mx_a = (a (* a))
@mx_b = (* (* (b b)))
@mn = (a (b o))
  & a ~ {a1 a2}
  & b ~ {b1 b2}
  & a1 ~ $([<] $(b1 lt))
  & lt ~ ?((@mx_b0 @mx_a0) (a2 (b2 o)))
@mx_a0 = (* (a (* a)))
@mx_b0 = (* (b b))
// mk(L, base, stride): trie of depth L whose leaf i is (base + i*stride, [])
@mk = (L (base (st o)))
  & L ~ ?((@mk_leaf @mk_node) (base (st o)))
@mk_leaf = (b (* (b (0 *))))
@mk_node = (lm (base (st (a c))))
  & lm ~ {l1 {l2 l3}}
  & base ~ {b1 b2}
  & st ~ {s1 {s2 s3}}
  & 1 ~ $([<<] $(l3 half))
  & half ~ $([*] $(s3 off))
  & b2 ~ $([+] $(off bR))
  & @mk ~ (l1 (b1 (s1 a)))
  & @mk ~ (l2 (bR (s2 c)))
@zl = (?(((0 *) @zl_node) o) o)
@zl_node = (lm (a b))
  & lm ~ {l1 l2}
  & @zl ~ (l1 a)
  & @zl ~ (l2 b)
// cp: push a channel pair onto leaf k's channel list
@cp_act = ((x lst) (P (x (1 (P lst)))))
// cq: push (r P): P is pushed iff r == 0 (r = "rejected"); a rejected channel is erased at both ends
@cq_act = ((x lst) ((r P) (x l2)))
  & r ~ ?(((q (m (1 (q m)))) (* (* (k k)))) (P (lst l2)))
@cp = (t (k (L (P o))))
  & L ~ ?((@cp_leaf @cp_node) (t (k (P o))))
@cp_leaf = (t (* (P o)))
  & @cp_act ~ (t (P o))
@cp_node = (lm (t (k (P o))))
  & k ~ {k1 k2}
  & lm ~ {l1 l2}
  & k1 ~ $([>>] $(l1 sh))
  & sh ~ $([&] $(1 b))
  & b ~ ?((@cp_L @cp_R) (t (k2 (l2 (P o)))))
@cp_L = ((l r) (k (L (P (l2 r)))))
  & @cp ~ (l (k (L (P l2))))
@cp_R = (* ((l r) (k (L (P (l r2))))))
  & @cp ~ (r (k (L (P r2))))
@cq = (t (k (L (P o))))
  & L ~ ?((@cq_leaf @cq_node) (t (k (P o))))
@cq_leaf = (t (* (P o)))
  & @cq_act ~ (t (P o))
@cq_node = (lm (t (k (P o))))
  & k ~ {k1 k2}
  & lm ~ {l1 l2}
  & k1 ~ $([>>] $(l1 sh))
  & sh ~ $([&] $(1 b))
  & b ~ ?((@cq_L @cq_R) (t (k2 (l2 (P o)))))
@cq_L = ((l r) (k (L (P (l2 r)))))
  & @cq ~ (l (k (L (P l2))))
@cq_R = (* ((l r) (k (L (P (l r2))))))
  & @cq ~ (r (k (L (P r2))))
// ---- shared trie primitives (depth-L complete binary trie, leaves are numbers, keyed by bits of the key, high bit first)
// lg(x) = number of bits of x (0 for 0): trie depth for keys 0..x
@lg = (?((0 @lg_s) o) o)
@lg_s = (xm o)
  & xm ~ $([+1] x)
  & x ~ $([>>] $(1 y))
  & @lg ~ (y z)
  & z ~ $([+1] o)

// zt(L): trie of depth L with all leaves 0
@zt = (?((0 @zt_node) o) o)
@zt_node = (lm (a b))
  & lm ~ {l1 l2}
  & @zt ~ (l1 a)
  & @zt ~ (l2 b)

// cnt(t, L): sum of the leaves
@cnt = (t (L o))
  & L ~ ?((@cnt_leaf @cnt_node) (t o))
@cnt_leaf = (x x)
@cnt_node = (lm ((a b) o))
  & lm ~ {l1 l2}
  & @cnt ~ (a (l1 x))
  & @cnt ~ (b (l2 y))
  & x ~ $([+] $(y o))

// ins(t, k, L): set leaf k to 1. Control flow depends on k and L only, so it expands before t exists.
@ins = (t (k (L o)))
  & L ~ ?((@ins_leaf @ins_node) (t (k o)))
@ins_leaf = (* (* 1))
@ins_node = (lm (t (k o)))
  & k ~ {k1 k2}
  & lm ~ {l1 l2}
  & k1 ~ $([>>] $(l1 sh))
  & sh ~ $([&] $(1 b))
  & b ~ ?((@ins_L @ins_R) (t (k2 (l2 o))))
@ins_L = ((l r) (k (L (l2 r))))
  & @ins ~ (l (k (L l2)))
@ins_R = (* ((l r) (k (L (l r2)))))
  & @ins ~ (r (k (L r2)))
