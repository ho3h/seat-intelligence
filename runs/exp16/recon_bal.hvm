
@prog = ((n (L (tau (E (HE (M HM)))))) (C F))
  & L ~ {L1 {L2 {L3 {L4 {L5 {L6 L7}}}}}}
  & @ew ~ (HE ((L1 tau) (E te)))
  & @mw ~ (HM (L2 (M (tm ((0 *) F)))))
  & @mg ~ (L3 (te (tm T)))
  & @dz ~ (T (L4 (0 (S P))))
  & @A_loop ~ (L5 (S Sf))
  & @pz ~ (Sf (P (L6 S2)))
  & @A_tl ~ (S2 (L7 (0 (n ((0 *) C)))))

// ---- sparse trie path: key k, remaining depth L, leaf payload P. Node = (1 (l r)), empty = (0 *), leaf = (1 P)
@pa = (k (L (P o)))
  & L ~ ?((@pa_leaf @pa_node) (k (P o)))
@pa_leaf = (* (P (1 P)))
@pa_node = (lm (k (P (1 kids))))
  & k ~ {k1 k2}
  & lm ~ {l1 l2}
  & k1 ~ $([>>] $(l1 sh))
  & sh ~ $([&] $(1 b))
  & b ~ ?((@pa_L @pa_R) (k2 (l2 (P kids))))
@pa_L = (k (L (P (sub (0 *)))))
  & @pa ~ (k (L (P sub)))
@pa_R = (* (k (L (P ((0 *) sub)))))
  & @pa ~ (k (L (P sub)))

// ---- merge two sparse tries of remaining depth L; leaf payloads (C P) are pairs of difference lists (hole result)
@mg = (L (a (b o)))
  & a ~ (ta pa)
  & ta ~ ?((@mg_a0 @mg_a1) (pa (L (b o))))
@mg_a0 = (* (* (b b)))
@mg_a1 = (* (pa (L (b o))))
  & b ~ (tb pb)
  & tb ~ ?((@mg_b0 @mg_b1) (pa (pb (L o))))
@mg_b0 = (pa (* (* (1 pa))))
@mg_b1 = (* (pa (pb (L (1 po)))))
  & L ~ ?((@mg_lf @mg_nd) (pa (pb po)))
@mg_lf = (((x ar) (y qr)) (((bh x) (qh y)) ((bh ar) (qh qr))))
@mg_nd = (lm ((al ar) ((bl br) (ol or))))
  & lm ~ {l1 l2}
  & @mg ~ (l1 (al (bl ol)))
  & @mg ~ (l2 (ar (br or)))

// ---- edge tree walk: height h, K = (L tau) -> sparse trie of channel ends
@ew = (h (K (e t)))
  & h ~ ?((@ew_leaf @ew_node) (K (e t)))
@ew_node = (hm ((L tau) ((el er) t)))
  & hm ~ {h1 h2}
  & L ~ {L1 {L2 L3}}
  & tau ~ {t1 t2}
  & @ew ~ (h1 ((L1 t1) (el tl)))
  & @ew ~ (h2 ((L2 t2) (er tr)))
  & @mg ~ (L3 (tl (tr t)))
@ew_leaf = ((L tau) ((u (v s)) t))
  & s ~ $([<] $(tau rej))
  & rej ~ ?((@ew_acc @ew_rej) (L (u (v t))))
@ew_rej = (* (* (* (* (0 *)))))
@ew_acc = (L (u (v t)))
  & L ~ {L1 {L2 L3}}
  & @pa ~ (u (L1 (((h1 (1 ((c2 c1) h1))) (q1 q1)) pu)))
  & @pa ~ (v (L2 (((h2 (1 ((c1 c2) h2))) (q2 q2)) pv)))
  & @mg ~ (L3 (pu (pv t)))

// ---- must-not-link tree walk -> sparse trie of probe wires + difference list of conflicts (a b c)
@mw = (h (L (m (t r))))
  & h ~ ?((@mw_leaf @mw_node) (L (m (t r))))
@mw_node = (hm (L ((ml mr) (t (rh rr)))))
  & hm ~ {h1 h2}
  & L ~ {L1 {L2 L3}}
  & @mw ~ (h1 (L1 (ml (tl (x rr)))))
  & @mw ~ (h2 (L2 (mr (tr (rh x)))))
  & @mg ~ (L3 (tl (tr t)))
@mw_leaf = (L ((a (b live)) (t r)))
  & live ~ ?((@mw_dead @mw_live) (L (a (b (t r)))))
@mw_dead = (* (* (* ((0 *) (q q)))))
@mw_live = (* (L (a (b (t (rh rr))))))
  & L ~ {L1 {L2 L3}}
  & a ~ {a1 a2}
  & b ~ {b1 b2}
  & @pa ~ (a1 (L1 (((h1 h1) (g1 (1 (wa g1)))) pu)))
  & @pa ~ (b1 (L2 (((h2 h2) (g2 (1 (wb g2)))) pv)))
  & @mg ~ (L3 (pu (pv t)))
  & wa ~ {la1 la2}
  & la1 ~ $([=] $(wb eq))
  & eq ~ ?((@mw_ne @mw_eq) (a2 (b2 (la2 (rh rr)))))
@mw_ne = (* (* (* (h h))))
@mw_eq = (* (a (b (l (h (1 ((a (b l)) h)))))))

// ---- densify: sparse trie -> dense trie S of (i ch) leaves and dense trie P of probe lists
@dz = (t (L (base (S P))))
  & t ~ (tg pl)
  & tg ~ ?((@dz_e @dz_p) (pl (L (base (S P)))))
@dz_e = (* (L (base (S P))))
  & L ~ {L1 L2}
  & @mk ~ (L1 (base (1 S)))
  & @zl ~ (L2 P)
@dz_p = (* (pl (L (base (S P)))))
  & L ~ ?((@dz_leaf @dz_node) (pl (base (S P))))
@dz_leaf = ((((0 *) cl) ((0 *) pr)) (b ((b (1 (c (0 *)))) pr)))
  & @bl ~ (cl c)
@dz_node = (lm ((a c) (base ((Sa Sc) (Pa Pc)))))
  & lm ~ {l1 {l2 l3}}
  & base ~ {b1 b2}
  & 1 ~ $([<<] $(l3 half))
  & b2 ~ $([+] $(half bR))
  & @dz ~ (a (l1 (b1 (Sa Pa))))
  & @dz ~ (c (l2 (bR (Sc Pc))))

// ---- after LP: send every final label into the vertex's probe wires; leaves become (x 0)
@pz = (s (p (L o)))
  & L ~ ?((@pz_leaf @pz_node) (s (p o)))
@pz_leaf = ((x *) (pr (y 0)))
  & @sd ~ (pr (x y))
@pz_node = (lm ((sa sc) ((pa pc) (oa oc))))
  & lm ~ {l1 l2}
  & @pz ~ (sa (pa (l1 oa)))
  & @pz ~ (sc (pc (l2 oc)))
@sd = ((?((@sd_nil @sd_cons) (pl (x y))) pl) (x y))
@sd_nil = (* (x x))
@sd_cons = (* ((p rest) (x y)))
  & x ~ {p x2}
  & @sd ~ (rest (x2 y))

// ---- fan: joins two channel-likes (i o) into one, as a persistent process. The value from above is copied into both
// children at once (DUP chain, ~1 rewrite per level); only the recursion waits on a switch (gate: one round per value)
@fan = (A (B (I O)))
  & @fl ~ (O (I (A B)))
@fl = ((x O2) (I ((ia oa) (ib ob))))
  & x ~ {x1 {x2 x3}}
  & oa ~ (x1 oa2)
  & ob ~ (x2 ob2)
  & x3 ~ ?((@fl_go (* @fl_go)) (O2 (I ((ia oa2) (ib ob2)))))
@fl_go = (O2 (I ((ia oa2) (ib ob2))))
  & ia ~ (ya ia2)
  & ib ~ (yb ib2)
  & ya ~ {a1 a2}
  & yb ~ {b1 b2}
  & a1 ~ $([<] $(b1 lt))
  & lt ~ ?(((a (* a)) (* (* (b b)))) (a2 (b2 y)))
  & I ~ (y I2)
  & @fl ~ (O2 (I2 ((ia2 oa2) (ib2 ob2))))

// ---- bl: list of channel-likes -> one balanced fan tree (pairing passes, pipelined; paid once, not per round)
@bl = ((?((@bl_nil @bl_c) (pl o)) pl) o)
@bl_nil = (* (@A_zs *))
@bl_c = (* ((a rest) o))
  & rest ~ (t2 pl2)
  & t2 ~ ?((@bl_one @bl_more) (pl2 (a o)))
@bl_one = (* (a a))
@bl_more = (* (pl2 (a o)))
  & @pp ~ ((1 (a (1 pl2))) l2)
  & @bl ~ (l2 o)
// pp: one pairing pass [a b c d e] -> [fan(a,b) fan(c,d) e]
@pp = ((?((@pp_nil @pp_c1) (pl o)) pl) o)
@pp_nil = (* (0 *))
@pp_c1 = (* ((a rest) o))
  & rest ~ (t2 pl2)
  & t2 ~ ?((@pp_one @pp_two) (pl2 (a o)))
@pp_one = (* (a (1 (a (0 *)))))
@pp_two = (* ((b rest) (a (1 (c o2)))))
  & @fan ~ (a (b c))
  & @pp ~ (rest o2)
// ---- cc core A (op mx)
@A_cc = (L (es Sf))
  & L ~ {L1 {L2 L3}}
  & @mk ~ (L1 (0 (1 S0)))
  & @A_ea_blk ~ (es ((L2 S0) S))
  & @A_loop ~ (L3 (S Sf))
@A_cct = (L (tau (es Sf)))
  & L ~ {L1 {L2 L3}}
  & @mk ~ (L1 (0 (1 S0)))
  & @A_et_blk ~ (es (((L2 tau) S0) S))
  & @A_loop ~ (L3 (S Sf))
@A_ea_step = ((L s) ((u v) (L3 s2)))
  & L ~ {L1 {L2 L3}}
  & @cp ~ (s (u (L1 ((c2 c1) s1))))
  & @cp ~ (s1 (v (L2 ((c1 c2) s2))))
@A_ea_fin = ((* s) s)
@A_et_step = (((L tau) s) ((u (v sc)) ((L3 tau3) s2)))
  & L ~ {L1 {L2 L3}}
  & tau ~ {t1 tau3}
  & sc ~ $([<] $(t1 rej))
  & rej ~ {r1 r2}
  & @cq ~ (s (u (L1 ((r1 (c2 c1)) s1))))
  & @cq ~ (s1 (v (L2 ((r2 (c1 c2)) s2))))
@A_et_fin = ((* s) s)
@A_ch_acc = ((c2 c1) (c1 c2))
@A_ch_rej = (* ((@A_zs *) (@A_zs *)))
@A_zs = (0 @A_zs)
@A_loop = (L (S O))
  & @A_spawn ~ (L (S (D (F O))))
  & D ~ (1 (1 D3))
  & @A_rt ~ (F D3)
@A_spawn = (L (S (D (F O))))
  & L ~ ?((@A_sp_leaf @A_sp_node) (S (D (F O))))
@A_sp_leaf = ((x ch) (D (F O)))
  & @A_lf ~ (x (ch (D (F O))))
@A_sp_node = (lm ((a b) (D (F (Oa Ob)))))
  & lm ~ {l1 l2}
  & @A_dn ~ (D (Da Db))
  & @A_up ~ (Fa (Fb F))
  & @A_spawn ~ (l1 (a (Da (Fa Oa))))
  & @A_spawn ~ (l2 (b (Db (Fb Ob))))
// vertex process: wait for the decision, then one round; emits its change flag
@A_lf = (x (ch (D (F out))))
  & D ~ (d D2)
  & d ~ ?((@A_lf_stop @A_lf_go) (x (ch (D2 (F out)))))
@A_lf_stop = (x (ch (* ((0 *) (x ch)))))
@A_lf_go = (* (x (ch (D2 (F out)))))
  & x ~ {xs {xa xc}}
  & @A_wk ~ (ch (xs (xa (ch2 m))))
  & m ~ {x2 m2}
  & m2 ~ $([!] $(xc f))
  & F ~ (1 (f F2))
  & @A_lf ~ (x2 (ch2 (D2 (F2 out))))
// up-loop: OR of two tagged flag streams (children stop together)
@A_up = ((?((@A_up_nil @A_up_cons) (pl (Fr Fo))) pl) (Fr Fo))
@A_up_nil = (* (* (0 *)))
@A_up_cons = (* ((f Fl) ((* (g Fr)) Fo)))
  & f ~ $([|] $(g h))
  & Fo ~ (1 (h Fo2))
  & @A_up ~ (Fl (Fr Fo2))
// down-loop: copy each decision to both children, stop after a 0
@A_dn = ((d D2) ((d1 Dl2) (d2 Dr2)))
  & d ~ {d1 {d2 d3}}
  & d3 ~ ?((@A_dn_stop @A_dn_go) (D2 (Dl2 Dr2)))
@A_dn_stop = (* (* *))
@A_dn_go = (* (D2 (Dl2 Dr2)))
  & @A_dn ~ (D2 (Dl2 Dr2))
// root: decision j+k = flag j; after the first 0, drop the remaining flags
@A_rt = ((?((@A_rt_nil @A_rt_cons) (pl D)) pl) D)
@A_rt_nil = (* *)
@A_rt_cons = (* ((f F2) D))
  & f ~ {f1 f2}
  & D ~ (f1 D2)
  & f2 ~ ?((@A_rt_stop @A_rt_go) (F2 D2))
@A_rt_stop = (* *)
@A_rt_go = (* (F2 D2))
  & @A_rt ~ (F2 D2)
@A_rnd = (L (S (S2 f)))
  & L ~ ?((@A_rnd_leaf @A_rnd_node) (S (S2 f)))
@A_rnd_node = (lm ((a b) ((a2 b2) f)))
  & lm ~ {l1 l2}
  & @A_rnd ~ (l1 (a (a2 f1)))
  & @A_rnd ~ (l2 (b (b2 f2)))
  & f1 ~ $([|] $(f2 f))
@A_rnd_leaf = ((x ch) ((x2 ch2) f))
  & x ~ {xs {xa xc}}
  & @A_wk ~ (ch (xs (xa (ch2 m))))
  & m ~ {x2 m2}
  & m2 ~ $([!] $(xc f))
@A_wk = ((?((@A_wk_nil @A_wk_cons) (pl (x (acc (ch2 m))))) pl) (x (acc (ch2 m))))
@A_wk_nil = (* (* (acc ((0 *) acc))))
@A_wk_cons = (* (((i o) rest) (x (acc ((1 ((i2 o2) rest2)) m)))))
  & x ~ {x1 x2}
  & o ~ (x1 o2)
  & i ~ (y i2)
  & acc ~ {a1 a2}
  & y ~ {b1 b2}
  & a1 ~ $([<] $(b1 lt))
  & lt ~ ?(((a (* a)) (* (* (b b)))) (a2 (b2 acc1)))
  & @A_wk ~ (rest (x2 (acc1 (rest2 m))))
@A_ea_blk = (t (S0 o0))
  & t ~ (T1 (E1 (T2 (E2 (T3 (E3 (T4 (E4 (T5 (E5 (T6 (E6 (T7 (E7 (T8 (E8 (T9 (E9 (T10 (E10 (T11 (E11 (T12 (E12 (T13 (E13 (T14 (E14 (T15 (E15 (T16 (E16 t16))))))))))))))))))))))))))))))))
  & T1 ~ ?((@A_ea_nil @A_ea_cons) (S0 (o0 (E1 (S1 o1)))))
  & T2 ~ ?((@A_ea_nil @A_ea_cons) (S1 (o1 (E2 (S2 o2)))))
  & T3 ~ ?((@A_ea_nil @A_ea_cons) (S2 (o2 (E3 (S3 o3)))))
  & T4 ~ ?((@A_ea_nil @A_ea_cons) (S3 (o3 (E4 (S4 o4)))))
  & T5 ~ ?((@A_ea_nil @A_ea_cons) (S4 (o4 (E5 (S5 o5)))))
  & T6 ~ ?((@A_ea_nil @A_ea_cons) (S5 (o5 (E6 (S6 o6)))))
  & T7 ~ ?((@A_ea_nil @A_ea_cons) (S6 (o6 (E7 (S7 o7)))))
  & T8 ~ ?((@A_ea_nil @A_ea_cons) (S7 (o7 (E8 (S8 o8)))))
  & T9 ~ ?((@A_ea_nil @A_ea_cons) (S8 (o8 (E9 (S9 o9)))))
  & T10 ~ ?((@A_ea_nil @A_ea_cons) (S9 (o9 (E10 (S10 o10)))))
  & T11 ~ ?((@A_ea_nil @A_ea_cons) (S10 (o10 (E11 (S11 o11)))))
  & T12 ~ ?((@A_ea_nil @A_ea_cons) (S11 (o11 (E12 (S12 o12)))))
  & T13 ~ ?((@A_ea_nil @A_ea_cons) (S12 (o12 (E13 (S13 o13)))))
  & T14 ~ ?((@A_ea_nil @A_ea_cons) (S13 (o13 (E14 (S14 o14)))))
  & T15 ~ ?((@A_ea_nil @A_ea_cons) (S14 (o14 (E15 (S15 o15)))))
  & T16 ~ ?((@A_ea_nil @A_ea_last) (S15 (o15 (E16 t16))))
@A_ea_nil = (S (o *))
  & @A_ea_fin ~ (S o)
@A_ea_cons = (* (S (o (E (S2 o)))))
  & @A_ea_step ~ (S (E S2))
@A_ea_last = (* (S (o (E t))))
  & @A_ea_step ~ (S (E S2))
  & @A_ea_blk ~ (t (S2 o))
@A_et_blk = (t (S0 o0))
  & t ~ (T1 (E1 (T2 (E2 (T3 (E3 (T4 (E4 (T5 (E5 (T6 (E6 (T7 (E7 (T8 (E8 (T9 (E9 (T10 (E10 (T11 (E11 (T12 (E12 (T13 (E13 (T14 (E14 (T15 (E15 (T16 (E16 t16))))))))))))))))))))))))))))))))
  & T1 ~ ?((@A_et_nil @A_et_cons) (S0 (o0 (E1 (S1 o1)))))
  & T2 ~ ?((@A_et_nil @A_et_cons) (S1 (o1 (E2 (S2 o2)))))
  & T3 ~ ?((@A_et_nil @A_et_cons) (S2 (o2 (E3 (S3 o3)))))
  & T4 ~ ?((@A_et_nil @A_et_cons) (S3 (o3 (E4 (S4 o4)))))
  & T5 ~ ?((@A_et_nil @A_et_cons) (S4 (o4 (E5 (S5 o5)))))
  & T6 ~ ?((@A_et_nil @A_et_cons) (S5 (o5 (E6 (S6 o6)))))
  & T7 ~ ?((@A_et_nil @A_et_cons) (S6 (o6 (E7 (S7 o7)))))
  & T8 ~ ?((@A_et_nil @A_et_cons) (S7 (o7 (E8 (S8 o8)))))
  & T9 ~ ?((@A_et_nil @A_et_cons) (S8 (o8 (E9 (S9 o9)))))
  & T10 ~ ?((@A_et_nil @A_et_cons) (S9 (o9 (E10 (S10 o10)))))
  & T11 ~ ?((@A_et_nil @A_et_cons) (S10 (o10 (E11 (S11 o11)))))
  & T12 ~ ?((@A_et_nil @A_et_cons) (S11 (o11 (E12 (S12 o12)))))
  & T13 ~ ?((@A_et_nil @A_et_cons) (S12 (o12 (E13 (S13 o13)))))
  & T14 ~ ?((@A_et_nil @A_et_cons) (S13 (o13 (E14 (S14 o14)))))
  & T15 ~ ?((@A_et_nil @A_et_cons) (S14 (o14 (E15 (S15 o15)))))
  & T16 ~ ?((@A_et_nil @A_et_last) (S15 (o15 (E16 t16))))
@A_et_nil = (S (o *))
  & @A_et_fin ~ (S o)
@A_et_cons = (* (S (o (E (S2 o)))))
  & @A_et_step ~ (S (E S2))
@A_et_last = (* (S (o (E t))))
  & @A_et_step ~ (S (E S2))
  & @A_et_blk ~ (t (S2 o))
@A_tl = (t (L (base (n (tail o)))))
  & L ~ ?((@A_tl_leaf @A_tl_node) (t (base (n (tail o)))))
@A_tl_leaf = ((x *) (base (n (tail o))))
  & base ~ {b0 i}
  & b0 ~ $([<] $(n keep))
  & keep ~ ?((@A_tl_drop @A_tl_keep) (y (tail o)))
  & y ~ x
  & i ~ *
@A_tl_drop = (* (t t))
@A_tl_keep = (* (x (t (1 (x t)))))
@A_tl_node = (lm ((a b) (base (n (tail o)))))
  & lm ~ {l1 {l2 l3}}
  & base ~ {b1 b2}
  & n ~ {n1 n2}
  & 1 ~ $([<<] $(l3 half))
  & b2 ~ $([+] $(half bR))
  & @A_tl ~ (a (l1 (b1 (n1 (mid o)))))
  & @A_tl ~ (b (l2 (bR (n2 (tail mid)))))
// mx(a, b) = max, mn(a, b) = min
@mx = (a (b o))
  & a ~ {a1 a2}
  & b ~ {b1 b2}
  & a1 ~ $([<] $(b1 lt))
  & lt ~ ?((@mx_a @mx_b) (a2 (b2 o)))
@mx_a = (a (* a))
@mx_b = (* (* (b b)))
@mn = (a (b o))
  & a ~ {a1 a2}
  & b ~ {b1 b2}
  & a1 ~ $([<] $(b1 lt))
  & lt ~ ?((@mx_b0 @mx_a0) (a2 (b2 o)))
@mx_a0 = (* (a (* a)))
@mx_b0 = (* (b b))
// mk(L, base, stride): trie of depth L whose leaf i is (base + i*stride, [])
@mk = (L (base (st o)))
  & L ~ ?((@mk_leaf @mk_node) (base (st o)))
@mk_leaf = (b (* (b (0 *))))
@mk_node = (lm (base (st (a c))))
  & lm ~ {l1 {l2 l3}}
  & base ~ {b1 b2}
  & st ~ {s1 {s2 s3}}
  & 1 ~ $([<<] $(l3 half))
  & half ~ $([*] $(s3 off))
  & b2 ~ $([+] $(off bR))
  & @mk ~ (l1 (b1 (s1 a)))
  & @mk ~ (l2 (bR (s2 c)))
@zl = (?(((0 *) @zl_node) o) o)
@zl_node = (lm (a b))
  & lm ~ {l1 l2}
  & @zl ~ (l1 a)
  & @zl ~ (l2 b)
// cp: push a channel pair onto leaf k's channel list
@cp_act = ((x lst) (P (x (1 (P lst)))))
// cq: push (r P): P is pushed iff r == 0 (r = "rejected"); a rejected channel is erased at both ends
@cq_act = ((x lst) ((r P) (x l2)))
  & r ~ ?(((q (m (1 (q m)))) (* (* (k k)))) (P (lst l2)))
@cp = (t (k (L (P o))))
  & L ~ ?((@cp_leaf @cp_node) (t (k (P o))))
@cp_leaf = (t (* (P o)))
  & @cp_act ~ (t (P o))
@cp_node = (lm (t (k (P o))))
  & k ~ {k1 k2}
  & lm ~ {l1 l2}
  & k1 ~ $([>>] $(l1 sh))
  & sh ~ $([&] $(1 b))
  & b ~ ?((@cp_L @cp_R) (t (k2 (l2 (P o)))))
@cp_L = ((l r) (k (L (P (l2 r)))))
  & @cp ~ (l (k (L (P l2))))
@cp_R = (* ((l r) (k (L (P (l r2))))))
  & @cp ~ (r (k (L (P r2))))
@cq = (t (k (L (P o))))
  & L ~ ?((@cq_leaf @cq_node) (t (k (P o))))
@cq_leaf = (t (* (P o)))
  & @cq_act ~ (t (P o))
@cq_node = (lm (t (k (P o))))
  & k ~ {k1 k2}
  & lm ~ {l1 l2}
  & k1 ~ $([>>] $(l1 sh))
  & sh ~ $([&] $(1 b))
  & b ~ ?((@cq_L @cq_R) (t (k2 (l2 (P o)))))
@cq_L = ((l r) (k (L (P (l2 r)))))
  & @cq ~ (l (k (L (P l2))))
@cq_R = (* ((l r) (k (L (P (l r2))))))
  & @cq ~ (r (k (L (P r2))))
// ---- shared trie primitives (depth-L complete binary trie, leaves are numbers, keyed by bits of the key, high bit first)
// lg(x) = number of bits of x (0 for 0): trie depth for keys 0..x
@lg = (?((0 @lg_s) o) o)
@lg_s = (xm o)
  & xm ~ $([+1] x)
  & x ~ $([>>] $(1 y))
  & @lg ~ (y z)
  & z ~ $([+1] o)

// zt(L): trie of depth L with all leaves 0
@zt = (?((0 @zt_node) o) o)
@zt_node = (lm (a b))
  & lm ~ {l1 l2}
  & @zt ~ (l1 a)
  & @zt ~ (l2 b)

// cnt(t, L): sum of the leaves
@cnt = (t (L o))
  & L ~ ?((@cnt_leaf @cnt_node) (t o))
@cnt_leaf = (x x)
@cnt_node = (lm ((a b) o))
  & lm ~ {l1 l2}
  & @cnt ~ (a (l1 x))
  & @cnt ~ (b (l2 y))
  & x ~ $([+] $(y o))

// ins(t, k, L): set leaf k to 1. Control flow depends on k and L only, so it expands before t exists.
@ins = (t (k (L o)))
  & L ~ ?((@ins_leaf @ins_node) (t (k o)))
@ins_leaf = (* (* 1))
@ins_node = (lm (t (k o)))
  & k ~ {k1 k2}
  & lm ~ {l1 l2}
  & k1 ~ $([>>] $(l1 sh))
  & sh ~ $([&] $(1 b))
  & b ~ ?((@ins_L @ins_R) (t (k2 (l2 o))))
@ins_L = ((l r) (k (L (l2 r))))
  & @ins ~ (l (k (L l2)))
@ins_R = (* ((l r) (k (L (l r2)))))
  & @ins ~ (r (k (L r2)))
