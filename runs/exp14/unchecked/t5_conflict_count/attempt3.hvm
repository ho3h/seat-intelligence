@prog = ((c mnl) out)
  & @walk_mnl ~ (c (mnl (0 out)))
@walk_mnl = (c (mnl (cnt out)))
  & mnl ~ ?(((@mnl_nil @mnl_cons) c) (cnt out))
@mnl_nil = (c (cnt out))
  & cnt ~ out
@mnl_cons = (* (((a (b *)) rest) (c (cnt out))))
  & c ~ {c_for_a c_for_b}
  & @read_idx ~ (c_for_a (a (ca *)))
  & @read_idx ~ (c_for_b (b (cb *)))
  & ca ~ $([=] $(cb eq))
  & eq ~ ?((@no_viol @yes_viol) (rest (c (cnt out))))
@no_viol = (rest (c (cnt out)))
  & @walk_mnl ~ (c (rest (cnt out)))
@yes_viol = (* (rest (c (cnt out))))
  & cnt ~ $([+1] cnt2)
  & @walk_mnl ~ (c (rest (cnt2 out)))
@read_idx = (c (idx (val out)))
  & idx ~ ?((@ri_zero @ri_pos) val)
@ri_zero = (val (val *))
@ri_pos = (* (idx_pred (c_tail (val out))))
  & c ~ ?(((@ri_nil @ri_cons) idx_pred) out)
@ri_nil = (idx (val out))
  & idx ~ *
  & val ~ 0
@ri_cons = (* (((h t) idx_pred) (val out)))
  & @read_idx ~ (t (idx_pred (val out)))
