@lg = (?((0 @lg_s) o) o)
@lg_s = (xm o)
  & xm ~ $([+1] x)
  & x ~ $([>>] $(1 y))
  & @lg ~ (y z)
  & z ~ $([+1] o)
@get_c = (t (k (L o)))
  & L ~ ?((@get_c_leaf @get_c_node) (t (k o)))
@get_c_leaf = (x (* x))
@get_c_node = (lm (t (k o)))
  & k ~ {k1 k2}
  & lm ~ {l1 l2}
  & k1 ~ $([>>] $(l1 sh))
  & sh ~ $([&] $(1 bt))
  & bt ~ ?((@get_c_L @get_c_R) (t (k2 (l2 o))))
@get_c_L = ((l *) (k (L o)))
  & @get_c ~ (l (k (L o)))
@get_c_R = (* ((* r) (k (L o))))
  & @get_c ~ (r (k (L o)))
@w_step = ((pair state) (state2 state3))
  & pair ~ (a (b *))
  & a ~ {a1 a2}
  & b ~ {b1 b2}
  & state ~ (C (L (cnt out)))
  & @get_c ~ (C (a1 (L (ca ca2))))
  & ca2 ~ *
  & @get_c ~ (C (b1 (L (cb cb2))))
  & cb2 ~ *
  & ca ~ $([=] $(cb eq))
  & eq ~ ?((skip incr) (cnt out))
@w_fin = (state out)
  & state ~ (C (L (cnt out)))
@w_blk = (t (S0 o0))
  & t ~ (T1 (E1 (T2 (E2 (T3 (E3 (T4 (E4 (T5 (E5 (T6 (E6 (T7 (E7 (T8 (E8 t8))))))))))))))))
  & T1 ~ ?((@w_nil @w_cons) (S0 (o0 (E1 (S1 o1)))))
  & T2 ~ ?((@w_nil @w_cons) (S1 (o1 (E2 (S2 o2)))))
  & T3 ~ ?((@w_nil @w_cons) (S2 (o2 (E3 (S3 o3)))))
  & T4 ~ ?((@w_nil @w_cons) (S3 (o3 (E4 (S4 o4)))))
  & T5 ~ ?((@w_nil @w_cons) (S4 (o4 (E5 (S5 o5)))))
  & T6 ~ ?((@w_nil @w_cons) (S5 (o5 (E6 (S6 o6)))))
  & T7 ~ ?((@w_nil @w_cons) (S6 (o6 (E7 (S7 o7)))))
  & T8 ~ ?((@w_nil @w_last) (S7 (o7 (E8 t8))))
@w_nil = (S (o *))
  & @w_fin ~ (S o)
@w_cons = (* (S (o (E (S2 o)))))
  & @w_step ~ (S (E S2))
@w_last = (* (S (o (E t))))
  & @w_step ~ (S (E S2))
  & @w_blk ~ (t (S2 o))
@prog = ((c mnl) out)
  & c ~ ?((@init_n @build_n) (mnl out))
@init_n = (* (0 *))
  & mnl ~ (L (out (0 *)))
@skip = (cnt (cnt out))
  & state2 ~ (C (L (cnt out)))
  & state3 ~ state2
  & @w_blk ~ (mnl (state2 out))
@incr = (* (cnt (cnt out)))
  & cnt ~ $([+1] cnt2)
  & state2 ~ (C (L (cnt2 out)))
  & state3 ~ state2
  & @w_blk ~ (mnl (state2 out))
@build_n = (* (nm1 (mnl out)))
  & nm1 ~ {ndum clen}
  & ndum ~ $([+1] n)
  & @lg ~ (clen L)
  & L ~ {L1 {L2 L3}}
  & @list_to_trie ~ (c (L1 C0))
  & @w_blk ~ (mnl ((C0 (L2 (0 out))) out))
@list_to_trie = ((l (L (T out))))
  & l ~ ?(((@tl_null @tl_cons) L) out)
@tl_null = (* out)
@tl_cons = (* (((h t) L) out))
  & h ~ {h1 h2}
  & L ~ (?((@tl_node @tl_leaf) L) h2)
@tl_node = (L2m (T1 out))
  & L2m ~ {L1 L2}
  & @tl_cons ~ ((t (L2 (T1 T2))))
  & T1 ~ (L1 *)
  & T2 ~ (L2 *)
  & out ~ (T1 T2)
@tl_leaf = (* (T out))
  & @list_to_trie ~ (t (L (T out)))
