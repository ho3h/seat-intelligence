@lg = (?((0 @lg_s) o) o)
@lg_s = (xm o)
  & xm ~ $([+1] x)
  & x ~ $([>>] $(1 y))
  & @lg ~ (y z)
  & z ~ $([+1] o)
@z0 = (?((0 @z0_n) o) o)
@z0_n = (lm (a c))
  & lm ~ {l1 l2}
  & @z0 ~ (l1 a)
  & @z0 ~ (l2 c)
@c_upd = (t (k (L (P o))))
  & L ~ ?((@c_upd_leaf @c_upd_node) (t (k (P o))))
@c_upd_leaf = (t (* (P o)))
  & @c_upd_act ~ (t (P o))
@c_upd_act = (* (p p))
@c_upd_node = (lm (t (k (P o))))
  & k ~ {k1 k2}
  & lm ~ {l1 l2}
  & k1 ~ $([>>] $(l1 sh))
  & sh ~ $([&] $(1 bt))
  & bt ~ ?((@c_upd_L @c_upd_R) (t (k2 (l2 (P o)))))
@c_upd_L = ((l r) (k (L (P (l2 r)))))
  & @c_upd ~ (l (k (L (P l2))))
@c_upd_R = (* ((l r) (k (L (P (l r2))))))
  & @c_upd ~ (r (k (L (P r2))))
@conf_or = (t (k (L (P o))))
  & L ~ ?((@conf_or_leaf @conf_or_node) (t (k (P o))))
@conf_or_leaf = (t (* (P o)))
  & @conf_or_act ~ (t (P o))
@conf_or_act = (x (c o))
  & x ~ $([|] $(c o))
@conf_or_node = (lm (t (k (P o))))
  & k ~ {k1 k2}
  & lm ~ {l1 l2}
  & k1 ~ $([>>] $(l1 sh))
  & sh ~ $([&] $(1 bt))
  & bt ~ ?((@conf_or_L @conf_or_R) (t (k2 (l2 (P o)))))
@conf_or_L = ((l r) (k (L (P (l2 r)))))
  & @conf_or ~ (l (k (L (P l2))))
@conf_or_R = (* ((l r) (k (L (P (l r2))))))
  & @conf_or ~ (r (k (L (P r2))))
@get_c = (t (k (L o)))
  & L ~ ?((@get_c_leaf @get_c_node) (t (k o)))
@get_c_leaf = (x (* x))
@get_c_node = (lm (t (k o)))
  & k ~ {k1 k2}
  & lm ~ {l1 l2}
  & k1 ~ $([>>] $(l1 sh))
  & sh ~ $([&] $(1 bt))
  & bt ~ ?((@get_c_L @get_c_R) (t (k2 (l2 o))))
@get_c_L = ((l *) (k (L o)))
  & @get_c ~ (l (k (L o)))
@get_c_R = (* ((* r) (k (L o))))
  & @get_c ~ (r (k (L o)))
@tl_drop = (* (t t))
@tl_keep = (* (x (t (1 (x t)))))
@tl = (t (L (base (E (acc o)))))
  & L ~ ?((@tl_leaf @tl_node) (t (base (E (acc o)))))
@tl_leaf = (x (i (n (acc o))))
  & i ~ $([<] $(n keep))
  & keep ~ ?((@tl_drop @tl_keep) (x (acc o)))
@tl_node = (lm ((a c) (base (E (acc o)))))
  & lm ~ {l1 {l2 l3}}
  & base ~ {b1 b2}
  & 1 ~ $([<<] $(l3 half))
  & b2 ~ $([+] $(half bR))
  & E ~ {E1 E2}
  & @tl ~ (a (l1 (b1 (E1 (mid o)))))
  & @tl ~ (c (l2 (bR (E2 (acc mid)))))
@prog = ((c mnl) out)
  & @z0 ~ (24 ct)
  & @z0 ~ (24 conf)
  & @c_fill ~ (c (0 (ct (mnl (24 (conf out))))))
@c_fill = (c_list (idx (ct (mnl (L (conf out))))))
  & c_list ~ ?((@c_end @c_next) (idx (ct (mnl (L (conf out))))))
@c_end = (* (idx (ct (mnl (L (conf out))))))
  & @mnl_proc ~ (mnl (L (ct (conf out))))
@c_next = (* ((val rest) (idx (ct (mnl (L (conf out)))))))
  & @c_upd ~ (ct (idx (L (val ct2))))
  & idx2 ~ $([+1] idx)
  & @c_fill ~ (rest (idx2 (ct2 (mnl (L (conf out))))))
@mnl_proc = (mnl (L (ct (conf out))))
  & mnl ~ ?((@mnl_end @mnl_next) (L (ct (conf out))))
@mnl_end = (* (L (ct (conf out))))
  & @tl ~ (conf (L (0 (out))))
@mnl_next = (* (((a b) rest) (L (ct (conf out)))))
  & @get_c ~ (ct (a (L (ca))))
  & @get_c ~ (ct (b (L (cb))))
  & ca ~ ?((@conflict @no_conflict) (cb (a (rest (L (conf out))))))
@conflict = (cb (a (rest (L (conf out)))))
  & @conf_or ~ (conf (ca (L (1 (conf2)))))
  & @mnl_proc ~ (rest (L (ct (conf2 out))))
@no_conflict = (* (cb (a (rest (L (conf out))))))
  & @mnl_proc ~ (rest (L (ct (conf out))))
