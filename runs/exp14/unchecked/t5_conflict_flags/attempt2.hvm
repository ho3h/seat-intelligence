@lg = (?((0 @lg_s) o) o)
@lg_s = (xm o)
  & xm ~ $([+1] x)
  & x ~ $([>>] $(1 y))
  & @lg ~ (y z)
  & z ~ $([+1] o)
@z0 = (?((0 @z0_n) o) o)
@z0_n = (lm (a c))
  & lm ~ {l1 l2}
  & @z0 ~ (l1 a)
  & @z0 ~ (l2 c)
@c_upd = (t (k (L (P o))))
  & L ~ ?((@c_upd_leaf @c_upd_node) (t (k (P o))))
@c_upd_leaf = (t (* (P o)))
  & @c_upd_act ~ (t (P o))
@c_upd_act = (* (p p))
@c_upd_node = (lm (t (k (P o))))
  & k ~ {k1 k2}
  & lm ~ {l1 l2}
  & k1 ~ $([>>] $(l1 sh))
  & sh ~ $([&] $(1 bt))
  & bt ~ ?((@c_upd_L @c_upd_R) (t (k2 (l2 (P o)))))
@c_upd_L = ((l r) (k (L (P (l2 r)))))
  & @c_upd ~ (l (k (L (P l2))))
@c_upd_R = (* ((l r) (k (L (P (l r2))))))
  & @c_upd ~ (r (k (L (P r2))))
@conf_or = (t (k (L (P o))))
  & L ~ ?((@conf_or_leaf @conf_or_node) (t (k (P o))))
@conf_or_leaf = (t (* (P o)))
  & @conf_or_act ~ (t (P o))
@conf_or_act = (x (c o))
  & x ~ $([|] $(c o))
@conf_or_node = (lm (t (k (P o))))
  & k ~ {k1 k2}
  & lm ~ {l1 l2}
  & k1 ~ $([>>] $(l1 sh))
  & sh ~ $([&] $(1 bt))
  & bt ~ ?((@conf_or_L @conf_or_R) (t (k2 (l2 (P o)))))
@conf_or_L = ((l r) (k (L (P (l2 r)))))
  & @conf_or ~ (l (k (L (P l2))))
@conf_or_R = (* ((l r) (k (L (P (l r2))))))
  & @conf_or ~ (r (k (L (P r2))))
@get_c = (t (k (L o)))
  & L ~ ?((@get_c_leaf @get_c_node) (t (k o)))
@get_c_leaf = (x (* x))
@get_c_node = (lm (t (k o)))
  & k ~ {k1 k2}
  & lm ~ {l1 l2}
  & k1 ~ $([>>] $(l1 sh))
  & sh ~ $([&] $(1 bt))
  & bt ~ ?((@get_c_L @get_c_R) (t (k2 (l2 o))))
@get_c_L = ((l *) (k (L o)))
  & @get_c ~ (l (k (L o)))
@get_c_R = (* ((* r) (k (L o))))
  & @get_c ~ (r (k (L o)))
@fl_p = (x (i (E f)))
  & x ~ $([=] $(i f))
@fl_no = (* (t t))
@fl_yes = (* (v (t (1 (v t)))))
@fl = (t (L (base (E (acc o)))))
  & L ~ ?((@fl_leaf @fl_node) (t (base (E (acc o)))))
@fl_leaf = (x (i (E (acc o))))
  & x ~ {x1 x2}
  & i ~ {i1 i2}
  & x2 ~ *
  & @fl_p ~ (x1 (i1 (E f)))
  & f ~ ?((@fl_no @fl_yes) (i2 (acc o)))
@fl_node = (lm ((a c) (base (E (acc o)))))
  & lm ~ {l1 {l2 l3}}
  & base ~ {b1 b2}
  & 1 ~ $([<<] $(l3 half))
  & b2 ~ $([+] $(half bR))
  & E ~ {E1 E2}
  & @fl ~ (a (l1 (b1 (E1 (mid o)))))
  & @fl ~ (c (l2 (bR (E2 (acc mid)))))
@prog = ((c mnl) out)
  & @z0 ~ (24 ct0)
  & @z0 ~ (24 conf0)
  & @c_walk ~ (c (0 (ct0 (mnl (24 (conf0 out))))))
@c_walk = (c_list (i (ct (data))))
  & c_list ~ ?((@c_nil @c_cons) (i (ct (data))))
@c_nil = (* (i (ct (mnl (L (conf out))))))
  & @mnl_walk ~ (mnl (L (ct (conf out))))
@c_cons = (* ((h t) (i (ct (mnl (L (conf out)))))))
  & @c_upd ~ (ct (i (L (h ct2))))
  & i_next ~ $([+1] i)
  & @c_walk ~ (t (i_next (ct2 (mnl (L (conf out))))))
@mnl_walk = (mnl (data))
  & data ~ (L (ct (conf out)))
  & mnl ~ ?((@mnl_nil @mnl_cons) (L (ct (conf out))))
@mnl_nil = (* (L (ct (conf (out2))))
  & @fl ~ (ct (L (0 (* cluster_ids))))
  & @output_clusters ~ (cluster_ids (L (ct (conf (out2 out)))))
@mnl_cons = (* (((a b) rest) (L (ct (conf out)))))
  & @get_c ~ (ct (a (L ca)))
  & L2 ~ {L2a L2b}
  & L ~ {L1 L3}
  & @get_c ~ (ct (b (L2a cb)))
  & ca ~ ?((@eq @ne) (cb (a (rest (L3 (ct (conf out)))))))
@eq = (cb (a (rest (L3 (ct (conf out))))))
  & @conf_or ~ (conf (ca (L2b (1 conf2))))
  & @mnl_walk ~ (rest (L3 (ct (conf2 out))))
@ne = (* (cb (a (rest (L3 (ct (conf out)))))))
  & @mnl_walk ~ (rest (L3 (ct (conf out))))
@output_clusters = (cluster_ids (data))
  & data ~ (L (ct (conf out)))
  & cluster_ids ~ ?((@out_nil @out_cons) (L (ct (conf out))))
@out_nil = (* (L (ct (conf out)))
  & out ~ (0 *)
@out_cons = (* ((cid rest) (L (ct (conf out)))))
  & L ~ {L1 L2}
  & @get_c ~ (conf (cid (L1 flag)))
  & flag ~ ?((@out0 @out1) (rest (L2 (ct (conf out)))))
@out0 = (rest (L2 (ct (conf out))))
  & @output_clusters ~ (rest (L2 (ct (conf out))))
@out1 = (* (rest (L2 (ct (conf out))))
  & @output_clusters ~ (rest (L2 (ct ((1 conf out)))))
