@seed_act = (* (* 1))
@seed_node = (lm (t (k (P o))))
  & k ~ {k1 k2}
  & lm ~ {l1 l2}
  & k1 ~ $([>>] $(l1 sh))
  & sh ~ $([&] $(1 bt))
  & bt ~ ?((@seed_L @seed_R) (t (k2 (l2 (P o)))))
@seed_L = ((l r) (k (L (P (l2 r)))))
  & @seed ~ (l (k (L (P l2))))
@seed_R = (* ((l r) (k (L (P (l r2))))))
