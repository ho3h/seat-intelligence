@reach_zc = (?((0 @reach_zc_n) o) o)
@reach_zc_n = (lm (a c))
  & lm ~ {l1 l2}
  & @reach_zc ~ (l1 a)
  & @reach_zc ~ (l2 c)
@reach_cu = (t (k (L (P o))))
  & L ~ ?((@reach_cu_leaf @reach_cu_node) (t (k (P o))))
@reach_cu_leaf = (t (* (P o)))
  & @reach_cu_act ~ (t (P o))
@reach_cu_act = (x (c o))
  & x ~ $([|] $(c o))
@reach_cu_node = (lm (t (k (P o))))
  & k ~ {k1 k2}
  & lm ~ {l1 l2}
  & k1 ~ $([>>] $(l1 sh))
  & sh ~ $([&] $(1 bt))
  & bt ~ ?((@reach_cu_L @reach_cu_R) (t (k2 (l2 (P o)))))
@reach_cu_L = ((l r) (k (L (P (l2 r)))))
  & @reach_cu ~ (l (k (L (P l2))))
@reach_cu_R = (* ((l r) (k (L (P (l r2))))))
  & @reach_cu ~ (r (k (L (P r2))))
@reach_act = (X (d (c (d2 (f m)))))
  & * ~ X
  & d ~ $([|] $(c d2_tmp))
  & d2_tmp ~ {d2 f}
  & 1 ~ m
@reach_msg = (m (w r))
  & * ~ w
  & m ~ r
@reach_loop = ((g (dt (c E))) o)
  & E ~ {E1 {E2 E3}}
  & E1 ~ (L1 *)
  & @reach_zc ~ (L1 ci)
  & E2 ~ {Ea Eb}
  & Ea ~ (Lr *)
  & @reach_rd ~ (Lr (Eb (g (dt (c (ci (g2 (dt2 (co any)))))))))
  & any ~ ?((@reach_done @reach_again) (g2 (dt2 (co (E3 o)))))
@reach_done = (* (dt (* (* dt))))
@reach_again = (* (g (dt (c (E o)))))
  & @reach_loop ~ ((g (dt (c E))) o)
@reach_rd = (L (E (g (dt (c (ci (g2 (dt2 (co any)))))))))
  & L ~ ?((@reach_leaf @reach_node) (E (g (dt (c (ci (g2 (dt2 (co any)))))))))
@reach_node = (lm (E ((g1 gr) ((d1 dr) ((c1 cr) (ci ((h1 hr) ((e1 er) (co any)))))))))
  & lm ~ {l1 l2}
  & E ~ {Ea Eb}
  & @reach_rd ~ (l1 (Ea (g1 (d1 (c1 (ci (h1 (e1 (cm a1)))))))))
  & @reach_rd ~ (l2 (Eb (gr (dr (cr (cm (hr (er (co a2)))))))))
  & a1 ~ $([|] $(a2 any))
@reach_leaf = (E (g (d (c (ci (g2 (d2 (co any))))))))
  & E ~ {Ex Ey}
  & Ey ~ (* X)
  & @reach_act ~ (X (d (c (d2 (f m)))))
  & f ~ {any f3}
  & f3 ~ ?((@reach_quiet @reach_emit) (g (m (ci (g2 (co Ex))))))
@reach_quiet = (g (* (ci (g (ci *)))))
@reach_emit = (* (g (nd (ci (g2 (co E))))))
  & E ~ (L *)
  & @reach_em ~ (g (nd (ci (g2 (co L)))))
@reach_em = ((?((@reach_em_nil @reach_em_cons) (q (nd (ci (g2 (co L)))))) q) (nd (ci (g2 (co L)))))
@reach_em_nil = (* (* (ci ((0 *) (ci *)))))
@reach_em_cons = (* (((v w) rest) (nd (ci ((1 ((v2 w2) rest2)) (co L))))))
  & v ~ {v1 v2}
  & w ~ {w1 w2}
  & nd ~ {n1 n2}
  & L ~ {La Lb}
  & @reach_msg ~ (n1 (w1 cand))
  & @reach_cu ~ (ci (v1 (La (cand cm))))
  & @reach_em ~ (rest (n2 (cm (rest2 (co Lb)))))
@cnt = (t (L o))
  & L ~ ?((@cnt_leaf @cnt_node) (t o))
@cnt_leaf = (x (1 o))
  & x ~ $([+] $(1 o))
@cnt_node = (lm ((a c) o))
