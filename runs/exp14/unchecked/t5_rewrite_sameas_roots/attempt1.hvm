@lg = (?((0 @lg_s) o) o)
@lg_s = (xm o)
  & xm ~ $([+1] x)
  & x ~ $([>>] $(1 y))
  & @lg ~ (y z)
  & z ~ $([+1] o)
@iota = (L (base o))
  & L ~ ?((@iota_leaf @iota_node) (base o))
@iota_leaf = (x x)
@iota_node = (lm (base (a c)))
  & lm ~ {l1 {l2 l3}}
  & base ~ {b1 b2}
  & 1 ~ $([<<] $(l3 half))
  & b2 ~ $([+] $(half bR))
  & @iota ~ (l1 (b1 a))
  & @iota ~ (l2 (bR c))
@gl_inf = (?((16777215 @gl_inf_n) o) o)
@gl_inf_n = (lm (a c))
  & lm ~ {l1 l2}
  & @gl_inf ~ (l1 a)
  & @gl_inf ~ (l2 c)
@tl_drop = (* (t t))
@tl_keep = (* (x (t (1 (x t)))))
@tl = (t (L (base (E (acc o)))))
  & L ~ ?((@tl_leaf @tl_node) (t (base (E (acc o)))))
@tl_leaf = (x (i (n (acc o))))
  & i ~ $([<] $(n keep))
  & keep ~ ?((@tl_drop @tl_keep) (x (acc o)))
@tl_node = (lm ((a c) (base (E (acc o)))))
  & lm ~ {l1 {l2 l3}}
  & base ~ {b1 b2}
  & 1 ~ $([<<] $(l3 half))
  & b2 ~ $([+] $(half bR))
  & E ~ {E1 E2}
  & @tl ~ (a (l1 (b1 (E1 (mid o)))))
  & @tl ~ (c (l2 (bR (E2 (acc mid)))))
@read_ptrs_step = ((L h) ((v) (L2 h2)))
  & L ~ {L1 L2}
  & h ~ (v h2)
@read_ptrs_fin = ((* h) h)
@read_ptrs_blk = (t (S0 o0))
  & t ~ (T1 (E1 (T2 (E2 (T3 (E3 (T4 (E4 (T5 (E5 (T6 (E6 (T7 (E7 (T8 (E8 (T9 (E9 (T10 (E10 (T11 (E11 (T12 (E12 (T13 (E13 (T14 (E14 (T15 (E15 (T16 (E16 t16))))))))))))))))))))))))))))))))
  & T1 ~ ?((@read_ptrs_nil @read_ptrs_cons) (S0 (o0 (E1 (S1 o1)))))
  & T2 ~ ?((@read_ptrs_nil @read_ptrs_cons) (S1 (o1 (E2 (S2 o2)))))
  & T3 ~ ?((@read_ptrs_nil @read_ptrs_cons) (S2 (o2 (E3 (S3 o3)))))
  & T4 ~ ?((@read_ptrs_nil @read_ptrs_cons) (S3 (o3 (E4 (S4 o4)))))
  & T5 ~ ?((@read_ptrs_nil @read_ptrs_cons) (S4 (o4 (E5 (S5 o5)))))
  & T6 ~ ?((@read_ptrs_nil @read_ptrs_cons) (S5 (o5 (E6 (S6 o6)))))
  & T7 ~ ?((@read_ptrs_nil @read_ptrs_cons) (S6 (o6 (E7 (S7 o7)))))
  & T8 ~ ?((@read_ptrs_nil @read_ptrs_cons) (S7 (o7 (E8 (S8 o8)))))
  & T9 ~ ?((@read_ptrs_nil @read_ptrs_cons) (S8 (o8 (E9 (S9 o9)))))
  & T10 ~ ?((@read_ptrs_nil @read_ptrs_cons) (S9 (o9 (E10 (S10 o10)))))
  & T11 ~ ?((@read_ptrs_nil @read_ptrs_cons) (S10 (o10 (E11 (S11 o11)))))
  & T12 ~ ?((@read_ptrs_nil @read_ptrs_cons) (S11 (o11 (E12 (S12 o12)))))
  & T13 ~ ?((@read_ptrs_nil @read_ptrs_cons) (S12 (o12 (E13 (S13 o13)))))
  & T14 ~ ?((@read_ptrs_nil @read_ptrs_cons) (S13 (o13 (E14 (S14 o14)))))
  & T15 ~ ?((@read_ptrs_nil @read_ptrs_cons) (S14 (o14 (E15 (S15 o15)))))
  & T16 ~ ?((@read_ptrs_nil @read_ptrs_last) (S15 (o15 (E16 t16))))
@read_ptrs_nil = (S (o *))
  & @read_ptrs_fin ~ (S o)
@read_ptrs_cons = (* (S (o (E (S2 o)))))
  & @read_ptrs_step ~ (S (E S2))
@read_ptrs_last = (* (S (o (E t))))
  & @read_ptrs_step ~ (S (E S2))
  & @read_ptrs_blk ~ (t (S2 o))
@get_ptr = (t (k (L o)))
  & L ~ ?((@get_ptr_leaf @get_ptr_node) (t (k o)))
@get_ptr_leaf = (x (* x))
@get_ptr_node = (lm (t (k o)))
  & k ~ {k1 k2}
  & lm ~ {l1 l2}
  & k1 ~ $([>>] $(l1 sh))
  & sh ~ $([&] $(1 bt))
  & bt ~ ?((@get_ptr_L @get_ptr_R) (t (k2 (l2 o))))
@get_ptr_L = ((l *) (k (L o)))
  & @get_ptr ~ (l (k (L o)))
@get_ptr_R = (* ((* r) (k (L o))))
  & @get_ptr ~ (r (k (L o)))
@empty_req = (?(((y y) @empty_req_n) o) o)
@empty_req_n = (lm (a c))
  & lm ~ {l1 l2}
  & @empty_req ~ (l1 a)
  & @empty_req ~ (l2 c)
@dup_ptr = (m (q (L o)))
  & L ~ ?((@dup_ptr_leaf @dup_ptr_node) (m (q o)))
@dup_ptr_leaf = (R ((R e) e))
@dup_ptr_node = (lm ((m1 m2) ((q1 q2) (o1 o2))))
  & lm ~ {l1 l2}
  & @dup_ptr ~ (m1 (q1 (l1 o1)))
  & @dup_ptr ~ (m2 (q2 (l2 o2)))
@set_ptr = (t (k (L (P o))))
  & L ~ ?((@set_ptr_leaf @set_ptr_node) (t (k (P o))))
@set_ptr_leaf = (t (* (P o)))
  & @set_ptr_act ~ (t (P o))
@set_ptr_act = (* (p p))
@set_ptr_node = (lm (t (k (P o))))
  & k ~ {k1 k2}
  & lm ~ {l1 l2}
  & k1 ~ $([>>] $(l1 sh))
  & sh ~ $([&] $(1 bt))
  & bt ~ ?((@set_ptr_L @set_ptr_R) (t (k2 (l2 (P o)))))
@set_ptr_L = ((l r) (k (L (P (l2 r)))))
  & @set_ptr ~ (l (k (L (P l2))))
@set_ptr_R = (* ((l r) (k (L (P (l r2))))))
  & @set_ptr ~ (r (k (L (P r2))))
@prog = ((n ptrs) out)
  & n ~ ?(((* (0 *)) @main_pos) (ptrs out))
@main_pos = (nm1 (ptrs out))
  & nm1 ~ {a c}
  & a ~ $([+1] n)
  & @lg ~ (c L)
  & L ~ {L1 {L2 {L3 {L4 {L5 {L6 {L7 {L8 {L9 {L10 L11}}}}}}}}}}
  & @iota ~ (L1 (0 Current0))
  & @read_ptrs ~ (ptrs ((L2 Current0) Ptrs))
  & @follow_all ~ ((Ptrs (Current0 (L3 (L4 (L5 (L6 (L7 (L8 (L9 (L10 (L11 Result)))))))))) (* (0 *))))
  & @tl ~ (Result (L11 (0 (n ((0 *) out)))))
@follow_all = ((Ptrs (Current (L (flags (Result))))) out)
  & @follow_pass ~ ((Ptrs (Current (L (flags Current2)))) Changed)
  & Changed ~ ?((@follow_done @follow_loop) (Ptrs (Current2 (L (flags (Result out))))))
@follow_done = (s (s (s (s s))))
@follow_loop = (* (Ptrs (Current2 (L (flags (Result out))))))
  & @follow_all ~ ((Ptrs (Current2 (L (flags (Result out)))))  out)
@follow_pass = ((Ptrs (Current (L (flags Current2)))) Changed)
  & @follow_reduce ~ (Current (L ((Ptrs flags) Current2 Changed)))
@follow_reduce = (c (L out))
  & L ~ ?((@reduce_leaf @reduce_node) (c out))
@reduce_leaf = (v (((P f) (c2 ch))))
  & @get_ptr ~ (P (v (L c_val)))
  & c_val ~ $([=] $(v eq_check))
  & eq_check ~ ?((@no_change @has_change) ((P f) (c2 (v ch))))
@no_change = ((P f) (c2 (v ch)))
  & ch ~ (v c2)
  & (P f) ~ (P f)
@has_change = ((P f) (c2 (v ch)))
  & ch ~ (c_val c2)
  & (P 1) ~ (P f)
@reduce_node = (lm ((c1 c2) (((P f) (c2res ch)))))
  & lm ~ {l1 l2}
  & @follow_reduce ~ (c1 (l1 ((P f) (c1res ch1))))
  & @follow_reduce ~ (c2 (l2 ((P f) (c1res (c2res ch2)))))
  & ch ~ (ch1 (ch2 (c2res (P f))))
