@lg = (?((0 @lg_s) o) o)
@lg_s = (xm o)
  & xm ~ $([+1] x)
  & x ~ $([>>] $(1 y))
  & @lg ~ (y z)
  & z ~ $([+1] o)
@tl_drop = (* (t t))
@tl_keep = (* (x (t (1 (x t)))))
@tl = (t (L (base (E (acc o)))))
  & L ~ ?((@tl_leaf @tl_node) (t (base (E (acc o)))))
@tl_leaf = (x (i (n (acc o))))
  & i ~ $([<] $(n keep))
  & keep ~ ?((@tl_drop @tl_keep) (x (acc o)))
@tl_node = (lm ((a c) (base (E (acc o)))))
  & lm ~ {l1 {l2 l3}}
  & base ~ {b1 b2}
  & 1 ~ $([<<] $(l3 half))
  & b2 ~ $([+] $(half bR))
  & E ~ {E1 E2}
  & @tl ~ (a (l1 (b1 (E1 (mid o)))))
  & @tl ~ (c (l2 (bR (E2 (acc mid)))))
@prog = ((n ptrs_list) out)
  & n ~ ?(((* (0 *)) @main_pos) (ptrs_list out))
@main_pos = (nm1 (ptrs_list out))
  & nm1 ~ {a c}
  & a ~ $([+1] n)
  & @lg ~ (c L)
  & @process_list ~ (ptrs_list (ptrs_list ((0 *) out)))
@process_list = (ptrs (ptrs_ref (result_acc (out))))
  & ptrs ~ (?(nil cons) out)
@nil = (p (r r))
@cons = ((h t) (out))
  & h ~ ptr_val
  & t ~ rest
  & @follow_chain ~ (ptr_val (ptrs_ref (h (result_acc (out2)))))
  & @process_list ~ (rest (ptrs_ref ((1 (h (result_acc (out2))) out3))))
@follow_chain = (ptr (ptrs (out (acc (out_final)))))
  & ptr ~ $([=] $(ptr eq))
  & eq ~ ?((@is_root @not_root) (ptrs (ptr (out))))
@is_root = (ptrs (* ptr))
@not_root = (ptrs (ptr (out)))
  & @get_ptr_at ~ (ptrs (ptr (next_ptr (out))))
  & @follow_chain ~ (next_ptr (ptrs (out)))
  & out ~ *
@get_ptr_at = (ptrs (pos (result (out))))
  & pos ~ $([=] $(0 is_zero))
  & is_zero ~ ?((@at_pos_0 @at_pos_rest) (ptrs (pos (result (out)))))
@at_pos_0 = (ptrs (* result result))
@at_pos_rest = (ptrs (pos (result (out))))
  & pos ~ $([-] $(1 pos2))
  & ptrs ~ (?(nil cons) out)
  & nil ~ (* * * *)
  & cons ~ ((h t) (out2))
  & @get_ptr_at ~ (t (pos2 (result (out))))
