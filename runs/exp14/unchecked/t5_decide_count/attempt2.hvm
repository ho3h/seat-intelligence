@prog = ((tau cands) out)
  & @count ~ (cands (tau (0 out)))
@count = (list (tau (acc out)))
  & list ~ ?((@count_nil @count_cons) (tau (acc out)))
@count_nil = (tau (acc out))
  & tau ~ *
  & out ~ acc
@count_cons = (* ((head tail) (tau (acc out))))
  & head ~ (u v_score)
  & u ~ *
  & v_score ~ (v score)
  & v ~ *
  & tau ~ {tau1 tau2}
  & tau1 ~ $([>] $(score skip_flag))
  & skip_flag ~ ?((@skip_elem @count_elem) (tail (tau2 (acc out))))
@skip_elem = (tail (tau (acc out)))
  & @count ~ (tail (tau (acc out)))
@count_elem = (* ((tail (tau (acc out))) x))
  & x ~ *
  & acc ~ $([+] $(1 new_acc))
  & @count ~ (tail (tau (new_acc out)))
