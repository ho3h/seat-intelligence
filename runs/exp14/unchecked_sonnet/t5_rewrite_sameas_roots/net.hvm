@lg = (?((0 @lg_s) o) o)
@lg_s = (xm o)
  & xm ~ $([+1] x)
  & x ~ $([>>] $(1 y))
  & @lg ~ (y z)
  & z ~ $([+1] o)
@z0 = (?((0 @z0_n) o) o)
@z0_n = (lm (a c))
  & lm ~ {l1 l2}
  & @z0 ~ (l1 a)
  & @z0 ~ (l2 c)
@dset = (t (k (L (P o))))
  & L ~ ?((@dset_leaf @dset_node) (t (k (P o))))
@dset_leaf = (t (* (P o)))
  & @dset_act ~ (t (P o))
@dset_act = (* (p p))
@dset_node = (lm (t (k (P o))))
  & k ~ {k1 k2}
  & lm ~ {l1 l2}
  & k1 ~ $([>>] $(l1 sh))
  & sh ~ $([&] $(1 bt))
  & bt ~ ?((@dset_L @dset_R) (t (k2 (l2 (P o)))))
@dset_L = ((l r) (k (L (P (l2 r)))))
  & @dset ~ (l (k (L (P l2))))
@dset_R = (* ((l r) (k (L (P (l r2))))))
  & @dset ~ (r (k (L (P r2))))
@rq0 = (?(((y y) @rq0_n) o) o)
@rq0_n = (lm (a c))
  & lm ~ {l1 l2}
  & @rq0 ~ (l1 a)
  & @rq0 ~ (l2 c)
@rq = (t (k (L (P o))))
  & L ~ ?((@rq_leaf @rq_node) (t (k (P o))))
@rq_leaf = (t (* (P o)))
  & @rq_act ~ (t (P o))
@rq_act = ((i o) (x (i o2)))
  & o ~ {x o2}
@rq_node = (lm (t (k (P o))))
  & k ~ {k1 k2}
  & lm ~ {l1 l2}
  & k1 ~ $([>>] $(l1 sh))
  & sh ~ $([&] $(1 bt))
  & bt ~ ?((@rq_L @rq_R) (t (k2 (l2 (P o)))))
@rq_L = ((l r) (k (L (P (l2 r)))))
  & @rq ~ (l (k (L (P l2))))
@rq_R = (* ((l r) (k (L (P (l r2))))))
  & @rq ~ (r (k (L (P r2))))
@dl = (m (q L))
  & L ~ ?((@dl_leaf @dl_node) (m q))
@dl_leaf = (R (R *))
@dl_node = (lm ((m1 m2) (q1 q2)))
  & lm ~ {l1 l2}
  & @dl ~ (m1 (q1 l1))
  & @dl ~ (m2 (q2 l2))
@w1_step = ((c acc) (x (c2 (1 (x acc)))))
  & c ~ $([+1] c2)
@w1_fin = ((c acc) (c acc))
@w1_blk = (t (S0 o0))
  & t ~ (T1 (E1 (T2 (E2 (T3 (E3 (T4 (E4 (T5 (E5 (T6 (E6 (T7 (E7 (T8 (E8 (T9 (E9 (T10 (E10 (T11 (E11 (T12 (E12 (T13 (E13 (T14 (E14 (T15 (E15 (T16 (E16 t16))))))))))))))))))))))))))))))))
  & T1 ~ ?((@w1_nil @w1_cons) (S0 (o0 (E1 (S1 o1)))))
  & T2 ~ ?((@w1_nil @w1_cons) (S1 (o1 (E2 (S2 o2)))))
  & T3 ~ ?((@w1_nil @w1_cons) (S2 (o2 (E3 (S3 o3)))))
  & T4 ~ ?((@w1_nil @w1_cons) (S3 (o3 (E4 (S4 o4)))))
  & T5 ~ ?((@w1_nil @w1_cons) (S4 (o4 (E5 (S5 o5)))))
  & T6 ~ ?((@w1_nil @w1_cons) (S5 (o5 (E6 (S6 o6)))))
  & T7 ~ ?((@w1_nil @w1_cons) (S6 (o6 (E7 (S7 o7)))))
  & T8 ~ ?((@w1_nil @w1_cons) (S7 (o7 (E8 (S8 o8)))))
  & T9 ~ ?((@w1_nil @w1_cons) (S8 (o8 (E9 (S9 o9)))))
  & T10 ~ ?((@w1_nil @w1_cons) (S9 (o9 (E10 (S10 o10)))))
  & T11 ~ ?((@w1_nil @w1_cons) (S10 (o10 (E11 (S11 o11)))))
  & T12 ~ ?((@w1_nil @w1_cons) (S11 (o11 (E12 (S12 o12)))))
  & T13 ~ ?((@w1_nil @w1_cons) (S12 (o12 (E13 (S13 o13)))))
  & T14 ~ ?((@w1_nil @w1_cons) (S13 (o13 (E14 (S14 o14)))))
  & T15 ~ ?((@w1_nil @w1_cons) (S14 (o14 (E15 (S15 o15)))))
  & T16 ~ ?((@w1_nil @w1_last) (S15 (o15 (E16 t16))))
@w1_nil = (S (o *))
  & @w1_fin ~ (S o)
@w1_cons = (* (S (o (E (S2 o)))))
  & @w1_step ~ (S (E S2))
@w1_last = (* (S (o (E t))))
  & @w1_step ~ (S (E S2))
  & @w1_blk ~ (t (S2 o))
@w2_step = ((L (i h)) (x (L3 (i2 h2))))
  & L ~ {L1 L3}
  & i ~ {i1 ip}
  & ip ~ $([-] $(1 i2))
  & @dset ~ (h (i1 (L1 (x h2))))
@w2_fin = ((* (* h)) h)
@w2_blk = (t (S0 o0))
  & t ~ (T1 (E1 (T2 (E2 (T3 (E3 (T4 (E4 (T5 (E5 (T6 (E6 (T7 (E7 (T8 (E8 (T9 (E9 (T10 (E10 (T11 (E11 (T12 (E12 (T13 (E13 (T14 (E14 (T15 (E15 (T16 (E16 t16))))))))))))))))))))))))))))))))
  & T1 ~ ?((@w2_nil @w2_cons) (S0 (o0 (E1 (S1 o1)))))
  & T2 ~ ?((@w2_nil @w2_cons) (S1 (o1 (E2 (S2 o2)))))
  & T3 ~ ?((@w2_nil @w2_cons) (S2 (o2 (E3 (S3 o3)))))
  & T4 ~ ?((@w2_nil @w2_cons) (S3 (o3 (E4 (S4 o4)))))
  & T5 ~ ?((@w2_nil @w2_cons) (S4 (o4 (E5 (S5 o5)))))
  & T6 ~ ?((@w2_nil @w2_cons) (S5 (o5 (E6 (S6 o6)))))
  & T7 ~ ?((@w2_nil @w2_cons) (S6 (o6 (E7 (S7 o7)))))
  & T8 ~ ?((@w2_nil @w2_cons) (S7 (o7 (E8 (S8 o8)))))
  & T9 ~ ?((@w2_nil @w2_cons) (S8 (o8 (E9 (S9 o9)))))
  & T10 ~ ?((@w2_nil @w2_cons) (S9 (o9 (E10 (S10 o10)))))
  & T11 ~ ?((@w2_nil @w2_cons) (S10 (o10 (E11 (S11 o11)))))
  & T12 ~ ?((@w2_nil @w2_cons) (S11 (o11 (E12 (S12 o12)))))
  & T13 ~ ?((@w2_nil @w2_cons) (S12 (o12 (E13 (S13 o13)))))
  & T14 ~ ?((@w2_nil @w2_cons) (S13 (o13 (E14 (S14 o14)))))
  & T15 ~ ?((@w2_nil @w2_cons) (S14 (o14 (E15 (S15 o15)))))
  & T16 ~ ?((@w2_nil @w2_last) (S15 (o15 (E16 t16))))
@w2_nil = (S (o *))
  & @w2_fin ~ (S o)
@w2_cons = (* (S (o (E (S2 o)))))
  & @w2_step ~ (S (E S2))
@w2_last = (* (S (o (E t))))
  & @w2_step ~ (S (E S2))
  & @w2_blk ~ (t (S2 o))
@fl = (t (L (base (E (acc o)))))
  & L ~ ?((@fl_leaf @fl_node) (t (base (E (acc o)))))
@fl_leaf = (x (i (E ((q (h v)) (q2 (h2 v2))))))
  & x ~ {x1 x2}
  & i ~ {i1 i2}
  & E ~ {E1 {E2 E3}}
  & @rq ~ (q (x1 (E1 (r q2))))
  & @dset ~ (v (i1 (E2 (x2 v2))))
  & @dset ~ (h (i2 (E3 (r h2))))
@fl_node = (lm ((a c) (base (E (acc o)))))
  & lm ~ {l1 {l2 l3}}
  & base ~ {b1 b2}
  & 1 ~ $([<<] $(l3 half))
  & b2 ~ $([+] $(half bR))
  & E ~ {E1 E2}
  & @fl ~ (a (l1 (b1 (E1 (mid o)))))
  & @fl ~ (c (l2 (bR (E2 (acc mid)))))
@tl_drop = (* (t t))
@tl_keep = (* (x (t (1 (x t)))))
@tl = (t (L (base (E (acc o)))))
  & L ~ ?((@tl_leaf @tl_node) (t (base (E (acc o)))))
@tl_leaf = (x (i (n (acc o))))
  & i ~ $([<] $(n keep))
  & keep ~ ?((@tl_drop @tl_keep) (x (acc o)))
@tl_node = (lm ((a c) (base (E (acc o)))))
  & lm ~ {l1 {l2 l3}}
  & base ~ {b1 b2}
  & 1 ~ $([<<] $(l3 half))
  & b2 ~ $([+] $(half bR))
  & E ~ {E1 E2}
  & @tl ~ (a (l1 (b1 (E1 (mid o)))))
  & @tl ~ (c (l2 (bR (E2 (acc mid)))))
@round = (D (L o))
  & L ~ {La {Lb {Lc {Ld {Le Lf}}}}}
  & @rq0 ~ (La Q0)
  & @z0 ~ (Lb H0)
  & @z0 ~ (Lc V0)
  & @fl ~ (D (Ld (0 (Le ((Q0 (H0 V0)) (Q (H V)))))))
  & @dl ~ (V (Q Lf))
  & H ~ o
@rounds = (D (c (L o)))
  & c ~ ?((@rd_z @rd_s) (D (L o)))
@rd_z = (D (* D))
@rd_s = (cm (D (L o)))
  & L ~ {L1 L2}
  & @round ~ (D (L1 D2))
  & @rounds ~ (D2 (cm (L2 o)))
@prog = (l out)
  & @w1_blk ~ (l ((0 (0 *)) (n rev)))
  & n ~ ?((@p_zero @p_pos) (rev out))
@p_zero = (* (0 *))
@p_pos = (nm1 (rev out))
  & nm1 ~ {a {c i0}}
  & a ~ $([+1] n)
  & @lg ~ (c L)
  & L ~ {L1 {L2 {L3 {L4 L5}}}}
  & @z0 ~ (L1 H0)
  & @w2_blk ~ (rev ((L2 (i0 H0)) H))
  & @rounds ~ (H (L3 (L4 Dr)))
  & @tl ~ (Dr (L5 (0 (n ((0 *) out)))))
