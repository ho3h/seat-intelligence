@lg = (?((0 @lg_s) o) o)
@lg_s = (xm o)
  & xm ~ $([+1] x)
  & x ~ $([>>] $(1 y))
  & @lg ~ (y z)
  & z ~ $([+1] o)
@z0 = (?((0 @z0_n) o) o)
@z0_n = (lm (a c))
  & lm ~ {l1 l2}
  & @z0 ~ (l1 a)
  & @z0 ~ (l2 c)
@cs = (t (k (L (P o))))
  & L ~ ?((@cs_leaf @cs_node) (t (k (P o))))
@cs_leaf = (t (* (P o)))
  & @cs_act ~ (t (P o))
@cs_act = (* (p p))
@cs_node = (lm (t (k (P o))))
  & k ~ {k1 k2}
  & lm ~ {l1 l2}
  & k1 ~ $([>>] $(l1 sh))
  & sh ~ $([&] $(1 bt))
  & bt ~ ?((@cs_L @cs_R) (t (k2 (l2 (P o)))))
@cs_L = ((l r) (k (L (P (l2 r)))))
  & @cs ~ (l (k (L (P l2))))
@cs_R = (* ((l r) (k (L (P (l r2))))))
  & @cs ~ (r (k (L (P r2))))
@rq = (t (k (L (P o))))
  & L ~ ?((@rq_leaf @rq_node) (t (k (P o))))
@rq_leaf = (t (* (P o)))
  & @rq_act ~ (t (P o))
@rq_act = ((i o) (x (i o2)))
  & o ~ {x o2}
@rq_node = (lm (t (k (P o))))
  & k ~ {k1 k2}
  & lm ~ {l1 l2}
  & k1 ~ $([>>] $(l1 sh))
  & sh ~ $([&] $(1 bt))
  & bt ~ ?((@rq_L @rq_R) (t (k2 (l2 (P o)))))
@rq_L = ((l r) (k (L (P (l2 r)))))
  & @rq ~ (l (k (L (P l2))))
@rq_R = (* ((l r) (k (L (P (l r2))))))
  & @rq ~ (r (k (L (P r2))))
@qe = (?(((y y) @qe_n) o) o)
@qe_n = (lm (a c))
  & lm ~ {l1 l2}
  & @qe ~ (l1 a)
  & @qe ~ (l2 c)
@dl = (m (q L))
  & L ~ ?((@dl_leaf @dl_node) (m q))
@dl_leaf = (R (R *))
@dl_node = (lm ((m1 m2) (q1 q2)))
  & lm ~ {l1 l2}
  & @dl ~ (m1 (q1 l1))
  & @dl ~ (m2 (q2 l2))
@w1_step = ((cnt acc) (e (cnt2 (1 (e acc)))))
  & cnt ~ $([+1] cnt2)
@w1_fin = ((cnt acc) (cnt acc))
@w1_blk = (t (S0 o0))
  & t ~ (T1 (E1 (T2 (E2 (T3 (E3 (T4 (E4 (T5 (E5 (T6 (E6 (T7 (E7 (T8 (E8 (T9 (E9 (T10 (E10 (T11 (E11 (T12 (E12 (T13 (E13 (T14 (E14 (T15 (E15 (T16 (E16 t16))))))))))))))))))))))))))))))))
  & T1 ~ ?((@w1_nil @w1_cons) (S0 (o0 (E1 (S1 o1)))))
  & T2 ~ ?((@w1_nil @w1_cons) (S1 (o1 (E2 (S2 o2)))))
  & T3 ~ ?((@w1_nil @w1_cons) (S2 (o2 (E3 (S3 o3)))))
  & T4 ~ ?((@w1_nil @w1_cons) (S3 (o3 (E4 (S4 o4)))))
  & T5 ~ ?((@w1_nil @w1_cons) (S4 (o4 (E5 (S5 o5)))))
  & T6 ~ ?((@w1_nil @w1_cons) (S5 (o5 (E6 (S6 o6)))))
  & T7 ~ ?((@w1_nil @w1_cons) (S6 (o6 (E7 (S7 o7)))))
  & T8 ~ ?((@w1_nil @w1_cons) (S7 (o7 (E8 (S8 o8)))))
  & T9 ~ ?((@w1_nil @w1_cons) (S8 (o8 (E9 (S9 o9)))))
  & T10 ~ ?((@w1_nil @w1_cons) (S9 (o9 (E10 (S10 o10)))))
  & T11 ~ ?((@w1_nil @w1_cons) (S10 (o10 (E11 (S11 o11)))))
  & T12 ~ ?((@w1_nil @w1_cons) (S11 (o11 (E12 (S12 o12)))))
  & T13 ~ ?((@w1_nil @w1_cons) (S12 (o12 (E13 (S13 o13)))))
  & T14 ~ ?((@w1_nil @w1_cons) (S13 (o13 (E14 (S14 o14)))))
  & T15 ~ ?((@w1_nil @w1_cons) (S14 (o14 (E15 (S15 o15)))))
  & T16 ~ ?((@w1_nil @w1_last) (S15 (o15 (E16 t16))))
@w1_nil = (S (o *))
  & @w1_fin ~ (S o)
@w1_cons = (* (S (o (E (S2 o)))))
  & @w1_step ~ (S (E S2))
@w1_last = (* (S (o (E t))))
  & @w1_step ~ (S (E S2))
  & @w1_blk ~ (t (S2 o))
@w2_step = ((L (idx T)) (e (L3 (idx2 T2))))
  & L ~ {L1 L3}
  & idx ~ {i1 i2}
  & i2 ~ $([-] $(1 idx2))
  & @cs ~ (T (i1 (L1 (e T2))))
@w2_fin = ((* (* T)) T)
@w2_blk = (t (S0 o0))
  & t ~ (T1 (E1 (T2 (E2 (T3 (E3 (T4 (E4 (T5 (E5 (T6 (E6 (T7 (E7 (T8 (E8 (T9 (E9 (T10 (E10 (T11 (E11 (T12 (E12 (T13 (E13 (T14 (E14 (T15 (E15 (T16 (E16 t16))))))))))))))))))))))))))))))))
  & T1 ~ ?((@w2_nil @w2_cons) (S0 (o0 (E1 (S1 o1)))))
  & T2 ~ ?((@w2_nil @w2_cons) (S1 (o1 (E2 (S2 o2)))))
  & T3 ~ ?((@w2_nil @w2_cons) (S2 (o2 (E3 (S3 o3)))))
  & T4 ~ ?((@w2_nil @w2_cons) (S3 (o3 (E4 (S4 o4)))))
  & T5 ~ ?((@w2_nil @w2_cons) (S4 (o4 (E5 (S5 o5)))))
  & T6 ~ ?((@w2_nil @w2_cons) (S5 (o5 (E6 (S6 o6)))))
  & T7 ~ ?((@w2_nil @w2_cons) (S6 (o6 (E7 (S7 o7)))))
  & T8 ~ ?((@w2_nil @w2_cons) (S7 (o7 (E8 (S8 o8)))))
  & T9 ~ ?((@w2_nil @w2_cons) (S8 (o8 (E9 (S9 o9)))))
  & T10 ~ ?((@w2_nil @w2_cons) (S9 (o9 (E10 (S10 o10)))))
  & T11 ~ ?((@w2_nil @w2_cons) (S10 (o10 (E11 (S11 o11)))))
  & T12 ~ ?((@w2_nil @w2_cons) (S11 (o11 (E12 (S12 o12)))))
  & T13 ~ ?((@w2_nil @w2_cons) (S12 (o12 (E13 (S13 o13)))))
  & T14 ~ ?((@w2_nil @w2_cons) (S13 (o13 (E14 (S14 o14)))))
  & T15 ~ ?((@w2_nil @w2_cons) (S14 (o14 (E15 (S15 o15)))))
  & T16 ~ ?((@w2_nil @w2_last) (S15 (o15 (E16 t16))))
@w2_nil = (S (o *))
  & @w2_fin ~ (S o)
@w2_cons = (* (S (o (E (S2 o)))))
  & @w2_step ~ (S (E S2))
@w2_last = (* (S (o (E t))))
  & @w2_step ~ (S (E S2))
  & @w2_blk ~ (t (S2 o))
@w3_step = ((L (q cnt)) ((u v) (L3 (q2 cnt2))))
  & L ~ {L1 {L2 L3}}
  & @rq ~ (q (u (L1 (ra q1))))
  & @rq ~ (q1 (v (L2 (rb q2))))
  & ra ~ $([=] $(rb eq))
  & cnt ~ $([+] $(eq cnt2))
@w3_fin = ((* (q cnt)) (q cnt))
@w3_blk = (t (S0 o0))
  & t ~ (T1 (E1 (T2 (E2 (T3 (E3 (T4 (E4 (T5 (E5 (T6 (E6 (T7 (E7 (T8 (E8 (T9 (E9 (T10 (E10 (T11 (E11 (T12 (E12 (T13 (E13 (T14 (E14 (T15 (E15 (T16 (E16 t16))))))))))))))))))))))))))))))))
  & T1 ~ ?((@w3_nil @w3_cons) (S0 (o0 (E1 (S1 o1)))))
  & T2 ~ ?((@w3_nil @w3_cons) (S1 (o1 (E2 (S2 o2)))))
  & T3 ~ ?((@w3_nil @w3_cons) (S2 (o2 (E3 (S3 o3)))))
  & T4 ~ ?((@w3_nil @w3_cons) (S3 (o3 (E4 (S4 o4)))))
  & T5 ~ ?((@w3_nil @w3_cons) (S4 (o4 (E5 (S5 o5)))))
  & T6 ~ ?((@w3_nil @w3_cons) (S5 (o5 (E6 (S6 o6)))))
  & T7 ~ ?((@w3_nil @w3_cons) (S6 (o6 (E7 (S7 o7)))))
  & T8 ~ ?((@w3_nil @w3_cons) (S7 (o7 (E8 (S8 o8)))))
  & T9 ~ ?((@w3_nil @w3_cons) (S8 (o8 (E9 (S9 o9)))))
  & T10 ~ ?((@w3_nil @w3_cons) (S9 (o9 (E10 (S10 o10)))))
  & T11 ~ ?((@w3_nil @w3_cons) (S10 (o10 (E11 (S11 o11)))))
  & T12 ~ ?((@w3_nil @w3_cons) (S11 (o11 (E12 (S12 o12)))))
  & T13 ~ ?((@w3_nil @w3_cons) (S12 (o12 (E13 (S13 o13)))))
  & T14 ~ ?((@w3_nil @w3_cons) (S13 (o13 (E14 (S14 o14)))))
  & T15 ~ ?((@w3_nil @w3_cons) (S14 (o14 (E15 (S15 o15)))))
  & T16 ~ ?((@w3_nil @w3_last) (S15 (o15 (E16 t16))))
@w3_nil = (S (o *))
  & @w3_fin ~ (S o)
@w3_cons = (* (S (o (E (S2 o)))))
  & @w3_step ~ (S (E S2))
@w3_last = (* (S (o (E t))))
  & @w3_step ~ (S (E S2))
  & @w3_blk ~ (t (S2 o))
@prog = ((c mnl) out)
  & @w1_blk ~ (c ((0 (0 *)) (n R)))
  & n ~ ?((@p_zero @p_pos) (R (mnl out)))
@p_zero = (* (* 0))
@p_pos = (nm1 (R (mnl out)))
  & nm1 ~ {a c}
  & @lg ~ (a L)
  & L ~ {L1 {L2 {L3 {L4 L5}}}}
  & @z0 ~ (L1 C0)
  & @w2_blk ~ (R ((L2 (c C0)) C))
  & @qe ~ (L3 Q0)
  & @w3_blk ~ (mnl ((L4 (Q0 0)) (Q out)))
  & @dl ~ (C (Q L5))
