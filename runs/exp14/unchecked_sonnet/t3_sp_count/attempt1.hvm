@lg = (?((0 @lg_s) o) o)
@lg_s = (xm o)
  & xm ~ $([+1] x)
  & x ~ $([>>] $(1 y))
  & @lg ~ (y z)
  & z ~ $([+1] o)
@gl_zl = (?(((0 *) @gl_zl_n) o) o)
@gl_zl_n = (lm (a c))
  & lm ~ {l1 l2}
  & @gl_zl ~ (l1 a)
  & @gl_zl ~ (l2 c)
@gl_adj = (t (k (L (P o))))
  & L ~ ?((@gl_adj_leaf @gl_adj_node) (t (k (P o))))
@gl_adj_leaf = (t (* (P o)))
  & @gl_adj_act ~ (t (P o))
@gl_adj_act = (l (x (1 (x l))))
@gl_adj_node = (lm (t (k (P o))))
  & k ~ {k1 k2}
  & lm ~ {l1 l2}
  & k1 ~ $([>>] $(l1 sh))
  & sh ~ $([&] $(1 bt))
  & bt ~ ?((@gl_adj_L @gl_adj_R) (t (k2 (l2 (P o)))))
@gl_adj_L = ((l r) (k (L (P (l2 r)))))
  & @gl_adj ~ (l (k (L (P l2))))
@gl_adj_R = (* ((l r) (k (L (P (l r2))))))
  & @gl_adj ~ (r (k (L (P r2))))
@z00 = (?(((0 0) @z00_n) o) o)
@z00_n = (lm (a c))
  & lm ~ {l1 l2}
  & @z00 ~ (l1 a)
  & @z00 ~ (l2 c)
@cs = (t (k (L (P o))))
  & L ~ ?((@cs_leaf @cs_node) (t (k (P o))))
@cs_leaf = (t (* (P o)))
  & @cs_act ~ (t (P o))
@cs_act = (* (p p))
@cs_node = (lm (t (k (P o))))
  & k ~ {k1 k2}
  & lm ~ {l1 l2}
  & k1 ~ $([>>] $(l1 sh))
  & sh ~ $([&] $(1 bt))
  & bt ~ ?((@cs_L @cs_R) (t (k2 (l2 (P o)))))
@cs_L = ((l r) (k (L (P (l2 r)))))
  & @cs ~ (l (k (L (P l2))))
@cs_R = (* ((l r) (k (L (P (l r2))))))
  & @cs ~ (r (k (L (P r2))))
@gt = (t (k (L o)))
  & L ~ ?((@gt_leaf @gt_node) (t (k o)))
@gt_leaf = (x (* x))
@gt_node = (lm (t (k o)))
  & k ~ {k1 k2}
  & lm ~ {l1 l2}
  & k1 ~ $([>>] $(l1 sh))
  & sh ~ $([&] $(1 bt))
  & bt ~ ?((@gt_L @gt_R) (t (k2 (l2 o))))
@gt_L = ((l *) (k (L o)))
  & @gt ~ (l (k (L o)))
@gt_R = (* ((* r) (k (L o))))
  & @gt ~ (r (k (L o)))
@cnt_zc = (?(((0 0) @cnt_zc_n) o) o)
@cnt_zc_n = (lm (a c))
  & lm ~ {l1 l2}
  & @cnt_zc ~ (l1 a)
  & @cnt_zc ~ (l2 c)
@cnt_cu = (t (k (L (P o))))
  & L ~ ?((@cnt_cu_leaf @cnt_cu_node) (t (k (P o))))
@cnt_cu_leaf = (t (* (P o)))
  & @cnt_cu_act ~ (t (P o))
@cnt_cu_act = ((n s) ((cn cs) (n2 s2)))
  & n ~ $([+] $(cn n2))
  & s ~ $([+] $(cs s2))
@cnt_cu_node = (lm (t (k (P o))))
  & k ~ {k1 k2}
  & lm ~ {l1 l2}
  & k1 ~ $([>>] $(l1 sh))
  & sh ~ $([&] $(1 bt))
  & bt ~ ?((@cnt_cu_L @cnt_cu_R) (t (k2 (l2 (P o)))))
@cnt_cu_L = ((l r) (k (L (P (l2 r)))))
  & @cnt_cu ~ (l (k (L (P l2))))
@cnt_cu_R = (* ((l r) (k (L (P (l r2))))))
  & @cnt_cu ~ (r (k (L (P r2))))
@cnt_act = (X ((vis cnt) ((nm sum) (d2 (f m)))))
  & X ~ *
  & nm ~ $([>] $(0 pos))
  & vis ~ {vis1 vis2}
  & vis1 ~ $([=] $(0 nv))
  & pos ~ $([&] $(nv go))
  & go ~ ?((@cnt_no @cnt_yes) (vis2 (cnt (sum (d2 (f m))))))
@cnt_no = (vis (cnt (sum ((vis cnt) (0 0)))))
  & sum ~ *
@cnt_yes = (* (vis (cnt (sum ((1 s1) (1 s2))))))
  & vis ~ *
  & cnt ~ *
  & sum ~ {s1 s2}
@cnt_msg = (m (w (1 m)))
  & w ~ *
@cnt_loop = ((g (dt (c E))) o)
  & E ~ {E1 {E2 E3}}
  & E1 ~ (L1 *)
  & @cnt_zc ~ (L1 ci)
  & E2 ~ {Ea Eb}
  & Ea ~ (Lr *)
  & @cnt_rd ~ (Lr (Eb (g (dt (c (ci (g2 (dt2 (co any)))))))))
  & any ~ ?((@cnt_done @cnt_again) (g2 (dt2 (co (E3 o)))))
@cnt_done = (* (dt (* (* dt))))
@cnt_again = (* (g (dt (c (E o)))))
  & @cnt_loop ~ ((g (dt (c E))) o)
@cnt_rd = (L (E (g (dt (c (ci (g2 (dt2 (co any)))))))))
  & L ~ ?((@cnt_leaf @cnt_node) (E (g (dt (c (ci (g2 (dt2 (co any)))))))))
@cnt_node = (lm (E ((g1 gr) ((d1 dr) ((c1 cr) (ci ((h1 hr) ((e1 er) (co any)))))))))
  & lm ~ {l1 l2}
  & E ~ {Ea Eb}
  & @cnt_rd ~ (l1 (Ea (g1 (d1 (c1 (ci (h1 (e1 (cm a1)))))))))
  & @cnt_rd ~ (l2 (Eb (gr (dr (cr (cm (hr (er (co a2)))))))))
  & a1 ~ $([|] $(a2 any))
@cnt_leaf = (E (g (d (c (ci (g2 (d2 (co any))))))))
  & E ~ {Ex Ey}
  & Ey ~ (* X)
  & @cnt_act ~ (X (d (c (d2 (f m)))))
  & f ~ {any f3}
  & f3 ~ ?((@cnt_quiet @cnt_emit) (g (m (ci (g2 (co Ex))))))
@cnt_quiet = (g (* (ci (g (ci *)))))
@cnt_emit = (* (g (nd (ci (g2 (co E))))))
  & E ~ (L *)
  & @cnt_em ~ (g (nd (ci (g2 (co L)))))
@cnt_em = ((?((@cnt_em_nil @cnt_em_cons) (q (nd (ci (g2 (co L)))))) q) (nd (ci (g2 (co L)))))
@cnt_em_nil = (* (* (ci ((0 *) (ci *)))))
@cnt_em_cons = (* (((v w) rest) (nd (ci ((1 ((v2 w2) rest2)) (co L))))))
  & v ~ {v1 v2}
  & w ~ {w1 w2}
  & nd ~ {n1 n2}
  & L ~ {La Lb}
  & @cnt_msg ~ (n1 (w1 cand))
  & @cnt_cu ~ (ci (v1 (La (cand cm))))
  & @cnt_em ~ (rest (n2 (cm (rest2 (co Lb)))))
@w_step = ((L g) ((u v) (L3 g3)))
  & L ~ {L1 L3}
  & @gl_adj ~ (g (u (L1 ((v 0) g3))))
@w_fin = ((* g) g)
@w_blk = (t (S0 o0))
  & t ~ (T1 (E1 (T2 (E2 (T3 (E3 (T4 (E4 (T5 (E5 (T6 (E6 (T7 (E7 (T8 (E8 (T9 (E9 (T10 (E10 (T11 (E11 (T12 (E12 (T13 (E13 (T14 (E14 (T15 (E15 (T16 (E16 t16))))))))))))))))))))))))))))))))
  & T1 ~ ?((@w_nil @w_cons) (S0 (o0 (E1 (S1 o1)))))
  & T2 ~ ?((@w_nil @w_cons) (S1 (o1 (E2 (S2 o2)))))
  & T3 ~ ?((@w_nil @w_cons) (S2 (o2 (E3 (S3 o3)))))
  & T4 ~ ?((@w_nil @w_cons) (S3 (o3 (E4 (S4 o4)))))
  & T5 ~ ?((@w_nil @w_cons) (S4 (o4 (E5 (S5 o5)))))
  & T6 ~ ?((@w_nil @w_cons) (S5 (o5 (E6 (S6 o6)))))
  & T7 ~ ?((@w_nil @w_cons) (S6 (o6 (E7 (S7 o7)))))
  & T8 ~ ?((@w_nil @w_cons) (S7 (o7 (E8 (S8 o8)))))
  & T9 ~ ?((@w_nil @w_cons) (S8 (o8 (E9 (S9 o9)))))
  & T10 ~ ?((@w_nil @w_cons) (S9 (o9 (E10 (S10 o10)))))
  & T11 ~ ?((@w_nil @w_cons) (S10 (o10 (E11 (S11 o11)))))
  & T12 ~ ?((@w_nil @w_cons) (S11 (o11 (E12 (S12 o12)))))
  & T13 ~ ?((@w_nil @w_cons) (S12 (o12 (E13 (S13 o13)))))
  & T14 ~ ?((@w_nil @w_cons) (S13 (o13 (E14 (S14 o14)))))
  & T15 ~ ?((@w_nil @w_cons) (S14 (o14 (E15 (S15 o15)))))
  & T16 ~ ?((@w_nil @w_last) (S15 (o15 (E16 t16))))
@w_nil = (S (o *))
  & @w_fin ~ (S o)
@w_cons = (* (S (o (E (S2 o)))))
  & @w_step ~ (S (E S2))
@w_last = (* (S (o (E t))))
  & @w_step ~ (S (E S2))
  & @w_blk ~ (t (S2 o))
@prog = ((n (s (t es))) out)
  & n ~ $([-] $(1 nm1))
  & @lg ~ (nm1 L)
  & L ~ {L1 {L2 {L3 {L4 {L5 {L6 L7}}}}}}
  & @gl_zl ~ (L1 G0)
  & @w_blk ~ (es ((L2 G0) G))
  & @z00 ~ (L3 D0)
  & @z00 ~ (L4 Ci)
  & @cs ~ (Ci (s (L5 ((1 1) C0))))
  & @cnt_loop ~ ((G (D0 (C0 (L6 0)))) Df)
  & @gt ~ (Df (t (L7 (* out))))
