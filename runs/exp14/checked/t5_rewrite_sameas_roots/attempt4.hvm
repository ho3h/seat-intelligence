@lg = (?((0 @lg_s) o) o)
@lg_s = (xm o)
  & xm ~ $([+1] x)
  & x ~ $([>>] $(1 y))
  & @lg ~ (y z)
  & z ~ $([+1] o)
@z0 = (?((0 @z0_n) o) o)
@z0_n = (lm (a c))
  & lm ~ {l1 l2}
  & @z0 ~ (l1 a)
  & @z0 ~ (l2 c)
@u_set = (t (k (L (P o))))
  & L ~ ?((@u_set_leaf @u_set_node) (t (k (P o))))
@u_set_leaf = (t (* (P o)))
  & @u_set_act ~ (t (P o))
@u_set_act = (* (p p))
@u_set_node = (lm (t (k (P o))))
  & k ~ {k1 k2}
  & lm ~ {l1 l2}
  & k1 ~ $([>>] $(l1 sh))
  & sh ~ $([&] $(1 bt))
  & bt ~ ?((@u_set_L @u_set_R) (t (k2 (l2 (P o)))))
@u_set_L = ((l r) (k (L (P (l2 r)))))
  & @u_set ~ (l (k (L (P l2))))
@u_set_R = (* ((l r) (k (L (P (l r2))))))
  & @u_set ~ (r (k (L (P r2))))
@tl_drop = (* (t t))
@tl_keep = (* (x (t (1 (x t)))))
@tl = (t (L (base (E (acc o)))))
  & L ~ ?((@tl_leaf @tl_node) (t (base (E (acc o)))))
@tl_leaf = (x (i (n (acc o))))
  & i ~ $([<] $(n keep))
  & keep ~ ?((@tl_drop @tl_keep) (x (acc o)))
@tl_node = (lm ((a c) (base (E (acc o)))))
  & lm ~ {l1 {l2 l3}}
  & base ~ {b1 b2}
  & 1 ~ $([<<] $(l3 half))
  & b2 ~ $([+] $(half bR))
  & E ~ {E1 E2}
  & @tl ~ (a (l1 (b1 (E1 (mid o)))))
  & @tl ~ (c (l2 (bR (E2 (acc mid)))))
@build_step = ((L (t idx)) (x (L2 (t2 r))))
  & L ~ {L1 L2}
  & idx ~ {idx1 idx2}
  & @u_set ~ (t (idx1 (L1 (x t2))))
  & idx2 ~ $([+1] r)
@build_fin = ((* (t *)) t)
@build_blk = (t (S0 o0))
  & t ~ (T1 (E1 (T2 (E2 (T3 (E3 (T4 (E4 (T5 (E5 (T6 (E6 (T7 (E7 (T8 (E8 (T9 (E9 (T10 (E10 (T11 (E11 (T12 (E12 (T13 (E13 (T14 (E14 (T15 (E15 (T16 (E16 t16))))))))))))))))))))))))))))))))
  & T1 ~ ?((@build_nil @build_cons) (S0 (o0 (E1 (S1 o1)))))
  & T2 ~ ?((@build_nil @build_cons) (S1 (o1 (E2 (S2 o2)))))
  & T3 ~ ?((@build_nil @build_cons) (S2 (o2 (E3 (S3 o3)))))
  & T4 ~ ?((@build_nil @build_cons) (S3 (o3 (E4 (S4 o4)))))
  & T5 ~ ?((@build_nil @build_cons) (S4 (o4 (E5 (S5 o5)))))
  & T6 ~ ?((@build_nil @build_cons) (S5 (o5 (E6 (S6 o6)))))
  & T7 ~ ?((@build_nil @build_cons) (S6 (o6 (E7 (S7 o7)))))
  & T8 ~ ?((@build_nil @build_cons) (S7 (o7 (E8 (S8 o8)))))
  & T9 ~ ?((@build_nil @build_cons) (S8 (o8 (E9 (S9 o9)))))
  & T10 ~ ?((@build_nil @build_cons) (S9 (o9 (E10 (S10 o10)))))
  & T11 ~ ?((@build_nil @build_cons) (S10 (o10 (E11 (S11 o11)))))
  & T12 ~ ?((@build_nil @build_cons) (S11 (o11 (E12 (S12 o12)))))
  & T13 ~ ?((@build_nil @build_cons) (S12 (o12 (E13 (S13 o13)))))
  & T14 ~ ?((@build_nil @build_cons) (S13 (o13 (E14 (S14 o14)))))
  & T15 ~ ?((@build_nil @build_cons) (S14 (o14 (E15 (S15 o15)))))
  & T16 ~ ?((@build_nil @build_last) (S15 (o15 (E16 t16))))
@build_nil = (S (o *))
  & @build_fin ~ (S o)
@build_cons = (* (S (o (E (S2 o)))))
  & @build_step ~ (S (E S2))
@build_last = (* (S (o (E t))))
  & @build_step ~ (S (E S2))
  & @build_blk ~ (t (S2 o))
@prog = (lst o)
  & @z0 ~ (8 t)
  & @build_blk ~ (lst ((8 (t 0)) out))
  & @tl ~ (out (8 (0 (256 ((0 *) o)))))
