@lg = (?((0 @lg_s) o) o)
@lg_s = (xm o)
  & xm ~ $([+1] x)
  & x ~ $([>>] $(1 y))
  & @lg ~ (y z)
  & z ~ $([+1] o)
@z0 = (?((0 @z0_n) o) o)
@z0_n = (lm (a c))
  & lm ~ {l1 l2}
  & @z0 ~ (l1 a)
  & @z0 ~ (l2 c)
@st = (t (k (L (P o))))
  & L ~ ?((@st_leaf @st_node) (t (k (P o))))
@st_leaf = (t (* (P o)))
  & @st_act ~ (t (P o))
@st_act = (* (p p))
@st_node = (lm (t (k (P o))))
  & k ~ {k1 k2}
  & lm ~ {l1 l2}
  & k1 ~ $([>>] $(l1 sh))
  & sh ~ $([&] $(1 bt))
  & bt ~ ?((@st_L @st_R) (t (k2 (l2 (P o)))))
@st_L = ((l r) (k (L (P (l2 r)))))
  & @st ~ (l (k (L (P l2))))
@st_R = (* ((l r) (k (L (P (l r2))))))
  & @st ~ (r (k (L (P r2))))
@pk = (t (k (L (P o))))
  & L ~ ?((@pk_leaf @pk_node) (t (k (P o))))
@pk_leaf = (t (* (P o)))
  & @pk_act ~ (t (P o))
@pk_act = (l (p l2))
  & l ~ {p l2}
@pk_node = (lm (t (k (P o))))
  & k ~ {k1 k2}
  & lm ~ {l1 l2}
  & k1 ~ $([>>] $(l1 sh))
  & sh ~ $([&] $(1 bt))
  & bt ~ ?((@pk_L @pk_R) (t (k2 (l2 (P o)))))
@pk_L = ((l r) (k (L (P (l2 r)))))
  & @pk ~ (l (k (L (P l2))))
@pk_R = (* ((l r) (k (L (P (l r2))))))
  & @pk ~ (r (k (L (P r2))))
@c_stream_step = ((L (idx ct)) (v (L2 (r t2))))
  & L ~ {L1 L2}
  & idx ~ {idx1 idx2}
  & @st ~ (ct (idx1 (L1 (v t2))))
  & idx2 ~ $([+1] r)
@c_stream_fin = ((* (* ct)) ct)
@c_stream_blk = (t (S0 o0))
  & t ~ (T1 (E1 (T2 (E2 (T3 (E3 (T4 (E4 (T5 (E5 (T6 (E6 (T7 (E7 (T8 (E8 (T9 (E9 (T10 (E10 (T11 (E11 (T12 (E12 (T13 (E13 (T14 (E14 (T15 (E15 (T16 (E16 t16))))))))))))))))))))))))))))))))
  & T1 ~ ?((@c_stream_nil @c_stream_cons) (S0 (o0 (E1 (S1 o1)))))
  & T2 ~ ?((@c_stream_nil @c_stream_cons) (S1 (o1 (E2 (S2 o2)))))
  & T3 ~ ?((@c_stream_nil @c_stream_cons) (S2 (o2 (E3 (S3 o3)))))
  & T4 ~ ?((@c_stream_nil @c_stream_cons) (S3 (o3 (E4 (S4 o4)))))
  & T5 ~ ?((@c_stream_nil @c_stream_cons) (S4 (o4 (E5 (S5 o5)))))
  & T6 ~ ?((@c_stream_nil @c_stream_cons) (S5 (o5 (E6 (S6 o6)))))
  & T7 ~ ?((@c_stream_nil @c_stream_cons) (S6 (o6 (E7 (S7 o7)))))
  & T8 ~ ?((@c_stream_nil @c_stream_cons) (S7 (o7 (E8 (S8 o8)))))
  & T9 ~ ?((@c_stream_nil @c_stream_cons) (S8 (o8 (E9 (S9 o9)))))
  & T10 ~ ?((@c_stream_nil @c_stream_cons) (S9 (o9 (E10 (S10 o10)))))
  & T11 ~ ?((@c_stream_nil @c_stream_cons) (S10 (o10 (E11 (S11 o11)))))
  & T12 ~ ?((@c_stream_nil @c_stream_cons) (S11 (o11 (E12 (S12 o12)))))
  & T13 ~ ?((@c_stream_nil @c_stream_cons) (S12 (o12 (E13 (S13 o13)))))
  & T14 ~ ?((@c_stream_nil @c_stream_cons) (S13 (o13 (E14 (S14 o14)))))
  & T15 ~ ?((@c_stream_nil @c_stream_cons) (S14 (o14 (E15 (S15 o15)))))
  & T16 ~ ?((@c_stream_nil @c_stream_last) (S15 (o15 (E16 t16))))
@c_stream_nil = (S (o *))
  & @c_stream_fin ~ (S o)
@c_stream_cons = (* (S (o (E (S2 o)))))
  & @c_stream_step ~ (S (E S2))
@c_stream_last = (* (S (o (E t))))
  & @c_stream_step ~ (S (E S2))
  & @c_stream_blk ~ (t (S2 o))
@mnl_stream_step = ((L (ct count)) ((a b) (L3 (t22 r2))))
  & L ~ {L1 {L2 L3}}
  & @pk ~ (ct (a (L1 (P t2))))
  & @pk ~ (t2 (b (L2 (P2 t22))))
  & P ~ $([=] $(P2 r))
  & count ~ $([+] $(r r2))
@mnl_stream_fin = ((* (* count)) count)
@mnl_stream_blk = (t (S0 o0))
  & t ~ (T1 (E1 (T2 (E2 (T3 (E3 (T4 (E4 (T5 (E5 (T6 (E6 (T7 (E7 (T8 (E8 (T9 (E9 (T10 (E10 (T11 (E11 (T12 (E12 (T13 (E13 (T14 (E14 (T15 (E15 (T16 (E16 t16))))))))))))))))))))))))))))))))
  & T1 ~ ?((@mnl_stream_nil @mnl_stream_cons) (S0 (o0 (E1 (S1 o1)))))
  & T2 ~ ?((@mnl_stream_nil @mnl_stream_cons) (S1 (o1 (E2 (S2 o2)))))
  & T3 ~ ?((@mnl_stream_nil @mnl_stream_cons) (S2 (o2 (E3 (S3 o3)))))
  & T4 ~ ?((@mnl_stream_nil @mnl_stream_cons) (S3 (o3 (E4 (S4 o4)))))
  & T5 ~ ?((@mnl_stream_nil @mnl_stream_cons) (S4 (o4 (E5 (S5 o5)))))
  & T6 ~ ?((@mnl_stream_nil @mnl_stream_cons) (S5 (o5 (E6 (S6 o6)))))
  & T7 ~ ?((@mnl_stream_nil @mnl_stream_cons) (S6 (o6 (E7 (S7 o7)))))
  & T8 ~ ?((@mnl_stream_nil @mnl_stream_cons) (S7 (o7 (E8 (S8 o8)))))
  & T9 ~ ?((@mnl_stream_nil @mnl_stream_cons) (S8 (o8 (E9 (S9 o9)))))
  & T10 ~ ?((@mnl_stream_nil @mnl_stream_cons) (S9 (o9 (E10 (S10 o10)))))
  & T11 ~ ?((@mnl_stream_nil @mnl_stream_cons) (S10 (o10 (E11 (S11 o11)))))
  & T12 ~ ?((@mnl_stream_nil @mnl_stream_cons) (S11 (o11 (E12 (S12 o12)))))
  & T13 ~ ?((@mnl_stream_nil @mnl_stream_cons) (S12 (o12 (E13 (S13 o13)))))
  & T14 ~ ?((@mnl_stream_nil @mnl_stream_cons) (S13 (o13 (E14 (S14 o14)))))
  & T15 ~ ?((@mnl_stream_nil @mnl_stream_cons) (S14 (o14 (E15 (S15 o15)))))
  & T16 ~ ?((@mnl_stream_nil @mnl_stream_last) (S15 (o15 (E16 t16))))
@mnl_stream_nil = (S (o *))
  & @mnl_stream_fin ~ (S o)
@mnl_stream_cons = (* (S (o (E (S2 o)))))
  & @mnl_stream_step ~ (S (E S2))
@mnl_stream_last = (* (S (o (E t))))
  & @mnl_stream_step ~ (S (E S2))
  & @mnl_stream_blk ~ (t (S2 o))
@prog = ((c mnl) out2)
  & @lg ~ (255 L)
  & L ~ {L1 {L2 L3}}
  & @z0 ~ (L1 t)
  & @c_stream_blk ~ (c ((L2 (0 t)) out))
  & @mnl_stream_blk ~ (mnl ((L3 (out 0)) out2))
