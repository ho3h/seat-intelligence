@z0 = (?((0 @z0_n) o) o)
@z0_n = (lm (a c))
  & lm ~ {l1 l2}
  & @z0 ~ (l1 a)
  & @z0 ~ (l2 c)
@hadd = (t (k (L (P o))))
  & L ~ ?((@hadd_leaf @hadd_node) (t (k (P o))))
@hadd_leaf = (t (* (P o)))
  & @hadd_act ~ (t (P o))
@hadd_act = (x (c o))
  & x ~ $([+] $(c o))
@hadd_node = (lm (t (k (P o))))
  & k ~ {k1 k2}
  & lm ~ {l1 l2}
  & k1 ~ $([>>] $(l1 sh))
  & sh ~ $([&] $(1 bt))
  & bt ~ ?((@hadd_L @hadd_R) (t (k2 (l2 (P o)))))
@hadd_L = ((l r) (k (L (P (l2 r)))))
  & @hadd ~ (l (k (L (P l2))))
@hadd_R = (* ((l r) (k (L (P (l r2))))))
  & @hadd ~ (r (k (L (P r2))))
@sk_step = (marks ((u v) t2))
  & u ~ $([*256] r)
  & r ~ $([+] $(v r2))
  & @hadd ~ (marks (r2 (16 (1 t2))))
@sk_fin = (marks marks)
@sk_blk = (t (S0 o0))
  & t ~ (T1 (E1 (T2 (E2 (T3 (E3 (T4 (E4 (T5 (E5 (T6 (E6 (T7 (E7 (T8 (E8 (T9 (E9 (T10 (E10 (T11 (E11 (T12 (E12 (T13 (E13 (T14 (E14 (T15 (E15 (T16 (E16 t16))))))))))))))))))))))))))))))))
  & T1 ~ ?((@sk_nil @sk_cons) (S0 (o0 (E1 (S1 o1)))))
  & T2 ~ ?((@sk_nil @sk_cons) (S1 (o1 (E2 (S2 o2)))))
  & T3 ~ ?((@sk_nil @sk_cons) (S2 (o2 (E3 (S3 o3)))))
  & T4 ~ ?((@sk_nil @sk_cons) (S3 (o3 (E4 (S4 o4)))))
  & T5 ~ ?((@sk_nil @sk_cons) (S4 (o4 (E5 (S5 o5)))))
  & T6 ~ ?((@sk_nil @sk_cons) (S5 (o5 (E6 (S6 o6)))))
  & T7 ~ ?((@sk_nil @sk_cons) (S6 (o6 (E7 (S7 o7)))))
  & T8 ~ ?((@sk_nil @sk_cons) (S7 (o7 (E8 (S8 o8)))))
  & T9 ~ ?((@sk_nil @sk_cons) (S8 (o8 (E9 (S9 o9)))))
  & T10 ~ ?((@sk_nil @sk_cons) (S9 (o9 (E10 (S10 o10)))))
  & T11 ~ ?((@sk_nil @sk_cons) (S10 (o10 (E11 (S11 o11)))))
  & T12 ~ ?((@sk_nil @sk_cons) (S11 (o11 (E12 (S12 o12)))))
  & T13 ~ ?((@sk_nil @sk_cons) (S12 (o12 (E13 (S13 o13)))))
  & T14 ~ ?((@sk_nil @sk_cons) (S13 (o13 (E14 (S14 o14)))))
  & T15 ~ ?((@sk_nil @sk_cons) (S14 (o14 (E15 (S15 o15)))))
  & T16 ~ ?((@sk_nil @sk_last) (S15 (o15 (E16 t16))))
@sk_nil = (S (o *))
  & @sk_fin ~ (S o)
@sk_cons = (* (S (o (E (S2 o)))))
  & @sk_step ~ (S (E S2))
@sk_last = (* (S (o (E t))))
  & @sk_step ~ (S (E S2))
  & @sk_blk ~ (t (S2 o))
@sc_step_b1z = (val_in (hole_in (marks_in (* (* (* (val_in (hole_in marks_in))))))))
@sc_step_b1s = (* (val_in (hole_in (marks_in (u_in (v_in (score_in (val_in (hole marks_in)))))))))
  & hole_in ~ (1 ((u_in (v_in score_in)) hole))
@sc_step = ((val (hole marks)) ((u (v score)) (br (br2 br3))))
  & u ~ {u1 u2}
  & v ~ {v1 v2}
  & score ~ {* score2}
  & u1 ~ $([*256] r)
  & r ~ $([+] $(v1 *))
  & 1 ~ ?((@sc_step_b1z @sc_step_b1s) (val (hole (marks (u2 (v2 (score2 (br (br2 br3)))))))))
@sc_fin = ((val (hole *)) val)
  & hole ~ (0 *)
@sc_blk = (t (S0 o0))
  & t ~ (T1 (E1 (T2 (E2 (T3 (E3 (T4 (E4 (T5 (E5 (T6 (E6 (T7 (E7 (T8 (E8 (T9 (E9 (T10 (E10 (T11 (E11 (T12 (E12 (T13 (E13 (T14 (E14 (T15 (E15 (T16 (E16 t16))))))))))))))))))))))))))))))))
  & T1 ~ ?((@sc_nil @sc_cons) (S0 (o0 (E1 (S1 o1)))))
  & T2 ~ ?((@sc_nil @sc_cons) (S1 (o1 (E2 (S2 o2)))))
  & T3 ~ ?((@sc_nil @sc_cons) (S2 (o2 (E3 (S3 o3)))))
  & T4 ~ ?((@sc_nil @sc_cons) (S3 (o3 (E4 (S4 o4)))))
  & T5 ~ ?((@sc_nil @sc_cons) (S4 (o4 (E5 (S5 o5)))))
  & T6 ~ ?((@sc_nil @sc_cons) (S5 (o5 (E6 (S6 o6)))))
  & T7 ~ ?((@sc_nil @sc_cons) (S6 (o6 (E7 (S7 o7)))))
  & T8 ~ ?((@sc_nil @sc_cons) (S7 (o7 (E8 (S8 o8)))))
  & T9 ~ ?((@sc_nil @sc_cons) (S8 (o8 (E9 (S9 o9)))))
  & T10 ~ ?((@sc_nil @sc_cons) (S9 (o9 (E10 (S10 o10)))))
  & T11 ~ ?((@sc_nil @sc_cons) (S10 (o10 (E11 (S11 o11)))))
  & T12 ~ ?((@sc_nil @sc_cons) (S11 (o11 (E12 (S12 o12)))))
  & T13 ~ ?((@sc_nil @sc_cons) (S12 (o12 (E13 (S13 o13)))))
  & T14 ~ ?((@sc_nil @sc_cons) (S13 (o13 (E14 (S14 o14)))))
  & T15 ~ ?((@sc_nil @sc_cons) (S14 (o14 (E15 (S15 o15)))))
  & T16 ~ ?((@sc_nil @sc_last) (S15 (o15 (E16 t16))))
@sc_nil = (S (o *))
  & @sc_fin ~ (S o)
@sc_cons = (* (S (o (E (S2 o)))))
  & @sc_step ~ (S (E S2))
@sc_last = (* (S (o (E t))))
  & @sc_step ~ (S (E S2))
  & @sc_blk ~ (t (S2 o))
@prog = ((known cands) out2)
  & @z0 ~ (16 t)
  & @sk_blk ~ (known (t out))
  & @sc_blk ~ (cands ((val (val out)) out2))
