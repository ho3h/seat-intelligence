@sc_step_b1z = (val_in (hole_in (known_in (* (* (* (val_in (hole_in known_in))))))))
@sc_step_b1s = (* (val_in (hole_in (known_in (u_in (v_in (score_in (val_in (hole known_in)))))))))
  & hole_in ~ (1 ((u_in (v_in score_in)) hole))
@sc_step = ((val (hole known)) ((u (v score)) (br (br2 br3))))
  & u ~ {* u2}
  & v ~ {* v2}
  & score ~ {* score2}
  & 1 ~ ?((@sc_step_b1z @sc_step_b1s) (val (hole (known (u2 (v2 (score2 (br (br2 br3)))))))))
@sc_fin = ((val (hole *)) val)
  & hole ~ (0 *)
@sc_blk = (t (S0 o0))
  & t ~ (T1 (E1 (T2 (E2 (T3 (E3 (T4 (E4 (T5 (E5 (T6 (E6 (T7 (E7 (T8 (E8 (T9 (E9 (T10 (E10 (T11 (E11 (T12 (E12 (T13 (E13 (T14 (E14 (T15 (E15 (T16 (E16 t16))))))))))))))))))))))))))))))))
  & T1 ~ ?((@sc_nil @sc_cons) (S0 (o0 (E1 (S1 o1)))))
  & T2 ~ ?((@sc_nil @sc_cons) (S1 (o1 (E2 (S2 o2)))))
  & T3 ~ ?((@sc_nil @sc_cons) (S2 (o2 (E3 (S3 o3)))))
  & T4 ~ ?((@sc_nil @sc_cons) (S3 (o3 (E4 (S4 o4)))))
  & T5 ~ ?((@sc_nil @sc_cons) (S4 (o4 (E5 (S5 o5)))))
  & T6 ~ ?((@sc_nil @sc_cons) (S5 (o5 (E6 (S6 o6)))))
  & T7 ~ ?((@sc_nil @sc_cons) (S6 (o6 (E7 (S7 o7)))))
  & T8 ~ ?((@sc_nil @sc_cons) (S7 (o7 (E8 (S8 o8)))))
  & T9 ~ ?((@sc_nil @sc_cons) (S8 (o8 (E9 (S9 o9)))))
  & T10 ~ ?((@sc_nil @sc_cons) (S9 (o9 (E10 (S10 o10)))))
  & T11 ~ ?((@sc_nil @sc_cons) (S10 (o10 (E11 (S11 o11)))))
  & T12 ~ ?((@sc_nil @sc_cons) (S11 (o11 (E12 (S12 o12)))))
  & T13 ~ ?((@sc_nil @sc_cons) (S12 (o12 (E13 (S13 o13)))))
  & T14 ~ ?((@sc_nil @sc_cons) (S13 (o13 (E14 (S14 o14)))))
  & T15 ~ ?((@sc_nil @sc_cons) (S14 (o14 (E15 (S15 o15)))))
  & T16 ~ ?((@sc_nil @sc_last) (S15 (o15 (E16 t16))))
@sc_nil = (S (o *))
  & @sc_fin ~ (S o)
@sc_cons = (* (S (o (E (S2 o)))))
  & @sc_step ~ (S (E S2))
@sc_last = (* (S (o (E t))))
  & @sc_step ~ (S (E S2))
  & @sc_blk ~ (t (S2 o))
@prog = ((known cands) out)
  & @sc_blk ~ (cands ((val (val known)) out))
