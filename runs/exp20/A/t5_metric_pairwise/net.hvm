@len_walker_step = (cnt (* r))
  & cnt ~ $([+1] r)
@len_walker_fin = (cnt cnt)
@len_walker_blk = (t (S0 o0))
  & t ~ (T1 (E1 (T2 (E2 (T3 (E3 (T4 (E4 (T5 (E5 (T6 (E6 (T7 (E7 (T8 (E8 (T9 (E9 (T10 (E10 (T11 (E11 (T12 (E12 (T13 (E13 (T14 (E14 (T15 (E15 (T16 (E16 t16))))))))))))))))))))))))))))))))
  & T1 ~ ?((@len_walker_nil @len_walker_cons) (S0 (o0 (E1 (S1 o1)))))
  & T2 ~ ?((@len_walker_nil @len_walker_cons) (S1 (o1 (E2 (S2 o2)))))
  & T3 ~ ?((@len_walker_nil @len_walker_cons) (S2 (o2 (E3 (S3 o3)))))
  & T4 ~ ?((@len_walker_nil @len_walker_cons) (S3 (o3 (E4 (S4 o4)))))
  & T5 ~ ?((@len_walker_nil @len_walker_cons) (S4 (o4 (E5 (S5 o5)))))
  & T6 ~ ?((@len_walker_nil @len_walker_cons) (S5 (o5 (E6 (S6 o6)))))
  & T7 ~ ?((@len_walker_nil @len_walker_cons) (S6 (o6 (E7 (S7 o7)))))
  & T8 ~ ?((@len_walker_nil @len_walker_cons) (S7 (o7 (E8 (S8 o8)))))
  & T9 ~ ?((@len_walker_nil @len_walker_cons) (S8 (o8 (E9 (S9 o9)))))
  & T10 ~ ?((@len_walker_nil @len_walker_cons) (S9 (o9 (E10 (S10 o10)))))
  & T11 ~ ?((@len_walker_nil @len_walker_cons) (S10 (o10 (E11 (S11 o11)))))
  & T12 ~ ?((@len_walker_nil @len_walker_cons) (S11 (o11 (E12 (S12 o12)))))
  & T13 ~ ?((@len_walker_nil @len_walker_cons) (S12 (o12 (E13 (S13 o13)))))
  & T14 ~ ?((@len_walker_nil @len_walker_cons) (S13 (o13 (E14 (S14 o14)))))
  & T15 ~ ?((@len_walker_nil @len_walker_cons) (S14 (o14 (E15 (S15 o15)))))
  & T16 ~ ?((@len_walker_nil @len_walker_last) (S15 (o15 (E16 t16))))
@len_walker_nil = (S (o *))
  & @len_walker_fin ~ (S o)
@len_walker_cons = (* (S (o (E (S2 o)))))
  & @len_walker_step ~ (S (E S2))
@len_walker_last = (* (S (o (E t))))
  & @len_walker_step ~ (S (E S2))
  & @len_walker_blk ~ (t (S2 o))
@prog_b1z = (* (0 (0 0)))
@prog_b1s = (* (* (0 (0 0))))
@prog = ((pred_list truth_list) (br (br2 br3)))
  & @len_walker_blk ~ (pred_list (0 out))
  & out ~ ?((@prog_b1z @prog_b1s) (truth_list (br (br2 br3))))
