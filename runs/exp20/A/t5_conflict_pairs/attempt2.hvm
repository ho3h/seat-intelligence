// t5_conflict_pairs: glue composition
@find_at_idx_step_b1z = (i_val (* r))
  & i_val ~ $([+1] r)
@find_at_idx_step_b1s = (* (* (elem_val elem_val)))
@find_at_idx_step = ((i target_idx) (elem (target_idx2 br)))
  & i ~ {i1 i2}
  & target_idx ~ {target_idx1 target_idx2}
  & i1 ~ $([=] $(target_idx1 r))
  & r ~ ?((@find_at_idx_step_b1z @find_at_idx_step_b1s) (i2 (elem br)))
@find_at_idx_fin = ((* *) 0)
@find_at_idx_blk = (t (S0 o0))
  & t ~ (T1 (E1 (T2 (E2 (T3 (E3 (T4 (E4 (T5 (E5 (T6 (E6 (T7 (E7 (T8 (E8 (T9 (E9 (T10 (E10 (T11 (E11 (T12 (E12 (T13 (E13 (T14 (E14 (T15 (E15 (T16 (E16 t16))))))))))))))))))))))))))))))))
  & T1 ~ ?((@find_at_idx_nil @find_at_idx_cons) (S0 (o0 (E1 (S1 o1)))))
  & T2 ~ ?((@find_at_idx_nil @find_at_idx_cons) (S1 (o1 (E2 (S2 o2)))))
  & T3 ~ ?((@find_at_idx_nil @find_at_idx_cons) (S2 (o2 (E3 (S3 o3)))))
  & T4 ~ ?((@find_at_idx_nil @find_at_idx_cons) (S3 (o3 (E4 (S4 o4)))))
  & T5 ~ ?((@find_at_idx_nil @find_at_idx_cons) (S4 (o4 (E5 (S5 o5)))))
  & T6 ~ ?((@find_at_idx_nil @find_at_idx_cons) (S5 (o5 (E6 (S6 o6)))))
  & T7 ~ ?((@find_at_idx_nil @find_at_idx_cons) (S6 (o6 (E7 (S7 o7)))))
  & T8 ~ ?((@find_at_idx_nil @find_at_idx_cons) (S7 (o7 (E8 (S8 o8)))))
  & T9 ~ ?((@find_at_idx_nil @find_at_idx_cons) (S8 (o8 (E9 (S9 o9)))))
  & T10 ~ ?((@find_at_idx_nil @find_at_idx_cons) (S9 (o9 (E10 (S10 o10)))))
  & T11 ~ ?((@find_at_idx_nil @find_at_idx_cons) (S10 (o10 (E11 (S11 o11)))))
  & T12 ~ ?((@find_at_idx_nil @find_at_idx_cons) (S11 (o11 (E12 (S12 o12)))))
  & T13 ~ ?((@find_at_idx_nil @find_at_idx_cons) (S12 (o12 (E13 (S13 o13)))))
  & T14 ~ ?((@find_at_idx_nil @find_at_idx_cons) (S13 (o13 (E14 (S14 o14)))))
  & T15 ~ ?((@find_at_idx_nil @find_at_idx_cons) (S14 (o14 (E15 (S15 o15)))))
  & T16 ~ ?((@find_at_idx_nil @find_at_idx_last) (S15 (o15 (E16 t16))))
@find_at_idx_nil = (S (o *))
  & @find_at_idx_fin ~ (S o)
@find_at_idx_cons = (* (S (o (E (S2 o)))))
  & @find_at_idx_step ~ (S (E S2))
@find_at_idx_last = (* (S (o (E t))))
  & @find_at_idx_step ~ (S (E S2))
  & @find_at_idx_blk ~ (t (S2 o))
@filter_step = (result ((a b) cell))
  & cell ~ (1 ((a b) result))
@filter_fin = (result result)
@filter_blk = (t (S0 o0))
  & t ~ (T1 (E1 (T2 (E2 (T3 (E3 (T4 (E4 (T5 (E5 (T6 (E6 (T7 (E7 (T8 (E8 (T9 (E9 (T10 (E10 (T11 (E11 (T12 (E12 (T13 (E13 (T14 (E14 (T15 (E15 (T16 (E16 t16))))))))))))))))))))))))))))))))
  & T1 ~ ?((@filter_nil @filter_cons) (S0 (o0 (E1 (S1 o1)))))
  & T2 ~ ?((@filter_nil @filter_cons) (S1 (o1 (E2 (S2 o2)))))
  & T3 ~ ?((@filter_nil @filter_cons) (S2 (o2 (E3 (S3 o3)))))
  & T4 ~ ?((@filter_nil @filter_cons) (S3 (o3 (E4 (S4 o4)))))
  & T5 ~ ?((@filter_nil @filter_cons) (S4 (o4 (E5 (S5 o5)))))
  & T6 ~ ?((@filter_nil @filter_cons) (S5 (o5 (E6 (S6 o6)))))
  & T7 ~ ?((@filter_nil @filter_cons) (S6 (o6 (E7 (S7 o7)))))
  & T8 ~ ?((@filter_nil @filter_cons) (S7 (o7 (E8 (S8 o8)))))
  & T9 ~ ?((@filter_nil @filter_cons) (S8 (o8 (E9 (S9 o9)))))
  & T10 ~ ?((@filter_nil @filter_cons) (S9 (o9 (E10 (S10 o10)))))
  & T11 ~ ?((@filter_nil @filter_cons) (S10 (o10 (E11 (S11 o11)))))
  & T12 ~ ?((@filter_nil @filter_cons) (S11 (o11 (E12 (S12 o12)))))
  & T13 ~ ?((@filter_nil @filter_cons) (S12 (o12 (E13 (S13 o13)))))
  & T14 ~ ?((@filter_nil @filter_cons) (S13 (o13 (E14 (S14 o14)))))
  & T15 ~ ?((@filter_nil @filter_cons) (S14 (o14 (E15 (S15 o15)))))
  & T16 ~ ?((@filter_nil @filter_last) (S15 (o15 (E16 t16))))
@filter_nil = (S (o *))
  & @filter_fin ~ (S o)
@filter_cons = (* (S (o (E (S2 o)))))
  & @filter_step ~ (S (E S2))
@filter_last = (* (S (o (E t))))
  & @filter_step ~ (S (E S2))
  & @filter_blk ~ (t (S2 o))
@prog = ((* mnl) out)
  & @filter_blk ~ (mnl ((0 *) out))
