// t5_conflict_pairs: glue composition
@index_step = ((i result) (c_val (r cell)))
  & i ~ {i1 i2}
  & i1 ~ $([+1] r)
  & cell ~ (1 ((i2 c_val) result))
@index_fin = ((* result) result)
@index_blk = (t (S0 o0))
  & t ~ (T1 (E1 (T2 (E2 (T3 (E3 (T4 (E4 (T5 (E5 (T6 (E6 (T7 (E7 (T8 (E8 (T9 (E9 (T10 (E10 (T11 (E11 (T12 (E12 (T13 (E13 (T14 (E14 (T15 (E15 (T16 (E16 t16))))))))))))))))))))))))))))))))
  & T1 ~ ?((@index_nil @index_cons) (S0 (o0 (E1 (S1 o1)))))
  & T2 ~ ?((@index_nil @index_cons) (S1 (o1 (E2 (S2 o2)))))
  & T3 ~ ?((@index_nil @index_cons) (S2 (o2 (E3 (S3 o3)))))
  & T4 ~ ?((@index_nil @index_cons) (S3 (o3 (E4 (S4 o4)))))
  & T5 ~ ?((@index_nil @index_cons) (S4 (o4 (E5 (S5 o5)))))
  & T6 ~ ?((@index_nil @index_cons) (S5 (o5 (E6 (S6 o6)))))
  & T7 ~ ?((@index_nil @index_cons) (S6 (o6 (E7 (S7 o7)))))
  & T8 ~ ?((@index_nil @index_cons) (S7 (o7 (E8 (S8 o8)))))
  & T9 ~ ?((@index_nil @index_cons) (S8 (o8 (E9 (S9 o9)))))
  & T10 ~ ?((@index_nil @index_cons) (S9 (o9 (E10 (S10 o10)))))
  & T11 ~ ?((@index_nil @index_cons) (S10 (o10 (E11 (S11 o11)))))
  & T12 ~ ?((@index_nil @index_cons) (S11 (o11 (E12 (S12 o12)))))
  & T13 ~ ?((@index_nil @index_cons) (S12 (o12 (E13 (S13 o13)))))
  & T14 ~ ?((@index_nil @index_cons) (S13 (o13 (E14 (S14 o14)))))
  & T15 ~ ?((@index_nil @index_cons) (S14 (o14 (E15 (S15 o15)))))
  & T16 ~ ?((@index_nil @index_last) (S15 (o15 (E16 t16))))
@index_nil = (S (o *))
  & @index_fin ~ (S o)
@index_cons = (* (S (o (E (S2 o)))))
  & @index_step ~ (S (E S2))
@index_last = (* (S (o (E t))))
  & @index_step ~ (S (E S2))
  & @index_blk ~ (t (S2 o))
@filter_step_b1z = (* (* (res res)))
@filter_step_b1s = (* (av (bv (res cell))))
  & cell ~ (1 ((av bv) res))
@filter_step = ((c_indexed result) ((a b) (c_indexed br)))
  & a ~ {a1 a2}
  & b ~ {b1 b2}
  & a1 ~ $([=] $(b1 r))
  & r ~ ?((@filter_step_b1z @filter_step_b1s) (a2 (b2 (result br))))
@filter_fin = ((* result) result)
@filter_blk = (t (S0 o0))
  & t ~ (T1 (E1 (T2 (E2 (T3 (E3 (T4 (E4 (T5 (E5 (T6 (E6 (T7 (E7 (T8 (E8 (T9 (E9 (T10 (E10 (T11 (E11 (T12 (E12 (T13 (E13 (T14 (E14 (T15 (E15 (T16 (E16 t16))))))))))))))))))))))))))))))))
  & T1 ~ ?((@filter_nil @filter_cons) (S0 (o0 (E1 (S1 o1)))))
  & T2 ~ ?((@filter_nil @filter_cons) (S1 (o1 (E2 (S2 o2)))))
  & T3 ~ ?((@filter_nil @filter_cons) (S2 (o2 (E3 (S3 o3)))))
  & T4 ~ ?((@filter_nil @filter_cons) (S3 (o3 (E4 (S4 o4)))))
  & T5 ~ ?((@filter_nil @filter_cons) (S4 (o4 (E5 (S5 o5)))))
  & T6 ~ ?((@filter_nil @filter_cons) (S5 (o5 (E6 (S6 o6)))))
  & T7 ~ ?((@filter_nil @filter_cons) (S6 (o6 (E7 (S7 o7)))))
  & T8 ~ ?((@filter_nil @filter_cons) (S7 (o7 (E8 (S8 o8)))))
  & T9 ~ ?((@filter_nil @filter_cons) (S8 (o8 (E9 (S9 o9)))))
  & T10 ~ ?((@filter_nil @filter_cons) (S9 (o9 (E10 (S10 o10)))))
  & T11 ~ ?((@filter_nil @filter_cons) (S10 (o10 (E11 (S11 o11)))))
  & T12 ~ ?((@filter_nil @filter_cons) (S11 (o11 (E12 (S12 o12)))))
  & T13 ~ ?((@filter_nil @filter_cons) (S12 (o12 (E13 (S13 o13)))))
  & T14 ~ ?((@filter_nil @filter_cons) (S13 (o13 (E14 (S14 o14)))))
  & T15 ~ ?((@filter_nil @filter_cons) (S14 (o14 (E15 (S15 o15)))))
  & T16 ~ ?((@filter_nil @filter_last) (S15 (o15 (E16 t16))))
@filter_nil = (S (o *))
  & @filter_fin ~ (S o)
@filter_cons = (* (S (o (E (S2 o)))))
  & @filter_step ~ (S (E S2))
@filter_last = (* (S (o (E t))))
  & @filter_step ~ (S (E S2))
  & @filter_blk ~ (t (S2 o))
@prog = ((c mnl) out2)
  & @index_blk ~ (c ((0 (0 *)) out))
  & @filter_blk ~ (mnl ((out (0 *)) out2))
