@we_step = ((L_out output_trie) ((u v) (L_out2 t2)))
  & L_out ~ {L_out1 L_out2}
  & u ~ $([*256] r)
  & r ~ $([+] $(v r2))
  & @hadd ~ (output_trie (r2 (L_out1 (1 t2))))
