@cne_step = (* (* 1))
@cne_fin = (found found)
@cne_blk = (t (S0 o0))
  & t ~ (T1 (E1 (T2 (E2 (T3 (E3 (T4 (E4 (T5 (E5 (T6 (E6 (T7 (E7 (T8 (E8 (T9 (E9 (T10 (E10 (T11 (E11 (T12 (E12 (T13 (E13 (T14 (E14 (T15 (E15 (T16 (E16 t16))))))))))))))))))))))))))))))))
  & T1 ~ ?((@cne_nil @cne_cons) (S0 (o0 (E1 (S1 o1)))))
  & T2 ~ ?((@cne_nil @cne_cons) (S1 (o1 (E2 (S2 o2)))))
  & T3 ~ ?((@cne_nil @cne_cons) (S2 (o2 (E3 (S3 o3)))))
  & T4 ~ ?((@cne_nil @cne_cons) (S3 (o3 (E4 (S4 o4)))))
  & T5 ~ ?((@cne_nil @cne_cons) (S4 (o4 (E5 (S5 o5)))))
  & T6 ~ ?((@cne_nil @cne_cons) (S5 (o5 (E6 (S6 o6)))))
  & T7 ~ ?((@cne_nil @cne_cons) (S6 (o6 (E7 (S7 o7)))))
  & T8 ~ ?((@cne_nil @cne_cons) (S7 (o7 (E8 (S8 o8)))))
  & T9 ~ ?((@cne_nil @cne_cons) (S8 (o8 (E9 (S9 o9)))))
  & T10 ~ ?((@cne_nil @cne_cons) (S9 (o9 (E10 (S10 o10)))))
  & T11 ~ ?((@cne_nil @cne_cons) (S10 (o10 (E11 (S11 o11)))))
  & T12 ~ ?((@cne_nil @cne_cons) (S11 (o11 (E12 (S12 o12)))))
  & T13 ~ ?((@cne_nil @cne_cons) (S12 (o12 (E13 (S13 o13)))))
  & T14 ~ ?((@cne_nil @cne_cons) (S13 (o13 (E14 (S14 o14)))))
  & T15 ~ ?((@cne_nil @cne_cons) (S14 (o14 (E15 (S15 o15)))))
  & T16 ~ ?((@cne_nil @cne_last) (S15 (o15 (E16 t16))))
@cne_nil = (S (o *))
  & @cne_fin ~ (S o)
@cne_cons = (* (S (o (E (S2 o)))))
  & @cne_step ~ (S (E S2))
@cne_last = (* (S (o (E t))))
  & @cne_step ~ (S (E S2))
  & @cne_blk ~ (t (S2 o))
@prog = ((pred *) out)
  & @cne_blk ~ (pred (0 out))
