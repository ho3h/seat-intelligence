@lg = (?((0 @lg_s) o) o)
@lg_s = (xm o)
  & xm ~ $([+1] x)
  & x ~ $([>>] $(1 y))
  & @lg ~ (y z)
  & z ~ $([+1] o)
@z0 = (?((0 @z0_n) o) o)
@z0_n = (lm (a c))
  & lm ~ {l1 l2}
  & @z0 ~ (l1 a)
  & @z0 ~ (l2 c)
@hadd = (t (k (L (P o))))
  & L ~ ?((@hadd_leaf @hadd_node) (t (k (P o))))
@hadd_leaf = (t (* (P o)))
  & @hadd_act ~ (t (P o))
@hadd_act = (x (c o))
  & x ~ $([+] $(c o))
@hadd_node = (lm (t (k (P o))))
  & k ~ {k1 k2}
  & lm ~ {l1 l2}
  & k1 ~ $([>>] $(l1 sh))
  & sh ~ $([&] $(1 bt))
  & bt ~ ?((@hadd_L @hadd_R) (t (k2 (l2 (P o)))))
@hadd_L = ((l r) (k (L (P (l2 r)))))
  & @hadd ~ (l (k (L (P l2))))
@hadd_R = (* ((l r) (k (L (P (l r2))))))
  & @hadd ~ (r (k (L (P r2))))
@rsum = (t (L o))
  & L ~ ?((@rsum_leaf @rsum_node) (t o))
@rsum_leaf = (x x)
@rsum_node = (lm ((a c) o))
  & lm ~ {l1 l2}
  & @rsum ~ (a (l1 x))
  & @rsum ~ (c (l2 y))
  & x ~ $([+] $(y o))
@walk_step = ((cnt trie) (* (cnt trie)))
@walk_fin = ((* trie) trie)
@walk_blk = (t (S0 o0))
  & t ~ (T1 (E1 (T2 (E2 (T3 (E3 (T4 (E4 (T5 (E5 (T6 (E6 (T7 (E7 (T8 (E8 (T9 (E9 (T10 (E10 (T11 (E11 (T12 (E12 (T13 (E13 (T14 (E14 (T15 (E15 (T16 (E16 t16))))))))))))))))))))))))))))))))
  & T1 ~ ?((@walk_nil @walk_cons) (S0 (o0 (E1 (S1 o1)))))
  & T2 ~ ?((@walk_nil @walk_cons) (S1 (o1 (E2 (S2 o2)))))
  & T3 ~ ?((@walk_nil @walk_cons) (S2 (o2 (E3 (S3 o3)))))
  & T4 ~ ?((@walk_nil @walk_cons) (S3 (o3 (E4 (S4 o4)))))
  & T5 ~ ?((@walk_nil @walk_cons) (S4 (o4 (E5 (S5 o5)))))
  & T6 ~ ?((@walk_nil @walk_cons) (S5 (o5 (E6 (S6 o6)))))
  & T7 ~ ?((@walk_nil @walk_cons) (S6 (o6 (E7 (S7 o7)))))
  & T8 ~ ?((@walk_nil @walk_cons) (S7 (o7 (E8 (S8 o8)))))
  & T9 ~ ?((@walk_nil @walk_cons) (S8 (o8 (E9 (S9 o9)))))
  & T10 ~ ?((@walk_nil @walk_cons) (S9 (o9 (E10 (S10 o10)))))
  & T11 ~ ?((@walk_nil @walk_cons) (S10 (o10 (E11 (S11 o11)))))
  & T12 ~ ?((@walk_nil @walk_cons) (S11 (o11 (E12 (S12 o12)))))
  & T13 ~ ?((@walk_nil @walk_cons) (S12 (o12 (E13 (S13 o13)))))
  & T14 ~ ?((@walk_nil @walk_cons) (S13 (o13 (E14 (S14 o14)))))
  & T15 ~ ?((@walk_nil @walk_cons) (S14 (o14 (E15 (S15 o15)))))
  & T16 ~ ?((@walk_nil @walk_last) (S15 (o15 (E16 t16))))
@walk_nil = (S (o *))
  & @walk_fin ~ (S o)
@walk_cons = (* (S (o (E (S2 o)))))
  & @walk_step ~ (S (E S2))
@walk_last = (* (S (o (E t))))
  & @walk_step ~ (S (E S2))
  & @walk_blk ~ (t (S2 o))
@prog = ((pred *) 0)
  & @lg ~ (15 L)
  & @z0 ~ (L t)
  & @walk_blk ~ (pred ((0 t) *))
