  & T7 ~ ?((@take_nil @take_cons) (S6 (o6 (E7 (S7 o7)))))
  & T8 ~ ?((@take_nil @take_cons) (S7 (o7 (E8 (S8 o8)))))
  & T9 ~ ?((@take_nil @take_cons) (S8 (o8 (E9 (S9 o9)))))
  & T10 ~ ?((@take_nil @take_cons) (S9 (o9 (E10 (S10 o10)))))
  & T11 ~ ?((@take_nil @take_cons) (S10 (o10 (E11 (S11 o11)))))
  & T12 ~ ?((@take_nil @take_cons) (S11 (o11 (E12 (S12 o12)))))
  & T13 ~ ?((@take_nil @take_cons) (S12 (o12 (E13 (S13 o13)))))
  & T14 ~ ?((@take_nil @take_cons) (S13 (o13 (E14 (S14 o14)))))
  & T15 ~ ?((@take_nil @take_cons) (S14 (o14 (E15 (S15 o15)))))
  & T16 ~ ?((@take_nil @take_last) (S15 (o15 (E16 t16))))
@take_nil = (S (o *))
  & @take_fin ~ (S o)
@take_cons = (* (S (o (E (S2 o)))))
  & @take_step ~ (S (E S2))
@take_last = (* (S (o (E t))))
  & @take_step ~ (S (E S2))
  & @take_blk ~ (t (S2 o))
@rev_step = ((k rev_list) ((u (v score)) (k cell)))
  & cell ~ (1 ((u (v score)) rev_list))
@rev_fin = ((k rev_list) out)
  & @take_blk ~ (rev_list ((k (0 *)) out))
@rev_blk = (t (S0 o0))
  & t ~ (T1 (E1 (T2 (E2 (T3 (E3 (T4 (E4 (T5 (E5 (T6 (E6 (T7 (E7 (T8 (E8 (T9 (E9 (T10 (E10 (T11 (E11 (T12 (E12 (T13 (E13 (T14 (E14 (T15 (E15 (T16 (E16 t16))))))))))))))))))))))))))))))))
