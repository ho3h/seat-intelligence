  & T2 ~ ?((@coll_nil @coll_cons) (S1 (o1 (E2 (S2 o2)))))
  & T3 ~ ?((@coll_nil @coll_cons) (S2 (o2 (E3 (S3 o3)))))
  & T4 ~ ?((@coll_nil @coll_cons) (S3 (o3 (E4 (S4 o4)))))
