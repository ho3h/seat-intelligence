  & T10 ~ ?((@rev_nil @rev_cons) (S9 (o9 (E10 (S10 o10)))))
  & T11 ~ ?((@rev_nil @rev_cons) (S10 (o10 (E11 (S11 o11)))))
  & T12 ~ ?((@rev_nil @rev_cons) (S11 (o11 (E12 (S12 o12)))))
  & T13 ~ ?((@rev_nil @rev_cons) (S12 (o12 (E13 (S13 o13)))))
  & T14 ~ ?((@rev_nil @rev_cons) (S13 (o13 (E14 (S14 o14)))))
  & T15 ~ ?((@rev_nil @rev_cons) (S14 (o14 (E15 (S15 o15)))))
  & T16 ~ ?((@rev_nil @rev_last) (S15 (o15 (E16 t16))))
@rev_nil = (S (o *))
  & @rev_fin ~ (S o)
@rev_cons = (* (S (o (E (S2 o)))))
  & @rev_step ~ (S (E S2))
@rev_last = (* (S (o (E t))))
  & @rev_step ~ (S (E S2))
  & @rev_blk ~ (t (S2 o))
@coll_step = ((k_st all_triples) ((u (v score)) (k_st cell)))
  & cell ~ (1 ((u (v score)) all_triples))
@coll_fin = ((k_st all_triples) out)
  & @rev_blk ~ (all_triples ((k_st (0 *)) out))
@coll_blk = (t (S0 o0))
  & t ~ (T1 (E1 (T2 (E2 (T3 (E3 (T4 (E4 (T5 (E5 (T6 (E6 (T7 (E7 (T8 (E8 (T9 (E9 (T10 (E10 (T11 (E11 (T12 (E12 (T13 (E13 (T14 (E14 (T15 (E15 (T16 (E16 t16))))))))))))))))))))))))))))))))
