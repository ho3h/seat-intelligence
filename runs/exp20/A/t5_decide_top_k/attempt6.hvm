  & T6 ~ ?((@rev_nil @rev_cons) (S5 (o5 (E6 (S6 o6)))))
  & T7 ~ ?((@rev_nil @rev_cons) (S6 (o6 (E7 (S7 o7)))))
  & T8 ~ ?((@rev_nil @rev_cons) (S7 (o7 (E8 (S8 o8)))))
