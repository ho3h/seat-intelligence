  & T10 ~ ?((@rev_out_nil @rev_out_cons) (S9 (o9 (E10 (S10 o10)))))
  & T11 ~ ?((@rev_out_nil @rev_out_cons) (S10 (o10 (E11 (S11 o11)))))
  & T12 ~ ?((@rev_out_nil @rev_out_cons) (S11 (o11 (E12 (S12 o12)))))
  & T13 ~ ?((@rev_out_nil @rev_out_cons) (S12 (o12 (E13 (S13 o13)))))
  & T14 ~ ?((@rev_out_nil @rev_out_cons) (S13 (o13 (E14 (S14 o14)))))
  & T15 ~ ?((@rev_out_nil @rev_out_cons) (S14 (o14 (E15 (S15 o15)))))
  & T16 ~ ?((@rev_out_nil @rev_out_last) (S15 (o15 (E16 t16))))
@rev_out_nil = (S (o *))
  & @rev_out_fin ~ (S o)
@rev_out_cons = (* (S (o (E (S2 o)))))
  & @rev_out_step ~ (S (E S2))
@rev_out_last = (* (S (o (E t))))
  & @rev_out_step ~ (S (E S2))
  & @rev_out_blk ~ (t (S2 o))
@take_step = ((k_rem output) ((u (v score)) (br br2)))
  & k_rem ~ ?((@take_step_b2z @take_step_b2s) (u (v (score (output (br br2))))))
@take_fin = ((* output) out)
  & @rev_out_blk ~ (output ((0 (0 *)) out))
@take_blk = (t (S0 o0))
  & t ~ (T1 (E1 (T2 (E2 (T3 (E3 (T4 (E4 (T5 (E5 (T6 (E6 (T7 (E7 (T8 (E8 (T9 (E9 (T10 (E10 (T11 (E11 (T12 (E12 (T13 (E13 (T14 (E14 (T15 (E15 (T16 (E16 t16))))))))))))))))))))))))))))))))
