@prog_b1z = (* (0 *))
@prog_b1s = (k_minus_1 (cands out))
  & k_minus_1 ~ $([+1] r)
  & @coll_blk ~ (cands ((r (0 *)) out))
@prog = ((k cands) br)
  & k ~ ?((@prog_b1z @prog_b1s) (cands br))
