// t5_decide_top_k
@sort_stream_fin_b2z = (* (0 *))
@sort_stream_fin_b2s = (* (lst lst))
@sort_stream_step = ((k_state sorted_list) ((u (v score)) (k_state cell)))
  & cell ~ (1 ((u (v score)) sorted_list))
@sort_stream_fin = ((k_state sorted_list) br)
  & k_state ~ ?((@sort_stream_fin_b2z @sort_stream_fin_b2s) (sorted_list br))
@sort_stream_blk = (t (S0 o0))
  & t ~ (T1 (E1 (T2 (E2 (T3 (E3 (T4 (E4 (T5 (E5 (T6 (E6 (T7 (E7 (T8 (E8 (T9 (E9 (T10 (E10 (T11 (E11 (T12 (E12 (T13 (E13 (T14 (E14 (T15 (E15 (T16 (E16 t16))))))))))))))))))))))))))))))))
  & T1 ~ ?((@sort_stream_nil @sort_stream_cons) (S0 (o0 (E1 (S1 o1)))))
  & T2 ~ ?((@sort_stream_nil @sort_stream_cons) (S1 (o1 (E2 (S2 o2)))))
  & T3 ~ ?((@sort_stream_nil @sort_stream_cons) (S2 (o2 (E3 (S3 o3)))))
  & T4 ~ ?((@sort_stream_nil @sort_stream_cons) (S3 (o3 (E4 (S4 o4)))))
  & T5 ~ ?((@sort_stream_nil @sort_stream_cons) (S4 (o4 (E5 (S5 o5)))))
  & T6 ~ ?((@sort_stream_nil @sort_stream_cons) (S5 (o5 (E6 (S6 o6)))))
  & T7 ~ ?((@sort_stream_nil @sort_stream_cons) (S6 (o6 (E7 (S7 o7)))))
  & T8 ~ ?((@sort_stream_nil @sort_stream_cons) (S7 (o7 (E8 (S8 o8)))))
  & T9 ~ ?((@sort_stream_nil @sort_stream_cons) (S8 (o8 (E9 (S9 o9)))))
  & T10 ~ ?((@sort_stream_nil @sort_stream_cons) (S9 (o9 (E10 (S10 o10)))))
  & T11 ~ ?((@sort_stream_nil @sort_stream_cons) (S10 (o10 (E11 (S11 o11)))))
  & T12 ~ ?((@sort_stream_nil @sort_stream_cons) (S11 (o11 (E12 (S12 o12)))))
  & T13 ~ ?((@sort_stream_nil @sort_stream_cons) (S12 (o12 (E13 (S13 o13)))))
  & T14 ~ ?((@sort_stream_nil @sort_stream_cons) (S13 (o13 (E14 (S14 o14)))))
  & T15 ~ ?((@sort_stream_nil @sort_stream_cons) (S14 (o14 (E15 (S15 o15)))))
  & T16 ~ ?((@sort_stream_nil @sort_stream_last) (S15 (o15 (E16 t16))))
@sort_stream_nil = (S (o *))
  & @sort_stream_fin ~ (S o)
@sort_stream_cons = (* (S (o (E (S2 o)))))
  & @sort_stream_step ~ (S (E S2))
@sort_stream_last = (* (S (o (E t))))
  & @sort_stream_step ~ (S (E S2))
  & @sort_stream_blk ~ (t (S2 o))
@prog_b1z = (* (0 *))
@prog_b1s = (k_minus_1 (cands out))
  & k_minus_1 ~ $([+1] r)
  & @sort_stream_blk ~ (cands ((r (0 *)) out))
@prog = ((k cands) br)
  & k ~ ?((@prog_b1z @prog_b1s) (cands br))
