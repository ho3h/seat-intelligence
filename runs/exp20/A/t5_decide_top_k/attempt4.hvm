// t5_decide_top_k
@take_walker_step_b2z = (* (* (* (res_p (0 res_p)))))
@take_walker_step_b2s = (k_rm1 (u_p (v_p (s_p (res_p (k_rm1 cell))))))
  & cell ~ (1 ((u_p (v_p s_p)) res_p))
@take_walker_step = ((k_rem result) ((u (v score)) (br br2)))
  & k_rem ~ ?((@take_walker_step_b2z @take_walker_step_b2s) (u (v (score (result (br br2))))))
@take_walker_fin = ((* result) result)
@take_walker_blk = (t (S0 o0))
  & t ~ (T1 (E1 (T2 (E2 (T3 (E3 (T4 (E4 (T5 (E5 (T6 (E6 (T7 (E7 (T8 (E8 (T9 (E9 (T10 (E10 (T11 (E11 (T12 (E12 (T13 (E13 (T14 (E14 (T15 (E15 (T16 (E16 t16))))))))))))))))))))))))))))))))
  & T1 ~ ?((@take_walker_nil @take_walker_cons) (S0 (o0 (E1 (S1 o1)))))
  & T2 ~ ?((@take_walker_nil @take_walker_cons) (S1 (o1 (E2 (S2 o2)))))
  & T3 ~ ?((@take_walker_nil @take_walker_cons) (S2 (o2 (E3 (S3 o3)))))
  & T4 ~ ?((@take_walker_nil @take_walker_cons) (S3 (o3 (E4 (S4 o4)))))
  & T5 ~ ?((@take_walker_nil @take_walker_cons) (S4 (o4 (E5 (S5 o5)))))
  & T6 ~ ?((@take_walker_nil @take_walker_cons) (S5 (o5 (E6 (S6 o6)))))
  & T7 ~ ?((@take_walker_nil @take_walker_cons) (S6 (o6 (E7 (S7 o7)))))
  & T8 ~ ?((@take_walker_nil @take_walker_cons) (S7 (o7 (E8 (S8 o8)))))
  & T9 ~ ?((@take_walker_nil @take_walker_cons) (S8 (o8 (E9 (S9 o9)))))
  & T10 ~ ?((@take_walker_nil @take_walker_cons) (S9 (o9 (E10 (S10 o10)))))
  & T11 ~ ?((@take_walker_nil @take_walker_cons) (S10 (o10 (E11 (S11 o11)))))
  & T12 ~ ?((@take_walker_nil @take_walker_cons) (S11 (o11 (E12 (S12 o12)))))
  & T13 ~ ?((@take_walker_nil @take_walker_cons) (S12 (o12 (E13 (S13 o13)))))
  & T14 ~ ?((@take_walker_nil @take_walker_cons) (S13 (o13 (E14 (S14 o14)))))
  & T15 ~ ?((@take_walker_nil @take_walker_cons) (S14 (o14 (E15 (S15 o15)))))
  & T16 ~ ?((@take_walker_nil @take_walker_last) (S15 (o15 (E16 t16))))
@take_walker_nil = (S (o *))
  & @take_walker_fin ~ (S o)
@take_walker_cons = (* (S (o (E (S2 o)))))
  & @take_walker_step ~ (S (E S2))
@take_walker_last = (* (S (o (E t))))
  & @take_walker_step ~ (S (E S2))
  & @take_walker_blk ~ (t (S2 o))
@sort_walker_step = ((k_st sorted_list) ((u_new (v_new score_new)) (k_st cell)))
  & cell ~ (1 ((u_new (v_new score_new)) sorted_list))
@sort_walker_fin = ((k_st sorted_list) out)
  & @take_walker_blk ~ (sorted_list ((k_st (0 *)) out))
@sort_walker_blk = (t (S0 o0))
  & t ~ (T1 (E1 (T2 (E2 (T3 (E3 (T4 (E4 (T5 (E5 (T6 (E6 (T7 (E7 (T8 (E8 (T9 (E9 (T10 (E10 (T11 (E11 (T12 (E12 (T13 (E13 (T14 (E14 (T15 (E15 (T16 (E16 t16))))))))))))))))))))))))))))))))
  & T1 ~ ?((@sort_walker_nil @sort_walker_cons) (S0 (o0 (E1 (S1 o1)))))
  & T2 ~ ?((@sort_walker_nil @sort_walker_cons) (S1 (o1 (E2 (S2 o2)))))
  & T3 ~ ?((@sort_walker_nil @sort_walker_cons) (S2 (o2 (E3 (S3 o3)))))
  & T4 ~ ?((@sort_walker_nil @sort_walker_cons) (S3 (o3 (E4 (S4 o4)))))
  & T5 ~ ?((@sort_walker_nil @sort_walker_cons) (S4 (o4 (E5 (S5 o5)))))
  & T6 ~ ?((@sort_walker_nil @sort_walker_cons) (S5 (o5 (E6 (S6 o6)))))
  & T7 ~ ?((@sort_walker_nil @sort_walker_cons) (S6 (o6 (E7 (S7 o7)))))
  & T8 ~ ?((@sort_walker_nil @sort_walker_cons) (S7 (o7 (E8 (S8 o8)))))
  & T9 ~ ?((@sort_walker_nil @sort_walker_cons) (S8 (o8 (E9 (S9 o9)))))
  & T10 ~ ?((@sort_walker_nil @sort_walker_cons) (S9 (o9 (E10 (S10 o10)))))
  & T11 ~ ?((@sort_walker_nil @sort_walker_cons) (S10 (o10 (E11 (S11 o11)))))
  & T12 ~ ?((@sort_walker_nil @sort_walker_cons) (S11 (o11 (E12 (S12 o12)))))
  & T13 ~ ?((@sort_walker_nil @sort_walker_cons) (S12 (o12 (E13 (S13 o13)))))
  & T14 ~ ?((@sort_walker_nil @sort_walker_cons) (S13 (o13 (E14 (S14 o14)))))
  & T15 ~ ?((@sort_walker_nil @sort_walker_cons) (S14 (o14 (E15 (S15 o15)))))
  & T16 ~ ?((@sort_walker_nil @sort_walker_last) (S15 (o15 (E16 t16))))
@sort_walker_nil = (S (o *))
  & @sort_walker_fin ~ (S o)
@sort_walker_cons = (* (S (o (E (S2 o)))))
  & @sort_walker_step ~ (S (E S2))
@sort_walker_last = (* (S (o (E t))))
  & @sort_walker_step ~ (S (E S2))
  & @sort_walker_blk ~ (t (S2 o))
@prog_b1z = (* (0 *))
@prog_b1s = (k_minus_1 (cands out))
  & k_minus_1 ~ $([+1] r)
  & @sort_walker_blk ~ (cands ((r (0 *)) out))
@prog = ((k cands) br)
  & k ~ ?((@prog_b1z @prog_b1s) (cands br))
