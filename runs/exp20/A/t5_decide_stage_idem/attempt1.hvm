@z0 = (?((0 @z0_n) o) o)
@z0_n = (lm (a c))
  & lm ~ {l1 l2}
  & @z0 ~ (l1 a)
  & @z0 ~ (l2 c)
@gl_sel1 = (x (* x))
@gl_sel2 = (* (y y))
@gl_sel1s = (* (x (* x)))
@gl_sel2s = (* (* (y y)))
@max_val = (t (k (L (P o))))
  & L ~ ?((@max_val_leaf @max_val_node) (t (k (P o))))
@max_val_leaf = (t (* (P o)))
  & @max_val_act ~ (t (P o))
@max_val_act = (x (c o))
  & x ~ {x1 x2}
  & c ~ {c1 c2}
  & x1 ~ $([<] $(c1 lt))
  & lt ~ ?((@gl_sel1 @gl_sel2s) (x2 (c2 o)))
@max_val_node = (lm (t (k (P o))))
  & k ~ {k1 k2}
  & lm ~ {l1 l2}
  & k1 ~ $([>>] $(l1 sh))
  & sh ~ $([&] $(1 bt))
  & bt ~ ?((@max_val_L @max_val_R) (t (k2 (l2 (P o)))))
@max_val_L = ((l r) (k (L (P (l2 r)))))
  & @max_val ~ (l (k (L (P l2))))
@max_val_R = (* ((l r) (k (L (P (l r2))))))
  & @max_val ~ (r (k (L (P r2))))
@ledger_step = ((L blocked_trie) ((verb (target status)) (L2 t2)))
  & status ~ $([<] $(2 r))
  & verb ~ $([<<] $(20 r2))
  & r2 ~ $([|] $(target r3))
  & L ~ {L1 L2}
  & @max_val ~ (blocked_trie (r3 (L1 (r t2))))
@ledger_fin = ((* blocked_trie) blocked_trie)
@ledger_blk = (t (S0 o0))
  & t ~ (T1 (E1 (T2 (E2 (T3 (E3 (T4 (E4 (T5 (E5 (T6 (E6 (T7 (E7 (T8 (E8 (T9 (E9 (T10 (E10 (T11 (E11 (T12 (E12 (T13 (E13 (T14 (E14 (T15 (E15 (T16 (E16 t16))))))))))))))))))))))))))))))))
  & T1 ~ ?((@ledger_nil @ledger_cons) (S0 (o0 (E1 (S1 o1)))))
  & T2 ~ ?((@ledger_nil @ledger_cons) (S1 (o1 (E2 (S2 o2)))))
  & T3 ~ ?((@ledger_nil @ledger_cons) (S2 (o2 (E3 (S3 o3)))))
  & T4 ~ ?((@ledger_nil @ledger_cons) (S3 (o3 (E4 (S4 o4)))))
  & T5 ~ ?((@ledger_nil @ledger_cons) (S4 (o4 (E5 (S5 o5)))))
  & T6 ~ ?((@ledger_nil @ledger_cons) (S5 (o5 (E6 (S6 o6)))))
  & T7 ~ ?((@ledger_nil @ledger_cons) (S6 (o6 (E7 (S7 o7)))))
  & T8 ~ ?((@ledger_nil @ledger_cons) (S7 (o7 (E8 (S8 o8)))))
  & T9 ~ ?((@ledger_nil @ledger_cons) (S8 (o8 (E9 (S9 o9)))))
  & T10 ~ ?((@ledger_nil @ledger_cons) (S9 (o9 (E10 (S10 o10)))))
  & T11 ~ ?((@ledger_nil @ledger_cons) (S10 (o10 (E11 (S11 o11)))))
  & T12 ~ ?((@ledger_nil @ledger_cons) (S11 (o11 (E12 (S12 o12)))))
  & T13 ~ ?((@ledger_nil @ledger_cons) (S12 (o12 (E13 (S13 o13)))))
  & T14 ~ ?((@ledger_nil @ledger_cons) (S13 (o13 (E14 (S14 o14)))))
  & T15 ~ ?((@ledger_nil @ledger_cons) (S14 (o14 (E15 (S15 o15)))))
  & T16 ~ ?((@ledger_nil @ledger_last) (S15 (o15 (E16 t16))))
@ledger_nil = (S (o *))
  & @ledger_fin ~ (S o)
@ledger_cons = (* (S (o (E (S2 o)))))
  & @ledger_step ~ (S (E S2))
@ledger_last = (* (S (o (E t))))
  & @ledger_step ~ (S (E S2))
  & @ledger_blk ~ (t (S2 o))
@proposal_step = ((L (output_val output_hole)) ((verb target) (L (output_val hole))))
  & output_hole ~ (1 ((verb target) hole))
@proposal_fin = ((* (output_val output_hole)) output_val)
  & output_hole ~ (0 *)
@proposal_blk = (t (S0 o0))
  & t ~ (T1 (E1 (T2 (E2 (T3 (E3 (T4 (E4 (T5 (E5 (T6 (E6 (T7 (E7 (T8 (E8 (T9 (E9 (T10 (E10 (T11 (E11 (T12 (E12 (T13 (E13 (T14 (E14 (T15 (E15 (T16 (E16 t16))))))))))))))))))))))))))))))))
  & T1 ~ ?((@proposal_nil @proposal_cons) (S0 (o0 (E1 (S1 o1)))))
  & T2 ~ ?((@proposal_nil @proposal_cons) (S1 (o1 (E2 (S2 o2)))))
  & T3 ~ ?((@proposal_nil @proposal_cons) (S2 (o2 (E3 (S3 o3)))))
  & T4 ~ ?((@proposal_nil @proposal_cons) (S3 (o3 (E4 (S4 o4)))))
  & T5 ~ ?((@proposal_nil @proposal_cons) (S4 (o4 (E5 (S5 o5)))))
  & T6 ~ ?((@proposal_nil @proposal_cons) (S5 (o5 (E6 (S6 o6)))))
  & T7 ~ ?((@proposal_nil @proposal_cons) (S6 (o6 (E7 (S7 o7)))))
  & T8 ~ ?((@proposal_nil @proposal_cons) (S7 (o7 (E8 (S8 o8)))))
  & T9 ~ ?((@proposal_nil @proposal_cons) (S8 (o8 (E9 (S9 o9)))))
  & T10 ~ ?((@proposal_nil @proposal_cons) (S9 (o9 (E10 (S10 o10)))))
  & T11 ~ ?((@proposal_nil @proposal_cons) (S10 (o10 (E11 (S11 o11)))))
  & T12 ~ ?((@proposal_nil @proposal_cons) (S11 (o11 (E12 (S12 o12)))))
  & T13 ~ ?((@proposal_nil @proposal_cons) (S12 (o12 (E13 (S13 o13)))))
  & T14 ~ ?((@proposal_nil @proposal_cons) (S13 (o13 (E14 (S14 o14)))))
  & T15 ~ ?((@proposal_nil @proposal_cons) (S14 (o14 (E15 (S15 o15)))))
  & T16 ~ ?((@proposal_nil @proposal_last) (S15 (o15 (E16 t16))))
@proposal_nil = (S (o *))
  & @proposal_fin ~ (S o)
@proposal_cons = (* (S (o (E (S2 o)))))
  & @proposal_step ~ (S (E S2))
@proposal_last = (* (S (o (E t))))
  & @proposal_step ~ (S (E S2))
  & @proposal_blk ~ (t (S2 o))
@prog = ((ledger proposals) out2)
  & @z0 ~ (24 t)
  & @ledger_blk ~ (ledger ((24 t) *))
  & @proposal_blk ~ (proposals ((24 (val val)) out2))
