@z0 = (?((0 @z0_n) o) o)
@z0_n = (lm (a c))
  & lm ~ {l1 l2}
  & @z0 ~ (l1 a)
  & @z0 ~ (l2 c)
@set_one = (t (k (L (P o))))
  & L ~ ?((@set_one_leaf @set_one_node) (t (k (P o))))
@set_one_leaf = (t (* (P o)))
  & @set_one_act ~ (t (P o))
@set_one_act = (* (p p))
@set_one_node = (lm (t (k (P o))))
  & k ~ {k1 k2}
  & lm ~ {l1 l2}
  & k1 ~ $([>>] $(l1 sh))
  & sh ~ $([&] $(1 bt))
  & bt ~ ?((@set_one_L @set_one_R) (t (k2 (l2 (P o)))))
@set_one_L = ((l r) (k (L (P (l2 r)))))
  & @set_one ~ (l (k (L (P l2))))
@set_one_R = (* ((l r) (k (L (P (l r2))))))
  & @set_one ~ (r (k (L (P r2))))
@get_val = (t (k (L o)))
  & L ~ ?((@get_val_leaf @get_val_node) (t (k o)))
@get_val_leaf = (x (* x))
@get_val_node = (lm (t (k o)))
  & k ~ {k1 k2}
  & lm ~ {l1 l2}
  & k1 ~ $([>>] $(l1 sh))
  & sh ~ $([&] $(1 bt))
  & bt ~ ?((@get_val_L @get_val_R) (t (k2 (l2 o))))
@get_val_L = ((l *) (k (L o)))
  & @get_val ~ (l (k (L o)))
@get_val_R = (* ((* r) (k (L o))))
  & @get_val ~ (r (k (L o)))
@tl_drop = (* (t t))
@tl_keep = (* (x (t (1 (x t)))))
@tl = (t (L (base (E (acc o)))))
  & L ~ ?((@tl_leaf @tl_node) (t (base (E (acc o)))))
@tl_leaf = (x (i (n (acc o))))
  & i ~ $([<] $(n keep))
  & keep ~ ?((@tl_drop @tl_keep) (x (acc o)))
@tl_node = (lm ((a c) (base (E (acc o)))))
  & lm ~ {l1 {l2 l3}}
  & base ~ {b1 b2}
  & 1 ~ $([<<] $(l3 half))
  & b2 ~ $([+] $(half bR))
  & E ~ {E1 E2}
  & @tl ~ (a (l1 (b1 (E1 (mid o)))))
  & @tl ~ (c (l2 (bR (E2 (acc mid)))))
@proposals_step = ((L (seen_trie count)) ((verb target) (L2 (t2 r3))))
  & verb ~ $([<<] $(20 r))
  & r ~ $([|] $(target r2))
  & L ~ {L1 L2}
  & @set_one ~ (seen_trie (r2 (L1 (1 t2))))
  & count ~ $([+1] r3)
@proposals_fin = ((* (* count)) count)
@proposals_blk = (t (S0 o0))
  & t ~ (T1 (E1 (T2 (E2 (T3 (E3 (T4 (E4 (T5 (E5 (T6 (E6 (T7 (E7 (T8 (E8 (T9 (E9 (T10 (E10 (T11 (E11 (T12 (E12 (T13 (E13 (T14 (E14 (T15 (E15 (T16 (E16 t16))))))))))))))))))))))))))))))))
  & T1 ~ ?((@proposals_nil @proposals_cons) (S0 (o0 (E1 (S1 o1)))))
  & T2 ~ ?((@proposals_nil @proposals_cons) (S1 (o1 (E2 (S2 o2)))))
  & T3 ~ ?((@proposals_nil @proposals_cons) (S2 (o2 (E3 (S3 o3)))))
  & T4 ~ ?((@proposals_nil @proposals_cons) (S3 (o3 (E4 (S4 o4)))))
  & T5 ~ ?((@proposals_nil @proposals_cons) (S4 (o4 (E5 (S5 o5)))))
  & T6 ~ ?((@proposals_nil @proposals_cons) (S5 (o5 (E6 (S6 o6)))))
  & T7 ~ ?((@proposals_nil @proposals_cons) (S6 (o6 (E7 (S7 o7)))))
  & T8 ~ ?((@proposals_nil @proposals_cons) (S7 (o7 (E8 (S8 o8)))))
  & T9 ~ ?((@proposals_nil @proposals_cons) (S8 (o8 (E9 (S9 o9)))))
  & T10 ~ ?((@proposals_nil @proposals_cons) (S9 (o9 (E10 (S10 o10)))))
  & T11 ~ ?((@proposals_nil @proposals_cons) (S10 (o10 (E11 (S11 o11)))))
  & T12 ~ ?((@proposals_nil @proposals_cons) (S11 (o11 (E12 (S12 o12)))))
  & T13 ~ ?((@proposals_nil @proposals_cons) (S12 (o12 (E13 (S13 o13)))))
  & T14 ~ ?((@proposals_nil @proposals_cons) (S13 (o13 (E14 (S14 o14)))))
  & T15 ~ ?((@proposals_nil @proposals_cons) (S14 (o14 (E15 (S15 o15)))))
  & T16 ~ ?((@proposals_nil @proposals_last) (S15 (o15 (E16 t16))))
@proposals_nil = (S (o *))
  & @proposals_fin ~ (S o)
@proposals_cons = (* (S (o (E (S2 o)))))
  & @proposals_step ~ (S (E S2))
@proposals_last = (* (S (o (E t))))
  & @proposals_step ~ (S (E S2))
  & @proposals_blk ~ (t (S2 o))
@prog = ((* proposals) proposals)
