@lg = (?((0 @lg_s) o) o)
@lg_s = (xm o)
  & xm ~ $([+1] x)
  & x ~ $([>>] $(1 y))
  & @lg ~ (y z)
  & z ~ $([+1] o)
@z0 = (?((0 @z0_n) o) o)
@z0_n = (lm (a c))
  & lm ~ {l1 l2}
  & @z0 ~ (l1 a)
  & @z0 ~ (l2 c)
@gt = (t (k (L o)))
  & L ~ ?((@gt_leaf @gt_node) (t (k o)))
@gt_leaf = (x (* x))
@gt_node = (lm (t (k o)))
  & k ~ {k1 k2}
  & lm ~ {l1 l2}
  & k1 ~ $([>>] $(l1 sh))
  & sh ~ $([&] $(1 bt))
  & bt ~ ?((@gt_L @gt_R) (t (k2 (l2 o))))
@gt_L = ((l *) (k (L o)))
  & @gt ~ (l (k (L o)))
@gt_R = (* ((* r) (k (L o))))
  & @gt ~ (r (k (L o)))
@dinc = (t (k (L (P o))))
  & L ~ ?((@dinc_leaf @dinc_node) (t (k (P o))))
@dinc_leaf = (t (* (P o)))
  & @dinc_act ~ (t (P o))
@dinc_act = (x (* o))
  & x ~ $([+1] o)
@dinc_node = (lm (t (k (P o))))
  & k ~ {k1 k2}
  & lm ~ {l1 l2}
  & k1 ~ $([>>] $(l1 sh))
  & sh ~ $([&] $(1 bt))
  & bt ~ ?((@dinc_L @dinc_R) (t (k2 (l2 (P o)))))
@dinc_L = ((l r) (k (L (P (l2 r)))))
  & @dinc ~ (l (k (L (P l2))))
@dinc_R = (* ((l r) (k (L (P (l r2))))))
  & @dinc ~ (r (k (L (P r2))))
@attrs_step = ((L attrs_trie) ((node (key *)) (L2 t2)))
  & L ~ {L1 L2}
  & node ~ $([<<] $(8 r))
  & r ~ $([|] $(key r2))
  & @dinc ~ (attrs_trie (r2 (L1 (* t2))))
@attrs_fin = ((* *) 0)
@attrs_blk = (t (S0 o0))
  & t ~ (T1 (E1 (T2 (E2 (T3 (E3 (T4 (E4 (T5 (E5 (T6 (E6 (T7 (E7 (T8 (E8 (T9 (E9 (T10 (E10 (T11 (E11 (T12 (E12 (T13 (E13 (T14 (E14 (T15 (E15 (T16 (E16 t16))))))))))))))))))))))))))))))))
  & T1 ~ ?((@attrs_nil @attrs_cons) (S0 (o0 (E1 (S1 o1)))))
  & T2 ~ ?((@attrs_nil @attrs_cons) (S1 (o1 (E2 (S2 o2)))))
  & T3 ~ ?((@attrs_nil @attrs_cons) (S2 (o2 (E3 (S3 o3)))))
  & T4 ~ ?((@attrs_nil @attrs_cons) (S3 (o3 (E4 (S4 o4)))))
  & T5 ~ ?((@attrs_nil @attrs_cons) (S4 (o4 (E5 (S5 o5)))))
  & T6 ~ ?((@attrs_nil @attrs_cons) (S5 (o5 (E6 (S6 o6)))))
  & T7 ~ ?((@attrs_nil @attrs_cons) (S6 (o6 (E7 (S7 o7)))))
  & T8 ~ ?((@attrs_nil @attrs_cons) (S7 (o7 (E8 (S8 o8)))))
  & T9 ~ ?((@attrs_nil @attrs_cons) (S8 (o8 (E9 (S9 o9)))))
  & T10 ~ ?((@attrs_nil @attrs_cons) (S9 (o9 (E10 (S10 o10)))))
  & T11 ~ ?((@attrs_nil @attrs_cons) (S10 (o10 (E11 (S11 o11)))))
  & T12 ~ ?((@attrs_nil @attrs_cons) (S11 (o11 (E12 (S12 o12)))))
  & T13 ~ ?((@attrs_nil @attrs_cons) (S12 (o12 (E13 (S13 o13)))))
  & T14 ~ ?((@attrs_nil @attrs_cons) (S13 (o13 (E14 (S14 o14)))))
  & T15 ~ ?((@attrs_nil @attrs_cons) (S14 (o14 (E15 (S15 o15)))))
  & T16 ~ ?((@attrs_nil @attrs_last) (S15 (o15 (E16 t16))))
@attrs_nil = (S (o *))
  & @attrs_fin ~ (S o)
@attrs_cons = (* (S (o (E (S2 o)))))
  & @attrs_step ~ (S (E S2))
@attrs_last = (* (S (o (E t))))
  & @attrs_step ~ (S (E S2))
  & @attrs_blk ~ (t (S2 o))
@prog = ((* *) 0)
