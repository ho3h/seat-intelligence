@list_len_w_step = ((n h0) (elem (r hole)))
  & n ~ $([+1] r)
  & h0 ~ (1 (elem hole))
@list_len_w_fin = ((n h0) n)
  & h0 ~ (0 *)
@list_len_w_blk = (t (S0 o0))
  & t ~ (T1 (E1 (T2 (E2 (T3 (E3 (T4 (E4 (T5 (E5 (T6 (E6 (T7 (E7 (T8 (E8 (T9 (E9 (T10 (E10 (T11 (E11 (T12 (E12 (T13 (E13 (T14 (E14 (T15 (E15 (T16 (E16 t16))))))))))))))))))))))))))))))))
  & T1 ~ ?((@list_len_w_nil @list_len_w_cons) (S0 (o0 (E1 (S1 o1)))))
  & T2 ~ ?((@list_len_w_nil @list_len_w_cons) (S1 (o1 (E2 (S2 o2)))))
  & T3 ~ ?((@list_len_w_nil @list_len_w_cons) (S2 (o2 (E3 (S3 o3)))))
  & T4 ~ ?((@list_len_w_nil @list_len_w_cons) (S3 (o3 (E4 (S4 o4)))))
  & T5 ~ ?((@list_len_w_nil @list_len_w_cons) (S4 (o4 (E5 (S5 o5)))))
  & T6 ~ ?((@list_len_w_nil @list_len_w_cons) (S5 (o5 (E6 (S6 o6)))))
  & T7 ~ ?((@list_len_w_nil @list_len_w_cons) (S6 (o6 (E7 (S7 o7)))))
  & T8 ~ ?((@list_len_w_nil @list_len_w_cons) (S7 (o7 (E8 (S8 o8)))))
  & T9 ~ ?((@list_len_w_nil @list_len_w_cons) (S8 (o8 (E9 (S9 o9)))))
  & T10 ~ ?((@list_len_w_nil @list_len_w_cons) (S9 (o9 (E10 (S10 o10)))))
  & T11 ~ ?((@list_len_w_nil @list_len_w_cons) (S10 (o10 (E11 (S11 o11)))))
  & T12 ~ ?((@list_len_w_nil @list_len_w_cons) (S11 (o11 (E12 (S12 o12)))))
  & T13 ~ ?((@list_len_w_nil @list_len_w_cons) (S12 (o12 (E13 (S13 o13)))))
  & T14 ~ ?((@list_len_w_nil @list_len_w_cons) (S13 (o13 (E14 (S14 o14)))))
  & T15 ~ ?((@list_len_w_nil @list_len_w_cons) (S14 (o14 (E15 (S15 o15)))))
  & T16 ~ ?((@list_len_w_nil @list_len_w_last) (S15 (o15 (E16 t16))))
@list_len_w_nil = (S (o *))
  & @list_len_w_fin ~ (S o)
@list_len_w_cons = (* (S (o (E (S2 o)))))
  & @list_len_w_step ~ (S (E S2))
@list_len_w_last = (* (S (o (E t))))
  & @list_len_w_step ~ (S (E S2))
  & @list_len_w_blk ~ (t (S2 o))
@list_len = (lst (out val))
  & @list_len_w_blk ~ (lst ((0 val) out))
@prog_b1z = (* (* 0))
@prog_b1s = (nm1 (* (* r5)))
  & nm1 ~ $([+1] r)
  & r ~ {r1 r2}
  & r1 ~ $([-] $(1 r3))
  & r2 ~ $([*] $(r3 r4))
  & r4 ~ $([>>] $(1 r5))
@prog = ((pred_list truth_list) br)
  & @list_len ~ (pred_list (n c1))
  & n ~ ?((@prog_b1z @prog_b1s) (c1 (truth_list br)))
