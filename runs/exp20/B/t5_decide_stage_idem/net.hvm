@lg = (?((0 @lg_s) o) o)
@lg_s = (xm o)
  & xm ~ $([+1] x)
  & x ~ $([>>] $(1 y))
  & @lg ~ (y z)
  & z ~ $([+1] o)
@z0 = (?((0 @z0_n) o) o)
@z0_n = (lm (a c))
  & lm ~ {l1 l2}
  & @z0 ~ (l1 a)
  & @z0 ~ (l2 c)
@or_blocked = (t (k (L (P o))))
  & L ~ ?((@or_blocked_leaf @or_blocked_node) (t (k (P o))))
@or_blocked_leaf = (t (* (P o)))
  & @or_blocked_act ~ (t (P o))
@or_blocked_act = (x (c o))
  & x ~ $([|] $(c o))
@or_blocked_node = (lm (t (k (P o))))
  & k ~ {k1 k2}
  & lm ~ {l1 l2}
  & k1 ~ $([>>] $(l1 sh))
  & sh ~ $([&] $(1 bt))
  & bt ~ ?((@or_blocked_L @or_blocked_R) (t (k2 (l2 (P o)))))
@or_blocked_L = ((l r) (k (L (P (l2 r)))))
  & @or_blocked ~ (l (k (L (P l2))))
@or_blocked_R = (* ((l r) (k (L (P (l r2))))))
  & @or_blocked ~ (r (k (L (P r2))))
@peek_check = (t (k (L (P o))))
  & L ~ ?((@peek_check_leaf @peek_check_node) (t (k (P o))))
@peek_check_leaf = (t (* (P o)))
  & @peek_check_act ~ (t (P o))
@peek_check_act = (l (p l2))
  & l ~ {p l2}
@peek_check_node = (lm (t (k (P o))))
  & k ~ {k1 k2}
  & lm ~ {l1 l2}
  & k1 ~ $([>>] $(l1 sh))
  & sh ~ $([&] $(1 bt))
  & bt ~ ?((@peek_check_L @peek_check_R) (t (k2 (l2 (P o)))))
@peek_check_L = ((l r) (k (L (P (l2 r)))))
  & @peek_check ~ (l (k (L (P l2))))
@peek_check_R = (* ((l r) (k (L (P (l r2))))))
  & @peek_check ~ (r (k (L (P r2))))
@ledger_walk_step = (blocked ((verb (target status)) t2))
  & target ~ $([<<] $(3 r))
  & r ~ $([|] $(verb r2))
  & status ~ $([>] $(1 r3))
  & 1 ~ $([-] $(r3 r4))
  & @or_blocked ~ (blocked (r2 (18 (r4 t2))))
@ledger_walk_fin = (blocked blocked)
@ledger_walk_blk = (t (S0 o0))
  & t ~ (T1 (E1 (T2 (E2 (T3 (E3 (T4 (E4 (T5 (E5 (T6 (E6 (T7 (E7 (T8 (E8 (T9 (E9 (T10 (E10 (T11 (E11 (T12 (E12 (T13 (E13 (T14 (E14 (T15 (E15 (T16 (E16 t16))))))))))))))))))))))))))))))))
  & T1 ~ ?((@ledger_walk_nil @ledger_walk_cons) (S0 (o0 (E1 (S1 o1)))))
  & T2 ~ ?((@ledger_walk_nil @ledger_walk_cons) (S1 (o1 (E2 (S2 o2)))))
  & T3 ~ ?((@ledger_walk_nil @ledger_walk_cons) (S2 (o2 (E3 (S3 o3)))))
  & T4 ~ ?((@ledger_walk_nil @ledger_walk_cons) (S3 (o3 (E4 (S4 o4)))))
  & T5 ~ ?((@ledger_walk_nil @ledger_walk_cons) (S4 (o4 (E5 (S5 o5)))))
  & T6 ~ ?((@ledger_walk_nil @ledger_walk_cons) (S5 (o5 (E6 (S6 o6)))))
  & T7 ~ ?((@ledger_walk_nil @ledger_walk_cons) (S6 (o6 (E7 (S7 o7)))))
  & T8 ~ ?((@ledger_walk_nil @ledger_walk_cons) (S7 (o7 (E8 (S8 o8)))))
  & T9 ~ ?((@ledger_walk_nil @ledger_walk_cons) (S8 (o8 (E9 (S9 o9)))))
  & T10 ~ ?((@ledger_walk_nil @ledger_walk_cons) (S9 (o9 (E10 (S10 o10)))))
  & T11 ~ ?((@ledger_walk_nil @ledger_walk_cons) (S10 (o10 (E11 (S11 o11)))))
  & T12 ~ ?((@ledger_walk_nil @ledger_walk_cons) (S11 (o11 (E12 (S12 o12)))))
  & T13 ~ ?((@ledger_walk_nil @ledger_walk_cons) (S12 (o12 (E13 (S13 o13)))))
  & T14 ~ ?((@ledger_walk_nil @ledger_walk_cons) (S13 (o13 (E14 (S14 o14)))))
  & T15 ~ ?((@ledger_walk_nil @ledger_walk_cons) (S14 (o14 (E15 (S15 o15)))))
  & T16 ~ ?((@ledger_walk_nil @ledger_walk_last) (S15 (o15 (E16 t16))))
@ledger_walk_nil = (S (o *))
  & @ledger_walk_fin ~ (S o)
@ledger_walk_cons = (* (S (o (E (S2 o)))))
  & @ledger_walk_step ~ (S (E S2))
@ledger_walk_last = (* (S (o (E t))))
  & @ledger_walk_step ~ (S (E S2))
  & @ledger_walk_blk ~ (t (S2 o))
@proposals_walk_step_b1z = (h_out (* (* h_out)))
@proposals_walk_step_b1s = (* (h_out (verb2 (target2 hole))))
  & h_out ~ (1 ((verb2 target2) hole))
@proposals_walk_step = ((blocked (kept h_out)) ((verb target) (t2 (t23 br))))
  & verb ~ {verb1 verb2}
  & target ~ {target1 target2}
  & target1 ~ $([<<] $(3 r))
  & r ~ $([|] $(verb1 r2))
  & r2 ~ {r1 {r22 r3}}
  & @peek_check ~ (blocked (r1 (18 (P t2))))
  & @peek_check ~ (kept (r22 (18 (P2 t22))))
  & P ~ $([|] $(P2 r4))
  & r4 ~ $([!] $(0 r5))
  & 1 ~ $([-] $(r5 r6))
  & r6 ~ {r12 r23}
  & @or_blocked ~ (t22 (r3 (18 (r12 t23))))
  & r23 ~ ?((@proposals_walk_step_b1z @proposals_walk_step_b1s) (h_out (verb2 (target2 br))))
@proposals_walk_fin = ((* (* h_out)) 0)
  & h_out ~ (0 *)
@proposals_walk_blk = (t (S0 o0))
  & t ~ (T1 (E1 (T2 (E2 (T3 (E3 (T4 (E4 (T5 (E5 (T6 (E6 (T7 (E7 (T8 (E8 (T9 (E9 (T10 (E10 (T11 (E11 (T12 (E12 (T13 (E13 (T14 (E14 (T15 (E15 (T16 (E16 t16))))))))))))))))))))))))))))))))
  & T1 ~ ?((@proposals_walk_nil @proposals_walk_cons) (S0 (o0 (E1 (S1 o1)))))
  & T2 ~ ?((@proposals_walk_nil @proposals_walk_cons) (S1 (o1 (E2 (S2 o2)))))
  & T3 ~ ?((@proposals_walk_nil @proposals_walk_cons) (S2 (o2 (E3 (S3 o3)))))
  & T4 ~ ?((@proposals_walk_nil @proposals_walk_cons) (S3 (o3 (E4 (S4 o4)))))
  & T5 ~ ?((@proposals_walk_nil @proposals_walk_cons) (S4 (o4 (E5 (S5 o5)))))
  & T6 ~ ?((@proposals_walk_nil @proposals_walk_cons) (S5 (o5 (E6 (S6 o6)))))
  & T7 ~ ?((@proposals_walk_nil @proposals_walk_cons) (S6 (o6 (E7 (S7 o7)))))
  & T8 ~ ?((@proposals_walk_nil @proposals_walk_cons) (S7 (o7 (E8 (S8 o8)))))
  & T9 ~ ?((@proposals_walk_nil @proposals_walk_cons) (S8 (o8 (E9 (S9 o9)))))
  & T10 ~ ?((@proposals_walk_nil @proposals_walk_cons) (S9 (o9 (E10 (S10 o10)))))
  & T11 ~ ?((@proposals_walk_nil @proposals_walk_cons) (S10 (o10 (E11 (S11 o11)))))
  & T12 ~ ?((@proposals_walk_nil @proposals_walk_cons) (S11 (o11 (E12 (S12 o12)))))
  & T13 ~ ?((@proposals_walk_nil @proposals_walk_cons) (S12 (o12 (E13 (S13 o13)))))
  & T14 ~ ?((@proposals_walk_nil @proposals_walk_cons) (S13 (o13 (E14 (S14 o14)))))
  & T15 ~ ?((@proposals_walk_nil @proposals_walk_cons) (S14 (o14 (E15 (S15 o15)))))
  & T16 ~ ?((@proposals_walk_nil @proposals_walk_last) (S15 (o15 (E16 t16))))
@proposals_walk_nil = (S (o *))
  & @proposals_walk_fin ~ (S o)
@proposals_walk_cons = (* (S (o (E (S2 o)))))
  & @proposals_walk_step ~ (S (E S2))
@proposals_walk_last = (* (S (o (E t))))
  & @proposals_walk_step ~ (S (E S2))
  & @proposals_walk_blk ~ (t (S2 o))
@prog = ((ledger proposals) val)
  & @z0 ~ (18 t)
  & @ledger_walk_blk ~ (ledger (t out))
  & @z0 ~ (18 t2)
  & @proposals_walk_blk ~ (proposals ((out (t2 val)) *))
