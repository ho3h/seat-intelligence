  & L ~ ?((@sort_tl_leaf @sort_tl_node) (t (base (E (acc o)))))
@sort_tl_leaf = (x (i (n (acc o))))
  & i ~ $([<] $(n keep))
  & keep ~ ?((@sort_tl_drop @sort_tl_keep) (x (acc o)))
@sort_tl_node = (lm ((a c) (base (E (acc o)))))
  & lm ~ {l1 {l2 l3}}
  & base ~ {b1 b2}
  & 1 ~ $([<<] $(l3 half))
  & b2 ~ $([+] $(half bR))
  & E ~ {E1 E2}
  & @sort_tl ~ (a (l1 (b1 (E1 (mid o)))))
  & @sort_tl ~ (c (l2 (bR (E2 (acc mid)))))
@lg = (?((0 @lg_s) o) o)
@lg_s = (xm o)
  & xm ~ $([+1] x)
  & x ~ $([>>] $(1 y))
  & @lg ~ (y z)
  & z ~ $([+1] o)
@sort_b1z = (* (* (0 *)))
@sort_b1s = (nm1 (c1 (c2 o)))
  & nm1 ~ {nm11 nm12}
  & nm12 ~ $([+1] r)
  & r ~ {r1 r2}
  & @lg ~ (nm11 L)
  & L ~ {L1 {L2 {L3 {L4 {L5 {L6 L7}}}}}}
  & @sort_kw_blk ~ (c1 (val *))
  & @sort_z ~ (L1 t)
  & @sort_tw_blk ~ (c2 ((L2 (0 t)) out2))
  & @sort_rw_blk ~ (val ((L3 (0 out2)) out3))
  & @sort_oz ~ (L6 t2)
  & @sort_sc ~ (out3 (L4 (0 ((L5 r1) (t2 H2)))))
  & @sort_tl ~ (H2 (L7 (0 (r2 ((0 *) o)))))
@sort = (lst br)
  & @sort_len ~ (lst (n (c1 c2)))
  & n ~ ?((@sort_b1z @sort_b1s) (c1 (c2 br)))
@zq = (?(((y y) @zq_n) o) o)
@zq_n = (lm (a c))
  & lm ~ {l1 l2}
  & @zq ~ (l1 a)
  & @zq ~ (l2 c)
@rq = (t (k (L (P o))))
  & L ~ ?((@rq_leaf @rq_node) (t (k (P o))))
@rq_leaf = (t (* (P o)))
  & @rq_act ~ (t (P o))
@rq_act = ((i o) (x (i o2)))
  & o ~ {x o2}
@rq_node = (lm (t (k (P o))))
  & k ~ {k1 k2}
  & lm ~ {l1 l2}
  & k1 ~ $([>>] $(l1 sh))
  & sh ~ $([&] $(1 bt))
  & bt ~ ?((@rq_L @rq_R) (t (k2 (l2 (P o)))))
@rq_L = ((l r) (k (L (P (l2 r)))))
  & @rq ~ (l (k (L (P l2))))
@rq_R = (* ((l r) (k (L (P (l r2))))))
  & @rq ~ (r (k (L (P r2))))
@dv = (m (q L))
  & L ~ ?((@dv_leaf @dv_node) (m q))
@dv_leaf = (R (R *))
@dv_node = (lm ((m1 m2) (q1 q2)))
  & lm ~ {l1 l2}
  & @dv ~ (m1 (q1 l1))
  & @dv ~ (m2 (q2 l2))
@w_step_b2z = (h_arg (* (* h_arg)))
@w_step_b2s = (* (h_arg (a_arg (b_arg hole))))
  & h_arg ~ (1 ((a_arg b_arg) hole))
@w_step = ((L (q h)) ((a_elem b_elem) (L3 (q22 br))))
  & L ~ {L1 {L2 L3}}
  & a_elem ~ {a_elem1 a_elem2}
  & b_elem ~ {b_elem1 b_elem2}
  & @rq ~ (q (a_elem1 (L1 (r q2))))
  & @rq ~ (q2 (b_elem1 (L2 (r2 q22))))
  & r ~ $([=] $(r2 r3))
  & r3 ~ ?((@w_step_b2z @w_step_b2s) (h (a_elem2 (b_elem2 br))))
@w_fin = ((* (q h)) q)
  & h ~ (0 *)
@w_blk = (t (S0 o0))
  & t ~ (T1 (E1 (T2 (E2 (T3 (E3 (T4 (E4 (T5 (E5 (T6 (E6 (T7 (E7 (T8 (E8 (T9 (E9 (T10 (E10 (T11 (E11 (T12 (E12 (T13 (E13 (T14 (E14 (T15 (E15 (T16 (E16 t16))))))))))))))))))))))))))))))))
  & T1 ~ ?((@w_nil @w_cons) (S0 (o0 (E1 (S1 o1)))))
  & T2 ~ ?((@w_nil @w_cons) (S1 (o1 (E2 (S2 o2)))))
  & T3 ~ ?((@w_nil @w_cons) (S2 (o2 (E3 (S3 o3)))))
  & T4 ~ ?((@w_nil @w_cons) (S3 (o3 (E4 (S4 o4)))))
  & T5 ~ ?((@w_nil @w_cons) (S4 (o4 (E5 (S5 o5)))))
  & T6 ~ ?((@w_nil @w_cons) (S5 (o5 (E6 (S6 o6)))))
  & T7 ~ ?((@w_nil @w_cons) (S6 (o6 (E7 (S7 o7)))))
  & T8 ~ ?((@w_nil @w_cons) (S7 (o7 (E8 (S8 o8)))))
  & T9 ~ ?((@w_nil @w_cons) (S8 (o8 (E9 (S9 o9)))))
  & T10 ~ ?((@w_nil @w_cons) (S9 (o9 (E10 (S10 o10)))))
  & T11 ~ ?((@w_nil @w_cons) (S10 (o10 (E11 (S11 o11)))))
  & T12 ~ ?((@w_nil @w_cons) (S11 (o11 (E12 (S12 o12)))))
  & T13 ~ ?((@w_nil @w_cons) (S12 (o12 (E13 (S13 o13)))))
  & T14 ~ ?((@w_nil @w_cons) (S13 (o13 (E14 (S14 o14)))))
  & T15 ~ ?((@w_nil @w_cons) (S14 (o14 (E15 (S15 o15)))))
  & T16 ~ ?((@w_nil @w_last) (S15 (o15 (E16 t16))))
@w_nil = (S (o *))
  & @w_fin ~ (S o)
@w_cons = (* (S (o (E (S2 o)))))
  & @w_step ~ (S (E S2))
@w_last = (* (S (o (E t))))
  & @w_step ~ (S (E S2))
  & @w_blk ~ (t (S2 o))
@prog_b3z = (* (* (0 *)))
@prog_b3s = (nm1 (c_copy (mnl o)))
  & nm1 ~ $([+1] r)
  & r ~ {r1 r2}
  & r2 ~ $([=] $(0 r3))
  & r1 ~ $([+] $(r3 r4))
  & r4 ~ $([-] $(1 r5))
  & @lg ~ (r5 L)
  & L ~ {L1 {L2 {L3 L4}}}
  & @tri ~ (c_copy (L1 t))
  & @zq ~ (L2 q)
  & @w_blk ~ (mnl ((L3 (q val)) out))
  & @dv ~ (t (out L4))
  & @sort ~ (val o)
@prog = ((c mnl) br)
  & @lc ~ (c (n c1))
  & n ~ ?((@prog_b3z @prog_b3s) (c1 (mnl br)))
