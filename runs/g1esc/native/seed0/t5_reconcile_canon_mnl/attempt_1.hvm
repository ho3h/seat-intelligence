@prog = ((n (tau (mnl cands))) out)
  & @dedup ~ (cands (0 *) (n (tau (mnl out))))

// ------- deduplicate candidates: keep max score per pair -------

@dedup = (cands acc cont)
  & cands ~ (tag payload)
  & tag ~ ?((@dedup_nil @dedup_cons) (payload (acc cont)))

@dedup_nil = (* (acc cont))
  & @after_dedup ~ (acc cont)

@dedup_cons = (* ((c cs) (acc cont)))
  & @upd ~ (c acc cs cont)

@upd = ((u (v s)) acc cs cont)
  & @upd_scan ~ ((s (u v)) acc newacc)
  & @dedup ~ (cs newacc cont)

@upd_scan = (s p acc out)
  & acc ~ (tag payload)
  & tag ~ ?((@upd_nil @upd_cons) (s (p (payload out))))

@upd_nil = (s (p (* out)))
  & out ~ (1 ((s p) (0 *)))

@upd_cons = (* (s (p ((h t) out))))
  & h ~ (old_s oldp)
  & p ~ {p_eq p_out}
  & oldp ~ {oldp_eq oldp_out}
  & @same_pair ~ (p_eq oldp_eq same)
  & same ~ ?((@upd_diff @upd_same) (s (p_out (old_s (oldp_out (t out))))))

@same_pair = ((u v) (ou ov) out)
  & u ~ $([=] $(ou eq1))
  & eq1 ~ ?((@same_false @same_eq_v) (v (ov out)))

@same_false = (* (* out))
  & out ~ 0

@same_eq_v = (* (v (ov out)))
  & v ~ $([=] $(ov out))

@upd_diff = (s (p (old_s (oldp (t out)))))
  & @upd_scan ~ ((s p) t newtail)
  & out ~ (1 ((old_s oldp) newtail))

@upd_same = (* (s (p (old_s (oldp (t out))))))
  & s ~ {s_cmp s_out}
  & old_s ~ {old_cmp old_out}
  & s_cmp ~ $([>] $(old_cmp gt))
  & gt ~ ?((@upd_keep @upd_replace) (s_out (p (old_out (oldp (t out))))))

@upd_keep = (* (* (old_out (oldp (t out)))))
  & out ~ (1 ((old_out oldp) t))

@upd_replace = (* (s_out (p (* (* (t out))))))
  & out ~ (1 ((s_out p) t))

@after_dedup = (acc (n (tau (mnl out))))
  & @filter ~ (acc tau filtered)
  & @sort ~ (filtered sorted)
  & @build ~ (n clusters)
  & @process ~ (sorted clusters mnl n out)

// ------- filter accepted pairs: score >= tau -------

@filter = (lst tau out)
  & lst ~ (tag payload)
  & tag ~ ?((@filter_nil @filter_cons) (tau (payload out)))

@filter_nil = (* (* out))
  & out ~ (0 *)

@filter_cons = (* (tau ((h t) out)))
  & h ~ (s p)
  & s ~ $([<] $(tau lt))
  & lt ~ ?((@filter_keep @filter_drop) (tau ((s p) (t out))))

@filter_keep = (tau ((s p) (t out)))
  & @filter ~ (t tau newtail)
  & out ~ (1 ((s p) newtail))

@filter_drop = (* (tau (* (t out))))
  & @filter ~ (t tau out)

// ------- insertion sort on (score, u, v) -------

@sort = (lst out)
  & @sort_acc ~ (lst (0 *) out)

@sort_acc = (lst acc out)
  & lst ~ (tag payload)
  & tag ~ ?((@sort_nil @sort_cons) (payload (acc out)))

@sort_nil = (* (acc out))
  & out ~ acc

@sort_cons = (* ((h t) (acc out)))
  & @insert_sorted ~ (h acc newacc)
  & @sort_acc ~ (t newacc out)

@insert_sorted = (c lst out)
  & lst ~ (tag payload)
  & tag ~ ?((@ins_nil @ins_cons) (c (payload out)))

@ins_nil = (c (* out))
  & out ~ (1 (c (0 *)))

@ins_cons = (* (c ((h t) out)))
  & @cmp_cand ~ (c h cmp)
  & cmp ~ ?((@ins_after @ins_before) (c (h (t out))))

@ins_after = (c (h (t out)))
  & @insert_sorted ~ (c t newtail)
  & out ~ (1 (h newtail))

@ins_before = (* (c (h (t out))))
  & out ~ (1 (c (1 (h t))))

// ------- candidate comparator: descending score, then u, then v -------

@cmp_cand = ((s1 (u1 v1)) (s2 (u2 v2)) out)
  & s1 ~ {s1a s1b}
  & s2 ~ {s2a s2b}
  & s1a ~ $([>] $(s2a gt1))
  & gt1 ~ ?((@cmp_not_gt1 @cmp_yes1) (s1b (s2b ((u1 v1) ((u2 v2) out)))))

@cmp_yes1 = (* (* (* (* (* out)))))
  & out ~ 1

@cmp_not_gt1 = (s1b (s2b (p1 (p2 out))))
  & s2b ~ $([>] $(s1b gt2))
  & gt2 ~ ?((@cmp_s_eq @cmp_no) (p1 (p2 out)))

@cmp_no = (* (* (* out)))
  & out ~ 0

@cmp_s_eq = (p1 (p2 out))
  & p1 ~ (u1 v1)
  & p2 ~ (u2 v2)
  & u1 ~ {u1a u1b}
  & u2 ~ {u2a u2b}
  & u1a ~ $([<] $(u2a lt1))
  & lt1 ~ ?((@cmp_u_not_lt @cmp_yes2) (u1b (u2b (v1 (v2 out)))))

@cmp_yes2 = (* (* (* (* out))))
  & out ~ 1

@cmp_u_not_lt = (u1b (u2b (v1 (v2 out))))
  & u2b ~ $([<] $(u1b lt2))
  & lt2 ~ ?((@cmp_u_eq @cmp_no2) (v1 (v2 out)))

@cmp_no2 = (* (* out))
  & out ~ 0

@cmp_u_eq = (v1 (v2 out))
  & v1 ~ $([<] $(v2 lt3))
  & lt3 ~ ?((@cmp_no3 @cmp_yes3) out)

@cmp_no3 = (* out)
  & out ~ 0

@cmp_yes3 = (* out)
  & out ~ 1

// ------- initial singleton clusters 0..n-1 -------

@build = (n out)
  & n ~ ?((@build_zero @build_pos) (n out))

@build_zero = (* out)
  & out ~ (0 *)

@build_pos = (prev (n out))
  & @build ~ (prev tail)
  & out ~ (1 ((1 (n (0 *))) tail))

// ------- process accepted pairs -------

@process = (pairs clusters mnl n out)
  & pairs ~ (tag payload)
  & tag ~ ?((@proc_nil @proc_cons) (payload (clusters (mnl (n out)))))

@proc_nil = (* (clusters (* (n out))))
  & @output_ids ~ (n clusters out)

@proc_cons = (* (((s (u v)) tail) (clusters (mnl (n out)))))
  & @process_pair ~ (u v clusters mnl newclusters)
  & @process ~ (tail newclusters mnl n out)

@process_pair = (u v clusters mnl newclusters)
  & @take_cluster ~ (u clusters pu)
  & pu ~ (cu restU)
  & @member ~ (v cu same)
  & same ~ ?((@pp_diff @pp_same) (cu (restU (v (mnl newclusters)))))

@pp_same = (* (cu (restU (* (* newclusters)))))
  & newclusters ~ (1 (cu restU))

@pp_diff = (cu (restU (v (mnl newclusters))))
  & @take_cluster ~ (v restU pv)
  & pv ~ (cv restUV)
  & @conflict ~ (cu cv mnl conflict)
  & conflict ~ ?((@pp_merge @pp_skip) (cu (cv (restUV newclusters))))

@pp_merge = (cu (cv (restUV newclusters)))
  & @append ~ (cu cv combined)
  & newclusters ~ (1 (combined restUV))

@pp_skip = (* (cu (cv (restUV newclusters))))
  & newclusters ~ (1 (cu (1 (cv restUV))))

// ------- take cluster containing id -------

@take_cluster = (id lst out)
  & lst ~ (tag payload)
  & tag ~ ?((@take_nil @take_cons) (id (payload out)))

@take_nil = (* (* out))
  & out ~ (0 *)

@take_cons = (* (id ((c t) out)))
  & @member ~ (id c bool)
  & bool ~ ?((@take_not @take_found) (id (c (t out))))

@take_not = (id (c (t out)))
  & @take_cluster ~ (id t fr)
  & fr ~ (found rest)
  & out ~ (found (1 (c rest)))

@take_found = (* (* (c (t out))))
  & out ~ (c t)

// ------- membership -------

@member = (id lst out)
  & lst ~ (tag payload)
  & tag ~ ?((@member_nil @member_cons) (id (payload out)))

@member_nil = (* (* out))
  & out ~ 0

@member_cons = (* (id ((x xs) out)))
  & id ~ $([=] $(x eq))
  & eq ~ ?((@member_tail @member_yes) (id (xs out)))

@member_tail = (id (xs out))
  & @member ~ (id xs out)

@member_yes = (* (id (xs out)))
  & out ~ 1

// ------- conflict check -------

@conflict = (cu cv mnl out)
  & mnl ~ (tag payload)
  & tag ~ ?((@conf_nil @conf_cons) (cu (cv (payload out))))

@conf_nil = (* (* (* out)))
  & out ~ 0

@conf_cons = (* (cu (cv (((a b) t) out))))
  & @cross ~ (a b cu cv found)
  & found ~ ?((@conf_tail @conf_yes) (cu (cv (t out))))

@conf_tail = (cu (cv (t out)))
  & @conflict ~ (cu cv t out)

@conf_yes = (* (cu (cv (t out))))
  & out ~ 1

@cross = (a b cu cv out)
  & @member ~ (a cu ma)
  & @member ~ (b cv mb)
  & @and ~ (ma mb and1)
  & @member ~ (b cu mc)
  & @member ~ (a cv md)
  & @and ~ (mc md and2)
  & @or ~ (and1 and2 out)

@and = (a b out)
  & a ~ ?((@and_false @and_true) (b out))

@and_false = (* out)
  & out ~ 0

@and_true = (* (b out))
  & out ~ b

@or = (a b out)
  & a ~ ?((@or_false @or_true) (b out))

@or_false = (b out)
  & out ~ b

@or_true = (* (b out))
  & out ~ 1

// ------- append two lists -------

@append = (a b out)
  & a ~ (tag payload)
  & tag ~ ?((@append_nil @append_cons) (payload (b out)))

@append_nil = (* (b out))
  & out ~ b

@append_cons = (* ((x xs) (b out)))
  & @append ~ (xs b rest)
  & out ~ (1 (x rest))

// ------- final output list of canonical ids -------

@output_ids = (n clusters out)
  & @out_loop ~ (n clusters (0 *) out)

@out_loop = (m clusters acc out)
  & m ~ ?((@out_zero @out_pos) (m (clusters (acc out))))

@out_zero = (* (clusters (acc out)))
  & @canonical ~ (0 clusters max)
  & out ~ (1 (max acc))

@out_pos = (prev (m (clusters (acc out))))
  & @canonical ~ (m clusters max)
  & @out_loop ~ (prev clusters (1 (max acc)) out)

@canonical = (id clusters maxout)
  & @take_cluster ~ (id clusters pair)
  & pair ~ (cluster rest)
  & rest ~ *
  & @list_max ~ (cluster 0 maxout)

@list_max = (lst best out)
  & lst ~ (tag payload)
  & tag ~ ?((@lmax_nil @lmax_cons) (best (payload out)))

@lmax_nil = (best (* out))
  & out ~ best

@lmax_cons = (* (best ((x xs) out)))
  & best ~ $([<] $(x gt))
  & gt ~ ?((@lmax_old @lmax_new) (x (best (xs out))))

@lmax_old = (* (best (xs out)))
  & @list_max ~ (xs best out)

@lmax_new = (* (x (* (xs out))))
  & @list_max ~ (xs x out)

// ------- reverse list -------

@reverse = (lst out)
  & @rev_acc ~ (lst (0 *) out)

@rev_acc = (lst acc out)
  & lst ~ (tag payload)
  & tag ~ ?((@rev_nil @rev_cons) (payload (acc out)))

@rev_nil = (* (acc out))
  & out ~ acc

@rev_cons = (* ((x xs) (acc out)))
  & @rev_acc ~ (xs (1 (x acc)) out)
