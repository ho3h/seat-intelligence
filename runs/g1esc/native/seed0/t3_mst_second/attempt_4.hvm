@prog = (input output)
  & input ~ (n edges)
  & @sort_edges ~ (edges Nil sorted)
  & @range_asc ~ (n Nil dsu)
  & @kruskal_loop ~ (sorted dsu 0 Nil Nil kres)
  & @after_kruskal ~ (kres output)

@after_kruskal = (kres output)
  & kres ~ (total mst non_mst)
  & non_mst ~ (tag payload)
  & tag ~ ?((@ak_no_non @ak_has_non) (total mst non_mst payload output))

@ak_no_non = (total mst non_mst payload output)
  & total ~ *
  & mst ~ *
  & non_mst ~ *
  & payload ~ *
  & output ~ 16777215

@ak_has_non = (z ctx)
  & z ~ *
  & ctx ~ (total mst non_mst payload output)
  & payload ~ *
  & @min_candidate ~ (non_mst mst total 16777215 output)

@min_candidate = (edges mst total best output)
  & edges ~ (tag payload)
  & tag ~ ?((@mc_nil @mc_cons) (payload mst total best output))

@mc_nil = (payload mst total best output)
  & payload ~ *
  & mst ~ *
  & total ~ *
  & output ~ best

@mc_cons = (z ctx)
  & z ~ *
  & ctx ~ (payload mst total best output)
  & payload ~ (edge rest)
  & @process_candidate ~ (edge rest mst total best output)

@process_candidate = (edge rest mst total best output)
  & edge ~ (u vw)
  & vw ~ (v w)
  & mst ~ {mst_path mst_rec}
  & total ~ {total_path total_rec}
  & @path_max ~ (u v mst_path 0 pm)
  & @candidate ~ (total_path pm w cand)
  & @min2 ~ (best cand new_best)
  & @min_candidate ~ (rest mst_rec total_rec new_best output)

@candidate = (total pm w out)
  & total ~ $([-] $(pm diff))
  & diff ~ $([+] $(w out))

@min2 = (a b out)
  & a ~ $([<] $(b lt))
  & lt ~ ?((@min_b @min_a) (a b out))

@min_b = (a b out)
  & a ~ *
  & out ~ b

@min_a = (z ctx)
  & z ~ *
  & ctx ~ (a b out)
  & b ~ *
  & out ~ a

@path_max = (u v edges acc out)
  & u ~ $([=] $(v eq))
  & eq ~ ?((@pm_search @pm_found) (u v edges acc out))

@pm_found = (z ctx)
  & z ~ *
  & ctx ~ (u v edges acc out)
  & u ~ *
  & v ~ *
  & edges ~ *
  & out ~ acc

@pm_search = (u v edges acc out)
  & edges ~ {edges_trav edges_full}
  & @path_search ~ (u v edges_trav edges_full acc out)

@path_search = (u v edges_trav edges_full acc out)
  & edges_trav ~ (tag payload)
  & tag ~ ?((@ps_nil @ps_cons) (u v payload edges_full acc out))

@ps_nil = (u v payload edges_full acc out)
  & u ~ *
  & v ~ *
  & payload ~ *
  & edges_full ~ *
  & acc ~ out

@ps_cons = (z ctx)
  & z ~ *
  & ctx ~ (u v payload edges_full acc out)
  & payload ~ (edge rest_trav)
  & @check_edge ~ (u v edge rest_trav edges_full acc out)

@check_edge = (u v edge rest_trav edges_full acc out)
  & edge ~ (a bw)
  & bw ~ (b w)
  & u ~ $([=] $(a eq_a))
  & eq_a ~ ?((@ce_try_b @ce_on_a) (u v a b w rest_trav edges_full acc out))

@ce_try_b = (u v a b w rest_trav edges_full acc out)
  & u ~ $([=] $(b eq_b))
  & eq_b ~ ?((@ce_skip_edge @ce_on_b) (u v a b w rest_trav edges_full acc out))

@ce_on_a = (z ctx)
  & z ~ *
  & ctx ~ (u v a b w rest_trav edges_full acc out)
  & b ~ {b_cmp b_use}
  & a ~ {a_cmp a_use}
  & b_cmp ~ $([!] $(a_cmp neq))
  & neq ~ ?((@ce_skip_edge @ce_use_b) (u v a_use b_use w rest_trav edges_full acc out))

@ce_on_b = (z ctx)
  & z ~ *
  & ctx ~ (u v a b w rest_trav edges_full acc out)
  & a ~ {a_cmp a_use}
  & b ~ {b_cmp b_use}
  & a_cmp ~ $([!] $(b_cmp neq))
  & neq ~ ?((@ce_skip_edge @ce_use_a) (u v a_use b_use w rest_trav edges_full acc out))

@ce_skip_edge = (u v a b w rest_trav edges_full acc out)
  & u ~ *
  & v ~ *
  & a ~ *
  & b ~ *
  & w ~ *
  & @path_search ~ (u v rest_trav edges_full acc out)

@ce_use_b = (z ctx)
  & z ~ *
  & ctx ~ (u v a b w rest_trav edges_full acc out)
  & @max ~ (acc w new_acc)
  & @path_max ~ (a v edges_full new_acc out)

@ce_use_a = (z ctx)
  & z ~ *
  & ctx ~ (u v a b w rest_trav edges_full acc out)
  & @max ~ (acc w new_acc)
  & @path_max ~ (b v edges_full new_acc out)

@max = (a b out)
  & a ~ $([>] $(b gt))
  & gt ~ ?((@max_b @max_a) (a b out))

@max_a = (* (a b out))
  & out ~ a

@max_b = (a b out)
  & out ~ b

@sort_edges = (edges acc out)
  & edges ~ (tag payload)
  & tag ~ ?((@sort_nil @sort_cons) (payload acc out))

@sort_nil = (payload acc out)
  & payload ~ *
  & out ~ acc

@sort_cons = (z ctx)
  & z ~ *
  & ctx ~ (payload acc out)
  & payload ~ (edge rest)
  & @insert ~ (edge acc new_acc)
  & @sort_edges ~ (rest new_acc out)

@insert = (edge sorted out)
  & sorted ~ (tag payload)
  & tag ~ ?((@ins_nil @ins_cons) (edge payload out))

@ins_nil = (edge payload out)
  & payload ~ *
  & out ~ (1 (edge (0 *)))

@ins_cons = (z ctx)
  & z ~ *
  & ctx ~ (edge payload out)
  & payload ~ (head tail)
  & @edge_weight ~ (edge ew)
  & @edge_weight ~ (head hw)
  & ew ~ $([>] $(hw cmp))
  & cmp ~ ?((@ins_before @ins_after) (edge head tail out))

@ins_after = (z ctx)
  & z ~ *
  & ctx ~ (edge head tail out)
  & @insert ~ (edge tail new_tail)
  & out ~ (1 (head new_tail))

@ins_before = (edge head tail out)
  & out ~ (1 (edge (1 (head tail))))

@edge_weight = (edge out)
  & edge ~ (u vw)
  & vw ~ (v w)
  & u ~ *
  & v ~ *
  & w ~ out

@range_asc = (n acc out)
  & n ~ ?((@range_zero @range_pos) (acc out))

@range_zero = (* (acc out))
  & acc ~ out

@range_pos = (n_pred ctx)
  & ctx ~ (acc out)
  & @range_asc ~ (n_pred (1 (n_pred acc)) out)

@get_at = (list idx out)
  & idx ~ ?((@ga_zero @ga_pos) (list out))

@ga_zero = (list out)
  & list ~ (h t)
  & h ~ out
  & t ~ *

@ga_pos = (idx_pred ctx)
  & ctx ~ (list out)
  & list ~ (h t)
  & h ~ *
  & @get_at ~ (t idx_pred out)

@set_at = (list idx value out)
  & idx ~ ?((@sa_zero @sa_pos) (list value out))

@sa_zero = (list value out)
  & list ~ (h t)
  & h ~ *
  & out ~ (1 (value t))

@sa_pos = (idx_pred ctx)
  & ctx ~ (list value out)
  & list ~ (h t)
  & @set_at ~ (t idx_pred value new_t)
  & out ~ (1 (h new_t))

@find = (x dsu out)
  & @get_at ~ (dsu x parent)
  & x ~ $([=] $(parent eq))
  & eq ~ ?((@find_go @find_stop) (parent dsu out))

@find_go = (parent dsu out)
  & @find ~ (parent dsu out)

@find_stop = (z ctx)
  & z ~ *
  & ctx ~ (parent dsu out)
  & dsu ~ *
  & out ~ parent

@kruskal_loop = (edges dsu total mst non_mst result)
  & edges ~ (tag payload)
  & tag ~ ?((@kr_nil @kr_cons) (payload dsu total mst non_mst result))

@kr_nil = (payload dsu total mst non_mst result)
  & payload ~ *
  & dsu ~ *
  & result ~ (total mst non_mst)

@kr_cons = (z ctx)
  & z ~ *
  & ctx ~ (payload dsu total mst non_mst result)
  & payload ~ (edge rest)
  & @process_edge ~ (edge rest dsu total mst non_mst result)

@process_edge = (edge rest dsu total mst non_mst result)
  & edge ~ (u vw)
  & vw ~ (v w)
  & dsu ~ {dsu_a dsu_bc}
  & dsu_bc ~ {dsu_b dsu_rec}
  & @find ~ (u dsu_a ru)
  & @find ~ (v dsu_b rv)
  & ru ~ $([=] $(rv same))
  & same ~ ?((@kr_diff @kr_same) (u v w rest dsu_rec total mst non_mst result ru rv))

@kr_same = (z ctx)
  & z ~ *
  & ctx ~ (u v w rest dsu_rec total mst non_mst result ru rv)
  & ru ~ *
  & rv ~ *
  & @kruskal_loop ~ (rest dsu_rec total mst (1 ((u (v w)) non_mst)) result)

@kr_diff = (u v w rest dsu_rec total mst non_mst result ru rv)
  & w ~ {w_add w_edge}
  & @set_at ~ (dsu_rec rv ru new_dsu)
  & total ~ $([+] $(w_add new_total))
  & @kruskal_loop ~ (rest new_dsu new_total (1 ((u (v w_edge)) mst)) non_mst result)
