@prog = (input output)
  & input ~ (n pairs)
  & {n_init n_emit} ~ n
  & @init_state ~ (n_init ((0 *) state))
  & @proc ~ (pairs (state final_state))
  & @emit_sizes ~ (final_state (0 (n_emit ((0 *) output))))

@init_state = (k (acc out))
  & k ~ ?((@init_zero @init_succ) (acc out))

@init_zero = (acc out)
  & acc ~ out

@init_succ = (k1 (acc out))
  & {k1_id k1_rest} ~ k1
  & {k1_parent k1_recurse} ~ k1_rest
  & @init_state ~ (k1_recurse ((1 ((k1_id k1_parent) acc)) out))

@proc = (pairs (state final_out))
  & pairs ~ (tag payload)
  & tag ~ ?((@proc_nil @proc_cons) (payload (state final_out)))

@proc_nil = (payload (state final_out))
  & payload ~ *
  & state ~ final_out

@proc_cons = (pred (payload (state final_out)))
  & pred ~ *
  & payload ~ (pair rest)
  & pair ~ (u v)
  & @union ~ (u (v (state (rest final_out))))

@union = (u (v (state (rest final_out))))
  & {state_find_u state_rest} ~ state
  & {state_find_v state_update} ~ state_rest
  & @find ~ (state_find_u (u ru))
  & @find ~ (state_find_v (v rv))
  & @finish_union ~ (ru (rv (state_update (rest final_out))))

@finish_union = (ru (rv (state (rest final_out))))
  & {ru_eq ru_rest} ~ ru
  & {rv_eq rv_rest} ~ rv
  & ru_eq ~ $([=] $(rv_eq eq))
  & eq ~ ?((@union_diff @union_same) (ru_rest (rv_rest (state (rest final_out)))))

@union_same = (ru (rv (state (rest final_out))))
  & ru ~ *
  & rv ~ *
  & @proc ~ (rest (state final_out))

@union_diff = (ru (rv (state (rest final_out))))
  & {ru_cmp ru_old} ~ ru
  & {rv_cmp rv_new} ~ rv
  & ru_cmp ~ $([<] $(rv_cmp lt))
  & lt ~ ?((@union_gt @union_lt) (ru_old (rv_new (state (rest final_out)))))

@union_lt = (ru (rv (state (rest final_out))))
  & @set_root ~ (state (ru (rv (rest final_out))))

@union_gt = (ru (rv (state (rest final_out))))
  & @set_root ~ (state (rv (ru (rest final_out))))

@set_root = (state (node (new (rest final_out))))
  & @replace ~ (state (node (new updated_state)))
  & @proc ~ (rest (updated_state final_out))

@replace = (state (node (new out)))
  & state ~ (tag payload)
  & tag ~ ?((@replace_nil @replace_cons) (payload (node (new out))))

@replace_nil = (payload (node (new out)))
  & payload ~ *
  & node ~ *
  & new ~ *
  & out ~ 0

@replace_cons = (pred (payload (node (new out))))
  & pred ~ *
  & payload ~ (entry tail)
  & entry ~ (id parent)
  & {node_cmp node_ctx} ~ node
  & {id_cmp id_keep} ~ id
  & id_cmp ~ $([=] $(node_cmp eq))
  & eq ~ ?((@repl_ne @repl_eq) (tail (id_keep (parent (node_ctx (new out))))))

@repl_ne = (tail (id (parent (node (new out)))))
  & @replace ~ (tail (node (new new_tail)))
  & out ~ (1 ((id parent) new_tail))

@repl_eq = (tail (id (parent (node (new out)))))
  & parent ~ *
  & node ~ *
  & out ~ (1 ((id new) tail))

@find = (state (node out))
  & state ~ (tag payload)
  & tag ~ ?((@find_nil @find_cons) (payload (node out)))

@find_nil = (payload (node out))
  & payload ~ *
  & node ~ *
  & out ~ 0

@find_cons = (pred (payload (node out)))
  & pred ~ *
  & payload ~ (entry tail)
  & entry ~ (id parent)
  & {node_cmp node_ctx} ~ node
  & id ~ $([=] $(node_cmp eq))
  & eq ~ ?((@find_ne @find_eq) (tail (parent (node_ctx out))))

@find_ne = (tail (parent (node out)))
  & parent ~ *
  & @find ~ (tail (node out))

@find_eq = (tail (parent (node out)))
  & {node_cmp node_ret} ~ node
  & {parent_cmp parent_follow} ~ parent
  & parent_cmp ~ $([=] $(node_cmp eqp))
  & eqp ~ ?((@find_eq_ne @find_eq_eq) (tail (parent_follow (node_ret out))))

@find_eq_ne = (tail (parent (node out)))
  & node ~ *
  & @find ~ (tail (parent out))

@find_eq_eq = (tail (parent (node out)))
  & tail ~ *
  & parent ~ *
  & node ~ out

@emit_sizes = (state (i (n (acc out))))
  & {i_cmp i_rest} ~ i
  & {n_cmp n_rest} ~ n
  & i_cmp ~ $([=] $(n_cmp eq))
  & eq ~ ?((@emit_done @emit_next) (state (i_rest (n_rest (acc out)))))

@emit_done = (state (i (n (acc out))))
  & state ~ *
  & i ~ *
  & n ~ *
  & acc ~ out

@emit_next = (state (i (n (acc out))))
  & {state_find state_rest} ~ state
  & {i_find i_after} ~ i
  & @find ~ (state_find (i_find root))
  & {i_cmp i_before_inc} ~ i_after
  & i_before_inc ~ $([+1] i_next)
  & root ~ $([=] $(i_cmp eq))
  & eq ~ ?((@emit_skip @emit_append) (state_rest (i_next (n (acc out)))))

@emit_skip = (root (state (i (n (acc out)))))
  & root ~ *
  & @emit_sizes ~ (state (i (n (acc out))))

@emit_append = (root (state (i (n (acc out)))))
  & {state_count state_keep} ~ state
  & {n_count n_keep} ~ n
  & @count_root ~ (state_count (0 (n_count (root cnt))))
  & cnt ~ ?((@append_zero @append_pos) (state_keep (i (n_keep (acc out)))))

@append_zero = (cnt (state (i (n (acc out)))))
  & cnt ~ *
  & @emit_sizes ~ (state (i (n (acc out))))

@append_pos = (pred (state (i (n (acc out)))))
  & pred ~ $([+1] cnt)
  & @emit_sizes ~ (state (i (n ((1 (cnt acc)) out))))

@count_root = (state (j (n (target (cnt out)))))
  & {j_cmp j_rest} ~ j
  & {n_cmp n_rest} ~ n
  & j_cmp ~ $([=] $(n_cmp eq))
  & eq ~ ?((@count_done @count_next) (state (j_rest (n_rest (target (cnt out))))))

@count_done = (state (j (n (target (cnt out)))))
  & state ~ *
  & j ~ *
  & n ~ *
  & target ~ *
  & cnt ~ out

@count_next = (state (j (n (target (cnt out)))))
  & {state_find state_keep} ~ state
  & {j_find j_inc} ~ j
  & @find ~ (state_find (j_find root))
  & j_inc ~ $([+1] j_next)
  & {target_cmp target_keep} ~ target
  & root ~ $([=] $(target_cmp match))
  & match ~ ?((@count_ne @count_eq) (state_keep (j_next (n (target_keep (cnt out))))))

@count_ne = (root (state (j (n (target (cnt out))))))
  & root ~ *
  & @count_root ~ (state (j (n (target (cnt out)))))

@count_eq = (root (state (j (n (target (cnt out))))))
  & root ~ *
  & cnt ~ $([+1] cnt_next)
  & @count_root ~ (state (j (n (target (cnt_next out)))))
