@prog = ((n (r edges)) out)
  & {n1 n2} ~ n
  & @make_list ~ (n1 list0)
  & @set_root ~ (r (list0 list1))
  & @repeat ~ (n2 (edges (list1 out)))

@make_list = (n out)
  & n ~ ?((@make_list_zero @make_list_succ) out)

@make_list_zero = out
  & out ~ (0 *)

@make_list_succ = (m out)
  & @make_list ~ (m tail)
  & out ~ (1 (16777214 tail))

@set_root = (r (list out))
  & r ~ ?((@sr_zero @sr_succ) (list out))

@sr_zero = (list out)
  & list ~ (tag payload)
  & tag ~ ?((@sr_zero_nil @sr_zero_cons) (payload out))

@sr_zero_nil = (payload out)
  & payload ~ *
  & out ~ *

@sr_zero_cons = (payload out)
  & payload ~ (head tail)
  & head ~ *
  & out ~ (1 (16777215 tail))

@sr_succ = (m (list out))
  & list ~ (tag payload)
  & tag ~ ?((@sr_succ_nil @sr_succ_cons) (m (payload out)))

@sr_succ_nil = (m (payload out))
  & m ~ *
  & payload ~ *
  & out ~ *

@sr_succ_cons = (m (payload out))
  & payload ~ (head tail)
  & @set_root ~ (m (tail new_tail))
  & out ~ (1 (head new_tail))

@get = (i (list out))
  & i ~ ?((@get_zero_idx @get_succ_idx) (list out))

@get_zero_idx = (list out)
  & list ~ (tag payload)
  & tag ~ ?((@get_zero_tag0 @get_zero_tag1) (payload out))

@get_zero_tag0 = (payload out)
  & payload ~ *
  & out ~ *

@get_zero_tag1 = (payload out)
  & payload ~ (head tail)
  & head ~ out
  & tail ~ *

@get_succ_idx = (m (list out))
  & list ~ (tag payload)
  & tag ~ ?((@get_succ_tag0 @get_succ_tag1) (m (payload out)))

@get_succ_tag0 = (m (payload out))
  & m ~ *
  & payload ~ *
  & out ~ *

@get_succ_tag1 = (m (payload out))
  & payload ~ (head tail)
  & head ~ *
  & @get ~ (m (tail out))

@set = (i (val (list out)))
  & i ~ ?((@set_zero_idx @set_succ_idx) (val (list out)))

@set_zero_idx = (val (list out))
  & list ~ (tag payload)
  & tag ~ ?((@set_zero_tag0 @set_zero_tag1) (val (payload out)))

@set_zero_tag0 = (val (payload out))
  & val ~ *
  & payload ~ *
  & out ~ *

@set_zero_tag1 = (val (payload out))
  & payload ~ (head tail)
  & head ~ *
  & out ~ (1 (val tail))

@set_succ_idx = (m (val (list out)))
  & list ~ (tag payload)
  & tag ~ ?((@set_succ_tag0 @set_succ_tag1) (m (val (payload out))))

@set_succ_tag0 = (m (val (payload out)))
  & m ~ *
  & val ~ *
  & payload ~ *
  & out ~ *

@set_succ_tag1 = (m (val (payload out)))
  & payload ~ (head tail)
  & @set ~ (m (val (tail new_tail)))
  & out ~ (1 (head new_tail))

@process_edge = (u (v (arr out)))
  & {u1 u2} ~ u
  & {v1 v2} ~ v
  & {arrA arrBC} ~ arr
  & {arrB arrC} ~ arrBC
  & @get ~ (u1 (arrA pu))
  & @get ~ (v1 (arrB pv))
  & pu ~ $([!] $(16777214 pu_known))
  & pv ~ $([!] $(16777214 pv_known))
  & @decide ~ (pu_known (pv_known (u2 (v2 (arrC out)))))

@decide = (pu (pv (u (v (arr out)))))
  & pu ~ ?((@decide_pu0 @decide_pu1) (pv (u (v (arr out)))))

@decide_pu0 = (pv (u (v (arr out))))
  & pv ~ ?((@decide_00 @decide_01) (u (v (arr out))))

@decide_pu1 = (pv (u (v (arr out))))
  & pv ~ ?((@decide_10 @decide_11) (u (v (arr out))))

@decide_00 = (u (v (arr out)))
  & u ~ *
  & v ~ *
  & arr ~ out

@decide_01 = (u (v (arr out)))
  & @set ~ (u (v (arr out)))

@decide_10 = (u (v (arr out)))
  & @set ~ (v (u (arr out)))

@decide_11 = (u (v (arr out)))
  & u ~ *
  & v ~ *
  & arr ~ out

@scan_edges = (edges (arr out))
  & edges ~ (tag payload)
  & tag ~ ?((@scan_nil @scan_cons) (payload (arr out)))

@scan_nil = (payload (arr out))
  & payload ~ *
  & arr ~ out

@scan_cons = (zero (payload (arr out)))
  & zero ~ *
  & payload ~ (edge rest)
  & edge ~ (u v)
  & @process_edge ~ (u (v (arr new_arr)))
  & @scan_edges ~ (rest (new_arr out))

@repeat = (count (edges (arr out)))
  & count ~ ?((@repeat_done @repeat_step) (edges (arr out)))

@repeat_done = (edges (arr out))
  & edges ~ *
  & arr ~ out

@repeat_step = (m (edges (arr out)))
  & {edges_scan edges_next} ~ edges
  & @scan_edges ~ (edges_scan (arr arr2))
  & @repeat ~ (m (edges_next (arr2 out)))
