@prog = ((n (r edges)) out)
  & {n1 n2} ~ n
  & @init ~ (n1 (r arr))
  & @repeat ~ (n2 (edges (arr out)))

@init = (n (r out))
  & @build ~ (n (r ((0 *) out)))

@build = (i (r (tail out)))
  & i ~ ?((@build_done @build_step) (r (tail out)))

@build_done = (* (tail out))
  & tail ~ out

@build_step = (p (r (tail out)))
  & {p1 p2} ~ p
  & {r1 r2} ~ r
  & p1 ~ $([=] $(r1 eq))
  & @pick ~ (eq head)
  & cell ~ (1 (head tail))
  & @build ~ (p2 (r2 (cell out)))

@pick = (cond out)
  & cond ~ ?((@pick_no @pick_yes) (* out))

@pick_no = (* out)
  & out ~ 16777214

@pick_yes = (* (* out))
  & out ~ 16777215

@repeat = (count (edges (arr out)))
  & count ~ ?((@repeat_done @repeat_step) (edges (arr out)))

@repeat_done = (* (arr out))
  & arr ~ out

@repeat_step = (m (edges (arr out)))
  & {edges1 edges2} ~ edges
  & @scan_edges ~ (edges1 (arr arr2))
  & @repeat ~ (m (edges2 (arr2 out)))

@scan_edges = ((tag payload) (arr out))
  & tag ~ ?((@scan_nil @scan_cons) (payload (arr out)))

@scan_nil = (* (arr out))
  & arr ~ out

@scan_cons = (* (((u v) rest) (arr out)))
  & @process_edge ~ (u (v (rest (arr out))))

@process_edge = (u (v (rest (arr out))))
  & {u1 u2} ~ u
  & {v1 v2} ~ v
  & {arr1 arr2 arr3} ~ arr
  & @get ~ (u1 (arr1 pu))
  & @get ~ (v1 (arr2 pv))
  & pu ~ $([!] $(16777214 pu_set))
  & pv ~ $([!] $(16777214 pv_set))
  & @decide ~ (pu_set (pv_set (u2 (v2 (rest (arr3 out))))))

@get = (i (list out))
  & i ~ ?((@get_zero @get_succ) (list out))

@get_zero = ((1 (head tail)) out)
  & head ~ out
  & tail ~ *

@get_succ = (m ((1 (head tail)) out))
  & head ~ *
  & @get ~ (m (tail out))

@set = (i (val (list out)))
  & i ~ ?((@set_zero @set_succ) (val (list out)))

@set_zero = (val ((1 (head tail)) out))
  & head ~ *
  & out ~ (1 (val tail))

@set_succ = (m (val ((1 (head tail)) out)))
  & head ~ *
  & @set ~ (m (val (tail out)))

@decide = (pu_set (pv_set (u (v (rest (arr out))))))
  & pu_set ~ ?((@decide_pu0 @decide_pu1) (pv_set (u (v (rest (arr out))))))

@decide_pu0 = (pv_set (u (v (rest (arr out)))))
  & pv_set ~ ?((@decide_00 @decide_01) (u (v (rest (arr out)))))

@decide_pu1 = (* (pv_set (u (v (rest (arr out))))))
  & pv_set ~ ?((@decide_10 @decide_11) (u (v (rest (arr out)))))

@decide_00 = (* (* (rest (arr out))))
  & @scan_edges ~ (rest (arr out))

@decide_01 = (* (u (v (rest (arr out)))))
  & @set ~ (u (v (arr arr2)))
  & @scan_edges ~ (rest (arr2 out))

@decide_10 = (u (v (rest (arr out))))
  & @set ~ (v (u (arr arr2)))
  & @scan_edges ~ (rest (arr2 out))

@decide_11 = (* (* (* (rest (arr out)))))
  & @scan_edges ~ (rest (arr out))
