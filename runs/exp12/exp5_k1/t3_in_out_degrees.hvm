// t3_in_out_degrees (GRAPH-SWING, runs/exp5): two degree histograms as complete binary tries keyed by vertex id,
// updated by pre-expanded "increment leaf" updates while streaming the edges, then flattened to lists (tail threaded
// through the traversal, first n leaves kept).
@prog = ((n es) out)
  & n ~ ?((@io_zero @io_pos) (es out))
@io_zero = (* ((0 *) (0 *)))
@io_pos = (nm1 (es out))
  & nm1 ~ {a b}
  & a ~ $([+1] n)
  & @lg ~ (b L)
  & L ~ {L1 {L2 {L3 {L4 L5}}}}
  & n ~ {n1 n2}
  & @zt ~ (L1 I0)
  & @zt ~ (L2 O0)
  & @w_blk ~ (es ((L3 (I0 O0)) (If Of)))
  & @tl ~ (If (L4 (0 (n1 ((0 *) li)))))
  & @tl ~ (Of (L5 (0 (n2 ((0 *) lo)))))
  & out ~ (li lo)
@io_step = ((L (I O)) ((u v) (L3 (I2 O2))))
  & L ~ {L1 {L2 L3}}
  & @inc ~ (I (v (L1 I2)))
  & @inc ~ (O (u (L2 O2)))
@io_fin = ((* (I O)) (I O))
@w_blk = (t (S0 o0))
  & t ~ (T1 (E1 t1))
  & T1 ~ ?((@w_nil @w_last) (S0 (o0 (E1 t1))))
@w_nil = (S (o *))
  & @io_fin ~ (S o)
@w_cons = (* (S (o (E (S2 o)))))
  & @io_step ~ (S (E S2))
@w_last = (* (S (o (E t))))
  & @io_step ~ (S (E S2))
  & @w_blk ~ (t (S2 o))
// inc(t, k, L): add 1 to leaf k
@inc = (t (k (L o)))
  & L ~ ?((@inc_leaf @inc_node) (t (k o)))
@inc_leaf = (x (* o))
  & x ~ $([+1] o)
@inc_node = (lm (t (k o)))
  & k ~ {k1 k2}
  & lm ~ {l1 l2}
  & k1 ~ $([>>] $(l1 sh))
  & sh ~ $([&] $(1 b))
  & b ~ ?((@inc_L @inc_R) (t (k2 (l2 o))))
@inc_L = ((l r) (k (L (l2 r))))
  & @inc ~ (l (k (L l2)))
@inc_R = (* ((l r) (k (L (l r2)))))
  & @inc ~ (r (k (L r2)))
// tl(t, L, base, n, tail): the leaves of t with index < n, in order, prepended to tail
@tl = (t (L (base (n (tail o)))))
  & L ~ ?((@tl_leaf @tl_node) (t (base (n (tail o)))))
@tl_leaf = (x (base (n (tail o))))
  & base ~ $([<] $(n keep))
  & keep ~ ?((@tl_drop @tl_keep) (x (tail o)))
@tl_drop = (* (t t))
@tl_keep = (* (x (t (1 (x t)))))
@tl_node = (lm ((a b) (base (n (tail o)))))
  & lm ~ {l1 {l2 l3}}
  & base ~ {b1 b2}
  & n ~ {n1 n2}
  & 1 ~ $([<<] $(l3 half))
  & b2 ~ $([+] $(half bR))
  & @tl ~ (a (l1 (b1 (n1 (mid o)))))
  & @tl ~ (b (l2 (bR (n2 (tail mid)))))
// ---- shared trie primitives (depth-L complete binary trie, leaves are numbers, keyed by bits of the key, high bit first)
// lg(x) = number of bits of x (0 for 0): trie depth for keys 0..x
@lg = (?((0 @lg_s) o) o)
@lg_s = (xm o)
  & xm ~ $([+1] x)
  & x ~ $([>>] $(1 y))
  & @lg ~ (y z)
  & z ~ $([+1] o)

// zt(L): trie of depth L with all leaves 0
@zt = (?((0 @zt_node) o) o)
@zt_node = (lm (a b))
  & lm ~ {l1 l2}
  & @zt ~ (l1 a)
  & @zt ~ (l2 b)

// cnt(t, L): sum of the leaves
@cnt = (t (L o))
  & L ~ ?((@cnt_leaf @cnt_node) (t o))
@cnt_leaf = (x x)
@cnt_node = (lm ((a b) o))
  & lm ~ {l1 l2}
  & @cnt ~ (a (l1 x))
  & @cnt ~ (b (l2 y))
  & x ~ $([+] $(y o))

// ins(t, k, L): set leaf k to 1. Control flow depends on k and L only, so it expands before t exists.
@ins = (t (k (L o)))
  & L ~ ?((@ins_leaf @ins_node) (t (k o)))
@ins_leaf = (* (* 1))
@ins_node = (lm (t (k o)))
  & k ~ {k1 k2}
  & lm ~ {l1 l2}
  & k1 ~ $([>>] $(l1 sh))
  & sh ~ $([&] $(1 b))
  & b ~ ?((@ins_L @ins_R) (t (k2 (l2 o))))
@ins_L = ((l r) (k (L (l2 r))))
  & @ins ~ (l (k (L l2)))
@ins_R = (* ((l r) (k (L (l r2)))))
  & @ins ~ (r (k (L r2)))
