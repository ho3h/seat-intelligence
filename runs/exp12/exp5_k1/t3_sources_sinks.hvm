// t3_sources_sinks (GRAPH-SWING, runs/exp5). Two bitmaps as complete binary tries keyed by vertex id; each edge is
// one pre-expanded "set leaf" insert into each trie; the edge list is consumed by a k-cell blocked stream walker.
// sources = n - |{v}|, sinks = n - |{u}|.
@prog = ((n es) out)
  & n ~ ?((@ss_zero @ss_pos) (es out))
@ss_zero = (* (0 0))
@ss_pos = (nm1 (es out))
  & nm1 ~ {a b}
  & a ~ $([+1] n1)
  & @lg ~ (b d)
  & d ~ {d1 {d2 d3}}
  & @zt ~ (d1 to0)
  & @zt ~ (d2 ti0)
  & @w_blk ~ (es ((d3 (to0 ti0)) (cout cin)))
  & n1 ~ {n2 n3}
  & n2 ~ $([-] $(cin src))
  & n3 ~ $([-] $(cout snk))
  & out ~ (src snk)
@ss_step = ((d (to ti)) ((u v) (d3 (to2 ti2))))
  & d ~ {d1 {d2 d3}}
  & @ins ~ (to (u (d1 to2)))
  & @ins ~ (ti (v (d2 ti2)))
@ss_fin = ((d (to ti)) (co ci))
  & d ~ {d1 d2}
  & @cnt ~ (to (d1 co))
  & @cnt ~ (ti (d2 ci))
@w_blk = (t (S0 o0))
  & t ~ (T1 (E1 t1))
  & T1 ~ ?((@w_nil @w_last) (S0 (o0 (E1 t1))))
@w_nil = (S (o *))
  & @ss_fin ~ (S o)
@w_cons = (* (S (o (E (S2 o)))))
  & @ss_step ~ (S (E S2))
@w_last = (* (S (o (E t))))
  & @ss_step ~ (S (E S2))
  & @w_blk ~ (t (S2 o))
// ---- shared trie primitives (depth-L complete binary trie, leaves are numbers, keyed by bits of the key, high bit first)
// lg(x) = number of bits of x (0 for 0): trie depth for keys 0..x
@lg = (?((0 @lg_s) o) o)
@lg_s = (xm o)
  & xm ~ $([+1] x)
  & x ~ $([>>] $(1 y))
  & @lg ~ (y z)
  & z ~ $([+1] o)

// zt(L): trie of depth L with all leaves 0
@zt = (?((0 @zt_node) o) o)
@zt_node = (lm (a b))
  & lm ~ {l1 l2}
  & @zt ~ (l1 a)
  & @zt ~ (l2 b)

// cnt(t, L): sum of the leaves
@cnt = (t (L o))
  & L ~ ?((@cnt_leaf @cnt_node) (t o))
@cnt_leaf = (x x)
@cnt_node = (lm ((a b) o))
  & lm ~ {l1 l2}
  & @cnt ~ (a (l1 x))
  & @cnt ~ (b (l2 y))
  & x ~ $([+] $(y o))

// ins(t, k, L): set leaf k to 1. Control flow depends on k and L only, so it expands before t exists.
@ins = (t (k (L o)))
  & L ~ ?((@ins_leaf @ins_node) (t (k o)))
@ins_leaf = (* (* 1))
@ins_node = (lm (t (k o)))
  & k ~ {k1 k2}
  & lm ~ {l1 l2}
  & k1 ~ $([>>] $(l1 sh))
  & sh ~ $([&] $(1 b))
  & b ~ ?((@ins_L @ins_R) (t (k2 (l2 o))))
@ins_L = ((l r) (k (L (l2 r))))
  & @ins ~ (l (k (L l2)))
@ins_R = (* ((l r) (k (L (l r2)))))
  & @ins ~ (r (k (L r2)))
