@prog = (input output)
  & input ~ (a b)
  & @mul ~ (a (b raw))
  & @trim ~ (raw output)

@mul = (lv1 (b out))
  & @mul_cons_lw ~ (lv1 (b out))

@mul_nil = (p (b out))
  & p ~ *
  & b ~ *
  & out ~ (0 *)

@mul_cons = (* ((h t) ({b1 b2} out)))
  & @mdigit ~ (b2 (h (0 row)))
  & @add ~ (row ((1 (0 mid)) (0 out)))
  & @mul_cons_lw ~ (t (b1 mid))

@mdigit = (lv2 (d (c out)))
  & @md_cons_lw ~ (lv2 (d (c out)))

@md_nil = (p (d (c out)))
  & p ~ *
  & d ~ *
  & out ~ (1 (c (0 *)))

@md_cons = (* (($([*] $(d1 $([+] $(c {$([%] $(4096 digit)) $([/] $(4096 c2))})))) xs) ({d1 d2} (c (1 (digit tail))))))
  & @md_cons_lw ~ (xs (d2 (c2 tail)))

@add = ((?((@add_xnil @add_xcons) (p (y (c out)))) p) (y (c out)))

@add_xnil = (p (y (c out)))
  & p ~ *
  & @add0 ~ (y (c out))

@add_xcons = (* ((xh xt) (y (c out))))
  & @add_y ~ (y (xh (xt (c out))))

@add_y = ((?((@add_y_nil @add_y_cons) (p (xh (xt (c out))))) p) (xh (xt (c out))))

@add_y_nil = (p (xh (xt (c out))))
  & p ~ *
  & @addstep ~ (xh (0 (c (digit c2))))
  & @add ~ (xt ((0 *) (c2 tail)))
  & out ~ (1 (digit tail))

@add_y_cons = (* ((yh yt) (xh (xt (c out)))))
  & @addstep ~ (xh (yh (c (digit c2))))
  & @add ~ (xt (yt (c2 tail)))
  & out ~ (1 (digit tail))

@add0 = (lv3 (c out))
  & @add0_cons_lw ~ (lv3 (c out))

@add0_nil = (p (c out))
  & p ~ *
  & out ~ (1 (c (0 *)))

@add0_cons = (* ((yh yt) (c (1 (digit tail)))))
  & @addstep ~ (0 (yh (c (digit c2))))
  & @add0_cons_lw ~ (yt (c2 tail))

@addstep = (x (y (c (digit carry))))
  & x ~ $([+] $(y $([+] $(c v))))
  & v ~ {v1 v2}
  & v1 ~ $([%] $(4096 digit))
  & v2 ~ $([/] $(4096 carry))

@trim = (lv4 out)
  & @trim_cons_lw ~ (lv4 out)

@trim_nil = (p out)
  & p ~ *
  & out ~ (0 *)

@trim_cons = (* ((h t) out))
  & @trim_join ~ (q (h out))
  & @trim_cons_lw ~ (t q)

@trim_join = ((?((@tj_nil @tj_cons) (p (h out))) p) (h out))

@tj_nil = (p (h out))
  & p ~ *
  & h ~ {h1 h2}
  & h1 ~ $([=] $(0 z))
  & z ~ ?((@trim_keep @trim_drop) (h2 out))

@tj_cons = (* ((qh qt) (h out)))
  & out ~ (1 (h (1 (qh qt))))

@trim_keep = (h out)
  & out ~ (1 (h (0 *)))

@trim_drop = (* (h out))
  & h ~ *
  & out ~ (0 *)

@mul_cons_lw = (ls54 (q34 q35))
  & ls54 ~ (g49 (e45 (g50 (e46 (g51 (e47 (g52 (e48 tk53))))))))
  & g49 ~ ?((@mul_nil @mul_cons_la) ((e45 (q37 q38)) (q34 q35)))
  & g50 ~ ?((@mul_nil @mul_cons_la) ((e46 (q40 q41)) (q37 q38)))
  & g51 ~ ?((@mul_nil @mul_cons_la) ((e47 (q43 q44)) (q40 q41)))
  & g52 ~ ?((@mul_nil @mul_cons) ((e48 tk53) (q43 q44)))

@md_cons_lw = (ls80 (q56 (q57 q58)))
  & ls80 ~ (g75 (e71 (g76 (e72 (g77 (e73 (g78 (e74 tk79))))))))
  & g75 ~ ?((@md_nil @md_cons_la) ((e71 (q60 (q61 q62))) (q56 (q57 q58))))
  & g76 ~ ?((@md_nil @md_cons_la) ((e72 (q64 (q65 q66))) (q60 (q61 q62))))
  & g77 ~ ?((@md_nil @md_cons_la) ((e73 (q68 (q69 q70))) (q64 (q65 q66))))
  & g78 ~ ?((@md_nil @md_cons) ((e74 tk79) (q68 (q69 q70))))

@add0_cons_lw = (ls102 (q82 q83))
  & ls102 ~ (g97 (e93 (g98 (e94 (g99 (e95 (g100 (e96 tk101))))))))
  & g97 ~ ?((@add0_nil @add0_cons_la) ((e93 (q85 q86)) (q82 q83)))
  & g98 ~ ?((@add0_nil @add0_cons_la) ((e94 (q88 q89)) (q85 q86)))
  & g99 ~ ?((@add0_nil @add0_cons_la) ((e95 (q91 q92)) (q88 q89)))
  & g100 ~ ?((@add0_nil @add0_cons) ((e96 tk101) (q91 q92)))

@trim_cons_lw = (ls120 q104)
  & ls120 ~ (g115 (e111 (g116 (e112 (g117 (e113 (g118 (e114 tk119))))))))
  & g115 ~ ?((@trim_nil @trim_cons_la) ((e111 q106) q104))
  & g116 ~ ?((@trim_nil @trim_cons_la) ((e112 q108) q106))
  & g117 ~ ?((@trim_nil @trim_cons_la) ((e113 q110) q108))
  & g118 ~ ?((@trim_nil @trim_cons) ((e114 tk119) q110))

@mul_cons_la = (* ((h (b1 mid)) ({b1 b2} out)))
  & @mdigit ~ (b2 (h (0 row)))
  & @add ~ (row ((1 (0 mid)) (0 out)))

@md_cons_la = (* (($([*] $(d1 $([+] $(c {$([%] $(4096 digit)) $([/] $(4096 c2))})))) (d2 (c2 tail))) ({d1 d2} (c (1 (digit tail))))))

@add0_cons_la = (* ((yh (c2 tail)) (c (1 (digit tail)))))
  & @addstep ~ (0 (yh (c (digit c2))))

@trim_cons_la = (* ((h q) out))
  & @trim_join ~ (q (h out))
