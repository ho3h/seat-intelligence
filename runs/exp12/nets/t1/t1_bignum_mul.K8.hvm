@prog = (input output)
  & input ~ (a b)
  & @mul ~ (a (b raw))
  & @trim ~ (raw output)

@mul = (lv1 (b out))
  & @mul_cons_lw ~ (lv1 (b out))

@mul_nil = (p (b out))
  & p ~ *
  & b ~ *
  & out ~ (0 *)

@mul_cons = (* ((h t) ({b1 b2} out)))
  & @mdigit ~ (b2 (h (0 row)))
  & @add ~ (row ((1 (0 mid)) (0 out)))
  & @mul_cons_lw ~ (t (b1 mid))

@mdigit = (lv2 (d (c out)))
  & @md_cons_lw ~ (lv2 (d (c out)))

@md_nil = (p (d (c out)))
  & p ~ *
  & d ~ *
  & out ~ (1 (c (0 *)))

@md_cons = (* (($([*] $(d1 $([+] $(c {$([%] $(4096 digit)) $([/] $(4096 c2))})))) xs) ({d1 d2} (c (1 (digit tail))))))
  & @md_cons_lw ~ (xs (d2 (c2 tail)))

@add = ((?((@add_xnil @add_xcons) (p (y (c out)))) p) (y (c out)))

@add_xnil = (p (y (c out)))
  & p ~ *
  & @add0 ~ (y (c out))

@add_xcons = (* ((xh xt) (y (c out))))
  & @add_y ~ (y (xh (xt (c out))))

@add_y = ((?((@add_y_nil @add_y_cons) (p (xh (xt (c out))))) p) (xh (xt (c out))))

@add_y_nil = (p (xh (xt (c out))))
  & p ~ *
  & @addstep ~ (xh (0 (c (digit c2))))
  & @add ~ (xt ((0 *) (c2 tail)))
  & out ~ (1 (digit tail))

@add_y_cons = (* ((yh yt) (xh (xt (c out)))))
  & @addstep ~ (xh (yh (c (digit c2))))
  & @add ~ (xt (yt (c2 tail)))
  & out ~ (1 (digit tail))

@add0 = (lv3 (c out))
  & @add0_cons_lw ~ (lv3 (c out))

@add0_nil = (p (c out))
  & p ~ *
  & out ~ (1 (c (0 *)))

@add0_cons = (* ((yh yt) (c (1 (digit tail)))))
  & @addstep ~ (0 (yh (c (digit c2))))
  & @add0_cons_lw ~ (yt (c2 tail))

@addstep = (x (y (c (digit carry))))
  & x ~ $([+] $(y $([+] $(c v))))
  & v ~ {v1 v2}
  & v1 ~ $([%] $(4096 digit))
  & v2 ~ $([/] $(4096 carry))

@trim = (lv4 out)
  & @trim_cons_lw ~ (lv4 out)

@trim_nil = (p out)
  & p ~ *
  & out ~ (0 *)

@trim_cons = (* ((h t) out))
  & @trim_join ~ (q (h out))
  & @trim_cons_lw ~ (t q)

@trim_join = ((?((@tj_nil @tj_cons) (p (h out))) p) (h out))

@tj_nil = (p (h out))
  & p ~ *
  & h ~ {h1 h2}
  & h1 ~ $([=] $(0 z))
  & z ~ ?((@trim_keep @trim_drop) (h2 out))

@tj_cons = (* ((qh qt) (h out)))
  & out ~ (1 (h (1 (qh qt))))

@trim_keep = (h out)
  & out ~ (1 (h (0 *)))

@trim_drop = (* (h out))
  & h ~ *
  & out ~ (0 *)

@mul_cons_lw = (ls74 (q34 q35))
  & ls74 ~ (g65 (e57 (g66 (e58 (g67 (e59 (g68 (e60 (g69 (e61 (g70 (e62 (g71 (e63 (g72 (e64 tk73))))))))))))))))
  & g65 ~ ?((@mul_nil @mul_cons_la) ((e57 (q37 q38)) (q34 q35)))
  & g66 ~ ?((@mul_nil @mul_cons_la) ((e58 (q40 q41)) (q37 q38)))
  & g67 ~ ?((@mul_nil @mul_cons_la) ((e59 (q43 q44)) (q40 q41)))
  & g68 ~ ?((@mul_nil @mul_cons_la) ((e60 (q46 q47)) (q43 q44)))
  & g69 ~ ?((@mul_nil @mul_cons_la) ((e61 (q49 q50)) (q46 q47)))
  & g70 ~ ?((@mul_nil @mul_cons_la) ((e62 (q52 q53)) (q49 q50)))
  & g71 ~ ?((@mul_nil @mul_cons_la) ((e63 (q55 q56)) (q52 q53)))
  & g72 ~ ?((@mul_nil @mul_cons) ((e64 tk73) (q55 q56)))

@md_cons_lw = (ls124 (q76 (q77 q78)))
  & ls124 ~ (g115 (e107 (g116 (e108 (g117 (e109 (g118 (e110 (g119 (e111 (g120 (e112 (g121 (e113 (g122 (e114 tk123))))))))))))))))
  & g115 ~ ?((@md_nil @md_cons_la) ((e107 (q80 (q81 q82))) (q76 (q77 q78))))
  & g116 ~ ?((@md_nil @md_cons_la) ((e108 (q84 (q85 q86))) (q80 (q81 q82))))
  & g117 ~ ?((@md_nil @md_cons_la) ((e109 (q88 (q89 q90))) (q84 (q85 q86))))
  & g118 ~ ?((@md_nil @md_cons_la) ((e110 (q92 (q93 q94))) (q88 (q89 q90))))
  & g119 ~ ?((@md_nil @md_cons_la) ((e111 (q96 (q97 q98))) (q92 (q93 q94))))
  & g120 ~ ?((@md_nil @md_cons_la) ((e112 (q100 (q101 q102))) (q96 (q97 q98))))
  & g121 ~ ?((@md_nil @md_cons_la) ((e113 (q104 (q105 q106))) (q100 (q101 q102))))
  & g122 ~ ?((@md_nil @md_cons) ((e114 tk123) (q104 (q105 q106))))

@add0_cons_lw = (ls166 (q126 q127))
  & ls166 ~ (g157 (e149 (g158 (e150 (g159 (e151 (g160 (e152 (g161 (e153 (g162 (e154 (g163 (e155 (g164 (e156 tk165))))))))))))))))
  & g157 ~ ?((@add0_nil @add0_cons_la) ((e149 (q129 q130)) (q126 q127)))
  & g158 ~ ?((@add0_nil @add0_cons_la) ((e150 (q132 q133)) (q129 q130)))
  & g159 ~ ?((@add0_nil @add0_cons_la) ((e151 (q135 q136)) (q132 q133)))
  & g160 ~ ?((@add0_nil @add0_cons_la) ((e152 (q138 q139)) (q135 q136)))
  & g161 ~ ?((@add0_nil @add0_cons_la) ((e153 (q141 q142)) (q138 q139)))
  & g162 ~ ?((@add0_nil @add0_cons_la) ((e154 (q144 q145)) (q141 q142)))
  & g163 ~ ?((@add0_nil @add0_cons_la) ((e155 (q147 q148)) (q144 q145)))
  & g164 ~ ?((@add0_nil @add0_cons) ((e156 tk165) (q147 q148)))

@trim_cons_lw = (ls200 q168)
  & ls200 ~ (g191 (e183 (g192 (e184 (g193 (e185 (g194 (e186 (g195 (e187 (g196 (e188 (g197 (e189 (g198 (e190 tk199))))))))))))))))
  & g191 ~ ?((@trim_nil @trim_cons_la) ((e183 q170) q168))
  & g192 ~ ?((@trim_nil @trim_cons_la) ((e184 q172) q170))
  & g193 ~ ?((@trim_nil @trim_cons_la) ((e185 q174) q172))
  & g194 ~ ?((@trim_nil @trim_cons_la) ((e186 q176) q174))
  & g195 ~ ?((@trim_nil @trim_cons_la) ((e187 q178) q176))
  & g196 ~ ?((@trim_nil @trim_cons_la) ((e188 q180) q178))
  & g197 ~ ?((@trim_nil @trim_cons_la) ((e189 q182) q180))
  & g198 ~ ?((@trim_nil @trim_cons) ((e190 tk199) q182))

@mul_cons_la = (* ((h (b1 mid)) ({b1 b2} out)))
  & @mdigit ~ (b2 (h (0 row)))
  & @add ~ (row ((1 (0 mid)) (0 out)))

@md_cons_la = (* (($([*] $(d1 $([+] $(c {$([%] $(4096 digit)) $([/] $(4096 c2))})))) (d2 (c2 tail))) ({d1 d2} (c (1 (digit tail))))))

@add0_cons_la = (* ((yh (c2 tail)) (c (1 (digit tail)))))
  & @addstep ~ (0 (yh (c (digit c2))))

@trim_cons_la = (* ((h q) out))
  & @trim_join ~ (q (h out))
