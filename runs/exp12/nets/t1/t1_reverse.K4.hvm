@prog = (l out)
  & @rev ~ (l ((0 *) out))

@rev = (lv1 (acc out))
  & @rev_cons_lw ~ (lv1 (acc out))

@rev_nil = (* (a a))

@rev_cons = (* ((h t) (acc out)))
  & @rev_cons_lw ~ (t ((1 (h acc)) out))

@rev_cons_lw = (ls30 (q10 q11))
  & ls30 ~ (g25 (e21 (g26 (e22 (g27 (e23 (g28 (e24 tk29))))))))
  & g25 ~ ?((@rev_nil @rev_cons_la) ((e21 (q13 q14)) (q10 q11)))
  & g26 ~ ?((@rev_nil @rev_cons_la) ((e22 (q16 q17)) (q13 q14)))
  & g27 ~ ?((@rev_nil @rev_cons_la) ((e23 (q19 q20)) (q16 q17)))
  & g28 ~ ?((@rev_nil @rev_cons) ((e24 tk29) (q19 q20)))

@rev_cons_la = (* ((h ((1 (h acc)) out)) (acc out)))
