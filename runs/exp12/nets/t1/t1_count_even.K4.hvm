@prog = (l out)
  & @ce ~ (l out)

@ce = (lv1 out)
  & @ce_cons_lw ~ (lv1 out)

@ce_nil = (* out)
  & out ~ 0

@ce_cons = (* ((h1 lv2) out))
  & @ce_more_lw ~ (lv2 (h1 out))

@ce_last = (* (h1 out))
  & h1 ~ $([&] $(1 p))
  & p ~ $([^] $(1 out))

@ce_more = (* (($([&] $(1 $([^] $(1 i2)))) t2) ($([&] $(1 $([^] $(1 $([+] $(i2 pairinc)))))) out)))
  & @ce_cons_lw ~ (t2 $([+] $(pairinc out)))

@ce_cons_lw = (ls31 q13)
  & ls31 ~ (g26 (e22 (g27 (e23 (g28 (e24 (g29 (e25 tk30))))))))
  & g26 ~ ?((@ce_nil @ce_cons_la) ((e22 (q15 q16)) q13))
  & g27 ~ ?((@ce_last @ce_more_la) ((e23 q18) (q15 q16)))
  & g28 ~ ?((@ce_nil @ce_cons_la) ((e24 (q20 q21)) q18))
  & g29 ~ ?((@ce_last @ce_more) ((e25 tk30) (q20 q21)))

@ce_more_lw = (ls51 (q33 q34))
  & ls51 ~ (g46 (e42 (g47 (e43 (g48 (e44 (g49 (e45 tk50))))))))
  & g46 ~ ?((@ce_last @ce_more_la) ((e42 q36) (q33 q34)))
  & g47 ~ ?((@ce_nil @ce_cons_la) ((e43 (q38 q39)) q36))
  & g48 ~ ?((@ce_last @ce_more_la) ((e44 q41) (q38 q39)))
  & g49 ~ ?((@ce_nil @ce_cons) ((e45 tk50) q41))

@ce_cons_la = (* ((h1 (h1 out)) out))

@ce_more_la = (* (($([&] $(1 $([^] $(1 i2)))) $([+] $(pairinc out))) ($([&] $(1 $([^] $(1 $([+] $(i2 pairinc)))))) out)))
