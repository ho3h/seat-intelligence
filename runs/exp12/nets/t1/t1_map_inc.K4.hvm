@prog = (l out)
  & @mi ~ (l out)

@mi = (lv1 out)
  & @mi_cons_lw ~ (lv1 out)

@mi_nil = (* (0 *))

@mi_cons = (* (($([+1] hp) lv2) (1 (hp outt))))
  & @mi_cons_lw ~ (lv2 outt)

@mi_cons_lw = (ls23 q7)
  & ls23 ~ (g18 (e14 (g19 (e15 (g20 (e16 (g21 (e17 tk22))))))))
  & g18 ~ ?((@mi_nil @mi_cons_la) ((e14 q9) q7))
  & g19 ~ ?((@mi_nil @mi_cons_la) ((e15 q11) q9))
  & g20 ~ ?((@mi_nil @mi_cons_la) ((e16 q13) q11))
  & g21 ~ ?((@mi_nil @mi_cons) ((e17 tk22) q13))

@mi_cons_la = (* (($([+1] hp) outt) (1 (hp outt))))
