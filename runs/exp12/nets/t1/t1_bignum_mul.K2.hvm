@prog = (input output)
  & input ~ (a b)
  & @mul ~ (a (b raw))
  & @trim ~ (raw output)

@mul = (lv1 (b out))
  & @mul_cons_lw ~ (lv1 (b out))

@mul_nil = (p (b out))
  & p ~ *
  & b ~ *
  & out ~ (0 *)

@mul_cons = (* ((h t) ({b1 b2} out)))
  & @mdigit ~ (b2 (h (0 row)))
  & @add ~ (row ((1 (0 mid)) (0 out)))
  & @mul_cons_lw ~ (t (b1 mid))

@mdigit = (lv2 (d (c out)))
  & @md_cons_lw ~ (lv2 (d (c out)))

@md_nil = (p (d (c out)))
  & p ~ *
  & d ~ *
  & out ~ (1 (c (0 *)))

@md_cons = (* (($([*] $(d1 $([+] $(c {$([%] $(4096 digit)) $([/] $(4096 c2))})))) xs) ({d1 d2} (c (1 (digit tail))))))
  & @md_cons_lw ~ (xs (d2 (c2 tail)))

@add = ((?((@add_xnil @add_xcons) (p (y (c out)))) p) (y (c out)))

@add_xnil = (p (y (c out)))
  & p ~ *
  & @add0 ~ (y (c out))

@add_xcons = (* ((xh xt) (y (c out))))
  & @add_y ~ (y (xh (xt (c out))))

@add_y = ((?((@add_y_nil @add_y_cons) (p (xh (xt (c out))))) p) (xh (xt (c out))))

@add_y_nil = (p (xh (xt (c out))))
  & p ~ *
  & @addstep ~ (xh (0 (c (digit c2))))
  & @add ~ (xt ((0 *) (c2 tail)))
  & out ~ (1 (digit tail))

@add_y_cons = (* ((yh yt) (xh (xt (c out)))))
  & @addstep ~ (xh (yh (c (digit c2))))
  & @add ~ (xt (yt (c2 tail)))
  & out ~ (1 (digit tail))

@add0 = (lv3 (c out))
  & @add0_cons_lw ~ (lv3 (c out))

@add0_nil = (p (c out))
  & p ~ *
  & out ~ (1 (c (0 *)))

@add0_cons = (* ((yh yt) (c (1 (digit tail)))))
  & @addstep ~ (0 (yh (c (digit c2))))
  & @add0_cons_lw ~ (yt (c2 tail))

@addstep = (x (y (c (digit carry))))
  & x ~ $([+] $(y $([+] $(c v))))
  & v ~ {v1 v2}
  & v1 ~ $([%] $(4096 digit))
  & v2 ~ $([/] $(4096 carry))

@trim = (lv4 out)
  & @trim_cons_lw ~ (lv4 out)

@trim_nil = (p out)
  & p ~ *
  & out ~ (0 *)

@trim_cons = (* ((h t) out))
  & @trim_join ~ (q (h out))
  & @trim_cons_lw ~ (t q)

@trim_join = ((?((@tj_nil @tj_cons) (p (h out))) p) (h out))

@tj_nil = (p (h out))
  & p ~ *
  & h ~ {h1 h2}
  & h1 ~ $([=] $(0 z))
  & z ~ ?((@trim_keep @trim_drop) (h2 out))

@tj_cons = (* ((qh qt) (h out)))
  & out ~ (1 (h (1 (qh qt))))

@trim_keep = (h out)
  & out ~ (1 (h (0 *)))

@trim_drop = (* (h out))
  & h ~ *
  & out ~ (0 *)

@mul_cons_lw = (ls44 (q34 q35))
  & ls44 ~ (g41 (e39 (g42 (e40 tk43))))
  & g41 ~ ?((@mul_nil @mul_cons_la) ((e39 (q37 q38)) (q34 q35)))
  & g42 ~ ?((@mul_nil @mul_cons) ((e40 tk43) (q37 q38)))

@md_cons_lw = (ls58 (q46 (q47 q48)))
  & ls58 ~ (g55 (e53 (g56 (e54 tk57))))
  & g55 ~ ?((@md_nil @md_cons_la) ((e53 (q50 (q51 q52))) (q46 (q47 q48))))
  & g56 ~ ?((@md_nil @md_cons) ((e54 tk57) (q50 (q51 q52))))

@add0_cons_lw = (ls70 (q60 q61))
  & ls70 ~ (g67 (e65 (g68 (e66 tk69))))
  & g67 ~ ?((@add0_nil @add0_cons_la) ((e65 (q63 q64)) (q60 q61)))
  & g68 ~ ?((@add0_nil @add0_cons) ((e66 tk69) (q63 q64)))

@trim_cons_lw = (ls80 q72)
  & ls80 ~ (g77 (e75 (g78 (e76 tk79))))
  & g77 ~ ?((@trim_nil @trim_cons_la) ((e75 q74) q72))
  & g78 ~ ?((@trim_nil @trim_cons) ((e76 tk79) q74))

@mul_cons_la = (* ((h (b1 mid)) ({b1 b2} out)))
  & @mdigit ~ (b2 (h (0 row)))
  & @add ~ (row ((1 (0 mid)) (0 out)))

@md_cons_la = (* (($([*] $(d1 $([+] $(c {$([%] $(4096 digit)) $([/] $(4096 c2))})))) (d2 (c2 tail))) ({d1 d2} (c (1 (digit tail))))))

@add0_cons_la = (* ((yh (c2 tail)) (c (1 (digit tail)))))
  & @addstep ~ (0 (yh (c (digit c2))))

@trim_cons_la = (* ((h q) out))
  & @trim_join ~ (q (h out))
