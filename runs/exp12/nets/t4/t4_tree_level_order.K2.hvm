@prog = (input out)
  & @bfs ~ ((1 (input (0 *))) ((0 *) out))

@bfs = ((?((@bfs_empty @bfs_cons) (payload (rear out))) payload) (rear out))

@bfs_empty = (* ((?((@normal_nil @normal_cons) (payload out)) payload) out))

@bfs_cons = (* (((?((@visit_leaf @visit_node) (payload (tail (rear out)))) payload) tail) (rear out)))

@visit_leaf = (* (tail (rear out)))
  & @bfs ~ (tail (rear out))

@visit_node = (* ((left (value right)) (tail (rear out))))
  & out ~ (1 (value out2))
  & @bfs ~ (tail ((1 (right (1 (left rear)))) out2))

@normal_nil = (* out)
  & out ~ (0 *)

@normal_cons = (* ((head tail) out))
  & @rev ~ ((1 (head tail)) ((0 *) front))
  & @bfs ~ (front ((0 *) out))

@rev = (lv1 (acc out))
  & @rev_cons_lw ~ (lv1 (acc out))

@rev_nil = (* (x x))

@rev_cons = (* ((head tail) (acc out)))
  & @rev_cons_lw ~ (tail ((1 (head acc)) out))

@rev_cons_lw = (ls20 (q10 q11))
  & ls20 ~ (g17 (e15 (g18 (e16 tk19))))
  & g17 ~ ?((@rev_nil @rev_cons_la) ((e15 (q13 q14)) (q10 q11)))
  & g18 ~ ?((@rev_nil @rev_cons) ((e16 tk19) (q13 q14)))

@rev_cons_la = (* ((head ((1 (head acc)) out)) (acc out)))
