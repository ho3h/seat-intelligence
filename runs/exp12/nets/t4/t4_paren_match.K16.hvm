@prog = (input output)
  & @many ~ (input (0 result))
  & result ~ (output (idx (rest close)))
  & idx ~ *
  & rest ~ *
  & close ~ *

@many = ((?((@many_nil @many_cons) (p (idx out))) p) (idx out))

@many_nil = (* (idx out))
  & out ~ ((0 *) (idx ((0 *) 0)))

@many_cons = (* ((h t) (idx out)))
  & h ~ $([=] $(40 z))
  & z ~ ?((@many_close @many_open) (t (idx out)))

@many_close = (t (idx out))
  & idx ~ {keep step}
  & step ~ $([+1] next)
  & out ~ ((0 *) (next (t keep)))

@many_open = (* (t (idx out)))
  & idx ~ {open_ix step}
  & step ~ $([+1] start)
  & @many ~ (t (start inner))
  & inner ~ (inside (after_open (rest close)))
  & @many ~ (rest (after_open suffix))
  & suffix ~ (after (final_idx (final_rest final_close)))
  & @append ~ (inside ((1 (open_ix after)) merged))
  & out ~ ((1 (close merged)) (final_idx (final_rest final_close)))

@append = (lv1 (b out))
  & @ap_cons_lw ~ (lv1 (b out))

@ap_nil = (* (b out))
  & out ~ b

@ap_cons = (* ((h t) (b (1 (h tail)))))
  & @ap_cons_lw ~ (t (b tail))

@ap_cons_lw = (ls90 (q10 q11))
  & ls90 ~ (g73 (e57 (g74 (e58 (g75 (e59 (g76 (e60 (g77 (e61 (g78 (e62 (g79 (e63 (g80 (e64 (g81 (e65 (g82 (e66 (g83 (e67 (g84 (e68 (g85 (e69 (g86 (e70 (g87 (e71 (g88 (e72 tk89))))))))))))))))))))))))))))))))
  & g73 ~ ?((@ap_nil @ap_cons_la) ((e57 (q13 q14)) (q10 q11)))
  & g74 ~ ?((@ap_nil @ap_cons_la) ((e58 (q16 q17)) (q13 q14)))
  & g75 ~ ?((@ap_nil @ap_cons_la) ((e59 (q19 q20)) (q16 q17)))
  & g76 ~ ?((@ap_nil @ap_cons_la) ((e60 (q22 q23)) (q19 q20)))
  & g77 ~ ?((@ap_nil @ap_cons_la) ((e61 (q25 q26)) (q22 q23)))
  & g78 ~ ?((@ap_nil @ap_cons_la) ((e62 (q28 q29)) (q25 q26)))
  & g79 ~ ?((@ap_nil @ap_cons_la) ((e63 (q31 q32)) (q28 q29)))
  & g80 ~ ?((@ap_nil @ap_cons_la) ((e64 (q34 q35)) (q31 q32)))
  & g81 ~ ?((@ap_nil @ap_cons_la) ((e65 (q37 q38)) (q34 q35)))
  & g82 ~ ?((@ap_nil @ap_cons_la) ((e66 (q40 q41)) (q37 q38)))
  & g83 ~ ?((@ap_nil @ap_cons_la) ((e67 (q43 q44)) (q40 q41)))
  & g84 ~ ?((@ap_nil @ap_cons_la) ((e68 (q46 q47)) (q43 q44)))
  & g85 ~ ?((@ap_nil @ap_cons_la) ((e69 (q49 q50)) (q46 q47)))
  & g86 ~ ?((@ap_nil @ap_cons_la) ((e70 (q52 q53)) (q49 q50)))
  & g87 ~ ?((@ap_nil @ap_cons_la) ((e71 (q55 q56)) (q52 q53)))
  & g88 ~ ?((@ap_nil @ap_cons) ((e72 tk89) (q55 q56)))

@ap_cons_la = (* ((h (b tail)) (b (1 (h tail)))))
