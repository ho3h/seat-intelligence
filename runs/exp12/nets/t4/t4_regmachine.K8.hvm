@prog = (input out)
  & @run ~ (input ((0 (0 (0 (0 0)))) out))

@run = (lv1 c)
  & @run_cons_lw ~ (lv1 c)

@run_nil = (payload (regs out))
  & payload ~ *
  & @emit ~ (regs out)

@run_cons = (* ((instr tail) (regs out)))
  & @step ~ (instr (regs next))
  & @run_cons_lw ~ (tail (next out))

@step = (instr (regs out))
  & instr ~ (op (a b))
  & @dispatch ~ (op (a (b (regs out))))

@dispatch = (?((@step0 @stepS) c) c)

@step0 = (a (b (regs out)))
  & @set ~ (a (b (regs out)))

@stepS = (?((@step1 @stepS2) c) c)

@stepS2 = (?((@step2 @stepS3) c) c)

@stepS3 = (?((@step3 @step4) c) c)

@step1 = (a (b (regs out)))
  & @add ~ (a (b (regs out)))

@step2 = (a (b (regs out)))
  & @sub ~ (a (b (regs out)))

@step3 = (a (b (regs out)))
  & @mul ~ (a (b (regs out)))

@step4 = (z (a (b (regs out))))
  & z ~ *
  & @mov ~ (a (b (regs out)))

@get = (?((@get0 @getS) c) c)

@get0 = (regs out)
  & regs ~ (r0 rest)
  & r0 ~ out
  & rest ~ *

@getS = (n (regs out))
  & regs ~ (r0 rest)
  & r0 ~ *
  & @get ~ (n (rest out))

@set = (?((@set0 @setS) c) c)

@set0 = (val (regs out))
  & regs ~ (r0 rest)
  & r0 ~ *
  & out ~ (val rest)

@setS = (n (val (regs out)))
  & regs ~ (r0 rest)
  & @set ~ (n (val (rest tail)))
  & out ~ (r0 tail)

@add = (a (b (regs out)))
  & a ~ {ag as}
  & regs ~ {pair keep}
  & pair ~ {left right}
  & @get ~ (ag (left av))
  & @get ~ (b (right bv))
  & av ~ $([+] $(bv val))
  & @set ~ (as (val (keep out)))

@sub = (a (b (regs out)))
  & a ~ {ag as}
  & regs ~ {pair keep}
  & pair ~ {left right}
  & @get ~ (ag (left av))
  & @get ~ (b (right bv))
  & av ~ $([-] $(bv val))
  & @set ~ (as (val (keep out)))

@mul = (a (b (regs out)))
  & a ~ {ag as}
  & regs ~ {pair keep}
  & pair ~ {left right}
  & @get ~ (ag (left av))
  & @get ~ (b (right bv))
  & av ~ $([*] $(bv val))
  & @set ~ (as (val (keep out)))

@mov = (a (b (regs out)))
  & regs ~ {source keep}
  & @get ~ (b (source val))
  & @set ~ (a (val (keep out)))

@emit = (regs out)
  & regs ~ (r0 rest1)
  & rest1 ~ (r1 rest2)
  & rest2 ~ (r2 rest3)
  & rest3 ~ (r3 sentinel)
  & sentinel ~ *
  & out ~ (1 (r0 (1 (r1 (1 (r2 (1 (r3 (0 *)))))))))

@run_cons_lw = (ls40 q8)
  & ls40 ~ (g31 (e23 (g32 (e24 (g33 (e25 (g34 (e26 (g35 (e27 (g36 (e28 (g37 (e29 (g38 (e30 tk39))))))))))))))))
  & g31 ~ ?((@run_nil @run_cons_la) ((e23 q10) q8))
  & g32 ~ ?((@run_nil @run_cons_la) ((e24 q12) q10))
  & g33 ~ ?((@run_nil @run_cons_la) ((e25 q14) q12))
  & g34 ~ ?((@run_nil @run_cons_la) ((e26 q16) q14))
  & g35 ~ ?((@run_nil @run_cons_la) ((e27 q18) q16))
  & g36 ~ ?((@run_nil @run_cons_la) ((e28 q20) q18))
  & g37 ~ ?((@run_nil @run_cons_la) ((e29 q22) q20))
  & g38 ~ ?((@run_nil @run_cons) ((e30 tk39) q22))

@run_cons_la = (* ((instr (next out)) (regs out)))
  & @step ~ (instr (regs next))
