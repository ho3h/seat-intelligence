@prog = (input out)
  & @bfs ~ ((1 (input (0 *))) ((0 *) out))

@bfs = ((?((@bfs_empty @bfs_cons) (payload (rear out))) payload) (rear out))

@bfs_empty = (* ((?((@normal_nil @normal_cons) (payload out)) payload) out))

@bfs_cons = (* (((?((@visit_leaf @visit_node) (payload (tail (rear out)))) payload) tail) (rear out)))

@visit_leaf = (* (tail (rear out)))
  & @bfs ~ (tail (rear out))

@visit_node = (* ((left (value right)) (tail (rear out))))
  & out ~ (1 (value out2))
  & @bfs ~ (tail ((1 (right (1 (left rear)))) out2))

@normal_nil = (* out)
  & out ~ (0 *)

@normal_cons = (* ((head tail) out))
  & @rev ~ ((1 (head tail)) ((0 *) front))
  & @bfs ~ (front ((0 *) out))

@rev = (lv1 (acc out))
  & @rev_cons_lw ~ (lv1 (acc out))

@rev_nil = (* (x x))

@rev_cons = (* ((head tail) (acc out)))
  & @rev_cons_lw ~ (tail ((1 (head acc)) out))

@rev_cons_lw = (ls50 (q10 q11))
  & ls50 ~ (g41 (e33 (g42 (e34 (g43 (e35 (g44 (e36 (g45 (e37 (g46 (e38 (g47 (e39 (g48 (e40 tk49))))))))))))))))
  & g41 ~ ?((@rev_nil @rev_cons_la) ((e33 (q13 q14)) (q10 q11)))
  & g42 ~ ?((@rev_nil @rev_cons_la) ((e34 (q16 q17)) (q13 q14)))
  & g43 ~ ?((@rev_nil @rev_cons_la) ((e35 (q19 q20)) (q16 q17)))
  & g44 ~ ?((@rev_nil @rev_cons_la) ((e36 (q22 q23)) (q19 q20)))
  & g45 ~ ?((@rev_nil @rev_cons_la) ((e37 (q25 q26)) (q22 q23)))
  & g46 ~ ?((@rev_nil @rev_cons_la) ((e38 (q28 q29)) (q25 q26)))
  & g47 ~ ?((@rev_nil @rev_cons_la) ((e39 (q31 q32)) (q28 q29)))
  & g48 ~ ?((@rev_nil @rev_cons) ((e40 tk49) (q31 q32)))

@rev_cons_la = (* ((head ((1 (head acc)) out)) (acc out)))
