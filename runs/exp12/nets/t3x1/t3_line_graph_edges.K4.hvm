@prog = ((?((@lg_zero @lg_pos) (es out)) es) out)

@lg_zero = (* 0)

@lg_pos = (nm1 (es out))
  & @lg ~ (nm1 d)
  & d ~ {d1 d2}
  & @zt ~ (d1 t0)
  & @w_blk ~ (es ((d2 t0) out))

@le_step = ((d t) ((u v) (d3 t2)))
  & d ~ {d1 {d2 d3}}
  & @inc ~ (t (u (d1 t1)))
  & @inc ~ (t1 (v (d2 t2)))

@le_fin = ((d t) o)
  & @pairs ~ (t (d o))

@inc = (t (k (?((@inc_leaf @inc_node) (t (k o))) o)))

@inc_leaf = (x (* o))
  & x ~ $([+1] o)

@inc_node = (lm (t (k o)))
  & k ~ {k1 k2}
  & lm ~ {l1 l2}
  & k1 ~ $([>>] $(l1 sh))
  & sh ~ $([&] $(1 b))
  & b ~ ?((@inc_L @inc_R) (t (k2 (l2 o))))

@inc_L = ((l r) (k (L (l2 r))))
  & @inc ~ (l (k (L l2)))

@inc_R = (* ((l r) (k (L (l r2)))))
  & @inc ~ (r (k (L r2)))

@pairs = (t (?((@pairs_leaf @pairs_node) (t o)) o))

@pairs_leaf = (x o)
  & x ~ {x1 x2}
  & x1 ~ $([-] $(1 y))
  & x2 ~ $([*] $(y z))
  & z ~ $([>>] $(1 o))

@pairs_node = (lm ((a b) o))
  & lm ~ {l1 l2}
  & @pairs ~ (a (l1 x))
  & @pairs ~ (b (l2 y))
  & x ~ $([+] $(y o))

@w_blk = (lv1 (S0 o0))
  & @w_last_lw ~ (lv1 (S0 o0))

@w_nil = (S (o *))
  & @le_fin ~ (S o)

@w_cons = (* (S (o (E (S2 o)))))
  & @le_step ~ (S (E S2))

@w_last = (* (S (o (E t))))
  & @le_step ~ (S (E S2))
  & @w_last_lw ~ (t (S2 o))

@lg = (?((0 @lg_s) o) o)

@lg_s = (xm o)
  & xm ~ $([+1] x)
  & x ~ $([>>] $(1 y))
  & @lg ~ (y z)
  & z ~ $([+1] o)

@zt = (?((0 @zt_node) o) o)

@zt_node = (lm (a b))
  & lm ~ {l1 l2}
  & @zt ~ (l1 a)
  & @zt ~ (l2 b)

@cnt = (t (?((@cnt_leaf @cnt_node) (t o)) o))

@cnt_leaf = (x x)

@cnt_node = (lm ((a b) o))
  & lm ~ {l1 l2}
  & @cnt ~ (a (l1 x))
  & @cnt ~ (b (l2 y))
  & x ~ $([+] $(y o))

@ins = (t (k (?((@ins_leaf @ins_node) (t (k o))) o)))

@ins_leaf = (* (* 1))

@ins_node = (lm (t (k o)))
  & k ~ {k1 k2}
  & lm ~ {l1 l2}
  & k1 ~ $([>>] $(l1 sh))
  & sh ~ $([&] $(1 b))
  & b ~ ?((@ins_L @ins_R) (t (k2 (l2 o))))

@ins_L = ((l r) (k (L (l2 r))))
  & @ins ~ (l (k (L l2)))

@ins_R = (* ((l r) (k (L (l r2)))))
  & @ins ~ (r (k (L r2)))

@w_last_lw = (ls35 (q10 q11))
  & ls35 ~ (g30 (e26 (g31 (e27 (g32 (e28 (g33 (e29 tk34))))))))
  & g30 ~ ?((@w_nil @w_last_la) (q10 (q11 (e26 (q14 q15)))))
  & g31 ~ ?((@w_nil @w_last_la) (q14 (q15 (e27 (q18 q19)))))
  & g32 ~ ?((@w_nil @w_last_la) (q18 (q19 (e28 (q22 q23)))))
  & g33 ~ ?((@w_nil @w_last) (q22 (q23 (e29 tk34))))

@w_last_la = (* (S (o (E (S2 o)))))
  & @le_step ~ (S (E S2))
