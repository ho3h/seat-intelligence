@prog = ((?((@io_zero @io_pos) (es out)) es) out)

@io_zero = (* ((0 *) (0 *)))

@io_pos = (nm1 (es out))
  & nm1 ~ {a b}
  & a ~ $([+1] n)
  & @lg ~ (b L)
  & L ~ {L1 {L2 {L3 {L4 L5}}}}
  & n ~ {n1 n2}
  & @zt ~ (L1 I0)
  & @zt ~ (L2 O0)
  & @w_blk ~ (es ((L3 (I0 O0)) (If Of)))
  & @tl ~ (If (L4 (0 (n1 ((0 *) li)))))
  & @tl ~ (Of (L5 (0 (n2 ((0 *) lo)))))
  & out ~ (li lo)

@io_step = ((L (I O)) ((u v) (L3 (I2 O2))))
  & L ~ {L1 {L2 L3}}
  & @inc ~ (I (v (L1 I2)))
  & @inc ~ (O (u (L2 O2)))

@io_fin = ((* (I O)) (I O))

@w_blk = (lv1 (S0 o0))
  & @w_last_lw ~ (lv1 (S0 o0))

@w_nil = (S (o *))
  & @io_fin ~ (S o)

@w_cons = (* (S (o (E (S2 o)))))
  & @io_step ~ (S (E S2))

@w_last = (* (S (o (E t))))
  & @io_step ~ (S (E S2))
  & @w_last_lw ~ (t (S2 o))

@inc = (t (k (?((@inc_leaf @inc_node) (t (k o))) o)))

@inc_leaf = (x (* o))
  & x ~ $([+1] o)

@inc_node = (lm (t (k o)))
  & k ~ {k1 k2}
  & lm ~ {l1 l2}
  & k1 ~ $([>>] $(l1 sh))
  & sh ~ $([&] $(1 b))
  & b ~ ?((@inc_L @inc_R) (t (k2 (l2 o))))

@inc_L = ((l r) (k (L (l2 r))))
  & @inc ~ (l (k (L l2)))

@inc_R = (* ((l r) (k (L (l r2)))))
  & @inc ~ (r (k (L r2)))

@tl = (t (L (base (n (tail o)))))
  & L ~ ?((@tl_leaf @tl_node) (t (base (n (tail o)))))

@tl_leaf = (x (base (n (tail o))))
  & base ~ $([<] $(n keep))
  & keep ~ ?((@tl_drop @tl_keep) (x (tail o)))

@tl_drop = (* (t t))

@tl_keep = (* (x (t (1 (x t)))))

@tl_node = (lm ((a b) (base (n (tail o)))))
  & lm ~ {l1 {l2 l3}}
  & base ~ {b1 b2}
  & n ~ {n1 n2}
  & 1 ~ $([<<] $(l3 half))
  & b2 ~ $([+] $(half bR))
  & @tl ~ (a (l1 (b1 (n1 (mid o)))))
  & @tl ~ (b (l2 (bR (n2 (tail mid)))))

@lg = (?((0 @lg_s) o) o)

@lg_s = (xm o)
  & xm ~ $([+1] x)
  & x ~ $([>>] $(1 y))
  & @lg ~ (y z)
  & z ~ $([+1] o)

@zt = (?((0 @zt_node) o) o)

@zt_node = (lm (a b))
  & lm ~ {l1 l2}
  & @zt ~ (l1 a)
  & @zt ~ (l2 b)

@cnt = (t (?((@cnt_leaf @cnt_node) (t o)) o))

@cnt_leaf = (x x)

@cnt_node = (lm ((a b) o))
  & lm ~ {l1 l2}
  & @cnt ~ (a (l1 x))
  & @cnt ~ (b (l2 y))
  & x ~ $([+] $(y o))

@ins = (t (k (?((@ins_leaf @ins_node) (t (k o))) o)))

@ins_leaf = (* (* 1))

@ins_node = (lm (t (k o)))
  & k ~ {k1 k2}
  & lm ~ {l1 l2}
  & k1 ~ $([>>] $(l1 sh))
  & sh ~ $([&] $(1 b))
  & b ~ ?((@ins_L @ins_R) (t (k2 (l2 o))))

@ins_L = ((l r) (k (L (l2 r))))
  & @ins ~ (l (k (L l2)))

@ins_R = (* ((l r) (k (L (l r2)))))
  & @ins ~ (r (k (L r2)))

@w_last_lw = (ls23 (q10 q11))
  & ls23 ~ (g20 (e18 (g21 (e19 tk22))))
  & g20 ~ ?((@w_nil @w_last_la) (q10 (q11 (e18 (q14 q15)))))
  & g21 ~ ?((@w_nil @w_last) (q14 (q15 (e19 tk22))))

@w_last_la = (* (S (o (E (S2 o)))))
  & @io_step ~ (S (E S2))
