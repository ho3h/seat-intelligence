  & g101 ~ ?((@w_nil @w_last_la) (q51 (q52 (e85 (q55 q56)))))
  & g102 ~ ?((@w_nil @w_last_la) (q55 (q56 (e86 (q59 q60)))))
  & g103 ~ ?((@w_nil @w_last_la) (q59 (q60 (e87 (q63 q64)))))
  & g104 ~ ?((@w_nil @w_last_la) (q63 (q64 (e88 (q67 q68)))))
  & g105 ~ ?((@w_nil @w_last_la) (q67 (q68 (e89 (q71 q72)))))
