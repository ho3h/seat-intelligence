@prog = ((k xs) out)
  & @sort ~ (xs sorted)
  & @take ~ (k (sorted out))

@sort = (lv1 out)
  & @sort_cons_lw ~ (lv1 out)

@sort_nil = (pl out)
  & pl ~ *
  & out ~ (0 *)

@sort_cons = (* ((h t) out))
  & @insert ~ (h (sorted out))
  & @sort_cons_lw ~ (t sorted)

@insert = (x ((?((@ins_nil @ins_cons) (x (pl out))) pl) out))

@ins_nil = (x (pl out))
  & pl ~ *
  & out ~ (1 (x (0 *)))

@ins_cons = (* (x ((h t) out)))
  & x ~ {xc xk}
  & h ~ {hc hk}
  & xc ~ $([>] $(hc z))
  & z ~ ?((@ins_no @ins_yes) (xk (hk (t out))))

@ins_no = (x (h (t out)))
  & @insert ~ (x (t rest))
  & out ~ (1 (h rest))

@ins_yes = (* (x (h (t out))))
  & out ~ (1 (x (1 (h t))))

@take = (?((@take_zero @take_pos) ctx) ctx)

@take_zero = (xs out)
  & xs ~ *
  & out ~ (0 *)

@take_pos = (km ((?((@take_nil @take_cons) (pl (km out))) pl) out))

@take_nil = (pl (km out))
  & pl ~ *
  & km ~ *
  & out ~ (0 *)

@take_cons = (* (pl (km out)))
  & pl ~ (h t)
  & @take ~ (km (t rest))
  & out ~ (1 (h rest))

@sort_cons_lw = (ls40 q8)
  & ls40 ~ (g31 (e23 (g32 (e24 (g33 (e25 (g34 (e26 (g35 (e27 (g36 (e28 (g37 (e29 (g38 (e30 tk39))))))))))))))))
  & g31 ~ ?((@sort_nil @sort_cons_la) ((e23 q10) q8))
  & g32 ~ ?((@sort_nil @sort_cons_la) ((e24 q12) q10))
  & g33 ~ ?((@sort_nil @sort_cons_la) ((e25 q14) q12))
  & g34 ~ ?((@sort_nil @sort_cons_la) ((e26 q16) q14))
  & g35 ~ ?((@sort_nil @sort_cons_la) ((e27 q18) q16))
  & g36 ~ ?((@sort_nil @sort_cons_la) ((e28 q20) q18))
  & g37 ~ ?((@sort_nil @sort_cons_la) ((e29 q22) q20))
  & g38 ~ ?((@sort_nil @sort_cons) ((e30 tk39) q22))

@sort_cons_la = (* ((h sorted) out))
  & @insert ~ (h (sorted out))
