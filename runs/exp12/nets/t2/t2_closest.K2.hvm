@prog = (inp out)
  & inp ~ (x xs)
  & @start ~ (xs (x out))

@start = (lv1 (x out))
  & @first_cell_lw ~ (lv1 (x out))

@empty = (* (x out))
  & x ~ *
  & out ~ 0

@first_cell = (* (({hc {hs hkeep}} t) ({$([<] $(hc z11)) {xs xkeep}} out)))
  & z11 ~ ?((@start_ge_hz @start_lt_hz) (xs (hs (xkeep (hkeep (xw48 out))))))
  & @cons_lw ~ (t xw48)

@start_ge = (xs (hs (x (h (t out)))))
  & xs ~ $([-] $(hs d))
  & @seed ~ (d (h (x (t out))))

@start_lt = (* (xs (hs (x (h (t out))))))
  & hs ~ $([-] $(xs d))
  & @seed ~ (d (h (x (t out))))

@seed = (d (h (x (t out))))
  & @walk ~ (t (x (h (d out))))

@walk = (lv2 (x (best (bd out))))
  & @cons_lw ~ (lv2 (x (best (bd out))))

@nil = (* (x (best (bd out))))
  & x ~ *
  & bd ~ *
  & best ~ out

@cons = (* (({hc {hs hcand}} t) ({$([<] $(hc z49)) {xs xrec}} (best (bd out)))))
  & z49 ~ ?((@ge_hz @clt_hz) (xs (hs (xrec (hcand (xw174 (best (bd out))))))))
  & @cons_lw ~ (t xw174)

@ge = (xs (hs (xr (hc (t (best (bd out)))))))
  & xs ~ $([-] $(hs d))
  & @consider ~ (d (hc (xr (t (best (bd out))))))

@clt = (* (xs (hs (xr (hc (t (best (bd out))))))))
  & hs ~ $([-] $(xs d))
  & @consider ~ (d (hc (xr (t (best (bd out))))))

@consider = (d (h (x (t (best (bd out))))))
  & d ~ {dl dr}
  & dr ~ {deq dcand}
  & bd ~ {bdl bdr}
  & bdr ~ {beq bdkeep}
  & h ~ {hcand hcmp}
  & best ~ {bestcmp bestkeep}
  & dl ~ $([<] $(bdl less))
  & deq ~ $([=] $(beq equal))
  & hcmp ~ $([<] $(bestcmp hless))
  & equal ~ $([&] $(hless tie))
  & less ~ $([|] $(tie update))
  & update ~ ?((@keep @replace) (dcand (bdkeep (hcand (bestkeep (x (t out)))))))

@keep = (d (bd (h (best (x (t out))))))
  & d ~ *
  & h ~ *
  & @walk ~ (t (x (best (bd out))))

@replace = (* (d (bd (h (best (x (t out)))))))
  & best ~ *
  & bd ~ *
  & @walk ~ (t (x (h (d out))))

@first_cell_lw = (ls190 (q178 q179))
  & ls190 ~ (g187 (e185 (g188 (e186 tk189))))
  & g187 ~ ?((@empty @first_cell_la) ((e185 (q181 (q182 (q183 q184)))) (q178 q179)))
  & g188 ~ ?((@nil @cons) ((e186 tk189) (q181 (q182 (q183 q184)))))

@cons_lw = (ls206 (q192 (q193 (q194 q195))))
  & ls206 ~ (g203 (e201 (g204 (e202 tk205))))
  & g203 ~ ?((@nil @cons_la) ((e201 (q197 (q198 (q199 q200)))) (q192 (q193 (q194 q195)))))
  & g204 ~ ?((@nil @cons) ((e202 tk205) (q197 (q198 (q199 q200)))))

@start_ge_hz = ($([-] $(q13 q18)) (q13 (q14 (q15 (hw29 q17)))))
  & hw29 ~ (q14 (q15 (q18 q17)))

@start_lt_hz = (* (q30 ($([-] $(q30 q36)) (q32 (q33 (hw47 q35))))))
  & hw47 ~ (q32 (q33 (q36 q35)))

@first_cell_la = (* (({hc {hs hkeep}} xw48) ({$([<] $(hc ?((@start_ge_hz @start_lt_hz) (xs (hs (xkeep (hkeep (xw48 out)))))))) {xs xkeep}} out)))

@keep_hz = (* (q85 (* (q87 (q88 (hw96 q90))))))
  & hw96 ~ (q88 (q87 (q85 q90)))

@replace_hz = (* (q97 (* (q99 (* (q101 (hw109 q103)))))))
  & hw109 ~ (q101 (q99 (q97 q103)))

@ge_hz = ($([-] $(q51 {$([<] $(q70 $([|] $(q81 z83)))) {$([=] $(q72 $([&] $(q80 q81)))) q69}})) (q51 (q52 ({q74 $([<] $(q76 q80))} (hw111 ({q76 q77} ({q70 {q72 q73}} q57)))))))
  & z83 ~ ?((@keep_hz @replace_hz) (q69 (q73 (q74 (q77 (q52 (xw110 q57)))))))
  & hw111 ~ xw110

@keep_hz1 = (* (q147 (* (q149 (q150 (hw158 q152))))))
  & hw158 ~ (q150 (q149 (q147 q152)))

@replace_hz1 = (* (q159 (* (q161 (* (q163 (hw171 q165)))))))
  & hw171 ~ (q163 (q161 (q159 q165)))

@clt_hz = (* (q112 ($([-] $(q112 {$([<] $(q132 $([|] $(q143 z145)))) {$([=] $(q134 $([&] $(q142 q143)))) q131}})) (q114 ({q136 $([<] $(q138 q142))} (hw173 ({q138 q139} ({q132 {q134 q135}} q119))))))))
  & z145 ~ ?((@keep_hz1 @replace_hz1) (q131 (q135 (q136 (q139 (q114 (xw172 q119)))))))
  & hw173 ~ xw172

@cons_la = (* (({hc {hs hcand}} xw174) ({$([<] $(hc ?((@ge_hz @clt_hz) (xs (hs (xrec (hcand (xw174 (best (bd out)))))))))) {xs xrec}} (best (bd out)))))
