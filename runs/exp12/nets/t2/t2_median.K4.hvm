@prog = (input out)
  & @sl ~ (input res)
  & res ~ (sorted len)
  & len ~ $([/] $(2 idx))
  & @sel ~ (sorted (idx out))

@sl = (lv1 out)
  & @sl_cons_lw ~ (lv1 out)

@sl_nil = (* out)
  & out ~ ((0 *) 0)

@sl_cons = (* ((head tail) (sorted2 len1)))
  & @ins ~ (head (sorted sorted2))
  & @sl_cons_lw ~ (tail (sorted $([+1] len1)))

@ins = (x ((?((@ins_nil @ins_cons) (payload (x out))) payload) out))

@ins_nil = (* (x out))
  & out ~ (1 (x (0 *)))

@ins_cons = (* ((head tail) (x out)))
  & x ~ {xcmp xctx}
  & head ~ {hcmp hctx}
  & xcmp ~ $([<] $(hcmp cmp))
  & cmp ~ ?((@ins_ge @ins_lt) (hctx (tail (xctx out))))

@ins_ge = (head (tail (x out)))
  & @ins ~ (x (tail rec))
  & out ~ (1 (head rec))

@ins_lt = (* (head (tail (x out))))
  & out ~ (1 (x (1 (head tail))))

@sel = ((?((@sel_nil @sel_cons) (payload (idx out))) payload) (idx out))

@sel_nil = (* (* out))
  & out ~ 0

@sel_cons = (* ((head tail) (?((@sel_here @sel_next) (head (tail out))) out)))

@sel_here = (head (* out))
  & out ~ head

@sel_next = (idx (* (tail out)))
  & @sel ~ (tail (idx out))

@sl_cons_lw = (ls24 q8)
  & ls24 ~ (g19 (e15 (g20 (e16 (g21 (e17 (g22 (e18 tk23))))))))
  & g19 ~ ?((@sl_nil @sl_cons_la) ((e15 q10) q8))
  & g20 ~ ?((@sl_nil @sl_cons_la) ((e16 q12) q10))
  & g21 ~ ?((@sl_nil @sl_cons_la) ((e17 q14) q12))
  & g22 ~ ?((@sl_nil @sl_cons) ((e18 tk23) q14))

@sl_cons_la = (* ((head (sorted $([+1] len1))) (sorted2 len1)))
  & @ins ~ (head (sorted sorted2))
