@prog = (input output)
  & @mode ~ (input stats)
  & stats ~ (value count)
  & value ~ output
  & count ~ *

@mode = ((?((@mn @mc) (pl out)) pl) out)

@mn = (pl out)
  & pl ~ *
  & out ~ (0 0)

@mc = (* ((h t) out))
  & h ~ {hfreq hcand}
  & t ~ {tmode tfreq}
  & @mode ~ (tmode mstats)
  & mstats ~ (best bcount)
  & @freq ~ (tfreq (hfreq fcount))
  & fcount ~ $([+1] candcount)
  & @select ~ (hcand (candcount (best (bcount out))))

@freq = (lv1 (target out))
  & @freq_cons_lw ~ (lv1 (target out))

@freq_nil = (pl (target out))
  & pl ~ *
  & target ~ *
  & out ~ 0

@freq_cons = (* (($([=] $(tc eq)) t) ({tc tr} out)))
  & @freq_cons_lw ~ (t (tr $([+] $(eq out))))

@select = (c (nc (b (bc out))))
  & nc ~ {ncc nck}
  & bc ~ {bcc bck}
  & ncc ~ $([>] $(bcc gt))
  & gt ~ ?((@sel_no @sel_yes) (c (nck (b (bck out)))))

@sel_yes = (* (c (nc (b (bc out)))))
  & b ~ *
  & bc ~ *
  & out ~ (c nc)

@sel_no = (c (nc (b (bc out))))
  & nc ~ {nce nck}
  & bc ~ {bce bck}
  & nce ~ $([=] $(bce eq))
  & eq ~ ?((@sel_diff @sel_equal) (c (nck (b (bck out)))))

@sel_diff = (c (nc (b (bc out))))
  & c ~ *
  & nc ~ *
  & out ~ (b bc)

@sel_equal = (* (c (nc (b (bc out)))))
  & c ~ {ccmp ckeep}
  & b ~ {bcmp bkeep}
  & ccmp ~ $([<] $(bcmp lt))
  & lt ~ ?((@sel_old @sel_new) (ckeep (nc (bkeep (bc out)))))

@sel_old = (ckeep (nc (bkeep (bc out))))
  & ckeep ~ *
  & nc ~ *
  & out ~ (bkeep bc)

@sel_new = (* (ckeep (nc (bkeep (bc out)))))
  & bkeep ~ *
  & bc ~ *
  & out ~ (ckeep nc)

@freq_cons_lw = (ls50 (q10 q11))
  & ls50 ~ (g41 (e33 (g42 (e34 (g43 (e35 (g44 (e36 (g45 (e37 (g46 (e38 (g47 (e39 (g48 (e40 tk49))))))))))))))))
  & g41 ~ ?((@freq_nil @freq_cons_la) ((e33 (q13 q14)) (q10 q11)))
  & g42 ~ ?((@freq_nil @freq_cons_la) ((e34 (q16 q17)) (q13 q14)))
  & g43 ~ ?((@freq_nil @freq_cons_la) ((e35 (q19 q20)) (q16 q17)))
  & g44 ~ ?((@freq_nil @freq_cons_la) ((e36 (q22 q23)) (q19 q20)))
  & g45 ~ ?((@freq_nil @freq_cons_la) ((e37 (q25 q26)) (q22 q23)))
  & g46 ~ ?((@freq_nil @freq_cons_la) ((e38 (q28 q29)) (q25 q26)))
  & g47 ~ ?((@freq_nil @freq_cons_la) ((e39 (q31 q32)) (q28 q29)))
  & g48 ~ ?((@freq_nil @freq_cons) ((e40 tk49) (q31 q32)))

@freq_cons_la = (* (($([=] $(tc eq)) (tr $([+] $(eq out)))) ({tc tr} out)))
