@prog = (input output)
  & @sort ~ (input output)

@sort = (lv1 out)
  & @sort_cons_lw ~ (lv1 out)

@sort_nil = (* out)
  & out ~ (0 *)

@sort_cons = (* ((pair tail) out))
  & @ins ~ (pair (sorted out))
  & @sort_cons_lw ~ (tail sorted)

@ins = (({kc kk} val) ((?((@ins_nil @ins_cons) (pl (kc ((kk val) out)))) pl) out))

@ins_nil = (pl (kc ((kk val) out)))
  & pl ~ *
  & kc ~ *
  & out ~ (1 ((kk val) (0 *)))

@ins_cons = (* ((({hc hk} hv) tail) (kc ((kk val) out))))
  & kc ~ $([>] $(hc cmp))
  & cmp ~ ?((@ins_before @ins_after) (((hk hv) tail) ((kk val) out)))

@ins_before = (((hk hv) tail) ((k v) out))
  & out ~ (1 ((k v) (1 ((hk hv) tail))))

@ins_after = (* (((hk hv) tail) ((k v) out)))
  & @ins ~ ((k v) (tail rec))
  & out ~ (1 ((hk hv) rec))

@sort_cons_lw = (ls40 q8)
  & ls40 ~ (g31 (e23 (g32 (e24 (g33 (e25 (g34 (e26 (g35 (e27 (g36 (e28 (g37 (e29 (g38 (e30 tk39))))))))))))))))
  & g31 ~ ?((@sort_nil @sort_cons_la) ((e23 q10) q8))
  & g32 ~ ?((@sort_nil @sort_cons_la) ((e24 q12) q10))
  & g33 ~ ?((@sort_nil @sort_cons_la) ((e25 q14) q12))
  & g34 ~ ?((@sort_nil @sort_cons_la) ((e26 q16) q14))
  & g35 ~ ?((@sort_nil @sort_cons_la) ((e27 q18) q16))
  & g36 ~ ?((@sort_nil @sort_cons_la) ((e28 q20) q18))
  & g37 ~ ?((@sort_nil @sort_cons_la) ((e29 q22) q20))
  & g38 ~ ?((@sort_nil @sort_cons) ((e30 tk39) q22))

@sort_cons_la = (* ((pair sorted) out))
  & @ins ~ (pair (sorted out))
