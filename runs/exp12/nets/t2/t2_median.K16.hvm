@prog = (input out)
  & @sl ~ (input res)
  & res ~ (sorted len)
  & len ~ $([/] $(2 idx))
  & @sel ~ (sorted (idx out))

@sl = (lv1 out)
  & @sl_cons_lw ~ (lv1 out)

@sl_nil = (* out)
  & out ~ ((0 *) 0)

@sl_cons = (* ((head tail) (sorted2 len1)))
  & @ins ~ (head (sorted sorted2))
  & @sl_cons_lw ~ (tail (sorted $([+1] len1)))

@ins = (x ((?((@ins_nil @ins_cons) (payload (x out))) payload) out))

@ins_nil = (* (x out))
  & out ~ (1 (x (0 *)))

@ins_cons = (* ((head tail) (x out)))
  & x ~ {xcmp xctx}
  & head ~ {hcmp hctx}
  & xcmp ~ $([<] $(hcmp cmp))
  & cmp ~ ?((@ins_ge @ins_lt) (hctx (tail (xctx out))))

@ins_ge = (head (tail (x out)))
  & @ins ~ (x (tail rec))
  & out ~ (1 (head rec))

@ins_lt = (* (head (tail (x out))))
  & out ~ (1 (x (1 (head tail))))

@sel = ((?((@sel_nil @sel_cons) (payload (idx out))) payload) (idx out))

@sel_nil = (* (* out))
  & out ~ 0

@sel_cons = (* ((head tail) (?((@sel_here @sel_next) (head (tail out))) out)))

@sel_here = (head (* out))
  & out ~ head

@sel_next = (idx (* (tail out)))
  & @sel ~ (tail (idx out))

@sl_cons_lw = (ls72 q8)
  & ls72 ~ (g55 (e39 (g56 (e40 (g57 (e41 (g58 (e42 (g59 (e43 (g60 (e44 (g61 (e45 (g62 (e46 (g63 (e47 (g64 (e48 (g65 (e49 (g66 (e50 (g67 (e51 (g68 (e52 (g69 (e53 (g70 (e54 tk71))))))))))))))))))))))))))))))))
  & g55 ~ ?((@sl_nil @sl_cons_la) ((e39 q10) q8))
  & g56 ~ ?((@sl_nil @sl_cons_la) ((e40 q12) q10))
  & g57 ~ ?((@sl_nil @sl_cons_la) ((e41 q14) q12))
  & g58 ~ ?((@sl_nil @sl_cons_la) ((e42 q16) q14))
  & g59 ~ ?((@sl_nil @sl_cons_la) ((e43 q18) q16))
  & g60 ~ ?((@sl_nil @sl_cons_la) ((e44 q20) q18))
  & g61 ~ ?((@sl_nil @sl_cons_la) ((e45 q22) q20))
  & g62 ~ ?((@sl_nil @sl_cons_la) ((e46 q24) q22))
  & g63 ~ ?((@sl_nil @sl_cons_la) ((e47 q26) q24))
  & g64 ~ ?((@sl_nil @sl_cons_la) ((e48 q28) q26))
  & g65 ~ ?((@sl_nil @sl_cons_la) ((e49 q30) q28))
  & g66 ~ ?((@sl_nil @sl_cons_la) ((e50 q32) q30))
  & g67 ~ ?((@sl_nil @sl_cons_la) ((e51 q34) q32))
  & g68 ~ ?((@sl_nil @sl_cons_la) ((e52 q36) q34))
  & g69 ~ ?((@sl_nil @sl_cons_la) ((e53 q38) q36))
  & g70 ~ ?((@sl_nil @sl_cons) ((e54 tk71) q38))

@sl_cons_la = (* ((head (sorted $([+1] len1))) (sorted2 len1)))
  & @ins ~ (head (sorted sorted2))
