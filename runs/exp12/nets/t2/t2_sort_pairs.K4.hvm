@prog = (input output)
  & @sort ~ (input output)

@sort = (lv1 out)
  & @sort_cons_lw ~ (lv1 out)

@sort_nil = (* out)
  & out ~ (0 *)

@sort_cons = (* ((pair tail) out))
  & @ins ~ (pair (sorted out))
  & @sort_cons_lw ~ (tail sorted)

@ins = (({kc kk} val) ((?((@ins_nil @ins_cons) (pl (kc ((kk val) out)))) pl) out))

@ins_nil = (pl (kc ((kk val) out)))
  & pl ~ *
  & kc ~ *
  & out ~ (1 ((kk val) (0 *)))

@ins_cons = (* ((({hc hk} hv) tail) (kc ((kk val) out))))
  & kc ~ $([>] $(hc cmp))
  & cmp ~ ?((@ins_before @ins_after) (((hk hv) tail) ((kk val) out)))

@ins_before = (((hk hv) tail) ((k v) out))
  & out ~ (1 ((k v) (1 ((hk hv) tail))))

@ins_after = (* (((hk hv) tail) ((k v) out)))
  & @ins ~ ((k v) (tail rec))
  & out ~ (1 ((hk hv) rec))

@sort_cons_lw = (ls24 q8)
  & ls24 ~ (g19 (e15 (g20 (e16 (g21 (e17 (g22 (e18 tk23))))))))
  & g19 ~ ?((@sort_nil @sort_cons_la) ((e15 q10) q8))
  & g20 ~ ?((@sort_nil @sort_cons_la) ((e16 q12) q10))
  & g21 ~ ?((@sort_nil @sort_cons_la) ((e17 q14) q12))
  & g22 ~ ?((@sort_nil @sort_cons) ((e18 tk23) q14))

@sort_cons_la = (* ((pair sorted) out))
  & @ins ~ (pair (sorted out))
