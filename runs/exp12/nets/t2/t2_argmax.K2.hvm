@prog = (l out)
  & @am ~ (l (0 (0 (0 out))))

@am = (lv1 (idx (bv (bi out))))
  & @am_cons_lw ~ (lv1 (idx (bv (bi out))))

@am_nil = (* (idx (bv (bi out))))
  & idx ~ *
  & bv ~ *
  & bi ~ out

@am_cons = (* (({$([>] $(bc z7)) hnew} t) ({inx ibest} ({bc bvkeep} (bi out)))))
  & z7 ~ ?((@am_no_hz @am_yes_hz) (xw36 (inx (hnew (bvkeep (ibest (bi out)))))))
  & @am_cons_lw ~ (t xw36)

@am_no = (t (inx (hnew (bvkeep (ibest (bi out))))))
  & hnew ~ *
  & ibest ~ *
  & inx ~ $([+1] idx2)
  & @am ~ (t (idx2 (bvkeep (bi out))))

@am_yes = (* (t (inx (hnew (bvkeep (ibest (bi out)))))))
  & bvkeep ~ *
  & bi ~ *
  & inx ~ $([+1] idx2)
  & @am ~ (t (idx2 (hnew (ibest out))))

@am_cons_lw = (ls53 (q39 (q40 (q41 q42))))
  & ls53 ~ (g50 (e48 (g51 (e49 tk52))))
  & g50 ~ ?((@am_nil @am_cons_la) ((e48 (q44 (q45 (q46 q47)))) (q39 (q40 (q41 q42)))))
  & g51 ~ ?((@am_nil @am_cons) ((e49 tk52) (q44 (q45 (q46 q47)))))

@am_no_hz = (hw21 ($([+1] q15) (* (q11 (* (q13 q14))))))
  & hw21 ~ (q15 (q11 (q13 q14)))

@am_yes_hz = (* (hw35 ($([+1] q29) (q24 (* (q26 (* q28)))))))
  & hw35 ~ (q29 (q24 (q26 q28)))

@am_cons_la = (* (({$([>] $(bc ?((@am_no_hz @am_yes_hz) (xw36 (inx (hnew (bvkeep (ibest (bi out))))))))) hnew} xw36) ({inx ibest} ({bc bvkeep} (bi out)))))
