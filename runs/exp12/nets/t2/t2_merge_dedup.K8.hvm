@prog = ((xs ys) out)
  & @merge ~ (xs (ys merged))
  & @dedup ~ (merged (0 (0 out)))

@merge = ((?((@mxnil @mxcons) (px (ys out))) px) (ys out))

@mxnil = (* (ys out))
  & ys ~ out

@mxcons = (* ((h t) (ys out)))
  & @merge_y ~ (ys (h (t out)))

@merge_y = ((?((@mynil @mycons) (py (h (t out)))) py) (h (t out)))

@mynil = (* (h (t out)))
  & out ~ (1 (h t))

@mycons = (* ((g u) (h (t out))))
  & h ~ {hc hs}
  & g ~ {gc gs}
  & hc ~ $([<] $(gc z))
  & z ~ ?((@my_ge @my_lt) (hs (gs (t (u out)))))

@my_ge = (hs (gs (t (u out))))
  & @merge ~ ((1 (hs t)) (u r))
  & out ~ (1 (gs r))

@my_lt = (* (hs (gs (t (u out)))))
  & @merge ~ (t ((1 (gs u)) r))
  & out ~ (1 (hs r))

@dedup = (lv1 (have (prev out)))
  & @dcons_lw ~ (lv1 (have (prev out)))

@dnil = (* (have (prev out)))
  & have ~ *
  & prev ~ *
  & out ~ (0 *)

@dcons = (* ((h t) (z6 (prev out))))
  & z6 ~ ?((@dfirst_hz @dmore_hz) (h (xw52 (prev out))))
  & @dcons_lw ~ (t xw52)

@dfirst = (h (t (prev out)))
  & prev ~ *
  & h ~ {emit newprev}
  & @dedup ~ (t (1 (newprev rest)))
  & out ~ (1 (emit rest))

@dmore = (* (h (t (prev out))))
  & h ~ {hc hkeep}
  & prev ~ {pc pkeep}
  & hc ~ $([=] $(pc z))
  & z ~ ?((@ddiff @dsame) (hkeep (pkeep (t out))))

@dsame = (* (hkeep (pkeep (t out))))
  & hkeep ~ *
  & @dedup ~ (t (1 (pkeep out)))

@ddiff = (hkeep (pkeep (t out)))
  & pkeep ~ *
  & hkeep ~ {emit newprev}
  & @dedup ~ (t (1 (newprev rest)))
  & out ~ (1 (emit rest))

@dcons_lw = (ls103 (q55 (q56 q57)))
  & ls103 ~ (g94 (e86 (g95 (e87 (g96 (e88 (g97 (e89 (g98 (e90 (g99 (e91 (g100 (e92 (g101 (e93 tk102))))))))))))))))
  & g94 ~ ?((@dnil @dcons_la) ((e86 (q59 (q60 q61))) (q55 (q56 q57))))
  & g95 ~ ?((@dnil @dcons_la) ((e87 (q63 (q64 q65))) (q59 (q60 q61))))
  & g96 ~ ?((@dnil @dcons_la) ((e88 (q67 (q68 q69))) (q63 (q64 q65))))
  & g97 ~ ?((@dnil @dcons_la) ((e89 (q71 (q72 q73))) (q67 (q68 q69))))
  & g98 ~ ?((@dnil @dcons_la) ((e90 (q75 (q76 q77))) (q71 (q72 q73))))
  & g99 ~ ?((@dnil @dcons_la) ((e91 (q79 (q80 q81))) (q75 (q76 q77))))
  & g100 ~ ?((@dnil @dcons_la) ((e92 (q83 (q84 q85))) (q79 (q80 q81))))
  & g101 ~ ?((@dnil @dcons) ((e93 tk102) (q83 (q84 q85))))

@dfirst_hz = ({q11 q12} (hw18 (* (1 (q11 q13)))))
  & hw18 ~ (1 (q12 q13))

@ddiff_hz = ({q33 q34} (* (hw40 (1 (q33 q35)))))
  & hw40 ~ (1 (q34 q35))

@dsame_hz = (* (* (q42 (hw49 q44))))
  & hw49 ~ (1 (q42 q44))

@dmore_hz = (* ({$([=] $(q25 z28)) q24} (hw51 ({q25 q26} q22))))
  & z28 ~ ?((@ddiff_hz @dsame_hz) (q24 (q26 (xw50 q22))))
  & hw51 ~ xw50

@dcons_la = (* ((h xw52) (?((@dfirst_hz @dmore_hz) (h (xw52 (prev out)))) (prev out))))
