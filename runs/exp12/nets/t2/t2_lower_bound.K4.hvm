@prog = ((xs t) out)
  & @lb ~ (xs (t (0 out)))

@lb = (l (t (acc out)))
  & l ~ lv1
  & @lb_first_lw ~ (lv1 (t (acc out)))

@lb_nil = (* (* (a a)))

@lb_first = (* ((h tail1) (t (acc out))))
  & @lb_pair_lw ~ (tail1 (h (t (acc out))))

@lb_second = (l (h (t (acc out))))
  & l ~ lv2
  & @lb_pair_lw ~ (lv2 (h (t (acc out))))

@lb_odd = (payload (h (t (acc out))))
  & payload ~ *
  & h ~ $([<] $(t z))
  & z ~ ?((@lb_stop0 @lb_stop1) (* (acc out)))

@lb_pair = (* ((h2 tail2) (h1 (t (acc out)))))
  & t ~ {tc tr}
  & h2 ~ $([<] $(tc z2))
  & z2 ~ ?((@lb_high @lb_both) (h1 (tr (tail2 (acc out)))))

@lb_high = (h1 (tr (tail2 (acc out))))
  & h1 ~ $([<] $(tr z1))
  & z1 ~ ?((@lb_stop0 @lb_stop1) (tail2 (acc out)))

@lb_both = (* (h1 (tr (tail2 (acc out)))))
  & h1 ~ *
  & acc ~ $([+2] acc2)
  & @lb ~ (tail2 (tr (acc2 out)))

@lb_stop0 = (tail (acc out))
  & tail ~ *
  & acc ~ out

@lb_stop1 = (* (tail (acc out)))
  & tail ~ *
  & acc ~ $([+1] out)

@lb_first_lw = (ls44 (q31 (q32 q33)))
  & ls44 ~ (g41 (e39 (g42 (e40 tk43))))
  & g41 ~ ?((@lb_nil @lb_first_la) ((e39 (q35 (q36 (q37 q38)))) (q31 (q32 q33))))
  & g42 ~ ?((@lb_odd @lb_pair) ((e40 tk43) (q35 (q36 (q37 q38)))))

@lb_pair_lw = ((?((@lb_odd @lb_pair) (q7 (q8 (q9 (q10 q11))))) q7) (q8 (q9 (q10 q11))))

@lb_first_la = (* ((h (h (t (acc out)))) (t (acc out))))
