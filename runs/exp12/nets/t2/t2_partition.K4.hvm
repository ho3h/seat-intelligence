@prog = (input out)
  & input ~ (p xs)
  & @part ~ (p (xs out))

@part = (p (xs out))
  & xs ~ lv1
  & @part_cons_lw ~ (lv1 (p out))

@part_nil = (body (p out))
  & body ~ *
  & p ~ *
  & out ~ ((0 *) (0 *))

@part_cons = (* (({$([<] $(p_cmp ?((@part_ge @part_lt) (h_keep (lo (hi out)))))) h_keep} t) ({p_rec p_cmp} out)))
  & @part_cons_lw ~ (t (p_rec (lo hi)))

@part_ge = (h (lo (hi out)))
  & out ~ (lo (1 (h hi)))

@part_lt = (ignored (h (lo (hi out))))
  & ignored ~ *
  & out ~ ((1 (h lo)) hi)

@part_cons_lw = (ls31 (q11 q12))
  & ls31 ~ (g26 (e22 (g27 (e23 (g28 (e24 (g29 (e25 tk30))))))))
  & g26 ~ ?((@part_nil @part_cons_la) ((e22 (q14 q15)) (q11 q12)))
  & g27 ~ ?((@part_nil @part_cons_la) ((e23 (q17 q18)) (q14 q15)))
  & g28 ~ ?((@part_nil @part_cons_la) ((e24 (q20 q21)) (q17 q18)))
  & g29 ~ ?((@part_nil @part_cons) ((e25 tk30) (q20 q21)))

@part_cons_la = (* (({$([<] $(p_cmp ?((@part_ge @part_lt) (h_keep (lo (hi out)))))) h_keep} (p_rec (lo hi))) ({p_rec p_cmp} out)))
