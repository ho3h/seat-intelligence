@prog = (t out)
  & @tf ~ (t out)

@tf = ((?((@tf_nil @tf_1) (pl out)) pl) out)

@tf_nil = (* 16777215)

@tf_1 = (m (pl out))
  & m ~ ?((@lift @tf_2) (pl out))

@tf_2 = (* ((l r) out))
  & @tf ~ (l lv)
  & @tf ~ (r rv)
  & @comb ~ (lv (rv out))

@lift = (a a)

@comb = (a (b w6))
  & a ~ {a_0 a_1}
  & b ~ {b_0 b_1}
  & w2 ~ {w2_0 w2_1}
  & a_0 ~ $([<] $(b_0 w2))
  & w2_0 ~ $([*] $(a_1 w3))
  & w2_1 ~ $([^] $(1 w4))
  & w4 ~ $([*] $(b_1 w5))
  & w3 ~ $([+] $(w5 w6))
