@prog = (t out)
  & @tf ~ (t out)

@tf = ((?((@tf_nil @tf_1) (pl out)) pl) out)

@tf_nil = (* 0)

@tf_1 = (m (pl out))
  & m ~ ?((@lift @tf_2) (pl out))

@tf_2 = (* ((l r) out))
  & @tf ~ (l lv)
  & @tf ~ (r rv)
  & @comb ~ (lv (rv out))

@lift = (a a)

@comb = (a (b w11))
  & a ~ {a_0 a_1}
  & b ~ {b_0 b_1}
  & w6 ~ {w6_0 w6_1}
  & a_0 ~ $([&] $(63 w1))
  & w1 ~ $([=] $(63 w2))
  & b_0 ~ $([&] $(15 w4))
  & w4 ~ $([=] $(15 w5))
  & w2 ~ $([&] $(w5 w6))
  & w6_0 ~ $([*] $(0 w7))
  & w6_1 ~ $([^] $(1 w8))
  & a_1 ~ $([+] $(b_1 w9))
  & w8 ~ $([*] $(w9 w10))
  & w7 ~ $([+] $(w10 w11))
