@prog = (l out)
  & @sw ~ (l (0 out))

@sw = ((?((@sw_nil @sw_cons) (pl (acc out))) pl) (acc out))

@sw_nil = (* (a a))

@sw_cons = (* ((h t) (acc out)))
  & @step ~ (acc (h acc2))
  & @sw ~ (t (acc2 out))

@step = (acc (x out))
  & @lift ~ (x hl)
  & @comb ~ (acc (hl out))

@lift = (a a)

@comb = (a (b w8))
  & a ~ {a_0 a_t0}
  & a_t0 ~ {a_1 a_2}
  & b ~ {b_0 b_t0}
  & b_t0 ~ {b_1 b_2}
  & w2 ~ {w2_0 w2_1}
  & a_0 ~ $([>] $(b_0 w2))
  & a_1 ~ $([-] $(b_1 w3))
  & w2_0 ~ $([*] $(w3 w4))
  & w2_1 ~ $([^] $(1 w5))
  & b_2 ~ $([-] $(a_2 w6))
  & w5 ~ $([*] $(w6 w7))
  & w4 ~ $([+] $(w7 w8))
