@prog = (t out)
  & @tf ~ (t s)
  & @fin ~ (s out)

@tf = ((?((@tf_nil @tf_1) (pl out)) pl) out)

@tf_nil = (* (0 0))

@tf_1 = (m (pl out))
  & m ~ ?((@lift @tf_2) (pl out))

@tf_2 = (* ((l r) out))
  & @tf ~ (l lv)
  & @tf ~ (r rv)
  & @comb ~ (lv (rv out))

@lift = (a (a 0))

@comb = ((a0 a1) ((b0 b1) (w6 w23)))
  & a0 ~ {a0_0 a0_t0}
  & a0_t0 ~ {a0_1 a0_t1}
  & a0_t1 ~ {a0_2 a0_3}
  & b0 ~ {b0_0 b0_t0}
  & b0_t0 ~ {b0_1 b0_t1}
  & b0_t1 ~ {b0_2 b0_3}
  & w2 ~ {w2_0 w2_1}
  & w7 ~ {w7_0 w7_1}
  & w11 ~ {w11_0 w11_1}
  & a1 ~ {a1_0 a1_1}
  & b1 ~ {b1_0 b1_1}
  & w14 ~ {w14_0 w14_1}
  & w18 ~ {w18_0 w18_1}
  & w19 ~ {w19_0 w19_1}
  & a0_0 ~ $([>] $(b0_0 w2))
  & w2_0 ~ $([*] $(a0_1 w3))
  & w2_1 ~ $([^] $(1 w4))
  & w4 ~ $([*] $(b0_1 w5))
  & w3 ~ $([+] $(w5 w6))
  & a0_2 ~ $([<] $(b0_2 w7))
  & w7_0 ~ $([*] $(a0_3 w8))
  & w7_1 ~ $([^] $(1 w9))
  & w9 ~ $([*] $(b0_3 w10))
  & w8 ~ $([+] $(w10 w11))
  & a1_0 ~ $([>] $(b1_0 w14))
  & w14_0 ~ $([*] $(a1_1 w15))
  & w14_1 ~ $([^] $(1 w16))
  & w16 ~ $([*] $(b1_1 w17))
  & w15 ~ $([+] $(w17 w18))
  & w11_0 ~ $([>] $(w18_0 w19))
  & w19_0 ~ $([*] $(w11_1 w20))
  & w19_1 ~ $([^] $(1 w21))
  & w21 ~ $([*] $(w18_1 w22))
  & w20 ~ $([+] $(w22 w23))

@fin = ((* a1) a1)
