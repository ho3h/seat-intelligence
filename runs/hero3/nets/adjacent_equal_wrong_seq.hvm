@prog = (l out)
  & @sw ~ (l ((0 (0 (0 0))) s))
  & @fin ~ (s out)

@sw = ((?((@sw_nil @sw_cons) (pl (acc out))) pl) (acc out))

@sw_nil = (* (a a))

@sw_cons = (* ((h t) (acc out)))
  & @step ~ (acc (h acc2))
  & @sw ~ (t (acc2 out))

@step = ((a0 (a1 (a2 a3))) (b (w1 (w8 (w12 w23)))))
  & a0 ~ {a0_0 a0_1}
  & w2 ~ {w2_0 w2_t0}
  & w2_t0 ~ {w2_1 w2_t1}
  & w2_t1 ~ {w2_2 w2_3}
  & b ~ {b_0 b_t0}
  & b_t0 ~ {b_1 b_2}
  & a2 ~ {a2_0 a2_1}
  & a3 ~ {a3_0 a3_1}
  & a0_0 ~ $([+] $(1 w1))
  & a0_1 ~ $([=] $(0 w2))
  & w2_0 ~ $([*] $(b_0 w4))
  & w2_1 ~ $([^] $(1 w5))
  & w5 ~ $([*] $(a1 w7))
  & w4 ~ $([+] $(w7 w8))
  & 0 ~ $([*] $(a2_0 w10))
  & 1 ~ $([*] $(b_1 w11))
  & w10 ~ $([+] $(w11 w12))
  & w2_2 ~ $([*] $(0 w13))
  & w2_3 ~ $([^] $(1 w14))
  & 0 ~ $([*] $(a3_0 w16))
  & a3_1 ~ $([+] $(0 w17))
  & a2_1 ~ $([=] $(b_2 w18))
  & w17 ~ $([+] $(w18 w19))
  & 1 ~ $([*] $(w19 w20))
  & w16 ~ $([+] $(w20 w21))
  & w14 ~ $([*] $(w21 w22))
  & w13 ~ $([+] $(w22 w23))

@fin = ((* (* (* a3))) a3)
