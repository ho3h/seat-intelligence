@prog = (l out)
  & @sw ~ (l (0 out))

@sw = ((?((@sw_nil @sw_cons) (pl (acc out))) pl) (acc out))

@sw_nil = (* (a a))

@sw_cons = (* ((h t) (acc out)))
  & @step ~ (acc (h acc2))
  & @sw ~ (t (acc2 out))

@step = (acc (x out))
  & @lift ~ (x hl)
  & @comb ~ (acc (hl out))

@lift = (a a)

@comb = (a (b w11))
  & a ~ {a_0 a_1}
  & b ~ {b_0 b_1}
  & w6 ~ {w6_0 w6_1}
  & a_0 ~ $([&] $(63 w1))
  & w1 ~ $([=] $(63 w2))
  & b_0 ~ $([&] $(15 w4))
  & w4 ~ $([=] $(15 w5))
  & w2 ~ $([&] $(w5 w6))
  & w6_0 ~ $([*] $(0 w7))
  & w6_1 ~ $([^] $(1 w8))
  & a_1 ~ $([+] $(b_1 w9))
  & w8 ~ $([*] $(w9 w10))
  & w7 ~ $([+] $(w10 w11))
