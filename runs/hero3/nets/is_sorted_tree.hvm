@prog = (t out)
  & @tf ~ (t s)
  & @fin ~ (s out)

@tf = ((?((@tf_nil @tf_1) (pl out)) pl) out)

@tf_nil = (* (1 (0 (0 1))))

@tf_1 = (m (pl out))
  & m ~ ?((@lift @tf_2) (pl out))

@tf_2 = (* ((l r) out))
  & @tf ~ (l lv)
  & @tf ~ (r rv)
  & @comb ~ (lv (rv out))

@lift = (a (0 (a_0 (a_1 1))))
  & a ~ {a_0 a_1}

@comb = ((a0 (a1 (a2 a3))) ((b0 (b1 (b2 b3))) (w2 (w8 (w14 w28)))))
  & a0 ~ {a0_0 a0_t0}
  & a0_t0 ~ {a0_1 a0_t1}
  & a0_t1 ~ {a0_2 a0_t2}
  & a0_t2 ~ {a0_3 a0_4}
  & b0 ~ {b0_0 b0_t0}
  & b0_t0 ~ {b0_1 b0_t1}
  & b0_t1 ~ {b0_2 b0_t2}
  & b0_t2 ~ {b0_3 b0_4}
  & b1 ~ {b1_0 b1_1}
  & a2 ~ {a2_0 a2_1}
  & b3 ~ {b3_0 b3_1}
  & a3 ~ {a3_0 a3_1}
  & a0_0 ~ $([&] $(b0_0 w2))
  & a0_1 ~ $([*] $(b1_0 w4))
  & a0_2 ~ $([^] $(1 w5))
  & w5 ~ $([*] $(a1 w7))
  & w4 ~ $([+] $(w7 w8))
  & b0_1 ~ $([*] $(a2_0 w10))
  & b0_2 ~ $([^] $(1 w11))
  & w11 ~ $([*] $(b2 w13))
  & w10 ~ $([+] $(w13 w14))
  & a0_3 ~ $([*] $(b3_0 w16))
  & a0_4 ~ $([^] $(1 w17))
  & b0_3 ~ $([*] $(a3_0 w19))
  & b0_4 ~ $([^] $(1 w20))
  & a3_1 ~ $([&] $(b3_1 w21))
  & a2_1 ~ $([>] $(b1_1 w22))
  & w22 ~ $([^] $(1 w23))
  & w21 ~ $([&] $(w23 w24))
  & w20 ~ $([*] $(w24 w25))
  & w19 ~ $([+] $(w25 w26))
  & w17 ~ $([*] $(w26 w27))
  & w16 ~ $([+] $(w27 w28))

@fin = ((* (* (* a3))) a3)
