@prog = (t out)
  & @tf ~ (t out)

@tf = ((?((@tf_nil @tf_1) (pl out)) pl) out)

@tf_nil = (* (16777215 0))

@tf_1 = (m (pl out))
  & m ~ ?((@lift @tf_2) (pl out))

@tf_2 = (* ((l r) out))
  & @tf ~ (l lv)
  & @tf ~ (r rv)
  & @comb ~ (lv (rv out))

@lift = (a (a_0 a_1))
  & a ~ {a_0 a_1}

@comb = ((a0 a1) ((b0 b1) (w6 w13)))
  & a0 ~ {a0_0 a0_1}
  & b0 ~ {b0_0 b0_1}
  & w2 ~ {w2_0 w2_1}
  & a1 ~ {a1_0 a1_1}
  & b1 ~ {b1_0 b1_1}
  & w9 ~ {w9_0 w9_1}
  & a0_0 ~ $([<] $(b0_0 w2))
  & w2_0 ~ $([*] $(a0_1 w3))
  & w2_1 ~ $([^] $(1 w4))
  & w4 ~ $([*] $(b0_1 w5))
  & w3 ~ $([+] $(w5 w6))
  & a1_0 ~ $([>] $(b1_0 w9))
  & w9_0 ~ $([*] $(a1_1 w10))
  & w9_1 ~ $([^] $(1 w11))
  & w11 ~ $([*] $(b1_1 w12))
  & w10 ~ $([+] $(w12 w13))
