@prog = (t out)
  & @tf ~ (t s)
  & @fin ~ (s out)

@tf = ((?((@tf_nil @tf_1) (pl out)) pl) out)

@tf_nil = (* (16777215 (0 0)))

@tf_1 = (m (pl out))
  & m ~ ?((@lift @tf_2) (pl out))

@tf_2 = (* ((l r) out))
  & @tf ~ (l lv)
  & @tf ~ (r rv)
  & @comb ~ (lv (rv out))

@lift = (a (a (0 1)))

@comb = ((a0 (a1 a2)) ((b0 (b1 b2)) (w6 (w14 w16))))
  & b0 ~ {b0_0 b0_1}
  & a0 ~ {a0_0 a0_1}
  & w2 ~ {w2_0 w2_t0}
  & w2_t0 ~ {w2_1 w2_t1}
  & w2_t1 ~ {w2_2 w2_3}
  & a2 ~ {a2_0 a2_1}
  & b0_0 ~ $([<] $(a0_0 w2))
  & w2_0 ~ $([*] $(b0_1 w3))
  & w2_1 ~ $([^] $(1 w4))
  & w4 ~ $([*] $(a0_1 w5))
  & w3 ~ $([+] $(w5 w6))
  & a2_0 ~ $([+] $(b1 w9))
  & w2_2 ~ $([*] $(w9 w10))
  & w2_3 ~ $([^] $(1 w11))
  & w11 ~ $([*] $(a1 w13))
  & w10 ~ $([+] $(w13 w14))
  & a2_1 ~ $([+] $(b2 w16))

@fin = ((* (a1 *)) a1)
