@prog = (t out)
  & @tf ~ (t s)
  & @fin ~ (s out)

@tf = ((?((@tf_nil @tf_1) (pl out)) pl) out)

@tf_nil = (* (0 (0 (0 (0 (0 0))))))

@tf_1 = (m (pl out))
  & m ~ ?((@lift @tf_2) (pl out))

@tf_2 = (* ((l r) out))
  & @tf ~ (l lv)
  & @tf ~ (r rv)
  & @comb ~ (lv (rv out))

@lift = (a (1 (a_0 (a_1 (1 (1 1))))))
  & a ~ {a_0 a_1}

@comb = ((a0 (a1 (a2 (a3 (a4 a5))))) ((b0 (b1 (b2 (b3 (b4 b5))))) (w2 (w14 (w24 (w39 (w53 w75)))))))
