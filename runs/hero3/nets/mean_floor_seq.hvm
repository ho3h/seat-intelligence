@prog = (l out)
  & @sw ~ (l ((0 0) s))
  & @fin ~ (s out)

@sw = ((?((@sw_nil @sw_cons) (pl (acc out))) pl) (acc out))

@sw_nil = (* (a a))

@sw_cons = (* ((h t) (acc out)))
  & @step ~ (acc (h acc2))
  & @sw ~ (t (acc2 out))

@step = (acc (x out))
  & @lift ~ (x hl)
  & @comb ~ (acc (hl out))

@lift = (a (a 1))

@comb = ((a0 a1) ((b0 b1) (w2 w5)))
  & a0 ~ $([+] $(b0 w2))
  & a1 ~ $([+] $(b1 w5))

@fin = ((a0 a1) w7)
  & a1 ~ {a1_0 a1_1}
  & w2 ~ {w2_0 w2_1}
  & a1_0 ~ $([>] $(1 w2))
  & w2_0 ~ $([*] $(a1_1 w3))
  & w2_1 ~ $([^] $(1 w4))
  & w4 ~ $([*] $(1 w5))
  & w3 ~ $([+] $(w5 w6))
  & a0 ~ $([/] $(w6 w7))
