@prog = (t out)
  & @tf ~ (t s)
  & @fin ~ (s out)

@tf = ((?((@tf_nil @tf_1) (pl out)) pl) out)

@tf_nil = (* (0 16777215))

@tf_1 = (m (pl out))
  & m ~ ?((@lift @tf_2) (pl out))

@tf_2 = (* ((l r) out))
  & @tf ~ (l lv)
  & @tf ~ (r rv)
  & @comb ~ (lv (rv out))

@lift = (a (1 w5))
  & w1 ~ {w1_0 w1_1}
  & a ~ $([!] $(0 w1))
  & w1_0 ~ $([*] $(0 w2))
  & w1_1 ~ $([^] $(1 w3))
  & w3 ~ $([*] $(16777215 w4))
  & w2 ~ $([+] $(w4 w5))

@comb = ((a0 a1) ((b0 b1) (w2 w15)))
  & a0 ~ {a0_0 a0_1}
  & a1 ~ {a1_0 a1_1}
  & w4 ~ {w4_0 w4_1}
  & b1 ~ {b1_0 b1_1}
  & w8 ~ {w8_0 w8_1}
  & a0_0 ~ $([+] $(b0 w2))
  & a1_0 ~ $([!] $(16777215 w4))
  & w4_0 ~ $([*] $(a1_1 w5))
  & w4_1 ~ $([^] $(1 w6))
  & b1_0 ~ $([!] $(16777215 w8))
  & a0_1 ~ $([+] $(b1_1 w9))
  & w8_0 ~ $([*] $(w9 w10))
  & w8_1 ~ $([^] $(1 w11))
  & w11 ~ $([*] $(16777215 w12))
  & w10 ~ $([+] $(w12 w13))
  & w6 ~ $([*] $(w13 w14))
  & w5 ~ $([+] $(w14 w15))

@fin = ((* a1) a1)
