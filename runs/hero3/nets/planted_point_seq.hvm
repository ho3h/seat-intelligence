@prog = (l out)
  & @sw ~ (l (0 out))

@sw = ((?((@sw_nil @sw_cons) (pl (acc out))) pl) (acc out))

@sw_nil = (* (a a))

@sw_cons = (* ((h t) (acc out)))
  & @step ~ (acc (h acc2))
  & @sw ~ (t (acc2 out))

@step = (acc (x out))
  & @lift ~ (x hl)
  & @comb ~ (acc (hl out))

@lift = (a a)

@comb = (a (b w9))
  & a ~ {a_0 a_1}
  & b ~ {b_0 b_1}
  & w4 ~ {w4_0 w4_1}
  & a_0 ~ $([=] $(12345678 w1))
  & b_0 ~ $([=] $(8765432 w3))
  & w1 ~ $([&] $(w3 w4))
  & w4_0 ~ $([*] $(0 w5))
  & w4_1 ~ $([^] $(1 w6))
  & a_1 ~ $([+] $(b_1 w7))
  & w6 ~ $([*] $(w7 w8))
  & w5 ~ $([+] $(w8 w9))
