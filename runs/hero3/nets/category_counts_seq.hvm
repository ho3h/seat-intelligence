@prog = (l out)
  & @sw ~ (l ((0 (0 (0 (0 (0 (0 0)))))) out))

@sw = ((?((@sw_nil @sw_cons) (pl (acc out))) pl) (acc out))

@sw_nil = (* (a a))

@sw_cons = (* ((h t) (acc out)))
  & @step ~ (acc (h acc2))
  & @sw ~ (t (acc2 out))

@step = (acc (x out))
  & @lift ~ (x hl)
  & @comb ~ (acc (hl out))

@lift = (a (w1 (w2 (w3 (w4 (w5 (w6 w7)))))))
  & a ~ {a_0 a_t0}
  & a_t0 ~ {a_1 a_t1}
  & a_t1 ~ {a_2 a_t2}
  & a_t2 ~ {a_3 a_t3}
  & a_t3 ~ {a_4 a_t4}
  & a_t4 ~ {a_5 a_6}
  & a_0 ~ $([=] $(0 w1))
  & a_1 ~ $([=] $(1 w2))
  & a_2 ~ $([=] $(2 w3))
  & a_3 ~ $([=] $(3 w4))
  & a_4 ~ $([=] $(4 w5))
  & a_5 ~ $([=] $(5 w6))
  & a_6 ~ $([=] $(6 w7))

@comb = ((a0 (a1 (a2 (a3 (a4 (a5 a6)))))) ((b0 (b1 (b2 (b3 (b4 (b5 b6)))))) (w2 (w5 (w8 (w11 (w14 (w17 w20))))))))
  & a0 ~ $([+] $(b0 w2))
  & a1 ~ $([+] $(b1 w5))
  & a2 ~ $([+] $(b2 w8))
  & a3 ~ $([+] $(b3 w11))
  & a4 ~ $([+] $(b4 w14))
  & a5 ~ $([+] $(b5 w17))
  & a6 ~ $([+] $(b6 w20))
