@prog = (t out)
  & @tf ~ (t out)

@tf = ((?((@tf_nil @tf_1) (pl out)) pl) out)

@tf_nil = (* (0 (0 0)))

@tf_1 = (m (pl out))
  & m ~ ?((@lift @tf_2) (pl out))

@tf_2 = (* ((l r) out))
  & @tf ~ (l lv)
  & @tf ~ (r rv)
  & @comb ~ (lv (rv out))

@lift = (a (a (0 0)))

@comb = ((a0 (a1 a2)) ((b0 (b1 b2)) (w6 (w23 w50))))
  & a0 ~ {a0_0 a0_t0}
  & a0_t0 ~ {a0_1 a0_t1}
