  & w41 ~ {w41_0 w41_1}
  & w45 ~ {w45_0 w45_1}
  & w46 ~ {w46_0 w46_1}
  & a0_0 ~ $([>] $(b0_0 w2))
  & w2_0 ~ $([*] $(a0_1 w3))
