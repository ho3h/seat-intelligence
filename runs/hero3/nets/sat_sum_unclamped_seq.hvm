@prog = (l out)
  & @sw ~ (l (0 out))

@sw = ((?((@sw_nil @sw_cons) (pl (acc out))) pl) (acc out))

@sw_nil = (* (a a))

@sw_cons = (* ((h t) (acc out)))
  & @step ~ (acc (h acc2))
  & @sw ~ (t (acc2 out))

@step = (acc (x out))
  & @lift ~ (x hl)
  & @comb ~ (acc (hl out))

@lift = (a a)

@comb = (a (b w7))
  & w2 ~ {w2_0 w2_1}
  & w3 ~ {w3_0 w3_1}
  & a ~ $([+] $(b w2))
  & w2_0 ~ $([<] $(1000000 w3))
  & w3_0 ~ $([*] $(w2_1 w4))
  & w3_1 ~ $([^] $(1 w5))
  & w5 ~ $([*] $(1000000 w6))
  & w4 ~ $([+] $(w6 w7))
