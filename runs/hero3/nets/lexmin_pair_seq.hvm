@prog = (l out)
  & @sw ~ (l ((16777215 16777215) out))

@sw = ((?((@sw_nil @sw_cons) (pl (acc out))) pl) (acc out))

@sw_nil = (* (a a))

@sw_cons = (* ((h t) (acc out)))
  & @step ~ (acc (h acc2))
  & @sw ~ (t (acc2 out))

@step = (acc (x out))
  & @lift ~ (x hl)
  & @comb ~ (acc (hl out))

@lift = ((a0 a1) (a0 a1))

@comb = ((a0 a1) ((b0 b1) (w13 w17)))
  & a0 ~ {a0_0 a0_t0}
  & a0_t0 ~ {a0_1 a0_2}
  & b0 ~ {b0_0 b0_t0}
  & b0_t0 ~ {b0_1 b0_2}
  & a1 ~ {a1_0 a1_1}
  & b1 ~ {b1_0 b1_1}
  & w9 ~ {w9_0 w9_t0}
  & w9_t0 ~ {w9_1 w9_t1}
  & w9_t1 ~ {w9_2 w9_3}
  & a0_0 ~ $([<] $(b0_0 w2))
  & a0_1 ~ $([=] $(b0_1 w3))
  & a1_0 ~ $([>] $(b1_0 w6))
  & w6 ~ $([^] $(1 w7))
  & w3 ~ $([&] $(w7 w8))
  & w2 ~ $([|] $(w8 w9))
  & w9_0 ~ $([*] $(a0_2 w10))
  & w9_1 ~ $([^] $(1 w11))
  & w11 ~ $([*] $(b0_2 w12))
  & w10 ~ $([+] $(w12 w13))
  & w9_2 ~ $([*] $(a1_1 w14))
  & w9_3 ~ $([^] $(1 w15))
  & w15 ~ $([*] $(b1_1 w16))
  & w14 ~ $([+] $(w16 w17))
