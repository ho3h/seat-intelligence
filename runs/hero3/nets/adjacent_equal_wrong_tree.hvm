@prog = (t out)
  & @tf ~ (t s)
  & @fin ~ (s out)

@tf = ((?((@tf_nil @tf_1) (pl out)) pl) out)

@tf_nil = (* (0 (0 (0 0))))

@tf_1 = (m (pl out))
  & m ~ ?((@lift @tf_2) (pl out))

@tf_2 = (* ((l r) out))
  & @tf ~ (l lv)
  & @tf ~ (r rv)
  & @comb ~ (lv (rv out))

@lift = (a (1 (a_0 (a_1 0))))
  & a ~ {a_0 a_1}

@comb = ((a0 (a1 (a2 a3))) ((b0 (b1 (b2 b3))) (w2 (w9 (w16 w29)))))
  & a0 ~ {a0_0 a0_1}
  & b0 ~ {b0_0 b0_1}
  & w3 ~ {w3_0 w3_t0}
  & w3_t0 ~ {w3_1 w3_t1}
  & w3_t1 ~ {w3_2 w3_3}
  & w10 ~ {w10_0 w10_t0}
  & w10_t0 ~ {w10_1 w10_t1}
  & w10_t1 ~ {w10_2 w10_3}
  & a2 ~ {a2_0 a2_1}
  & b2 ~ {b2_0 b2_1}
  & b3 ~ {b3_0 b3_1}
  & a3 ~ {a3_0 a3_1}
  & a0_0 ~ $([+] $(b0_0 w2))
  & a0_1 ~ $([=] $(0 w3))
  & w3_0 ~ $([*] $(b1 w5))
  & w3_1 ~ $([^] $(1 w6))
  & w6 ~ $([*] $(a1 w8))
  & w5 ~ $([+] $(w8 w9))
  & b0_1 ~ $([=] $(0 w10))
  & w10_0 ~ $([*] $(a2_0 w12))
  & w10_1 ~ $([^] $(1 w13))
  & w13 ~ $([*] $(b2_0 w15))
  & w12 ~ $([+] $(w15 w16))
  & w3_2 ~ $([*] $(b3_0 w18))
  & w3_3 ~ $([^] $(1 w19))
  & w10_2 ~ $([*] $(a3_0 w21))
  & w10_3 ~ $([^] $(1 w22))
  & a3_1 ~ $([+] $(b3_1 w23))
  & a2_1 ~ $([=] $(b2_1 w24))
  & w23 ~ $([+] $(w24 w25))
  & w22 ~ $([*] $(w25 w26))
  & w21 ~ $([+] $(w26 w27))
  & w19 ~ $([*] $(w27 w28))
  & w18 ~ $([+] $(w28 w29))

@fin = ((* (* (* a3))) a3)
