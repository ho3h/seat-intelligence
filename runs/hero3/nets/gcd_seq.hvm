@prog = (l out)
  & @sw ~ (l (0 out))

@sw = ((?((@sw_nil @sw_cons) (pl (acc out))) pl) (acc out))

@sw_nil = (* (a a))

@sw_cons = (* ((h t) (acc out)))
  & @step ~ (acc (h acc2))
  & @sw ~ (t (acc2 out))

@step = (acc (x out))
  & @lift ~ (x hl)
  & @comb ~ (acc (hl out))

@lift = (a a)

@comb = (a (b out))
  & b ~ {b1 b2}
  & b1 ~ ?((@gcd_z @gcd_s) (a (b2 out)))

@gcd_z = (a (* a))

@gcd_s = (* (a (b out)))
  & b ~ {b1 b2}
  & a ~ $([%] $(b1 r))
  & @comb ~ (b2 (r out))
