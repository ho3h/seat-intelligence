@prog = (l out)
  & @sw ~ (l ((16777215 0) out))

@sw = ((?((@sw_nil @sw_cons) (pl (acc out))) pl) (acc out))

@sw_nil = (* (a a))

@sw_cons = (* ((h t) (acc out)))
  & @step ~ (acc (h acc2))
  & @sw ~ (t (acc2 out))

@step = (acc (x out))
  & @lift ~ (x hl)
  & @comb ~ (acc (hl out))

@lift = (a (a_0 a_1))
  & a ~ {a_0 a_1}

@comb = ((a0 a1) ((b0 b1) (w6 w13)))
  & a0 ~ {a0_0 a0_1}
  & b0 ~ {b0_0 b0_1}
  & w2 ~ {w2_0 w2_1}
  & a1 ~ {a1_0 a1_1}
  & b1 ~ {b1_0 b1_1}
  & w9 ~ {w9_0 w9_1}
  & a0_0 ~ $([<] $(b0_0 w2))
  & w2_0 ~ $([*] $(a0_1 w3))
  & w2_1 ~ $([^] $(1 w4))
  & w4 ~ $([*] $(b0_1 w5))
  & w3 ~ $([+] $(w5 w6))
  & a1_0 ~ $([>] $(b1_0 w9))
  & w9_0 ~ $([*] $(a1_1 w10))
  & w9_1 ~ $([^] $(1 w11))
  & w11 ~ $([*] $(b1_1 w12))
  & w10 ~ $([+] $(w12 w13))
