// Input: (k, xs)
@prog = ((k xs) out)
  & @top ~ (xs (k ((0 *) out)))

// Process xs, maintaining a descending list of at most k items.
@top = ((?((@top_nil @top_cons) (payload (k (acc out)))) payload) (k (acc out)))

@top_nil = (* (k (acc out)))
  & k ~ *
  & out ~ acc

@top_cons = (* ((h t) (k (acc out))))
  & k ~ {ki kr}
  & @ins ~ (ki (h (acc newacc)))
  & @top ~ (t (kr (newacc out)))

// Insert x into acc, retaining at most cap items.
@ins = (?((@ins_zero @ins_pos) (x (acc out))) (x (acc out)))

@ins_zero = (* (acc out))
  & acc ~ *
  & out ~ (0 *)

@ins_pos = (rem (x (acc out)))
  & @scan ~ (acc (rem (x out)))

@scan = ((?((@scan_nil @scan_cons) (payload (rem (x out)))) payload) (rem (x out)))

@scan_nil = (* (rem (x out)))
  & rem ~ *
  & out ~ (1 (x (0 *)))

@scan_cons = (* ((h t) (rem (x out))))
  & x ~ {xc xk}
  & h ~ {hc hk}
  & xc ~ $([<] $(hc z))
  & rem ~ $([-] $(1 rem2))
  & z ~ ?((@sg_ge @sg_lt) (rem2 (xk (hk (t out))))

// x >= h: keep x, then take the remaining capacity from the tail.
@sg_ge = (rem (x (h (t out))))
  & h ~ *
  & @take ~ (rem (t tail))
  & out ~ (1 (x tail))

// x < h: keep h, then insert x into the tail.
@sg_lt = (* (rem (x (h (t out)))))
  & @ins ~ (rem (x (t newtail)))
  & out ~ (1 (h newtail))

// Take at most cap items from xs.
@take = (?((@take_zero @take_pos) (xs out)) (xs out))

@take_zero = (xs out)
  & xs ~ *
  & out ~ (0 *)

@take_pos = (rem (xs out))
  & @take_list ~ (xs (rem out))

@take_list = ((?((@take_nil @take_cons) (payload (rem out))) payload) (rem out))

@take_nil = (* (rem out))
  & rem ~ *
  & out ~ (0 *)

@take_cons = (* ((h t) (rem out)))
  & @take ~ (rem (t tail))
  & out ~ (1 (h tail))
