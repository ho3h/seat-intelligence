// Input: (k, xs). Process xs while keeping a descending list of at most k items.
@prog = ((k xs) out)
  & @top ~ (xs (k ((0 *) out)))

@top = ((?((@top_nil @top_cons) (payload (k (acc out)))) payload) (k (acc out)))

@top_nil = (* (* (a a)))

@top_cons = (* ((h t) (k (acc out))))
  & k ~ {ki kr}
  & @ins ~ (ki (h (acc newacc)))
  & @top ~ (t (kr (newacc out)))

// Insert x into acc, retaining at most cap items.
@ins = (?((@ins_zero @ins_pos) ctx) ctx)

@ins_zero = (* (* out))
  & out ~ (0 *)

@ins_pos = (rem (x (acc out)))
  & @scan ~ (acc (rem (x out)))

@scan = ((?((@scan_nil @scan_cons) (payload (rem (x out)))) payload) (rem (x out)))

@scan_nil = (* (* (x out)))
  & out ~ (1 (x (0 *)))

@scan_cons = (* ((h t) (rem (x out))))
  & x ~ {xt xk}
  & h ~ {ht hk}
  & xt ~ $([<] $(ht z))
  & z ~ ?((@scan_ge @scan_lt) (rem (xk (hk (t out))))

@scan_ge = (rem (x (h (t out))))
  & h ~ *
  & @take ~ (rem (t tail))
  & out ~ (1 (x tail))

@scan_lt = (* (rem (x (h (t out)))))
  & @ins ~ (rem (x (t newtail)))
  & out ~ (1 (h newtail))

// Take at most cap items from xs.
@take = (?((@take_zero @take_pos) ctx) ctx)

@take_zero = (* out)
  & out ~ (0 *)

@take_pos = (rem ((?((@take_nil @take_cons) (payload (rem out))) payload) out))

@take_nil = (* (* out))
  & out ~ (0 *)

@take_cons = (* ((h t) (rem out)))
  & @take ~ (rem (t tail))
  & out ~ (1 (h tail))
