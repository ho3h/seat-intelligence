// Process multiplier digits; fuse each digit product with accumulation.
@prog = ((a b) out)
  & @loop ~ (b (a ((0 *) raw)))
  & @trim ~ (raw (result flag))
  & flag ~ *
  & out ~ result

@loop = ((?((@loop_nil @loop_cons) (pl (a (acc out)))) pl) (a (acc out)))

@loop_nil = (* (a (acc out)))
  & a ~ *
  & acc ~ out

@loop_cons = (* ((h t) (a (acc out))))
  & a ~ {aa ar}
  & @fma ~ (aa (h (0 (acc next))))
  & @loop ~ (t ((1 (0 ar)) (next out)))

// Fused multiply-add: out = a * factor + acc, with carry.
@fma = ((?((@fma_nil @fma_cons) (pa (factor (carry (acc out)))) pa) (factor (carry (acc out))))

@fma_nil = (* (factor (carry (acc out))))
  & factor ~ *
  & @add_bonly ~ (acc (carry out))

@fma_cons = (* ((h t) (factor (carry (acc out)))))
  & @fma_acc ~ (acc (h (t (factor (carry out)))))

@fma_acc = ((?((@fma_acc_nil @fma_acc_cons) (pd (h (t (factor (carry out))))) pd) (h (t (factor (carry out)))))

@fma_acc_nil = (* (h (t (factor (carry out))))
  & factor ~ {f1 f2}
  & h ~ $([*] $(f1 prod))
  & prod ~ $([+] $(carry total))
  & total ~ {td tm}
  & td ~ $([/] $(4096 carry2))
  & tm ~ $([%] $(4096 digit))
  & @fma ~ (t (f2 (carry2 ((0 *) rest))))
  & out ~ (1 (digit rest))

@fma_acc_cons = (* ((d dt) (h (t (factor (carry out)))))
  & factor ~ {f1 f2}
  & h ~ $([*] $(f1 prod))
  & prod ~ $([+] $(d sum1))
  & sum1 ~ $([+] $(carry total))
  & total ~ {td tm}
  & td ~ $([/] $(4096 carry2))
  & tm ~ $([%] $(4096 digit))
  & @fma ~ (t (f2 (carry2 (dt rest))))
  & out ~ (1 (digit rest))

// Add a carry to the remaining accumulator digits.
@add_bonly = ((?((@add_bonly_nil @add_bonly_cons) (pb (carry out))) pb) (carry out))

@add_bonly_nil = (* (carry out))
  & out ~ (1 (carry (0 *)))

@add_bonly_cons = (* ((d t) (carry out)))
  & d ~ $([+] $(carry total))
  & total ~ {td tm}
  & td ~ $([/] $(4096 carry2))
  & tm ~ $([%] $(4096 digit))
  & @add_bonly ~ (t (carry2 rest))
  & out ~ (1 (digit rest))

// Remove most-significant zero digits and report whether the result is zero.
@trim = ((?((@trim_nil @trim_cons) (pl out)) pl) out)

@trim_nil = (* out)
  & out ~ ((0 *) 1)

@trim_cons = (* ((h t) out))
  & @trim ~ (t (nt zt))
  & zt ~ ?((@trim_tail_nonzero @trim_tail_zero) (h (nt out)))

@trim_tail_nonzero = (h (nt out))
  & out ~ ((1 (h nt)) 0)

@trim_tail_zero = (* (h (nt out)))
  & h ~ {hc hv}
  & hc ~ $([=] $(0 z))
  & z ~ ?((@trim_h_nonzero @trim_h_zero) (hv (nt out)))

@trim_h_nonzero = (hv (nt out))
  & nt ~ *
  & out ~ ((1 (hv (0 *))) 0)

@trim_h_zero = (* (hv (nt out)))
  & hv ~ *
  & nt ~ *
  & out ~ ((0 *) 1)
