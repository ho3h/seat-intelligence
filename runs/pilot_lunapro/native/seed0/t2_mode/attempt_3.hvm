// Count each candidate in the original list and keep the most frequent value.
// Equal frequencies are resolved in favor of the smaller value.
@prog = (l out)
  & l ~ {rem full}
  & @walk ~ (rem (full (0 (0 out))))

@walk = ((?((@walk_nil @walk_cons) (pl (full (bv (bc out))))) pl) (full (bv (bc out))))

@walk_nil = (* (full (bv (bc out))))
  & full ~ *
  & bc ~ *
  & out ~ bv

@walk_cons = (* ((h t) (full (bv (bc out)))))
  & h ~ {hcnt hval}
  & full ~ {fc fr}
  & bv ~ {bvc bvrec}
  & bc ~ {bcgt {bceq bcrec}}
  & @count ~ (fc (hcnt (0 c)))
  & c ~ {cgt ceq}
  & hval ~ {hcmp hnew}
  & cgt ~ $([>] $(bcgt gt))
  & ceq ~ $([=] $(bceq eq))
  & hcmp ~ $([<] $(bvc lt))
  & eq ~ $([&] $(lt tie))
  & gt ~ $([|] $(tie upd))
  & upd ~ ?((@walk_keep @walk_take) (hnew (c (t (fr (bvrec (bcrec out)))))))

@walk_keep = (h (c (t (full (bv (bc out))))))
  & h ~ *
  & c ~ *
  & @walk ~ (t (full (bv (bc out))))

@walk_take = (* (h (c (t (full (bv (bc out)))))))
  & bv ~ *
  & bc ~ *
  & @walk ~ (t (full (h (c out))))

@count = ((?((@count_nil @count_cons) (pl (x (acc out)))) pl) (x (acc out)))

@count_nil = (* (x (acc out)))
  & x ~ *
  & acc ~ out

@count_cons = (* ((h t) (x (acc out))))
  & x ~ {xc xr}
  & h ~ $([=] $(xc eq))
  & eq ~ ?((@cnt_no @cnt_yes) (xr (t (acc out))))

@cnt_no = (xr (t (acc out)))
  & @count ~ (t (xr (acc out)))

@cnt_yes = (* (xr (t (acc out))))
  & acc ~ $([+1] acc2)
  & @count ~ (t (xr (acc2 out)))
