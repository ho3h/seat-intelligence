// @prog starts the maximum fold with accumulator 0.
@prog = (l out)
  & @max ~ (l (0 out))

@max = ((?((@max_nil @max_cons) (pl (acc out))) pl) (acc out))

@max_nil = (* (a a))

@max_cons = (* ((h t) (acc out)))
  & h ~ {hv hc}
  & acc ~ {av ac}
  & hc ~ $([>] $(ac z))
  & z ~ ?((@max_keep @max_take) (t (hv (av out))))

@max_keep = (t (hv (av out)))
  & hv ~ *
  & @max ~ (t (av out))

@max_take = (* (t (hv (av out))))
  & av ~ *
  & @max ~ (t (hv out))
