@decide__C5 = (* ({$([>] $(a ?((@decide__C2 @decide__C3) (b (c (d (e (f (g h))))))))) f} (g (b (c ({a d} (e h)))))))

@decide__C6 = (?((@decide__C4 @decide__C5) a) a)

@prog = ((b a) c)
