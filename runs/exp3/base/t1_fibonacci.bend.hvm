@fib_pair = ({$([=0x0000000] ?((@fib_pair__C2 (* (* (0 1)))) (a b))) a} b)

@fib_pair__C0 = ($([+] $(b c)) ({a b} (a c)))

@fib_pair__C1 = (* (a (b (a b))))

@fib_pair__C2 = ({$([:%0x0000002] $([=0x0000000] ?((@fib_pair__C0 @fib_pair__C1) (e (i j))))) $([:/0x0000002] a)} j)
  & @fib_pair ~ (a ({$([*] $(f $([+] $(h i)))) {f {$([*] $(d e)) c}}} {$([*] $(g h)) {g {$([+] $(b $([-] $(c d)))) b}}}))

@prog = (a b)
  & @fib_pair ~ (a (b *))


