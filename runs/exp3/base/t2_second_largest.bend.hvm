@find_second__C4 = (* ({$([>] $(a ?((@find_second__C2 @find_second__C3) (b (c (d (e f))))))) d} (e (b ({a c} f)))))

@find_second__C5 = (?(((* (a a)) @find_second__C4) b) b)

@prog = (a b)
