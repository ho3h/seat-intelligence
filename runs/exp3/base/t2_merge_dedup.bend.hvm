@List/Cons = (a (b ((1 (a (b c))) c)))

@List/Nil = ((0 a) a)

@dedup = ((@dedup__C1 a) a)

@dedup__C0 = (* ({a c} (b f)))
  & @List/Cons ~ (a (e f))
  & @dedup ~ (d e)
  & @skip ~ (b (c d))

@dedup__C1 = (?((@List/Nil @dedup__C0) a) a)

@merge = ((@merge__C9 a) a)

@merge__C0 = ({a c} (b (f (e i))))
  & @List/Cons ~ (a (h i))
  & @merge ~ (d (g h))
  & @skip ~ (b (c d))
  & @skip ~ (e (f g))

@merge__C1 = (* (b (c ({a f} (e i)))))
  & @List/Cons ~ (a (h i))
  & @merge ~ (d (g h))
  & @List/Cons ~ (b (c d))
  & @skip ~ (e (f g))

@merge__C2 = ({$([>] $(a ?((@merge__C0 @merge__C1) (b (c (d e)))))) b} (c ({a d} e)))

@merge__C3 = (* ({a c} (b (e (f i)))))
  & @List/Cons ~ (a (h i))
  & @merge ~ (d (g h))
  & @skip ~ (b (c d))
  & @List/Cons ~ (e (f g))

@merge__C4 = (a (b d))
  & @dedup ~ (c d)
  & @List/Cons ~ (a (b c))

@merge__C5 = (* ({a d} (e ({$([<] $(a ?((@merge__C2 @merge__C3) (b (c (d (e f))))))) b} (c f)))))

@merge__C6 = (?((@merge__C4 @merge__C5) a) a)

@merge__C7 = a
  & @dedup ~ a

@merge__C8 = (* (a (b ((@merge__C6 (a (b c))) c))))

@merge__C9 = (?((@merge__C7 @merge__C8) a) a)

@prog = ((a b) c)
  & @merge ~ (a (b c))

@skip = ((@skip__C3 a) a)

@skip__C0 = (* a)
  & @List/Cons ~ a

@skip__C1 = (* (b (* (a c))))
  & @skip ~ (a (b c))

@skip__C2 = (* ({$([=] $(a ?((@skip__C0 @skip__C1) (b (c (d e)))))) c} (d ({a b} e))))

@skip__C3 = (?(((* @List/Nil) @skip__C2) a) a)


