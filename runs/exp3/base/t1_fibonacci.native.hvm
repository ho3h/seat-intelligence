// @fib returns (F_n, F_(n+1)).
@prog = (n out)
  & @fib ~ (n (f next))
  & f ~ out
  & next ~ *

@fib = (?((@fib_zero @fib_succ) ctx) ctx)

@fib_zero = out
  & out ~ (0 1)

@fib_succ = (m out)
  & m ~ $([+1] n)
  & n ~ {n1 n2}
  & n1 ~ $([/] $(2 half))
  & n2 ~ $([%] $(2 parity))
  & @fib ~ (half (a b))
  & a ~ {a1 ar1}
  & ar1 ~ {a2 ar2}
  & ar2 ~ {a3 a4}
  & b ~ {b1 br1}
  & br1 ~ {b2 br2}
  & br2 ~ {b3 b4}
  & b1 ~ $([+] $(b2 twice))
  & twice ~ $([-] $(a1 term))
  & a2 ~ $([*] $(term c))
  & a3 ~ $([*] $(a4 asq))
  & b3 ~ $([*] $(b4 bsq))
  & asq ~ $([+] $(bsq d))
  & c ~ {c_keep c_add}
  & d ~ {d_keep d_add}
  & c_add ~ $([+] $(d_add sum))
  & parity ~ ?((@fib_even @fib_odd) (c_keep (d_keep (sum out))))

@fib_even = (c (d (sum out)))
  & sum ~ *
  & out ~ (c d)

@fib_odd = (* (c (d (sum out))))
  & c ~ *
  & out ~ (d sum)
