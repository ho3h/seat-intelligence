// Merge the sorted lists, then remove adjacent duplicates.
@prog = ((xs ys) out)
  & @merge ~ (xs (ys merged))
  & @dedup ~ (merged (0 (0 out)))

@merge = ((?((@mxnil @mxcons) (px (ys out))) px) (ys out))

@mxnil = (* (ys out))
  & ys ~ out

@mxcons = (* ((h t) (ys out)))
  & @merge_y ~ (ys (h (t out)))

@merge_y = ((?((@mynil @mycons) (py (h (t out)))) py) (h (t out)))

@mynil = (* (h (t out)))
  & out ~ (1 (h t))

@mycons = (* ((g u) (h (t out))))
  & h ~ {hc hs}
  & g ~ {gc gs}
  & hc ~ $([<] $(gc z))
  & z ~ ?((@my_ge @my_lt) (hs (gs (t (u out)))))

@my_ge = (hs (gs (t (u out))))
  & @merge ~ ((1 (hs t)) (u r))
  & out ~ (1 (gs r))

@my_lt = (* (hs (gs (t (u out)))))
  & @merge ~ (t ((1 (gs u)) r))
  & out ~ (1 (hs r))

@dedup = ((?((@dnil @dcons) (p (have (prev out)))) p) (have (prev out)))

@dnil = (* (have (prev out)))
  & have ~ *
  & prev ~ *
  & out ~ (0 *)

@dcons = (* ((h t) (have (prev out))))
  & have ~ ?((@dfirst @dmore) (h (t (prev out))))

@dfirst = (h (t (prev out)))
  & prev ~ *
  & h ~ {emit newprev}
  & @dedup ~ (t (1 (newprev rest)))
  & out ~ (1 (emit rest))

@dmore = (* (h (t (prev out))))
  & h ~ {hc hkeep}
  & prev ~ {pc pkeep}
  & hc ~ $([=] $(pc z))
  & z ~ ?((@ddiff @dsame) (hkeep (pkeep (t out))))

@dsame = (* (hkeep (pkeep (t out))))
  & hkeep ~ *
  & @dedup ~ (t (1 (pkeep out)))

@ddiff = (hkeep (pkeep (t out)))
  & pkeep ~ *
  & hkeep ~ {emit newprev}
  & @dedup ~ (t (1 (newprev rest)))
  & out ~ (1 (emit rest))
