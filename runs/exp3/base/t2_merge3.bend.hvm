@List/Cons = (a (b ((1 (a (b c))) c)))

@merge = ((@merge__C6 a) a)

@merge__C0 = (b (c (a (e g))))
  & @List/Cons ~ (a (f g))
  & @merge ~ (d (e f))
  & @List/Cons ~ (b (c d))

@merge__C1 = (* (a (b (c (d g)))))
  & @List/Cons ~ (a (f g))
  & @merge ~ (b (e f))
  & @List/Cons ~ (c (d e))

@merge__C2 = a
  & @List/Cons ~ a

@merge__C3 = (* ({a e} (f ({$([>] $(a b)) c} (d g)))))
  & $(b ?((@merge__C0 @merge__C1) (c (d (e (f g)))))) ~ [=0x0000000]

@merge__C4 = (?((@merge__C2 @merge__C3) a) a)

@merge__C5 = (* (a (b ((@merge__C4 (a (b c))) c))))

@merge__C6 = (?(((a a) @merge__C5) b) b)

@prog = ((a (b d)) e)
  & @merge ~ (c (d e))
  & @merge ~ (a (b c))


