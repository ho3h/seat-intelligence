  & @List/Cons ~ (z (ob pb))
  & @List/Cons ~ (ab (nb ob))
  & @List/Cons ~ (bb (mb nb))
  & @List/Cons ~ (cb (lb mb))
  & @List/Cons ~ (db (kb lb))
  & @List/Cons ~ (eb (jb kb))
  & @List/Cons ~ (fb (ib jb))
  & @build ~ (gb (hb ib))

@prog = a
  & @build ~ (0 a)


