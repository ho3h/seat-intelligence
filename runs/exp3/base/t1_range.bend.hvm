  & @List/Cons ~ (l (cc dc))
  & @List/Cons ~ (m (bc cc))
  & @List/Cons ~ (n (ac bc))
  & @List/Cons ~ (o (zb ac))
  & @List/Cons ~ (p (yb zb))
  & @List/Cons ~ (q (xb yb))
  & @List/Cons ~ (r (wb xb))
  & @List/Cons ~ (s (vb wb))
  & @List/Cons ~ (t (ub vb))
