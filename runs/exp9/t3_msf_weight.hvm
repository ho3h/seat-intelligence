  & n ~ {n1 n2}
  & 1 ~ $([<<] $(l3 half))
  & b2 ~ $([+] $(half bR))
  & @ki ~ (a (l1 (b1 (n1 x))))
  & @ki ~ (b (l2 (bR (n2 y))))
@ki0 = (g (L (base (n o))))
  & L ~ ?((@ki0_leaf @ki0_node) (g (base (n o))))
@ki0_leaf = (l (i (n (pk l))))
  & i ~ {i1 i2}
  & i1 ~ $([<] $(n inr))
