@tr_go = (v (D (A (E ((1 (a rest)) b)))))
  & D ~ {D1 D2}
  & A ~ {A1 A2}
  & E ~ {Ex {Ey Ez}}
  & Ex ~ (* (L *))
  & @lk ~ (D1 (v (L pk)))
  & pk ~ $([&] $(4095 a0))
  & a0 ~ {a a1}
  & Ey ~ (* (* La))
  & @lk ~ (A1 (a1 (La (u (* c)))))
  & @tr ~ (u (D2 (A2 (Ez (rest b0)))))
