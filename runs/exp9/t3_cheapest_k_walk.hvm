// t3_cheapest_k_walk (GRAPH-SWING-2, runs/exp9): k ungated (min, +) push rounds (rounds template), the same net as
// walk_count with a min-update and a saturating add (a candidate from an INF leaf stays INF).
@prog = ((n (s (t (k es)))) out)
  & n ~ ?((@ck_zero @ck_pos) (s (t (k (es out)))))
@ck_zero = (* (* (* (* 16777215))))
@ck_pos = (nm1 (s (t (k (es out)))))
  & nm1 ~ {a b}
  & a ~ $([+1] n)
  & @lg ~ (b L)
  & L ~ {L1 {L2 {L3 {L4 {L5 L6}}}}}
  & n ~ {n1 n2}
  & @zl ~ (L1 G0)
  & @w_blk ~ (es ((L2 G0) G))
  & s ~ {s1 s2}
  & s1 ~ $([<] $(n1 inr))
  & inr ~ {i1 i2}
  & s2 ~ $([*] $(i1 key))
  & i2 ~ ?((16777215 (* 0)) val)
  & @zi ~ (L3 Z)
  & @mu ~ (Z (key (L4 (val C0))))
  & @wr ~ (k (G (C0 (L5 Cf))))
  & @get ~ (Cf (t (n2 (L6 out))))
@ck_step = ((L g) ((u (v w)) (L2 g2)))
  & L ~ {L1 L2}
  & @gp ~ (g (u (L1 ((v w) g2))))
@ck_fin = ((* g) g)
@re_zero = (L z)
  & @zi ~ (L z)
@re_emit = ((?((@km_nil @km_cons) (p (c (z (l2 (zo Lf)))))) p) (c (z (l2 (zo Lf)))))
@km_nil = (* (* (z ((0 *) (z *)))))
@km_cons = (* (((v w) rest) (c (z ((1 ((v2 w2) rest2)) (zo Lf))))))
  & v ~ {v1 v2}
  & w ~ {w1 w2}
  & c ~ {c1 {c2 c3}}
  & Lf ~ {f1 f2}
  & c1 ~ $([+] $(w1 sm))
  & c2 ~ $([>>] $(23 hi))
  & hi ~ $([*] $(16777215 msk))
  & sm ~ $([|] $(msk cand))
  & @mu ~ (z (v1 (f1 (cand zm))))
  & @re_emit ~ (rest (c3 (zm (rest2 (zo f2)))))
@w_blk = (t (S0 o0))
  & t ~ (T1 (E1 (T2 (E2 (T3 (E3 (T4 (E4 (T5 (E5 (T6 (E6 (T7 (E7 (T8 (E8 (T9 (E9 (T10 (E10 (T11 (E11 (T12 (E12 (T13 (E13 (T14 (E14 (T15 (E15 (T16 (E16 t16))))))))))))))))))))))))))))))))
  & T1 ~ ?((@w_nil @w_cons) (S0 (o0 (E1 (S1 o1)))))
  & T2 ~ ?((@w_nil @w_cons) (S1 (o1 (E2 (S2 o2)))))
  & T3 ~ ?((@w_nil @w_cons) (S2 (o2 (E3 (S3 o3)))))
  & T4 ~ ?((@w_nil @w_cons) (S3 (o3 (E4 (S4 o4)))))
  & T5 ~ ?((@w_nil @w_cons) (S4 (o4 (E5 (S5 o5)))))
  & T6 ~ ?((@w_nil @w_cons) (S5 (o5 (E6 (S6 o6)))))
  & T7 ~ ?((@w_nil @w_cons) (S6 (o6 (E7 (S7 o7)))))
  & T8 ~ ?((@w_nil @w_cons) (S7 (o7 (E8 (S8 o8)))))
  & T9 ~ ?((@w_nil @w_cons) (S8 (o8 (E9 (S9 o9)))))
  & T10 ~ ?((@w_nil @w_cons) (S9 (o9 (E10 (S10 o10)))))
  & T11 ~ ?((@w_nil @w_cons) (S10 (o10 (E11 (S11 o11)))))
  & T12 ~ ?((@w_nil @w_cons) (S11 (o11 (E12 (S12 o12)))))
  & T13 ~ ?((@w_nil @w_cons) (S12 (o12 (E13 (S13 o13)))))
  & T14 ~ ?((@w_nil @w_cons) (S13 (o13 (E14 (S14 o14)))))
  & T15 ~ ?((@w_nil @w_cons) (S14 (o14 (E15 (S15 o15)))))
  & T16 ~ ?((@w_nil @w_last) (S15 (o15 (E16 t16))))
@w_nil = (S (o *))
  & @ck_fin ~ (S o)
@w_cons = (* (S (o (E (S2 o)))))
  & @ck_step ~ (S (E S2))
@w_last = (* (S (o (E t))))
  & @ck_step ~ (S (E S2))
  & @w_blk ~ (t (S2 o))

@wr = (k (G (C (L o))))
  & k ~ ?((@wr_done @wr_step) (G (C (L o))))
@wr_done = (* (C (* C)))
@wr_step = (km (G (C (L o))))
  & L ~ {L1 {L2 {L3 L4}}}
  & @re_zero ~ (L1 z)
  & @ws ~ (L2 (L3 (G (C (z (G2 C2))))))
  & @wr ~ (km (G2 (C2 (L4 o))))
@ws = (Lr (Lf (g (c (z (g2 zo))))))
  & Lr ~ ?((@ws_leaf @ws_node) (Lf (g (c (z (g2 zo))))))
@ws_leaf = (Lf (lst (cv (z (lst2 zo)))))
  & @re_emit ~ (lst (cv (z (lst2 (zo Lf)))))
@ws_node = (lm (Lf ((ga gb) ((ca cb) (z ((ha hb) zo))))))
  & lm ~ {l1 l2}
  & Lf ~ {f1 f2}
  & @ws ~ (l1 (f1 (ga (ca (z (ha zm))))))
  & @ws ~ (l2 (f2 (gb (cb (zm (hb zo))))))

@get = (D (t (n (L o))))
  & @getd ~ (D (t (n (L (16777215 o)))))
@getd = (D (t (n (L (df o)))))
  & t ~ {t1 t2}
  & t1 ~ $([<] $(n inr))
  & inr ~ ?((@get_out @get_in) (D (t2 (L (df o)))))
@get_out = (* (* (* (df df))))
@get_in = (* (D (t (L (* o)))))
  & @lk ~ (D (t (L o)))
@lk = (D (k (L o)))
  & L ~ ?((@lk_leaf @lk_node) (D (k o)))
@lk_leaf = (x (* x))
@lk_node = (lm (D (k o)))
  & k ~ {k1 k2}
  & lm ~ {l1 l2}
  & k1 ~ $([>>] $(l1 sh))
  & sh ~ $([&] $(1 b))
  & b ~ ?((@lk_L @lk_R) (D (k2 (l2 o))))
@lk_L = ((l *) (k (L o)))
  & @lk ~ (l (k (L o)))
@lk_R = (* ((* r) (k (L o))))
  & @lk ~ (r (k (L o)))
// ---- shared SSSP core (GRAPH-SWING, runs/exp5): frontier Bellman-Ford over tries.
// G: adjacency trie keyed by vertex, leaves are lists of (v w). Dt: distance trie. C: candidate trie of this round.
// One round = one pre-expanded traversal of (G, Dt, C): at each leaf, d' = min(d, c) (accepted only if c <= budget);
// a leaf that improved emits d'+w into the NEXT round's candidate trie for each of its out-edges (min-updates, keyed
// by v, threaded through the traversal in order); flags are OR-reduced; the loop continues while anything improved.
// E = (L b): trie depth and budget (b = 16777215 means no budget).
@loop = ((g (dt (c E))) o)
  & E ~ {E1 {E2 E3}}
  & E1 ~ (L1 *)
  & @zi ~ (L1 ci)
  & E2 ~ {Ea Eb}
  & Ea ~ (Lr *)
  & @rd ~ (Lr (Eb (g (dt (c (ci (g2 (dt2 (co any)))))))))
  & any ~ ?((@lp_done @lp_again) (g2 (dt2 (co (E3 o)))))
@lp_done = (* (dt (* (* dt))))
@lp_again = (* (g (dt (c (E o)))))
  & @loop ~ ((g (dt (c E))) o)

@rd = (L (E (g (dt (c (ci (g2 (dt2 (co any)))))))))
  & L ~ ?((@rd_leaf @rd_node) (E (g (dt (c (ci (g2 (dt2 (co any)))))))))
@rd_node = (lm (E ((g1 gr) ((d1 dr) ((c1 cr) (ci ((h1 hr) ((e1 er) (co any)))))))))
  & lm ~ {l1 l2}
  & E ~ {Ea Eb}
  & @rd ~ (l1 (Ea (g1 (d1 (c1 (ci (h1 (e1 (cm a1)))))))))
  & @rd ~ (l2 (Eb (gr (dr (cr (cm (hr (er (co a2)))))))))
  & a1 ~ $([|] $(a2 any))
@rd_leaf = (E (g (d (c (ci (g2 (d2 (co any))))))))
  & c ~ {c1 {c2 c3}}
  & d ~ {dA dB}
  & E ~ {Ex Ey}
  & Ey ~ (* b)
  & c1 ~ $([<] $(dA lt))
  & c2 ~ $([>] $(b gt))
  & lt ~ $([>] $(gt f))
  & f ~ {f1 {any f3}}
  & f1 ~ ?((@rl_keep @rl_take) (dB (c3 nd)))
  & nd ~ {nd1 d2}
  & f3 ~ ?((@rl_quiet @rl_emit) (g (nd1 (ci (g2 (co Ex))))))
@rl_keep = (d (* d))
@rl_take = (* (* (c c)))
@rl_quiet = (g (* (ci (g (ci *)))))
@rl_emit = (* (g (nd (ci (g2 (co E))))))
  & E ~ (L *)
  & @em ~ (g (nd (ci (g2 (co L)))))

// emit nd+w into the candidate trie for every (v w) of the adjacency list, rebuilding the list
@em = ((?((@em_nil @em_cons) (p (nd (ci (g2 (co L)))))) p) (nd (ci (g2 (co L)))))
@em_nil = (* (* (ci ((0 *) (ci *)))))
@em_cons = (* (((v w) rest) (nd (ci ((1 ((v2 w2) rest2)) (co L))))))
  & v ~ {v1 v2}
  & w ~ {w1 w2}
  & nd ~ {n1 n2}
  & L ~ {La Lb}
  & n1 ~ $([+] $(w1 cand))
  & @mu ~ (ci (v1 (La (cand cm))))
  & @em ~ (rest (n2 (cm (rest2 (co Lb)))))

// leaf actions for nav(): min-update, and push (v w) onto an adjacency list
@mu_act = (old (cand o))
  & old ~ {o1 o2}
  & cand ~ {k1 k2}
  & k1 ~ $([<] $(o1 lt))
  & lt ~ ?((@mu_keep @mu_take) (o2 (k2 o)))
@mu_keep = (x (* x))
@mu_take = (* (* (y y)))
@gp_act = (lst ((v w) (1 ((v w) lst))))

// tries with constant leaves: 16777215, and empty lists
@zi = (?((16777215 @zi_node) o) o)
@zi_node = (lm (a b))
  & lm ~ {l1 l2}
  & @zi ~ (l1 a)
  & @zi ~ (l2 b)
@zl = (?(((0 *) @zl_node) o) o)
@zl_node = (lm (a b))
  & lm ~ {l1 l2}
  & @zl ~ (l1 a)
  & @zl ~ (l2 b)

// initial state: (G, Dt = all INF, C0 = 0 at s if s < n), then the loop; o receives the final distance trie
@sssp_start = (n (s (L (b (g o)))))
  & s ~ {s1 s2}
  & n ~ {n1 n2}
  & n1 ~ *
  & s1 ~ $([<] $(n2 inr))
  & inr ~ {i1 i2}
  & s2 ~ $([*] $(i1 key))
  & i2 ~ ?((16777215 (* 0)) val)
  & L ~ {L1 {L2 {L3 L4}}}
  & @zi ~ (L1 D0)
  & @zi ~ (L2 Ci)
  & @mu ~ (Ci (key (L3 (val C0))))
  & @loop ~ ((g (D0 (C0 (L4 b)))) o)
@mu = (t (k (L (P o))))
  & L ~ ?((@mu_leaf @mu_node) (t (k (P o))))
@mu_leaf = (t (* (P o)))
  & @mu_act ~ (t (P o))
@mu_node = (lm (t (k (P o))))
  & k ~ {k1 k2}
  & lm ~ {l1 l2}
  & k1 ~ $([>>] $(l1 sh))
  & sh ~ $([&] $(1 b))
  & b ~ ?((@mu_L @mu_R) (t (k2 (l2 (P o)))))
@mu_L = ((l r) (k (L (P (l2 r)))))
  & @mu ~ (l (k (L (P l2))))
@mu_R = (* ((l r) (k (L (P (l r2))))))
  & @mu ~ (r (k (L (P r2))))
@gp = (t (k (L (P o))))
  & L ~ ?((@gp_leaf @gp_node) (t (k (P o))))
@gp_leaf = (t (* (P o)))
  & @gp_act ~ (t (P o))
@gp_node = (lm (t (k (P o))))
  & k ~ {k1 k2}
  & lm ~ {l1 l2}
  & k1 ~ $([>>] $(l1 sh))
  & sh ~ $([&] $(1 b))
  & b ~ ?((@gp_L @gp_R) (t (k2 (l2 (P o)))))
@gp_L = ((l r) (k (L (P (l2 r)))))
  & @gp ~ (l (k (L (P l2))))
@gp_R = (* ((l r) (k (L (P (l r2))))))
  & @gp ~ (r (k (L (P r2))))
// ---- shared trie primitives (depth-L complete binary trie, leaves are numbers, keyed by bits of the key, high bit first)
// lg(x) = number of bits of x (0 for 0): trie depth for keys 0..x
@lg = (?((0 @lg_s) o) o)
@lg_s = (xm o)
  & xm ~ $([+1] x)
  & x ~ $([>>] $(1 y))
  & @lg ~ (y z)
  & z ~ $([+1] o)

// zt(L): trie of depth L with all leaves 0
@zt = (?((0 @zt_node) o) o)
@zt_node = (lm (a b))
  & lm ~ {l1 l2}
  & @zt ~ (l1 a)
  & @zt ~ (l2 b)

// cnt(t, L): sum of the leaves
@cnt = (t (L o))
  & L ~ ?((@cnt_leaf @cnt_node) (t o))
@cnt_leaf = (x x)
@cnt_node = (lm ((a b) o))
  & lm ~ {l1 l2}
  & @cnt ~ (a (l1 x))
  & @cnt ~ (b (l2 y))
  & x ~ $([+] $(y o))

// ins(t, k, L): set leaf k to 1. Control flow depends on k and L only, so it expands before t exists.
@ins = (t (k (L o)))
  & L ~ ?((@ins_leaf @ins_node) (t (k o)))
@ins_leaf = (* (* 1))
@ins_node = (lm (t (k o)))
  & k ~ {k1 k2}
  & lm ~ {l1 l2}
  & k1 ~ $([>>] $(l1 sh))
  & sh ~ $([&] $(1 b))
  & b ~ ?((@ins_L @ins_R) (t (k2 (l2 o))))
@ins_L = ((l r) (k (L (l2 r))))
  & @ins ~ (l (k (L l2)))
@ins_R = (* ((l r) (k (L (l r2)))))
  & @ins ~ (r (k (L r2)))
