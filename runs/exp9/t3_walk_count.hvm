// t3_walk_count (GRAPH-SWING-2, runs/exp9): k UNGATED push rounds over tries (new template `rounds`). The round count
// is an input, so no convergence test sits between rounds: every vertex pushes its count to all out-neighbours
// every round (keyed nav adds into a fresh zero trie), and because each round's control flow depends only on the
// adjacency and k, round r+1's structure expands while round r's numbers are still flowing.
@prog = ((n (s (t (k es)))) out)
  & n ~ ?((@wc_zero @wc_pos) (s (t (k (es out)))))
@wc_zero = (* (* (* (* 0))))
@wc_pos = (nm1 (s (t (k (es out)))))
  & nm1 ~ {a b}
  & a ~ $([+1] n)
  & @lg ~ (b L)
  & L ~ {L1 {L2 {L3 {L4 {L5 L6}}}}}
  & n ~ {n1 n2}
  & @zl ~ (L1 G0)
  & @w_blk ~ (es ((L2 G0) G))
  & s ~ {s1 s2}
  & s1 ~ $([<] $(n1 inr))
  & inr ~ {i1 i2}
  & s2 ~ $([*] $(i1 key))
  & @zt ~ (L3 Z)
  & @ad ~ (Z (key (L4 (i2 C0))))
  & @wr ~ (k (G (C0 (L5 Cf))))
  & @getd ~ (Cf (t (n2 (L6 (0 out)))))
@wc_step = ((L g) ((u v) (L2 g2)))
  & L ~ {L1 L2}
  & @pn ~ (g (u (L1 (v g2))))
@wc_fin = ((* g) g)
@re_zero = (L z)
  & @zt ~ (L z)
@re_emit = ((?((@wm_nil @wm_cons) (p (c (z (l2 (zo Lf)))))) p) (c (z (l2 (zo Lf)))))
@wm_nil = (* (* (z ((0 *) (z *)))))
@wm_cons = (* ((v rest) (c (z ((1 (v2 rest2)) (zo Lf))))))
  & v ~ {v1 v2}
  & c ~ {c1 c2}
  & Lf ~ {f1 f2}
  & @ad ~ (z (v1 (f1 (c1 zm))))
  & @re_emit ~ (rest (c2 (zm (rest2 (zo f2)))))
@w_blk = (t (S0 o0))
  & t ~ (T1 (E1 (T2 (E2 (T3 (E3 (T4 (E4 (T5 (E5 (T6 (E6 (T7 (E7 (T8 (E8 (T9 (E9 (T10 (E10 (T11 (E11 (T12 (E12 (T13 (E13 (T14 (E14 (T15 (E15 (T16 (E16 t16))))))))))))))))))))))))))))))))
  & T1 ~ ?((@w_nil @w_cons) (S0 (o0 (E1 (S1 o1)))))
  & T2 ~ ?((@w_nil @w_cons) (S1 (o1 (E2 (S2 o2)))))
  & T3 ~ ?((@w_nil @w_cons) (S2 (o2 (E3 (S3 o3)))))
  & T4 ~ ?((@w_nil @w_cons) (S3 (o3 (E4 (S4 o4)))))
  & T5 ~ ?((@w_nil @w_cons) (S4 (o4 (E5 (S5 o5)))))
  & T6 ~ ?((@w_nil @w_cons) (S5 (o5 (E6 (S6 o6)))))
  & T7 ~ ?((@w_nil @w_cons) (S6 (o6 (E7 (S7 o7)))))
  & T8 ~ ?((@w_nil @w_cons) (S7 (o7 (E8 (S8 o8)))))
  & T9 ~ ?((@w_nil @w_cons) (S8 (o8 (E9 (S9 o9)))))
  & T10 ~ ?((@w_nil @w_cons) (S9 (o9 (E10 (S10 o10)))))
  & T11 ~ ?((@w_nil @w_cons) (S10 (o10 (E11 (S11 o11)))))
  & T12 ~ ?((@w_nil @w_cons) (S11 (o11 (E12 (S12 o12)))))
  & T13 ~ ?((@w_nil @w_cons) (S12 (o12 (E13 (S13 o13)))))
  & T14 ~ ?((@w_nil @w_cons) (S13 (o13 (E14 (S14 o14)))))
  & T15 ~ ?((@w_nil @w_cons) (S14 (o14 (E15 (S15 o15)))))
  & T16 ~ ?((@w_nil @w_last) (S15 (o15 (E16 t16))))
@w_nil = (S (o *))
  & @wc_fin ~ (S o)
@w_cons = (* (S (o (E (S2 o)))))
  & @wc_step ~ (S (E S2))
@w_last = (* (S (o (E t))))
  & @wc_step ~ (S (E S2))
  & @w_blk ~ (t (S2 o))

@wr = (k (G (C (L o))))
  & k ~ ?((@wr_done @wr_step) (G (C (L o))))
@wr_done = (* (C (* C)))
@wr_step = (km (G (C (L o))))
  & L ~ {L1 {L2 {L3 L4}}}
  & @re_zero ~ (L1 z)
  & @ws ~ (L2 (L3 (G (C (z (G2 C2))))))
  & @wr ~ (km (G2 (C2 (L4 o))))
@ws = (Lr (Lf (g (c (z (g2 zo))))))
  & Lr ~ ?((@ws_leaf @ws_node) (Lf (g (c (z (g2 zo))))))
@ws_leaf = (Lf (lst (cv (z (lst2 zo)))))
  & @re_emit ~ (lst (cv (z (lst2 (zo Lf)))))
@ws_node = (lm (Lf ((ga gb) ((ca cb) (z ((ha hb) zo))))))
  & lm ~ {l1 l2}
  & Lf ~ {f1 f2}
  & @ws ~ (l1 (f1 (ga (ca (z (ha zm))))))
  & @ws ~ (l2 (f2 (gb (cb (zm (hb zo))))))

@get = (D (t (n (L o))))
  & @getd ~ (D (t (n (L (16777215 o)))))
@getd = (D (t (n (L (df o)))))
  & t ~ {t1 t2}
  & t1 ~ $([<] $(n inr))
  & inr ~ ?((@get_out @get_in) (D (t2 (L (df o)))))
@get_out = (* (* (* (df df))))
@get_in = (* (D (t (L (* o)))))
  & @lk ~ (D (t (L o)))
@lk = (D (k (L o)))
  & L ~ ?((@lk_leaf @lk_node) (D (k o)))
@lk_leaf = (x (* x))
@lk_node = (lm (D (k o)))
  & k ~ {k1 k2}
  & lm ~ {l1 l2}
  & k1 ~ $([>>] $(l1 sh))
  & sh ~ $([&] $(1 b))
  & b ~ ?((@lk_L @lk_R) (D (k2 (l2 o))))
@lk_L = ((l *) (k (L o)))
  & @lk ~ (l (k (L o)))
@lk_R = (* ((* r) (k (L o))))
  & @lk ~ (r (k (L o)))
@ad_act = (old (c o))
  & old ~ $([+] $(c o))
@pn_act = (lst (x (1 (x lst))))
@pn = (t (k (L (P o))))
  & L ~ ?((@pn_leaf @pn_node) (t (k (P o))))
@pn_leaf = (t (* (P o)))
  & @pn_act ~ (t (P o))
@pn_node = (lm (t (k (P o))))
  & k ~ {k1 k2}
  & lm ~ {l1 l2}
  & k1 ~ $([>>] $(l1 sh))
  & sh ~ $([&] $(1 b))
  & b ~ ?((@pn_L @pn_R) (t (k2 (l2 (P o)))))
@pn_L = ((l r) (k (L (P (l2 r)))))
  & @pn ~ (l (k (L (P l2))))
@pn_R = (* ((l r) (k (L (P (l r2))))))
  & @pn ~ (r (k (L (P r2))))
@ad = (t (k (L (P o))))
  & L ~ ?((@ad_leaf @ad_node) (t (k (P o))))
@ad_leaf = (t (* (P o)))
  & @ad_act ~ (t (P o))
@ad_node = (lm (t (k (P o))))
  & k ~ {k1 k2}
  & lm ~ {l1 l2}
  & k1 ~ $([>>] $(l1 sh))
  & sh ~ $([&] $(1 b))
  & b ~ ?((@ad_L @ad_R) (t (k2 (l2 (P o)))))
@ad_L = ((l r) (k (L (P (l2 r)))))
  & @ad ~ (l (k (L (P l2))))
@ad_R = (* ((l r) (k (L (P (l r2))))))
  & @ad ~ (r (k (L (P r2))))
@zl = (?(((0 *) @zl_node) o) o)
@zl_node = (lm (a b))
  & lm ~ {l1 l2}
  & @zl ~ (l1 a)
  & @zl ~ (l2 b)

// ---- shared trie primitives (depth-L complete binary trie, leaves are numbers, keyed by bits of the key, high bit first)
// lg(x) = number of bits of x (0 for 0): trie depth for keys 0..x
@lg = (?((0 @lg_s) o) o)
@lg_s = (xm o)
  & xm ~ $([+1] x)
  & x ~ $([>>] $(1 y))
  & @lg ~ (y z)
  & z ~ $([+1] o)

// zt(L): trie of depth L with all leaves 0
@zt = (?((0 @zt_node) o) o)
@zt_node = (lm (a b))
  & lm ~ {l1 l2}
  & @zt ~ (l1 a)
  & @zt ~ (l2 b)

// cnt(t, L): sum of the leaves
@cnt = (t (L o))
  & L ~ ?((@cnt_leaf @cnt_node) (t o))
@cnt_leaf = (x x)
@cnt_node = (lm ((a b) o))
  & lm ~ {l1 l2}
  & @cnt ~ (a (l1 x))
  & @cnt ~ (b (l2 y))
  & x ~ $([+] $(y o))

// ins(t, k, L): set leaf k to 1. Control flow depends on k and L only, so it expands before t exists.
@ins = (t (k (L o)))
  & L ~ ?((@ins_leaf @ins_node) (t (k o)))
@ins_leaf = (* (* 1))
@ins_node = (lm (t (k o)))
  & k ~ {k1 k2}
  & lm ~ {l1 l2}
  & k1 ~ $([>>] $(l1 sh))
  & sh ~ $([&] $(1 b))
  & b ~ ?((@ins_L @ins_R) (t (k2 (l2 o))))
@ins_L = ((l r) (k (L (l2 r))))
  & @ins ~ (l (k (L l2)))
@ins_R = (* ((l r) (k (L (l r2)))))
  & @ins ~ (r (k (L r2)))
