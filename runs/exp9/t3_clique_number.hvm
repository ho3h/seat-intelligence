@sel1 = (x (* x))
@sel2 = (* (y y))
@sel1s = (* (x (* x)))
@sel2s = (* (* (y y)))
@ad_act = (old (c o))
  & old ~ $([+] $(c o))
@pn_act = (lst (x (1 (x lst))))
@pn = (t (k (L (P o))))
