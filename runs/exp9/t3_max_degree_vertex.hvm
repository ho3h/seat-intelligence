// t3_max_degree_vertex (GRAPH-SWING-2, runs/exp9): degree trie by keyed increments while streaming the edges, then
// one argmax tree reduction (ties go to the left = smaller id).
@prog = ((n es) out)
  & n ~ ?((@md_zero @md_pos) (es out))
@md_zero = (* 16777215)
@md_pos = (nm1 (es out))
  & @lg ~ (nm1 L)
  & L ~ {L1 {L2 L3}}
  & @zt ~ (L1 T0)
  & @w_blk ~ (es ((L2 T0) T))
  & @amx ~ (T (L3 (0 (* out))))
@md_step = ((L t) ((u v) (L3 t2)))
  & L ~ {L1 {L2 L3}}
  & @ad ~ (t (u (L1 (1 t1))))
  & @ad ~ (t1 (v (L2 (1 t2))))
@md_fin = ((* t) t)
// amx(T, L, base) -> (max leaf, its index), ties to the left
@amx = (t (L (base o)))
  & L ~ ?((@amx_leaf @amx_node) (t (base o)))
@amx_leaf = (d (i (d i)))
@amx_node = (lm ((a b) (base o)))
  & lm ~ {l1 {l2 l3}}
  & base ~ {b1 b2}
  & 1 ~ $([<<] $(l3 half))
  & b2 ~ $([+] $(half bR))
  & @amx ~ (a (l1 (b1 ma)))
  & @amx ~ (b (l2 (bR mb)))
  & @axsel ~ (ma (mb o))
@axsel = ((ma ia) ((mb ib) o))
  & ma ~ {ma1 ma2}
  & mb ~ {mb1 mb2}
  & ma1 ~ $([<] $(mb1 lt))
  & lt ~ ?((@as_l @as_r) ((ma2 ia) ((mb2 ib) o)))
@as_l = (a (* a))
@as_r = (* (* (b b)))
@w_blk = (t (S0 o0))
  & t ~ (T1 (E1 (T2 (E2 (T3 (E3 (T4 (E4 (T5 (E5 (T6 (E6 (T7 (E7 (T8 (E8 (T9 (E9 (T10 (E10 (T11 (E11 (T12 (E12 (T13 (E13 (T14 (E14 (T15 (E15 (T16 (E16 t16))))))))))))))))))))))))))))))))
  & T1 ~ ?((@w_nil @w_cons) (S0 (o0 (E1 (S1 o1)))))
  & T2 ~ ?((@w_nil @w_cons) (S1 (o1 (E2 (S2 o2)))))
  & T3 ~ ?((@w_nil @w_cons) (S2 (o2 (E3 (S3 o3)))))
  & T4 ~ ?((@w_nil @w_cons) (S3 (o3 (E4 (S4 o4)))))
  & T5 ~ ?((@w_nil @w_cons) (S4 (o4 (E5 (S5 o5)))))
  & T6 ~ ?((@w_nil @w_cons) (S5 (o5 (E6 (S6 o6)))))
  & T7 ~ ?((@w_nil @w_cons) (S6 (o6 (E7 (S7 o7)))))
  & T8 ~ ?((@w_nil @w_cons) (S7 (o7 (E8 (S8 o8)))))
  & T9 ~ ?((@w_nil @w_cons) (S8 (o8 (E9 (S9 o9)))))
  & T10 ~ ?((@w_nil @w_cons) (S9 (o9 (E10 (S10 o10)))))
  & T11 ~ ?((@w_nil @w_cons) (S10 (o10 (E11 (S11 o11)))))
  & T12 ~ ?((@w_nil @w_cons) (S11 (o11 (E12 (S12 o12)))))
  & T13 ~ ?((@w_nil @w_cons) (S12 (o12 (E13 (S13 o13)))))
  & T14 ~ ?((@w_nil @w_cons) (S13 (o13 (E14 (S14 o14)))))
  & T15 ~ ?((@w_nil @w_cons) (S14 (o14 (E15 (S15 o15)))))
  & T16 ~ ?((@w_nil @w_last) (S15 (o15 (E16 t16))))
@w_nil = (S (o *))
  & @md_fin ~ (S o)
@w_cons = (* (S (o (E (S2 o)))))
  & @md_step ~ (S (E S2))
@w_last = (* (S (o (E t))))
  & @md_step ~ (S (E S2))
  & @w_blk ~ (t (S2 o))
@ad_act = (old (c o))
  & old ~ $([+] $(c o))
@ad = (t (k (L (P o))))
  & L ~ ?((@ad_leaf @ad_node) (t (k (P o))))
@ad_leaf = (t (* (P o)))
  & @ad_act ~ (t (P o))
@ad_node = (lm (t (k (P o))))
  & k ~ {k1 k2}
  & lm ~ {l1 l2}
  & k1 ~ $([>>] $(l1 sh))
  & sh ~ $([&] $(1 b))
  & b ~ ?((@ad_L @ad_R) (t (k2 (l2 (P o)))))
@ad_L = ((l r) (k (L (P (l2 r)))))
  & @ad ~ (l (k (L (P l2))))
@ad_R = (* ((l r) (k (L (P (l r2))))))
  & @ad ~ (r (k (L (P r2))))
// ---- shared trie primitives (depth-L complete binary trie, leaves are numbers, keyed by bits of the key, high bit first)
// lg(x) = number of bits of x (0 for 0): trie depth for keys 0..x
@lg = (?((0 @lg_s) o) o)
@lg_s = (xm o)
  & xm ~ $([+1] x)
  & x ~ $([>>] $(1 y))
  & @lg ~ (y z)
  & z ~ $([+1] o)

// zt(L): trie of depth L with all leaves 0
@zt = (?((0 @zt_node) o) o)
@zt_node = (lm (a b))
  & lm ~ {l1 l2}
  & @zt ~ (l1 a)
  & @zt ~ (l2 b)

// cnt(t, L): sum of the leaves
@cnt = (t (L o))
  & L ~ ?((@cnt_leaf @cnt_node) (t o))
@cnt_leaf = (x x)
@cnt_node = (lm ((a b) o))
  & lm ~ {l1 l2}
  & @cnt ~ (a (l1 x))
  & @cnt ~ (b (l2 y))
  & x ~ $([+] $(y o))

// ins(t, k, L): set leaf k to 1. Control flow depends on k and L only, so it expands before t exists.
@ins = (t (k (L o)))
  & L ~ ?((@ins_leaf @ins_node) (t (k o)))
@ins_leaf = (* (* 1))
@ins_node = (lm (t (k o)))
  & k ~ {k1 k2}
  & lm ~ {l1 l2}
  & k1 ~ $([>>] $(l1 sh))
  & sh ~ $([&] $(1 b))
  & b ~ ?((@ins_L @ins_R) (t (k2 (l2 o))))
@ins_L = ((l r) (k (L (l2 r))))
  & @ins ~ (l (k (L l2)))
@ins_R = (* ((l r) (k (L (l r2)))))
  & @ins ~ (r (k (L r2)))
