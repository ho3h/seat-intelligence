// t3_greedy_coloring (GRAPH-SWING-2, runs/exp9): the greedy recursion col(v) = mex{col(u) : u < v, u ~ v} built
// directly as a dataflow net (the exp5 dag_longest pattern). Streaming the edges: each edge (lo, hi) pushes a reply
// wire x onto the multicast chain of lo (request trie Q) and ORs (1 << x) into hi's mask accumulator (trie A).
// fin wires mex(A[v]) into chain v; chain ends are the colours; tl flattens them. No rounds: colours ripple along
// increasing-id paths. Limitation: masks are 24-bit, so a vertex with >= 24 lower neighbours all forced into
// distinct colours >= 23 would be wrong (never met at these sizes: colour <= #lower neighbours).
@prog = ((n es) out)
  & n ~ ?((@gc_zero @gc_pos) (es out))
@gc_zero = (* (0 *))
@gc_pos = (nm1 (es out))
  & nm1 ~ {a b}
  & a ~ $([+1] n)
  & @lg ~ (b L)
  & L ~ {L1 {L2 {L3 {L4 L5}}}}
  & @zt ~ (L1 A0)
  & @zq ~ (L2 Q0)
  & @w_blk ~ (es ((L3 (A0 Q0)) (Af Qf)))
  & @zc ~ (Af (Qf (L4 C)))
  & @tl ~ (C (L5 (0 (n ((0 *) out)))))
@gc_step = ((L (A Q)) ((a b) (L3 (A2 Q2))))
  & a ~ {a1 a2}
  & b ~ {b1 b2}
  & a1 ~ $([<] $(b1 lt))
  & lt ~ ?((@gc_swap @gc_keep) (a2 (b2 (u v))))
  & L ~ {L1 {L2 L3}}
  & @pu ~ (Q (u (L1 (x Q2))))
  & 1 ~ $([<<] $(x y))
  & @oa ~ (A (v (L2 (y A2))))
@gc_swap = (a (b (b a)))
@gc_keep = (* (a (b (a b))))
@gc_fin = ((* s) s)
@oa_act = (old (y o))
  & old ~ $([|] $(y o))
// zc(A, Q, L): trie of chain ends; leaf v: mex(A[v]) enters chain v, the chain's end is the colour itself
@zc = (a (q (L o)))
  & L ~ ?((@zc_leaf @zc_node) (a (q o)))
@zc_leaf = (a ((c o) o))
  & @mex ~ (a c)
@zc_node = (lm ((a1 a2) ((q1 q2) (x y))))
  & lm ~ {l1 l2}
  & @zc ~ (a1 (q1 (l1 x)))
  & @zc ~ (a2 (q2 (l2 y)))
@w_blk = (t (S0 o0))
  & t ~ (T1 (E1 (T2 (E2 (T3 (E3 (T4 (E4 (T5 (E5 (T6 (E6 (T7 (E7 (T8 (E8 (T9 (E9 (T10 (E10 (T11 (E11 (T12 (E12 (T13 (E13 (T14 (E14 (T15 (E15 (T16 (E16 t16))))))))))))))))))))))))))))))))
  & T1 ~ ?((@w_nil @w_cons) (S0 (o0 (E1 (S1 o1)))))
  & T2 ~ ?((@w_nil @w_cons) (S1 (o1 (E2 (S2 o2)))))
  & T3 ~ ?((@w_nil @w_cons) (S2 (o2 (E3 (S3 o3)))))
  & T4 ~ ?((@w_nil @w_cons) (S3 (o3 (E4 (S4 o4)))))
  & T5 ~ ?((@w_nil @w_cons) (S4 (o4 (E5 (S5 o5)))))
  & T6 ~ ?((@w_nil @w_cons) (S5 (o5 (E6 (S6 o6)))))
  & T7 ~ ?((@w_nil @w_cons) (S6 (o6 (E7 (S7 o7)))))
  & T8 ~ ?((@w_nil @w_cons) (S7 (o7 (E8 (S8 o8)))))
  & T9 ~ ?((@w_nil @w_cons) (S8 (o8 (E9 (S9 o9)))))
  & T10 ~ ?((@w_nil @w_cons) (S9 (o9 (E10 (S10 o10)))))
  & T11 ~ ?((@w_nil @w_cons) (S10 (o10 (E11 (S11 o11)))))
  & T12 ~ ?((@w_nil @w_cons) (S11 (o11 (E12 (S12 o12)))))
  & T13 ~ ?((@w_nil @w_cons) (S12 (o12 (E13 (S13 o13)))))
  & T14 ~ ?((@w_nil @w_cons) (S13 (o13 (E14 (S14 o14)))))
  & T15 ~ ?((@w_nil @w_cons) (S14 (o14 (E15 (S15 o15)))))
  & T16 ~ ?((@w_nil @w_last) (S15 (o15 (E16 t16))))
@w_nil = (S (o *))
  & @gc_fin ~ (S o)
@w_cons = (* (S (o (E (S2 o)))))
  & @gc_step ~ (S (E S2))
@w_last = (* (S (o (E t))))
  & @gc_step ~ (S (E S2))
  & @w_blk ~ (t (S2 o))

@mex = (a o)
  & a ~ {a1 a2}
  & a1 ~ $([^] $(16777215 na))
  & a2 ~ $([+1] a3)
  & na ~ $([&] $(a3 p))
  & p ~ $([-] $(1 q))
  & @pop ~ (q o)
@pop = (x o)
  & x ~ {x1 x2}
  & x1 ~ $([>>] $(1 y))
  & y ~ $([&] $(5592405 y2))
  & x2 ~ $([-] $(y2 z))
  & z ~ {z1 z2}
  & z1 ~ $([&] $(3355443 za))
  & z2 ~ $([>>] $(2 zb))
  & zb ~ $([&] $(3355443 zc))
  & za ~ $([+] $(zc w))
  & w ~ {w1 w2}
  & w1 ~ $([>>] $(4 wa))
  & w2 ~ $([+] $(wa wb))
  & wb ~ $([&] $(986895 wc))
  & wc ~ $([*] $(65793 wd))
  & wd ~ $([>>] $(16 o))

@zq = (?(((y y) @zq_node) o) o)
@zq_node = (lm (a b))
  & lm ~ {l1 l2}
  & @zq ~ (l1 a)
  & @zq ~ (l2 b)
@pu_act = ((i o) (x (i o2)))
  & o ~ {x o2}
@pu = (t (k (L (P o))))
  & L ~ ?((@pu_leaf @pu_node) (t (k (P o))))
@pu_leaf = (t (* (P o)))
  & @pu_act ~ (t (P o))
@pu_node = (lm (t (k (P o))))
  & k ~ {k1 k2}
  & lm ~ {l1 l2}
  & k1 ~ $([>>] $(l1 sh))
  & sh ~ $([&] $(1 b))
  & b ~ ?((@pu_L @pu_R) (t (k2 (l2 (P o)))))
@pu_L = ((l r) (k (L (P (l2 r)))))
  & @pu ~ (l (k (L (P l2))))
@pu_R = (* ((l r) (k (L (P (l r2))))))
  & @pu ~ (r (k (L (P r2))))
@oa = (t (k (L (P o))))
  & L ~ ?((@oa_leaf @oa_node) (t (k (P o))))
@oa_leaf = (t (* (P o)))
  & @oa_act ~ (t (P o))
@oa_node = (lm (t (k (P o))))
  & k ~ {k1 k2}
  & lm ~ {l1 l2}
  & k1 ~ $([>>] $(l1 sh))
  & sh ~ $([&] $(1 b))
  & b ~ ?((@oa_L @oa_R) (t (k2 (l2 (P o)))))
@oa_L = ((l r) (k (L (P (l2 r)))))
  & @oa ~ (l (k (L (P l2))))
@oa_R = (* ((l r) (k (L (P (l r2))))))
  & @oa ~ (r (k (L (P r2))))
// tl(t, L, base, n, tail): the leaves of t with index < n, in order, prepended to tail
@tl = (t (L (base (n (tail o)))))
  & L ~ ?((@tl_leaf @tl_node) (t (base (n (tail o)))))
@tl_leaf = (x (base (n (tail o))))
  & base ~ $([<] $(n keep))
  & keep ~ ?((@tl_drop @tl_keep) (x (tail o)))
@tl_drop = (* (t t))
@tl_keep = (* (x (t (1 (x t)))))
@tl_node = (lm ((a b) (base (n (tail o)))))
  & lm ~ {l1 {l2 l3}}
  & base ~ {b1 b2}
  & n ~ {n1 n2}
  & 1 ~ $([<<] $(l3 half))
  & b2 ~ $([+] $(half bR))
  & @tl ~ (a (l1 (b1 (n1 (mid o)))))
  & @tl ~ (b (l2 (bR (n2 (tail mid)))))
// ---- shared trie primitives (depth-L complete binary trie, leaves are numbers, keyed by bits of the key, high bit first)
// lg(x) = number of bits of x (0 for 0): trie depth for keys 0..x
@lg = (?((0 @lg_s) o) o)
@lg_s = (xm o)
  & xm ~ $([+1] x)
  & x ~ $([>>] $(1 y))
  & @lg ~ (y z)
  & z ~ $([+1] o)

// zt(L): trie of depth L with all leaves 0
@zt = (?((0 @zt_node) o) o)
@zt_node = (lm (a b))
  & lm ~ {l1 l2}
  & @zt ~ (l1 a)
  & @zt ~ (l2 b)

// cnt(t, L): sum of the leaves
@cnt = (t (L o))
  & L ~ ?((@cnt_leaf @cnt_node) (t o))
@cnt_leaf = (x x)
@cnt_node = (lm ((a b) o))
  & lm ~ {l1 l2}
  & @cnt ~ (a (l1 x))
  & @cnt ~ (b (l2 y))
  & x ~ $([+] $(y o))

// ins(t, k, L): set leaf k to 1. Control flow depends on k and L only, so it expands before t exists.
@ins = (t (k (L o)))
  & L ~ ?((@ins_leaf @ins_node) (t (k o)))
@ins_leaf = (* (* 1))
@ins_node = (lm (t (k o)))
  & k ~ {k1 k2}
  & lm ~ {l1 l2}
  & k1 ~ $([>>] $(l1 sh))
  & sh ~ $([&] $(1 b))
  & b ~ ?((@ins_L @ins_R) (t (k2 (l2 o))))
@ins_L = ((l r) (k (L (l2 r))))
  & @ins ~ (l (k (L l2)))
@ins_R = (* ((l r) (k (L (l r2)))))
  & @ins ~ (r (k (L r2)))
