@prog = (input output)
  & input ~ (c (e rest))
  & rest ~ *
  & @solve ~ (c (e output))

@solve = (c (e output))
  & @proc_edges ~ (c (e ((0 *) output)))

@proc_edges = (c (e (rewrites output)))
  & e ~ ?((@done @one_edge) ((c (rewrites output))))

@done = (ctx)
  & ctx ~ (c (rewrites output))
  & c ~ *
  & @output_degrees ~ ((rewrites output))

@one_edge = ((u v) (c (rewrites output)))
  & {c1 c2} ~ c
  & @lookup ~ (c1 (u cu_res))
  & @lookup ~ (c2 (v cv_res))
  & {cu1 cu2} ~ cu_res
  & {cv1 cv2} ~ cv_res
  & cmp ~ $([!] $(cv1 cmp_result))
  & cu1 ~ cmp
  & cmp_result ~ ?((@same @diff) ((cu2 (cv2 (rewrites output)))))

@same = (cu (cv (rewrites output)))
  & cu ~ *
  & cv ~ *
  & @proc_edges ~ (rewrites output)

@diff = (dummy (cu (cv (rewrites output))))
  & dummy ~ *
  & {cu_a cu_b} ~ cu
  & {cv_a cv_b} ~ cv
  & lt ~ $([<] $(cv_a lt_result))
  & cu_a ~ lt
  & lt_result ~ ?((@cu_lt @cu_ge) ((cu_b (cv_b (rewrites output)))))

@cu_lt = (cu (cv (rewrites output)))
  & new_edge ~ (1 ((cu (cv rewrites))))
  & @proc_edges ~ (new_edge output)

@cu_ge = (dummy (cu (cv (rewrites output))))
  & dummy ~ *
  & new_edge ~ (1 ((cv (cu rewrites))))
  & @proc_edges ~ (new_edge output)

@lookup = (lst (idx result))
  & idx ~ ?((@lz @ls) ((lst result)))

@lz = (ctx)
  & ctx ~ (lst result)
  & lst ~ (h t)
  & t ~ *
  & h ~ result

@ls = (pred_ctx)
  & pred_ctx ~ (pred (lst result))
  & pred ~ *
  & lst ~ (h t)
  & h ~ *
  & @lookup ~ (t (pred result_inner))
  & result ~ result_inner

@output_degrees = (rewrites output)
  & rewrites ~ ?((@od_nil @od_cons) (output))

@od_nil = output ~ (0 *)

@od_cons = ((u v) (rest output))
  & output ~ (1 (u (1 (v output_rest))))
  & @output_degrees ~ ((rest output_rest))
