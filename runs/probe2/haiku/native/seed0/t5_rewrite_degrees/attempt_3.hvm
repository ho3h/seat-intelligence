@prog = (input output)
  & input ~ (c (e rest))
  & rest ~ *
  & @solve ~ (c (e output))

@solve = (c (e output))
  & @proc_edges ~ (c (e ((0 *) output)))

@proc_edges = (c (e (rewrites output)))
  & e ~ ?((@done @one_edge) ((c (rewrites output))))

@done = (ctx)
  & ctx ~ (c (rewrites output))
  & c ~ *
  & @output_degrees ~ ((rewrites output))

@one_edge = (ctx_with_edge)
  & ctx_with_edge ~ ((u v) (c (rewrites output)))
  & {c1 c2} ~ c
  & @lookup ~ (c1 (u cu_res))
  & @lookup ~ (c2 (v cv_res))
  & eq ~ $([=] $(cv_res eq_result))
  & eq_result ~ ?((@skip @process_diff) (({cu_d1 cu_d2} ({cv_d1 cv_d2} (rewrites output)))))

@skip = (ctx)
  & ctx ~ (cu (cv (rewrites output)))
  & cu ~ *
  & cv ~ *
  & @proc_edges ~ (rewrites output)

@process_diff = (ctx_pred)
  & ctx_pred ~ (_ (cu (cv (rewrites output))))
  & _ ~ *
  & lt ~ $([<] $(cv lt_result))
  & lt_result ~ ?((@add_cu_cv @add_cv_cu) ((cu (cv (rewrites output)))))

@add_cu_cv = (ctx)
  & ctx ~ (cu (cv (rewrites output)))
  & new_list ~ (1 ((cu (cv rewrites))))
  & @proc_edges ~ (new_list output)

@add_cv_cu = (ctx_pred)
  & ctx_pred ~ (_ (cu (cv (rewrites output))))
  & _ ~ *
  & new_list ~ (1 ((cv (cu rewrites))))
  & @proc_edges ~ (new_list output)

@lookup = (lst (idx result))
  & idx ~ ?((@lz @ls) ((lst result)))

@lz = (ctx)
  & ctx ~ (lst result)
  & lst ~ (h t)
  & t ~ *
  & h ~ (val unused)
  & unused ~ *
  & result ~ val

@ls = (pred_and_ctx)
  & pred_and_ctx ~ (pred (lst result))
  & pred ~ *
  & lst ~ (h t)
  & h ~ *
  & @lookup ~ (t (pred result_inner))
  & result ~ result_inner

@output_degrees = (rewrites output)
  & rewrites ~ ?((@od_nil @od_cons) (output))

@od_nil = output ~ (0 *)

@od_cons = (edge_rest)
  & edge_rest ~ ((u v) (rest output))
  & @output_degrees ~ (rest output_res)
  & output_res ~ (1 (u (1 (v output_tail))))
