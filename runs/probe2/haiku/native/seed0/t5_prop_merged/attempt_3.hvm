@prog = (input output)
  & input ~ ((c attrs) *)
  & @process ~ (c (attrs (0 *) output))

@process = (c (attrs acc out))
  & attrs ~ (?((@proc_nil @proc_cons) (c (acc out))) *)

@proc_nil = (c (acc out))
  & * ~ c
  & out ~ acc

@proc_cons = (* (((n (k v)) t) (c (acc out))))
  & @get_cid ~ (n (c cid))
  & cid ~ ((cid_val rest) *)
  & * ~ rest
  & @insert_sorted ~ ((cid_val (k v)) (acc acc_new))
  & @process ~ (c (t acc_new out))

@get_cid = (i (list out))
  & i ~ ?((@gc_z @gc_s) (list out))

@gc_z = (list out)
  & list ~ (h t)
  & * ~ t
  & out ~ h

@gc_s = (((i_rest out) list) *)
  & @get_cid ~ (i_rest (list out))

@insert_sorted = ((cid (k v)) (acc out))
  & acc ~ (?((@is_nil @is_cons) out) *)

@is_nil = (out)
  & out ~ (1 ((cid (k v)) (0 *)))

@is_cons = (* (((cid2 (k2 v2)) rest) out))
  & cid ~ $([<] $(cid2 cmp_cid))
  & cmp_cid ~ (?((@is_lt @is_ge) ((cid (k v)) (cid2 (k2 v2)) rest out)) *)

@is_lt = ((cid (k v)) (cid2 (k2 v2)) rest out)
  & out ~ (1 (((cid (k v)) cont) *))
  & @insert_sorted ~ (((cid2 (k2 v2)) rest) cont)

@is_ge = ((cid (k v)) (cid2 (k2 v2)) rest out)
  & cid ~ $([=] $(cid2 cmp_eq))
  & cmp_eq ~ (?((@is_eq @is_gt) ((cid (k v)) (cid2 (k2 v2)) rest out)) *)

@is_eq = ((cid (k v)) (cid2 (k2 v2)) rest out)
  & * ~ cid2
  & k ~ $([=] $(k2 cmp_k))
  & cmp_k ~ (?((@is_same_k @is_diff_k) ((k v) (v2 rest out))) *)

@is_same_k = ((k v) (v2 rest out))
  & * ~ k
  & @min_val ~ ((v v2) min_v)
  & out ~ (1 (((cid (k min_v)) cont) *))
  & @insert_sorted ~ (rest cont)

@is_diff_k = ((k v) (v2 rest out))
  & * ~ v2
  & out ~ (1 (((cid (k v)) cont) *))
  & @insert_sorted ~ (((cid2 (k2 v2)) rest) cont)

@is_gt = ((cid (k v)) (cid2 (k2 v2)) rest out)
  & out ~ (1 (((cid2 (k2 v2)) cont) *))
  & @insert_sorted ~ (((cid (k v)) rest) cont)

@min_val = ((v1 v2) out)
  & v1 ~ $([<] $(v2 cmp))
  & cmp ~ ?((@mv_v1 @mv_v2) ((v1 v2) out)) *)

@mv_v1 = ((v1 v2) out)
  & out ~ v1
  & * ~ v2

@mv_v2 = ((v1 v2) out)
  & * ~ v1
  & out ~ v2
