@prog = ((c edges) out)
  & c ~ {c1 c2}
  & @length ~ (c1 n)
  & @main_loop ~ (c2 (edges (0 n out)))

@length = ((?((@len_nil @len_cons) (pl out)) pl) out)

@len_nil = (p out)
  & p ~ *
  & out ~ 0

@len_cons = (* (p out))
  & p ~ (head tail)
  & head ~ *
  & @length ~ (tail len)
  & len ~ $([+1] out)

@main_loop = (c (edges (i (n out))))
  & i ~ {i1 i2}
  & n ~ {n1 n2}
  & i1 ~ $([=] $(n1 eq))
  & eq ~ ?((@ml_cont @ml_done) (c (edges (i2 n2 out))))

@ml_done = (* (c (edges (i n out))))
  & c ~ *
  & edges ~ *
  & i ~ *
  & n ~ *
  & out ~ (0 *)

@ml_cont = (c (edges (i n out)))
  & c ~ {c1 c2}
  & i ~ {i1 i2}
  & i2 ~ {i3 i4}
  & @nth ~ (c1 (i1 ci))
  & ci ~ $([=] $(i3 eq2))
  & eq2 ~ ?((@ml_skip @ml_add) (c2 (edges (i4 n out))))

@ml_skip = (c (edges (i n out)))
  & i ~ $([+1] i_next)
  & @main_loop ~ (c (edges (i_next n out)))

@ml_add = (* (c (edges (i n out))))
  & c ~ {c1 c2}
  & edges ~ {e1 e2}
  & i ~ {i1 i2}
  & @degree ~ (c1 (e1 (i1 deg)))
  & i2 ~ $([+1] i_next)
  & @main_loop ~ (c2 (e2 (i_next n rest)))
  & out ~ (1 (deg rest))

@degree = (c (edges (i out)))
  & @scan_edges ~ (c (edges (i ((0 *) neigh))))
  & @length ~ (neigh out)

@scan_edges = (c ((?((@scan_nil @scan_cons) (c (pl (i (acc out))))) pl) (i (acc out))))

@scan_nil = (c (p (i (acc out))))
  & c ~ *
  & p ~ *
  & i ~ *
  & acc ~ out

@scan_cons = (* (c (((u v) rest) (i (acc out)))))
  & c ~ {c12 c_ctx}
  & c12 ~ {c1 c2}
  & @nth ~ (c1 u cu)
  & @nth ~ (c2 v cv)
  & i ~ {i12 i34}
  & i12 ~ {i1 i2}
  & i34 ~ {i3 i4}
  & cu ~ {cu1 cu2}
  & cv ~ {cv1 cv2}
  & cu1 ~ $([=] $(i1 eq1))
  & cv1 ~ $([=] $(i2 eq2))
  & eq1 ~ $([^] $(eq2 cond))
  & cu2 ~ $([+] $(cv2 sum))
  & sum ~ $([-] $(i3 other))
  & cond ~ ?((@sc_no @sc_yes) (c_ctx (i4 (other (acc (rest out))))))

@sc_no = (c (i (other (acc (rest out)))))
  & other ~ *
  & @scan_edges ~ (c (rest (i (acc out))))

@sc_yes = (* (c (i (other (acc (rest out))))))
  & acc ~ {a1 a2}
  & @member ~ (a1 (other mem))
  & mem ~ ?((@sc_yes_add @sc_yes_keep) (c (i (other (a2 (rest out))))))

@sc_yes_add = (c (i (other (acc (rest out)))))
  & @scan_edges ~ (c (rest (i ((1 (other acc)) out))))

@sc_yes_keep = (* (c (i (other (acc (rest out))))))
  & other ~ *
  & @scan_edges ~ (c (rest (i (acc out))))

@member = ((?((@mem_nil @mem_cons) (pl (x out))) pl) (x out))

@mem_nil = (p (x out))
  & p ~ *
  & x ~ *
  & out ~ 0

@mem_cons = (* ((head tail) (x out)))
  & x ~ {x1 x2}
  & head ~ $([=] $(x1 eq))
  & eq ~ ?((@mem_no @mem_yes) (x2 (tail out)))

@mem_no = (x (tail out))
  & @member ~ (tail (x out))

@mem_yes = (* (x (tail out)))
  & x ~ *
  & tail ~ *
  & out ~ 1

@nth = ((?((@nth_nil @nth_cons) (pl (idx out))) pl) (idx out))

@nth_nil = (p (idx out))
  & p ~ *
  & idx ~ *
  & out ~ 0

@nth_cons = (* ((head tail) (idx out)))
  & idx ~ ?((@nth_ret @nth_rec) (head (tail out)))

@nth_ret = (h (t out))
  & t ~ *
  & h ~ out

@nth_rec = (i0 (h (t out)))
  & h ~ *
  & @nth ~ (t (i0 out))
