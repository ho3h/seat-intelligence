@prog = (input out)
  & input ~ (n edges)
  & {n_zero n_rest} ~ n
  & {n_greedy_rest n_search_rest} ~ n_rest
  & @make_matrix ~ (n_zero adj0)
  & @build_edges ~ (edges (adj0 adj))
  & {adj_greedy adj_search} ~ adj
  & {n_greedy_loop n_greedy_cur} ~ n_greedy_rest
  & @zeros ~ (n_greedy_cur cur_greedy)
  & @greedy ~ (0 (n_greedy_loop (adj_greedy (cur_greedy (0 best0)))))
  & {n_search_loop n_search_cur} ~ n_search_rest
  & @zeros ~ (n_search_cur cur_search)
  & @search ~ (0 (n_search_loop (adj_search (cur_search (0 (best0 out))))))

@make_matrix = (n out)
  & {n_row n_cnt} ~ n
  & n_cnt ~ ?((@mm_zero @mm_pos) (n_row out))
@mm_zero = (n_row out)
  & n_row ~ *
  & out ~ (0 *)
@mm_pos = (n_minus (n_row out))
  & @zeros ~ (n_row row)
  & @make_matrix ~ (n_minus rest)
  & out ~ (1 (row rest))

@zeros = (n out)
  & n ~ ?((@zeros_zero @zeros_pos) out)
@zeros_zero = (out)
  & out ~ (0 *)
@zeros_pos = (n_minus out)
  & @zeros ~ (n_minus tail)
  & out ~ (1 (0 tail))

@build_edges = (edges adj out)
  & edges ~ (tag payload)
  & tag ~ ?((@be_nil @be_cons) (payload adj out))
@be_nil = (payload adj out)
  & payload ~ *
  & adj ~ out
@be_cons = (* (payload adj out))
  & payload ~ (edge tail)
  & edge ~ (u v)
  & {u1 u2} ~ u
  & {v1 v2} ~ v
  & @set_edge ~ (adj u1 v1 adj1)
  & @set_edge ~ (adj1 v2 u2 adj2)
  & @build_edges ~ (tail adj2 out)

@set_edge = (adj u v out)
  & adj ~ (tag payload)
  & tag ~ ?((@se_nil @se_cons) (u (v (payload out))))
@se_nil = (u (v (payload out)))
  & u ~ *
  & v ~ *
  & payload ~ *
  & out ~ (0 *)
@se_cons = (* (u (v (payload out))))
  & payload ~ (row rest)
  & u ~ ?((@se_row0 @se_rowpos) (row (rest (v out))))
@se_row0 = (row (rest (v out)))
  & rest ~ *
  & @set_bit ~ (row v 1 out)
@se_rowpos = (u_minus (row (rest (v out))))
  & @set_edge ~ (rest u_minus v newrest)
  & out ~ (1 (row newrest))

@set_bit = (lst idx bit out)
  & lst ~ (tag payload)
  & tag ~ ?((@set_nil @set_cons) (payload idx bit out))
@set_nil = (payload idx bit out)
  & payload ~ *
  & idx ~ *
  & bit ~ *
  & out ~ (0 *)
@set_cons = (* (payload idx bit out))
  & payload ~ (h t)
  & idx ~ ?((@set_idx0 @set_idxpos) (h t bit out))
@set_idx0 = (h t bit out)
  & h ~ $([|] $(bit newh))
  & out ~ (1 (newh t))
@set_idxpos = (idx_minus (h t bit out))
  & @set_bit ~ (t idx_minus bit newtail)
  & out ~ (1 (h newtail))

@nth = (lst idx out)
  & lst ~ (tag payload)
  & tag ~ ?((@nth_nil @nth_cons) (payload idx out))
@nth_nil = (payload idx out)
  & payload ~ *
  & idx ~ *
  & out ~ 0
@nth_cons = (* (payload idx out))
  & payload ~ (head tail)
  & idx ~ ?((@nth_zero @nth_pos) (head tail out))
@nth_zero = (head tail out)
  & tail ~ *
  & head ~ out
@nth_pos = (idx_minus (head tail out))
  & head ~ *
  & @nth ~ (tail idx_minus out)

@is_subset = (a b out)
  & a ~ (tag payload)
  & tag ~ ?((@iss_nil @iss_cons) (b (payload out)))
@iss_nil = (b (payload out))
  & b ~ *
  & payload ~ *
  & out ~ 1
@iss_cons = (* (b (payload out)))
  & payload ~ (ha ta)
  & b ~ (btag bpayload)
  & btag ~ ?((@iss_bnil @iss_bcons) (ha (ta (bpayload out))))
@iss_bnil = (ha (ta (bpayload out)))
  & ha ~ *
  & ta ~ *
  & bpayload ~ *
  & out ~ 0
@iss_bcons = (* (ha (ta (bpayload out))))
  & bpayload ~ (hb tb)
  & ha ~ ?((@iss_ha_zero @iss_ha_one) (hb (tb (ta out))))
@iss_ha_zero = (hb (tb (ta out)))
  & hb ~ *
  & @is_subset ~ (ta tb out)
@iss_ha_one = (* (hb (tb (ta out))))
  & hb ~ ?((@iss_hb_zero @iss_hb_one) (tb (ta out)))
@iss_hb_zero = (tb (ta out))
  & ta ~ *
  & tb ~ *
  & out ~ 0
@iss_hb_one = (* (tb (ta out)))
  & @is_subset ~ (ta tb out)

@max = (a b out)
  & {a1 a2} ~ a
  & {b1 b2} ~ b
  & a1 ~ $([>] $(b1 gt))
  & gt ~ ?((@max_b @max_a) (a2 (b2 out)))
@max_b = (a (b out))
  & a ~ *
  & b ~ out
@max_a = (* (a (b out)))
  & b ~ *
  & a ~ out

@greedy = (i n adj cur size out)
  & {i_cmp i_ctx} ~ i
  & {n_cmp n_ctx} ~ n
  & i_cmp ~ $([<] $(n_cmp cmp))
  & cmp ~ ?((@greedy_done @greedy_step) (i_ctx (n_ctx (adj (cur (size out))))))
@greedy_done = (i n adj cur size out)
  & i ~ *
  & n ~ *
  & adj ~ *
  & cur ~ *
  & size ~ out
@greedy_step = (* (i n adj cur size out))
  & {i_add i_work} ~ i
  & {i_idx i_unused} ~ i_work
  & i_unused ~ *
  & {i_idx_q i_idx_upd} ~ i_idx
  & i_add ~ $([+1] iplus)
  & {adj_nth adj_recur} ~ adj
  & {cur_check cur_new} ~ cur
  & @nth ~ (adj_nth i_idx_q mask_i)
  & @is_subset ~ (cur_check mask_i incl)
  & @greedy_maybe ~ (incl cur_new size i_idx_upd iplus n adj_recur out)
@greedy_maybe = (incl cur size i_idx i n adj out)
  & incl ~ ?((@greedy_no @greedy_yes) (cur (size (i_idx (i (n (adj out)))))))
@greedy_no = (cur size i_idx i n adj out)
  & i_idx ~ *
  & @greedy ~ (i (n (adj (cur (size out)))))
@greedy_yes = (* (cur size i_idx i n adj out))
  & @set_bit ~ (cur i_idx 1 new_cur)
  & size ~ $([+1] new_size)
  & @greedy ~ (i (n (adj (new_cur (new_size out)))))

@search = (i n adj cur size best out)
  & {i_cmp i_ctx} ~ i
  & {n_cmp n_ctx} ~ n
  & i_cmp ~ $([<] $(n_cmp cmp))
  & cmp ~ ?((@search_done @search_step) (i_ctx (n_ctx (adj (cur (size (best out)))))))
@search_done = (i n adj cur size best out)
  & i ~ *
  & n ~ *
  & adj ~ *
  & cur ~ *
  & @max ~ (best (size out))
@search_step = (* (i n adj cur size best out))
  & {i_bound i_work} ~ i
  & {n_bound n_work} ~ n
  & {size_bound size_work} ~ size
  & {best_bound best_work} ~ best
  & n_bound ~ $([-] $(i_bound rem))
  & rem ~ $([+] $(size_bound bound))
  & bound ~ $([>] $(best_bound gt))
  & gt ~ ?((@search_prune @search_continue) (i_work (n_work (adj (cur (size_work (best_work out)))))))
@search_prune = (i n adj cur size best out)
  & i ~ *
  & n ~ *
  & adj ~ *
  & cur ~ *
  & size ~ *
  & best ~ out
@search_continue = (* (i n adj cur size best out))
  & {i_add i_work2} ~ i
  & {i_idx i_unused2} ~ i_work2
  & i_unused2 ~ *
  & {i_idx_q i_idx_upd} ~ i_idx
  & i_add ~ $([+1] iplus)
  & {iplus_excl iplus_incl} ~ iplus
  & {n_excl n_incl} ~ n
  & {adj_nth adj_rest} ~ adj
  & {adj_excl adj_incl} ~ adj_rest
  & {cur_excl cur_work} ~ cur
  & {cur_check cur_new} ~ cur_work
  & {size_excl size_incl} ~ size
  & @nth ~ (adj_nth i_idx_q mask_i)
  & @search ~ (iplus_excl (n_excl (adj_excl (cur_excl (size_excl (best out_excl))))))
  & @is_subset ~ (cur_check mask_i incl)
  & @maybe_include ~ (incl (cur_new (size_incl (i_idx_upd (out_excl (iplus_incl (n_incl (adj_incl out))))))))
@maybe_include = (incl cur size i_idx best i n adj out)
  & incl ~ ?((@no_include @yes_include) (cur (size (i_idx (best (i (n (adj out))))))))
@no_include = (cur size i_idx best i n adj out)
  & cur ~ *
  & size ~ *
  & i_idx ~ *
  & i ~ *
  & n ~ *
  & adj ~ *
  & best ~ out
@yes_include = (* (cur size i_idx best i n adj out))
  & @set_bit ~ (cur i_idx 1 new_cur)
  & size ~ $([+1] new_size)
  & @search ~ (i (n (adj (new_cur (new_size (best out))))))
