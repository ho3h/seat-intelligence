@prog = ((xs t) out)
  & @lb ~ (xs (t (0 out)))

@lb = ((?((@lb_done @lb_cons) (pl (t (acc out)))) pl) (t (acc out)))

@lb_done = (* (* (a a)))

@lb_cons = (* ((h tl) (t (acc out))))
  & t ~ {t1 t2}
  & h ~ $([<] $(t1 c))
  & c ~ ?((@lb_done @lb_go) (tl (t2 (acc out))))

@lb_go = (* (tl (t (acc out))))
  & acc ~ $([+] $(1 acc2))
  & @lb ~ (tl (t (acc2 out)))
