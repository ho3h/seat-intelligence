@prog = ({n1 n2} out)
  & n1 ~ $([>>] $(1 a))
  & a ~ $([&] $(5592405 b))
  & n2 ~ $([-] $(b x))
  & x ~ {x1 x2}
  & x1 ~ $([&] $(3355443 y1))
  & x2 ~ $([>>] $(2 x3))
  & x3 ~ $([&] $(3355443 y2))
  & y1 ~ $([+] $(y2 z))
  & z ~ {z1 z2}
  & z1 ~ $([>>] $(4 z3))
  & z2 ~ $([+] $(z3 w))
  & w ~ $([&] $(986895 v))
  & v ~ $([*] $(65793 u))
  & u ~ $([>>] $(16 out))
