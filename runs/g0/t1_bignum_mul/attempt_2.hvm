@prog = ((a b) out)
  & @mul ~ (a (b r))
  & @norm ~ (r out)

// mul(a, b): a = a0:at  ->  F(b, a0, 0:mul(at,b), 0)
@mul = ((?((@mul_nil @mul_cons) (p (b out))) p) (b out))
@mul_nil = (* (* (0 *)))
@mul_cons = (* ((a0 at) ({b1 b2} out)))
  & @mul ~ (at (b2 r))
  & @F ~ (b1 (a0 ((1 (0 r)) (0 out))))

// F(b, d, acc, c) = b*d + acc + c
@F = ((?((@F_nil @F_cons) (p (d (acc (c out))))) p) (d (acc (c out))))
@F_nil = (* (* (acc (c out))))
  & @addc ~ (acc (c out))
@F_cons = (* ((bi bt) ({d1 d2} (acc (c (1 (lo rest)))))))
  & @hd0 ~ (acc (ai at))
  & bi ~ $([*] $(d1 m))
  & m ~ $([+] $(ai s1))
  & s1 ~ $([+] $(c {t1 t2}))
  & t1 ~ $([&] $(4095 lo))
  & t2 ~ $([>>] $(12 hi))
  & @F ~ (bt (d2 (at (hi rest))))

// hd0(list) = (head, tail), with Nil -> (0, Nil)
@hd0 = ((?((@hd0_nil @hd0_cons) (p r)) p) r)
@hd0_nil = (* (0 (0 *)))
@hd0_cons = (* (p p))

// addc(acc, c) = acc + c
@addc = (acc (c out))
  & c ~ ?((@addc_z @addc_s) (acc out))
@addc_z = (a a)
@addc_s = (cm1 (acc out))
  & cm1 ~ $([+1] c)
  & @addc_loop ~ (acc (c out))
@addc_loop = ((?((@al_nil @al_cons) (p (c out))) p) (c out))
@al_nil = (* (c (1 (c (0 *)))))
@al_cons = (* ((ai at) (c (1 (lo rest)))))
  & ai ~ $([+] $(c {t1 t2}))
  & t1 ~ $([&] $(4095 lo))
  & t2 ~ $([>>] $(12 hi))
  & @addc ~ (at (hi rest))

// norm: strip most-significant zero digits
@norm = ((?((@norm_nil @norm_cons) (p out)) p) out)
@norm_nil = (* (0 *))
@norm_cons = (* ((x xs) out))
  & @norm ~ (xs r)
  & r ~ (?((@nn_nil @nn_cons) (x (rp out))) rp)
@nn_cons = (* (x (rp (1 (x (1 rp))))))
@nn_nil = (x (* out))
  & x ~ ?(((0 *) @nn_s) out)
@nn_s = (p (1 (x (0 *))))
  & p ~ $([+1] x)
