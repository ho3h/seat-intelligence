@prog = (l out)
  & @dd ~ (l out)

@dd = ((?((@dd_nil @dd_cons) (pl out)) pl) out)

@dd_nil = (* (0 *))

@dd_cons = (* (({h1 h2} t) (1 (h1 rest))))
  & @go ~ (h2 (t rest))

@go = (prev ((?((@go_nil @go_cons) (pl (prev out))) pl) out))

@go_nil = (* (* (0 *)))

@go_cons = (* (({h1 h2} t) (prev out)))
  & h1 ~ $([=] $(prev e))
  & e ~ ?((@go_new @go_same) (h2 (t out)))

@go_new = ({h1 h2} (t (1 (h1 rest))))
  & @go ~ (h2 (t rest))

@go_same = (* (h (t out)))
  & @go ~ (h (t out))
